---
import Base from '../layouts/Base.astro';
---
<Base title="Comparar municipios — Ranking España" description="Compara dos o tres municipios de España por sus puntuaciones turísticas">

<div class="comparar-page">
  <div class="comparar-header">
    <h1>⚖️ Comparar municipios</h1>
    <p>Elige 2 o 3 municipios y mira lado a lado quién gana en monumentos, gastronomía, playas, fiestas y más.</p>
    <div class="comparar-ejemplos">
      <span class="ej-label">Pruébalo:</span>
      <a class="ej-chip" href="/comparar?a=29084&b=29053">Ronda vs Frigiliana</a>
      <a class="ej-chip" href="/comparar?a=45168&b=16078">Toledo vs Cuenca</a>
      <a class="ej-chip" href="/comparar?a=20069&b=48020">San Sebastián vs Bilbao</a>
      <a class="ej-chip" href="/comparar?a=05008&b=33036">Cudillero vs Llanes</a>
    </div>
  </div>

  <!-- Buscadores -->
  <div class="comparar-slots" id="slots">
    <div class="slot" id="slot-0">
      <div class="slot-label"><span class="slot-num">1</span> Primer municipio</div>
      <div class="slot-search">
        <input id="input-0" type="text" placeholder="🔍 Busca un municipio..." autocomplete="off">
        <div class="slot-ac" id="ac-0"></div>
        <button type="button" class="slot-near hidden" id="near-0">📍 Sugerir cercanos</button>
        <div class="slot-suggest hidden" id="suggest-0"></div>
      </div>
      <div class="slot-card hidden" id="card-0"></div>
    </div>
    <div class="slot" id="slot-1">
      <div class="slot-label"><span class="slot-num">2</span> Segundo municipio</div>
      <div class="slot-search">
        <input id="input-1" type="text" placeholder="🔍 Busca un municipio..." autocomplete="off">
        <div class="slot-ac" id="ac-1"></div>
        <button type="button" class="slot-near hidden" id="near-1">📍 Sugerir cercanos</button>
        <div class="slot-suggest hidden" id="suggest-1"></div>
      </div>
      <div class="slot-card hidden" id="card-1"></div>
    </div>
    <div class="slot slot-optional" id="slot-2">
      <div class="slot-label"><span class="slot-num">3</span> Tercero <span class="slot-opt">(opcional)</span></div>
      <div class="slot-search">
        <input id="input-2" type="text" placeholder="🔍 Añadir tercero (opcional)..." autocomplete="off">
        <div class="slot-ac" id="ac-2"></div>
        <button type="button" class="slot-near hidden" id="near-2">📍 Sugerir cercanos</button>
        <div class="slot-suggest hidden" id="suggest-2"></div>
      </div>
      <div class="slot-card hidden" id="card-2"></div>
    </div>
  </div>

  <!-- Botón comparar -->
  <div class="comparar-btn-wrap hidden" id="comparar-btn-wrap">
    <button class="comparar-btn" id="comparar-btn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
      Ver comparativa
    </button>
  </div>

  <!-- Área de comparación -->
  <div class="comparar-result hidden" id="comparar-result">
    <!-- Radar chart -->
    <div class="radar-wrap">
      <canvas id="radar-canvas" width="500" height="500"></canvas>
    </div>
    <!-- Tabla de puntuaciones -->
    <div class="comparar-table-wrap">
      <table class="comparar-table" id="comparar-table">
        <thead id="table-head"></thead>
        <tbody id="table-body"></tbody>
      </table>
    </div>
  </div>
</div>

<script>
const CATS = [
  { key: 'monumentos',   label: 'Monumentos' },
  { key: 'castillos',    label: 'Castillos' },
  { key: 'gastronomia',  label: 'Gastronomía' },
  { key: 'vinos',        label: 'Vinos' },
  { key: 'fiestas',      label: 'Fiestas' },
  { key: 'senderismo',   label: 'Senderismo' },
  { key: 'miradores',    label: 'Miradores' },
  { key: 'Playas',       label: 'Playas' },
  { key: 'TurismoRural', label: 'Turismo rural' },
  { key: 'Campings',     label: 'Camping' },
  { key: 'lujo',         label: 'Lujo' },
  { key: 'solteros',     label: 'Solteros' },
  { key: 'misterioso',   label: 'Misterio' },
];

const COLORS = ['#FF385C', '#0066FF', '#00B67A'];
const COLORS_ALPHA = ['rgba(255,56,92,.18)', 'rgba(0,102,255,.18)', 'rgba(0,182,122,.18)'];

// Estado
const state = [null, null, null]; // {codigo, nombre, provincia, scores}
let debounceTimers = [null, null, null];

// Wire up inputs via event listeners (module scope — no inline handlers)
[0, 1, 2].forEach(i => {
  const input = document.getElementById(`input-${i}`) as HTMLInputElement;
  if (!input) return;
  input.addEventListener('input', () => slotSearch(i, input.value));
  input.addEventListener('keydown', (e) => { if (e.key === 'Escape') clearSlot(i); });
  document.getElementById(`near-${i}`)?.addEventListener('click', () => loadNear(i));
});

// Muestra el botón "Sugerir cercanos" en los huecos vacíos cuando ya hay
// al menos un municipio elegido en el que anclarse.
function refreshNear() {
  const hayAncla = state.some(Boolean);
  [0, 1, 2].forEach(i => {
    const btn = document.getElementById(`near-${i}`);
    const sug = document.getElementById(`suggest-${i}`);
    if (!btn) return;
    if (state[i] == null && hayAncla) {
      btn.classList.remove('hidden');
    } else {
      btn.classList.add('hidden');
      if (sug) { sug.classList.add('hidden'); sug.innerHTML = ''; }
    }
  });
}

async function loadNear(i: number) {
  const ancla = state.find(Boolean) as any;
  if (!ancla) return;
  const sug = document.getElementById(`suggest-${i}`)!;
  sug.innerHTML = '<div class="sug-loading">Buscando municipios cercanos…</div>';
  sug.classList.remove('hidden');
  const list: any[] = await fetch(`/api/municipio-cercanos/${ancla.codigo}`).then(r => r.json()).catch(() => []);
  const elegidos = new Set(state.filter(Boolean).map((s: any) => s.codigo));
  const cercanos = list.filter((m: any) => !elegidos.has(m.codigo_ine)).slice(0, 6);
  if (!cercanos.length) { sug.innerHTML = '<div class="sug-loading">No hay cercanos con datos.</div>'; return; }
  sug.innerHTML = `<div class="sug-title">Cerca de ${ancla.nombre}:</div>`;
  const wrap = document.createElement('div');
  wrap.className = 'sug-chips';
  cercanos.forEach((m: any) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'sug-chip';
    b.innerHTML = `<strong>${m.nombre}</strong><span>${m.provincia}</span>`;
    b.addEventListener('click', () => selectMun(i, m.codigo_ine, m.nombre, m.provincia));
    wrap.append(b);
  });
  sug.append(wrap);
}

document.getElementById('comparar-btn')?.addEventListener('click', () => {
  document.getElementById('comparar-result')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
});

document.addEventListener('click', (e) => {
  if (!(e.target as Element)?.closest?.('.slot-search')) {
    document.querySelectorAll('.slot-ac').forEach(ac => ac.classList.remove('open'));
  }
});

async function slotSearch(i: number, q: string) {
  clearTimeout(debounceTimers[i] as any);
  const ac = document.getElementById(`ac-${i}`)!;
  if (!q || q.length < 2) { ac.innerHTML = ''; ac.classList.remove('open'); return; }
  debounceTimers[i] = setTimeout(async () => {
    const res: any[] = await fetch(`/api/search?q=${encodeURIComponent(q)}`).then(r => r.json());
    const munis = res.filter((m: any) => m.tipo === 'municipio' && m.codigo_ine && m.provincia);
    if (!munis.length) { ac.classList.remove('open'); return; }
    ac.innerHTML = '';
    munis.slice(0, 6).forEach((m: any) => {
      const el = document.createElement('div');
      el.className = 'sac-item';
      const strong = document.createElement('strong');
      strong.textContent = m.nombre;
      const span = document.createElement('span');
      span.textContent = m.provincia;
      el.append(strong, span);
      el.addEventListener('click', () => selectMun(i, m.codigo_ine, m.nombre, m.provincia));
      ac.append(el);
    });
    ac.classList.add('open');
  }, 220) as any;
}

async function selectMun(i: number, codigo: string, nombre: string, provincia: string) {
  const ac = document.getElementById(`ac-${i}`)!;
  ac.classList.remove('open');
  const input = document.getElementById(`input-${i}`) as HTMLInputElement;
  if (input) input.value = '';
  const scores = await fetch(`/api/municipio-scores/${codigo}`).then(r => r.json()).catch(() => null);
  if (!scores) return;
  state[i] = { codigo, nombre, provincia, scores: Array.isArray(scores) ? scores : [] };
  const search = document.querySelector(`#slot-${i} .slot-search`);
  if (search) search.classList.add('hidden');
  renderCard(i);
  renderComparison();
  refreshNear();
}

function clearSlot(i: number) {
  state[i] = null;
  const card = document.getElementById(`card-${i}`)!;
  card.classList.add('hidden');
  card.innerHTML = '';
  const search = document.querySelector(`#slot-${i} .slot-search`);
  if (search) search.classList.remove('hidden');
  const input = document.getElementById(`input-${i}`) as HTMLInputElement;
  if (input) { input.value = ''; input.readOnly = false; input.classList.remove('selected'); input.focus(); }
  renderComparison();
  refreshNear();
}

function renderCard(i: number) {
  const m = state[i]!;
  const card = document.getElementById(`card-${i}`)!;
  card.innerHTML = `
    <div class="cmp-chip" style="--c:${COLORS[i]}">
      <span class="cmp-chip-dot"></span>
      <div class="cmp-chip-text">
        <span class="cmp-chip-name">${m.nombre}</span>
        <span class="cmp-chip-prov">${m.provincia || ''}</span>
      </div>
      <button class="cmp-chip-clear" data-slot="${i}" aria-label="Quitar">✕</button>
    </div>`;
  card.querySelector('.cmp-chip-clear')?.addEventListener('click', () => clearSlot(i));
  card.classList.remove('hidden');
}

function renderComparison() {
  const active = state.filter(Boolean);
  const result = document.getElementById('comparar-result');
  const btnWrap = document.getElementById('comparar-btn-wrap');
  if (active.length < 2) {
    result.classList.add('hidden');
    btnWrap.classList.add('hidden');
    return;
  }
  btnWrap.classList.remove('hidden');
  result.classList.remove('hidden');

  renderTable(active);
  renderRadar(active);
}

function getScore(scores, key) {
  const s = scores.find(s => s.categoria === key);
  return s ? Math.round(s.puntuacion) : 0;
}

// Solo las categorías en las que al menos uno de los municipios tiene dato (>0).
function visibleCats(active) {
  return CATS.filter(cat => active.some(m => getScore(m.scores, cat.key) > 0));
}

function renderTable(active) {
  const head = document.getElementById('table-head');
  const body = document.getElementById('table-body');
  const cats = visibleCats(active);

  head.innerHTML = `<tr>
    <th>Categoría</th>
    ${active.map((m, i) => `<th style="color:${COLORS[i]}">${m.nombre}</th>`).join('')}
  </tr>`;

  body.innerHTML = cats.map(cat => {
    const vals = active.map(m => getScore(m.scores, cat.key));
    const max = Math.max(...vals);
    return `<tr>
      <td class="cat-label">${cat.label}</td>
      ${vals.map((v, i) => {
        const isBest = v === max && max > 0;
        if (v <= 0) {
          return `<td class="score-cell"><div class="sc-dash">—</div></td>`;
        }
        return `
        <td class="score-cell ${isBest ? 'best' : ''}">
          <div class="sc-num" style="${isBest ? `color:${COLORS[i]}` : ''}">${v}</div>
          <div class="sc-track"><span class="sc-fill" style="width:${v}%;background:${COLORS[i]}"></span></div>
        </td>`;
      }).join('')}
    </tr>`;
  }).join('');
}

function renderRadar(active) {
  const cats = visibleCats(active);
  const radarWrap = document.querySelector('.radar-wrap');
  // El radar necesita al menos 3 ejes para tener forma; si no, se oculta.
  if (radarWrap) radarWrap.classList.toggle('hidden', cats.length < 3);
  if (cats.length < 3) return;

  const canvas = document.getElementById('radar-canvas');
  const ctx = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;
  const cx = W / 2, cy = H / 2;
  const R = Math.min(W, H) * 0.38;
  const N = cats.length;

  ctx.clearRect(0, 0, W, H);

  const angle = (i) => (i / N) * Math.PI * 2 - Math.PI / 2;
  const pt = (i, r) => ({
    x: cx + r * Math.cos(angle(i)),
    y: cy + r * Math.sin(angle(i))
  });

  // Grid rings
  ctx.strokeStyle = '#e0e0e0';
  ctx.lineWidth = 1;
  [20, 40, 60, 80, 100].forEach(v => {
    ctx.beginPath();
    for (let i = 0; i < N; i++) {
      const p = pt(i, R * v / 100);
      i === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y);
    }
    ctx.closePath();
    ctx.stroke();
  });

  // Axes
  ctx.strokeStyle = '#ccc';
  for (let i = 0; i < N; i++) {
    ctx.beginPath();
    ctx.moveTo(cx, cy);
    const p = pt(i, R);
    ctx.lineTo(p.x, p.y);
    ctx.stroke();
  }

  // Labels
  ctx.fillStyle = '#555';
  ctx.font = `${W > 400 ? 11 : 9}px Inter,sans-serif`;
  ctx.textAlign = 'center';
  for (let i = 0; i < N; i++) {
    const p = pt(i, R + 22);
    ctx.fillText(cats[i].label, p.x, p.y + 4);
  }

  // Data polygons
  active.forEach((m, mi) => {
    const vals = cats.map(c => getScore(m.scores, c.key));
    ctx.beginPath();
    for (let i = 0; i < N; i++) {
      const p = pt(i, R * vals[i] / 100);
      i === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y);
    }
    ctx.closePath();
    ctx.fillStyle = COLORS_ALPHA[mi];
    ctx.fill();
    ctx.strokeStyle = COLORS[mi];
    ctx.lineWidth = 2.5;
    ctx.stroke();
    // Dots
    for (let i = 0; i < N; i++) {
      const p = pt(i, R * vals[i] / 100);
      ctx.beginPath();
      ctx.arc(p.x, p.y, 4, 0, Math.PI * 2);
      ctx.fillStyle = COLORS[mi];
      ctx.fill();
    }
  });

  // Leyenda
  ctx.font = '13px Inter,sans-serif';
  active.forEach((m, i) => {
    const y = H - 30 + i * 18;
    ctx.fillStyle = COLORS[i];
    ctx.fillRect(cx - 80, y - 10, 14, 14);
    ctx.fillStyle = '#333';
    ctx.textAlign = 'left';
    ctx.fillText(`${m.nombre} (${m.provincia})`, cx - 60, y + 2);
  });
}

// Precargar desde URL params ?a=CODIGO&b=CODIGO
async function preloadFromParams() {
  const params = new URLSearchParams(window.location.search);
  const codes = [params.get('a'), params.get('b')].filter(Boolean) as string[];
  for (let i = 0; i < codes.length; i++) {
    const mun = await fetch(`/api/municipio/${codes[i]}`).then(r => r.ok ? r.json() : null).catch(() => null);
    if (mun) await selectMun(i, mun.codigo_ine, mun.nombre, mun.provincia);
  }
}
preloadFromParams();
</script>

<style is:global>
/* Estilos acotados a .comparar-page para que apliquen también a los
   elementos que se crean por JS (chips, autocompletado, tabla). */
.comparar-page { max-width: 900px; margin: 0 auto; padding: 32px 16px 64px; }
.comparar-page .comparar-header { text-align: center; margin-bottom: 32px; }
.comparar-page .comparar-header h1 { font-size: 2rem; font-weight: 700; letter-spacing: -0.02em; color: var(--text); margin: 0 0 8px; }
.comparar-page .comparar-header p { color: #666; font-size: 1rem; max-width: 560px; margin: 0 auto; }
.comparar-page .comparar-ejemplos {
  display: flex; flex-wrap: wrap; gap: 8px; justify-content: center;
  align-items: center; margin-top: 18px;
}
.comparar-page .ej-label { font-size: .82rem; color: #999; font-weight: 600; }
.comparar-page .ej-chip {
  font-size: .82rem; font-weight: 600; color: var(--text);
  background: #fff; border: 1.5px solid #e6e6e9; border-radius: 999px;
  padding: 6px 14px; transition: border-color .15s, background .15s;
}
.comparar-page .ej-chip:hover { border-color: var(--primary); background: rgba(255,56,92,.05); }
.comparar-page .slot-label {
  display: flex; align-items: center; gap: 7px;
  font-size: .82rem; font-weight: 700; color: var(--text); margin-bottom: 8px;
}
.comparar-page .slot-num {
  display: inline-flex; align-items: center; justify-content: center;
  width: 20px; height: 20px; border-radius: 50%;
  background: var(--primary); color: #fff; font-size: .72rem; font-weight: 700;
}
.comparar-page .slot-opt { color: #aaa; font-weight: 500; }

.comparar-page .comparar-slots { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-bottom: 40px; align-items: start; }
@media (max-width: 700px) { .comparar-page .comparar-slots { grid-template-columns: 1fr; } }

.comparar-page .slot { position: relative; }
.comparar-page .slot-search { position: relative; }
.comparar-page .slot-search input {
  width: 100%; box-sizing: border-box;
  padding: 14px 16px; font-size: .95rem; font-family: inherit;
  background: #fff; color: var(--text);
  border: 2px solid #e6e6e9; border-radius: 14px; outline: none;
  transition: border-color .2s, box-shadow .2s;
}
.comparar-page .slot-search input::placeholder { color: #aab; }
.comparar-page .slot-search input:focus { border-color: var(--primary); box-shadow: 0 0 0 4px rgba(255,56,92,.12); }

.comparar-page .slot-ac {
  display: none; position: absolute; top: 100%; left: 0; right: 0;
  background: #fff; border: 1px solid #e6e6e9; border-radius: 14px;
  box-shadow: 0 12px 32px rgba(0,0,0,.14); z-index: 50; overflow: hidden;
  margin-top: 6px;
}
.comparar-page .slot-ac.open { display: block; }
.comparar-page .sac-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 13px 16px; min-height: 52px; text-decoration: none; color: var(--text);
  cursor: pointer; font-size: .95rem; border-bottom: 1px solid #f3f3f5;
}
.comparar-page .sac-item:last-child { border-bottom: none; }
.comparar-page .sac-item:hover, .comparar-page .sac-item:active { background: #fff5f6; }
.comparar-page .sac-item strong { font-weight: 600; }
.comparar-page .sac-item span { color: #999; font-size: .82rem; white-space: nowrap; margin-left: 8px; }

/* Sugerir cercanos */
.comparar-page .slot-near {
  display: inline-flex; align-items: center; gap: 6px; margin-top: 8px;
  background: #fff0f3; color: var(--primary); border: 1px solid rgba(255,56,92,.28);
  border-radius: 999px; padding: 8px 14px; font-size: .82rem; font-weight: 600;
  font-family: inherit; cursor: pointer; transition: background .15s;
}
.comparar-page .slot-near:hover { background: var(--primary); color: #fff; }
.comparar-page .slot-suggest { margin-top: 10px; }
.comparar-page .sug-title { font-size: .78rem; font-weight: 600; color: #888; margin-bottom: 7px; }
.comparar-page .sug-loading { font-size: .82rem; color: #999; padding: 4px 0; }
.comparar-page .sug-chips { display: flex; flex-wrap: wrap; gap: 7px; }
.comparar-page .sug-chip {
  display: inline-flex; align-items: baseline; gap: 6px;
  background: #fff; border: 1.5px solid #e6e6e9; border-radius: 999px;
  padding: 7px 13px; font-family: inherit; cursor: pointer; text-align: left;
  transition: border-color .15s, background .15s;
}
.comparar-page .sug-chip:hover { border-color: var(--primary); background: rgba(255,56,92,.05); }
.comparar-page .sug-chip strong { font-size: .85rem; font-weight: 600; color: var(--text); }
.comparar-page .sug-chip span { font-size: .74rem; color: #aaa; }

.comparar-page .comparar-btn-wrap { text-align: center; margin: 8px 0 32px; }
.comparar-page .comparar-btn {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--primary); color: #fff;
  border: none; border-radius: 50px; padding: 14px 32px;
  font-size: 1rem; font-weight: 700; cursor: pointer;
  box-shadow: 0 4px 16px rgba(255,56,92,.35);
  transition: transform .15s, box-shadow .15s;
}
.comparar-page .comparar-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(255,56,92,.45); }
.comparar-page .comparar-btn:active { transform: translateY(0); }

/* Chip de municipio seleccionado */
.comparar-page .cmp-chip {
  display: flex; align-items: center; gap: 12px;
  background: #fff; border: 2px solid var(--c);
  border-radius: 14px; padding: 13px 14px;
  box-shadow: 0 6px 18px color-mix(in srgb, var(--c) 20%, transparent);
  animation: chipIn .18s ease;
}
@keyframes chipIn { from { opacity: 0; transform: translateY(-5px) scale(.98); } to { opacity: 1; transform: none; } }
.comparar-page .cmp-chip-dot {
  width: 11px; height: 11px; border-radius: 50%; background: var(--c); flex: none;
  box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 18%, transparent);
}
.comparar-page .cmp-chip-text { display: flex; flex-direction: column; line-height: 1.25; flex: 1; min-width: 0; }
.comparar-page .cmp-chip-name {
  font-weight: 700; font-size: 1.02rem; color: var(--text);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.comparar-page .cmp-chip-prov { font-size: .78rem; color: #999; }
.comparar-page .cmp-chip-clear {
  flex: none; width: 26px; height: 26px; border-radius: 50%;
  border: none; background: #f1f1f3; color: #999; cursor: pointer;
  font-size: .78rem; line-height: 1; display: flex; align-items: center; justify-content: center;
  transition: background .15s, color .15s, transform .15s;
}
.comparar-page .cmp-chip-clear:hover { background: var(--c); color: #fff; transform: rotate(90deg); }
.comparar-page .hidden { display: none; }

/* Comparación */
.comparar-page .comparar-result { display: flex; flex-direction: column; gap: 40px; align-items: center; }
.comparar-page .radar-wrap {
  background: #fff; border-radius: 20px;
