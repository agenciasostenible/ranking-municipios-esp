---
import Base from '../layouts/Base.astro';
import { DB } from '../lib/d1client';

// Todos los instagramers verificados con provincias agrupadas
const { results: igRows } = await DB.prepare(
  `SELECT i.id, i.handle, i.nombre, i.avatar_url, i.especialidad, i.bio, i.seguidores,
          COUNT(im.id) AS n_munis,
          GROUP_CONCAT(DISTINCT COALESCE(im.provincia,'')) AS provincias
   FROM instagramers i
   LEFT JOIN instagramer_municipios im ON im.instagramer_id = i.id
   WHERE i.verificado = 1
   GROUP BY i.id
   ORDER BY i.id ASC`
).all();

const allCreadores = (igRows as any[]).map((r) => ({
  ...r,
  provincias: r.provincias || '',
  curado: r.id <= 2,  // los dos migrados de creadores son los primeros
}));

const especialidades = [
  { slug: 'naturaleza', label: '🌿 Naturaleza' },
  { slug: 'gastronomia', label: '🍽️ Gastronomía' },
  { slug: 'cultura', label: '🏛️ Cultura' },
  { slug: 'aventura', label: '🧗 Aventura' },
  { slug: 'rural', label: '🏡 Rural' },
  { slug: 'playa', label: '🏖️ Playa' },
  { slug: 'general', label: '🗺️ General' },
];
---
<Base
  title="Instagramers de viajes por España — Ranking Spain"
  description="Directorio de instagramers especializados en turismo por España. Filtra por naturaleza, gastronomía, cultura, aventura, rural y más."
>

<div class="ig-page">
  <div class="ig-hero">
    <span class="ig-kicker">📸 Instagramers</span>
    <h1>Creadores que recorren España</h1>
    <p>Instagramers especializados en turismo por España. Descubre qué municipios recomiendan y síguelos para inspirarte.</p>
    <a href="/instagramers/unirme" class="ig-cta">¿Eres instagramer? Únete gratis →</a>
  </div>

  <!-- Buscador por zona con autocomplete -->
  <div class="ig-search-wrap">
    <input
      id="ig-search"
      type="text"
      placeholder="Filtra por provincia o ciudad… (ej. Granada)"
      autocomplete="off"
      class="ig-search"
    />
    <div id="ig-search-ac" class="ig-search-ac"></div>
    <span id="ig-search-matched" class="ig-search-matched" hidden></span>
  </div>

  <!-- Filtros por especialidad -->
  <div class="ig-filters" id="ig-filters">
    <button class="ig-filter-btn active" data-esp="">Todas las especialidades</button>
    {especialidades.map((e) => (
      <button class="ig-filter-btn" data-esp={e.slug}>{e.label}</button>
    ))}
  </div>

  {allCreadores.length === 0 ? (
    <div class="ig-empty">
      <p>Aún no hay instagramers. <a href="/instagramers/unirme">¡Sé el primero!</a></p>
    </div>
  ) : (
    <div class="ig-grid" id="ig-grid">
      {allCreadores.map((ig) => (
        <div
          class="ig-card"
          data-esp={ig.especialidad || ''}
          data-provincias={(ig.provincias || '').toLowerCase()}
        >
          {ig.curado && <span class="ig-badge-curado">⭐ Destacado</span>}
          <div class="ig-card-av-wrap">
            {ig.avatar_url
              ? <img class="ig-av" src={ig.avatar_url} alt={`@${ig.handle}`} loading="lazy" />
              : <span class="ig-av ig-av-ph">{String(ig.handle || '?')[0].toUpperCase()}</span>
            }
          </div>
          <div class="ig-card-body">
            {ig.nombre && ig.nombre !== ig.handle && <div class="ig-nombre">{ig.nombre}</div>}
            <div class="ig-handle">@{ig.handle}</div>
            {ig.seguidores > 0 && (
              <div class="ig-seg">👥 {ig.seguidores >= 1000000 ? (ig.seguidores/1000000).toFixed(ig.seguidores%1000000===0?0:1)+' mill.' : ig.seguidores >= 1000 ? Math.round(ig.seguidores/1000)+' mil' : ig.seguidores} seguidores</div>
            )}
            {ig.especialidad && (
              <div class="ig-tags">
                {ig.especialidad.split(',').slice(0,3).map((e: string) => (
                  <span class="ig-tag">{e.trim()}</span>
                ))}
              </div>
            )}
            {ig.bio && <p class="ig-bio">"{ig.bio}"</p>}
            {ig.provincias && (
              <div class="ig-zonas">📍 {ig.provincias.split(',').filter((p: string) => p.trim()).slice(0,5).join(' · ')}</div>
            )}
          </div>
          <a class="ig-ig-btn" href={`https://instagram.com/${ig.handle}`} target="_blank" rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            Ver en Instagram
          </a>
        </div>
      ))}
    </div>
  )}

  <div class="ig-none" id="ig-none" style="display:none">
    <p>No hay instagramers con esta especialidad todavía. <a href="/instagramers/unirme">¿Te unes?</a></p>
  </div>

  <div class="ig-join-banner">
    <strong>¿Creas contenido sobre turismo en España?</strong>
    <p>Únete a nuestra comunidad de instagramers y aparece en este directorio.</p>
    <a href="/instagramers/unirme" class="ig-cta ig-cta-outline">Registrarme gratis</a>
  </div>
</div>

<script>
  const filters  = document.querySelectorAll<HTMLButtonElement>('.ig-filter-btn');
  const cards    = document.querySelectorAll<HTMLElement>('.ig-card');
  const none     = document.getElementById('ig-none')!;
  const searchEl = document.getElementById('ig-search') as HTMLInputElement;
  const ac       = document.getElementById('ig-search-ac')!;
  const matched  = document.getElementById('ig-search-matched')!;

  let activeEsp = '';
  let searchQ   = '';

  function applyFilters() {
    let visible = 0;
    cards.forEach((c) => {
      const espMatch = !activeEsp || (',' + (c.dataset.esp || '') + ',').includes(',' + activeEsp + ',');
      const provMatch = !searchQ || (c.dataset.provincias || '').includes(searchQ);
      const show = espMatch && provMatch;
      (c as HTMLElement).style.display = show ? '' : 'none';
      if (show) visible++;
    });
    none.style.display = visible === 0 ? 'block' : 'none';
  }

  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      filters.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeEsp = btn.dataset.esp || '';
      applyFilters();
    });
  });

  function igEsc(s: string) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  function igHl(str: string, q: string) {
    const i = str.toLowerCase().indexOf(q.toLowerCase());
    if (i < 0) return igEsc(str);
    return igEsc(str.slice(0,i)) + `<strong>${igEsc(str.slice(i,i+q.length))}</strong>` + igEsc(str.slice(i+q.length));
  }

  // Autocomplete: busca municipios y provincias via /api/search
  let stmr: any;
  searchEl.addEventListener('input', () => {
    // Al editar manualmente limpia la selección confirmada
    searchQ = '';
    matched.hidden = true;
    applyFilters();
    clearTimeout(stmr);
    const q = searchEl.value.trim();
    if (q.length < 2) { ac.innerHTML = ''; return; }
    stmr = setTimeout(async () => {
      try {
        const r = await fetch('/api/search?q=' + encodeURIComponent(q));
        const d = await r.json() as any[];
        const provSet = new Map<string, string>(); // nombre → nombre
        const munis: any[] = [];
        for (const item of (d || [])) {
          if (item.tipo === 'provincia') { provSet.set(item.nombre, item.nombre); }
          else if (item.tipo === 'municipio') {
            munis.push(item);
            if (item.provincia) provSet.set(item.provincia, item.provincia);
          }
        }
        const provItems = [...provSet.values()].slice(0, 3).map(p =>
          `<a href="#" data-q="${igEsc(p.toLowerCase())}" data-label="${igEsc(p)}" style="display:flex;align-items:center;gap:12px;padding:11px 16px;text-decoration:none;color:#222;border-bottom:1px solid #f5f5f5;cursor:pointer">
            <span style="flex-shrink:0;width:32px;height:32px;border-radius:8px;background:#f3f0ff;display:flex;align-items:center;justify-content:center;font-size:.9rem">📍</span>
            <span style="flex:1;min-width:0">
              <span style="display:block;font-size:.88rem;font-weight:600">${igHl(p,q)}</span>
              <span style="display:block;font-size:.75rem;color:#888">Provincia</span>
            </span></a>`
        );
        const muniItems = munis.slice(0, 5).map(m =>
          `<a href="#" data-q="${igEsc((m.provincia||'').toLowerCase())}" data-label="${igEsc(m.nombre)}" style="display:flex;align-items:center;gap:12px;padding:11px 16px;text-decoration:none;color:#222;border-bottom:1px solid #f5f5f5;cursor:pointer">
            <span style="flex-shrink:0;width:32px;height:32px;border-radius:8px;background:#fff1f3;display:flex;align-items:center;justify-content:center;font-size:.9rem">🏘️</span>
            <span style="flex:1;min-width:0">
              <span style="display:block;font-size:.88rem;font-weight:600">${igHl(m.nombre,q)}</span>
              ${m.provincia?`<span style="display:block;font-size:.75rem;color:#888">${igEsc(m.provincia)}</span>`:''}
            </span></a>`
        );
        ac.innerHTML = [...provItems, ...muniItems].join('');
      } catch {}
    }, 200);
  });

  ac.addEventListener('click', (e: any) => {
    e.preventDefault();
    const a = e.target.closest('a[data-q]');
    if (!a) return;
    searchQ = a.getAttribute('data-q') || '';
    searchEl.value = a.getAttribute('data-label') || '';
    matched.textContent = '✓ ' + searchEl.value;
    matched.hidden = false;
    ac.innerHTML = '';
    applyFilters();
  });

  // Limpiar ac al hacer clic fuera
  document.addEventListener('click', (e: any) => {
    if (!ac.contains(e.target) && e.target !== searchEl) ac.innerHTML = '';
  });

  // Limpiar búsqueda con Escape
  searchEl.addEventListener('keydown', (e: any) => {
    if (e.key === 'Escape') {
      searchEl.value = '';
      searchQ = '';
      matched.hidden = true;
      ac.innerHTML = '';
      applyFilters();
    }
  });
</script>

<style>
  .ig-page { max-width: 960px; margin: 0 auto; padding: 28px 16px 60px; }
  .ig-kicker { display: inline-block; background: #f3f0ff; color: #7c3aed; font-weight: 800; font-size: .78rem; letter-spacing: .04em; padding: 5px 12px; border-radius: 20px; margin-bottom: 12px; }
  .ig-hero { text-align: center; margin-bottom: 28px; }
  .ig-hero h1 { font-size: 1.7rem; font-weight: 700; letter-spacing: -0.02em; color: #222; margin: 0 0 10px; }
  .ig-hero p { color: #555; font-size: .98rem; line-height: 1.55; margin: 0 0 20px; }
  .ig-cta { display: inline-block; background: #7c3aed; color: #fff; padding: 13px 24px; border-radius: 12px; font-weight: 800; font-size: .95rem; text-decoration: none; }
  .ig-cta-outline { background: transparent; border: 2px solid #7c3aed; color: #7c3aed; }
  .ig-search-wrap { margin-bottom: 14px; position: relative; }
  .ig-search { width: 100%; padding: 12px 16px; border: 1.5px solid #ddd; border-radius: 12px; font-size: .95rem; font-family: inherit; background: #fff; color: #222; }
  .ig-search:focus { outline: none; border-color: #7c3aed; }
  .ig-search::placeholder { color: #aaa; }
  .ig-search-ac { position: absolute; top: 100%; left: 0; right: 0; z-index: 30; background: #fff; border-radius: 0 0 12px 12px; box-shadow: 0 8px 24px rgba(0,0,0,.12); overflow: hidden; }
  .ig-search-ac a { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-top: 1px solid #f0f0f0; text-decoration: none; color: #222; font-size: .92rem; }
  .ig-search-ac a:first-child { border-top: none; }
  .ig-search-ac a:hover { background: #f3f0ff; }
  .ig-search-ac small { color: #999; margin-left: auto; font-size: .78rem; }
  .ig-ac-ic { font-size: .9rem; flex-shrink: 0; }
  .ig-ac-prov { font-weight: 700; }
  .ig-search-matched { font-size: .82rem; color: #16a34a; font-weight: 700; display: block; margin-top: 4px; }
  .ig-filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 22px; }
  .ig-filter-btn { background: #f5f5f5; border: 1.5px solid #e5e5e5; color: #555; font-size: .84rem; font-weight: 700; border-radius: 20px; padding: 7px 14px; cursor: pointer; font-family: inherit; transition: all .15s; }
  .ig-filter-btn:hover { border-color: #c4b5fd; color: #7c3aed; }
  .ig-filter-btn.active { background: #7c3aed; border-color: #7c3aed; color: #fff; }
  .ig-empty, .ig-none { text-align: center; padding: 40px 0; color: #888; }
  .ig-empty a, .ig-none a { color: #7c3aed; font-weight: 700; }

  /* Grid de cards */
  .ig-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; margin-bottom: 40px; }
  .ig-card { background: #fff; border: 1px solid #e8e8e8; border-radius: 18px; padding: 20px 16px 16px; display: flex; flex-direction: column; align-items: center; gap: 10px; position: relative; transition: border-color .15s, box-shadow .15s; }
  .ig-card:hover { border-color: #c4b5fd; box-shadow: 0 6px 24px rgba(124,58,237,.1); }
  .ig-badge-curado { position: absolute; top: 12px; right: 12px; font-size: .68rem; font-weight: 700; background: #fef3c7; color: #92400e; border-radius: 8px; padding: 3px 8px; }

  /* Avatar */
  .ig-card-av-wrap { width: 76px; height: 76px; flex-shrink: 0; }
  .ig-av { width: 76px !important; height: 76px !important; max-width: 76px !important; max-height: 76px !important; border-radius: 50%; object-fit: cover; display: block; border: 3px solid #f3f0ff; }
  .ig-av-ph { width: 76px; height: 76px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #f3f0ff; color: #7c3aed; font-weight: 800; font-size: 1.8rem; border: 3px solid #ede9fe; }

  /* Cuerpo */
  .ig-card-body { display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; width: 100%; }
  .ig-nombre { font-size: .88rem; font-weight: 700; color: #222; }
  .ig-handle { font-size: .82rem; color: #7c3aed; font-weight: 700; }
  .ig-seg { font-size: .75rem; color: #16a34a; font-weight: 700; margin: 1px 0; }
  .ig-tags { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px; margin: 2px 0; }
  .ig-tag { display: inline-block; background: #f3f0ff; color: #7c3aed; font-size: .68rem; font-weight: 700; padding: 2px 8px; border-radius: 20px; text-transform: capitalize; white-space: nowrap; }
  .ig-bio { color: #777; font-size: .8rem; font-style: italic; line-height: 1.4; margin: 2px 0 0; }
  .ig-zonas { font-size: .74rem; color: #888; margin-top: 3px; line-height: 1.4; }

  /* Botón Instagram */
  .ig-ig-btn { display: flex; align-items: center; justify-content: center; gap: 7px; width: 100%; margin-top: 6px; padding: 10px; background: #f3f0ff; color: #7c3aed; font-size: .84rem; font-weight: 700; border-radius: 12px; text-decoration: none; transition: background .15s; }
  .ig-ig-btn:hover { background: #ede9fe; }

  /* Banner join */
  .ig-join-banner { text-align: center; background: #f3f0ff; border-radius: 18px; padding: 32px 24px; margin-top: 8px; }
  .ig-join-banner strong { font-size: 1.1rem; color: #3b1fa0; display: block; margin-bottom: 6px; }
  .ig-join-banner p { color: #7c3aed; margin: 0 0 16px; }

  @media (max-width: 600px) { .ig-grid { grid-template-columns: 1fr; gap: 12px; } }
</style>
</Base>
