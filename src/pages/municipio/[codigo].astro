---
import { DB } from '../../lib/d1client';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getCatInfo, formatPob, LABELS, FICHA_CATS, DETAIL_CATS } from '../../lib/db';
import { getTipoIcon, getSelloStyle, TIPO_LABEL } from '../../lib/entidades';
import { getProvGradient, CAT_COLORS } from '../../lib/utils';
// @ts-ignore

const { codigo } = Astro.params;
const desde = Astro.url.searchParams.get('desde') ?? '';

const municipio = await DB.prepare(`SELECT * FROM municipios WHERE codigo_ine = ?`).bind(codigo).first();
if (!municipio) return Astro.redirect('/');

const { results: puntuaciones } = await DB.prepare(
  `SELECT categoria, puntuacion, ranking_provincial, ranking_nacional
   FROM puntuaciones WHERE codigo_ine = ? ORDER BY puntuacion DESC`
).bind(codigo).all();

const totalNacionalRow = await DB.prepare(`SELECT COUNT(*) as n FROM municipios`).first();
const totalNacional = totalNacionalRow?.n ?? 0;

const { results: entidades } = await DB.prepare(
  `SELECT tipo, nombre, nivel_sello, descripcion FROM entidades e
   WHERE e.codigo_ine = ?
     AND (e.tipo NOT IN ('espacio','parque_natural') OR (
       SELECT COUNT(DISTINCT e2.codigo_ine) FROM entidades e2
       WHERE e2.nombre = e.nombre AND e2.tipo = e.tipo
     ) <= 8)
   ORDER BY
     CASE nivel_sello
       WHEN 'UNESCO' THEN 1 WHEN 'IT Internacional' THEN 2
       WHEN 'Parque Nacional' THEN 3 WHEN 'BIC Nacional' THEN 4
       WHEN 'IT Nacional' THEN 5 ELSE 6
     END, tipo, nombre
   LIMIT 40`
).bind(codigo).all();

const totalProvRow = await DB.prepare(`SELECT COUNT(*) as n FROM municipios WHERE provincia = ?`).bind(municipio.provincia).first();
const totalProv = totalProvRow?.n ?? 0;

const globalScore = puntuaciones.find((p: any) => p.categoria === 'ranking_global');
const fichaScores = (puntuaciones as any[]).filter((p: any) => FICHA_CATS.includes(p.categoria));
const detailScores = (puntuaciones as any[]).filter((p: any) => DETAIL_CATS.includes(p.categoria));

const why: string[] = municipio.why_json
  ? (() => { try { return JSON.parse(municipio.why_json as string); } catch { return []; } })()
  : [];

// No mostrar "POR QUÉ VISITAR" si ya está en la sección "¿Por qué destaca?" (Campings, TurismoRural)
const whyToDisplay: string[] = (desde === 'Campings' || desde === 'TurismoRural') ? [] : why;

const topCat = fichaScores.filter((p: any) => p.categoria !== 'ranking_global')
  .sort((a: any, b: any) => (a.ranking_provincial ?? 999) - (b.ranking_provincial ?? 999))[0];
const topCatInfo = topCat ? getCatInfo(topCat.categoria) : null;
const topCatPos = topCat?.ranking_provincial ?? null;

const titleSeo = topCatInfo && topCatPos
  ? `${municipio.nombre} - Ranking turístico · #${topCatPos} en ${topCatInfo.label} en ${municipio.provincia}`
  : `${municipio.nombre} — Ranking turístico · ${municipio.provincia}`;
const whyText = why.slice(0,3).join(', ');
const descSeo = `${municipio.nombre} (${municipio.poblacion ? formatPob(municipio.poblacion as number)+' hab.' : ''}) está en el puesto #${globalScore?.ranking_provincial ?? '—'} de ${totalProv} municipios en ${municipio.provincia}.${whyText ? ' Destaca en: ' + whyText + '.' : ''}`;

const heroGradient = getProvGradient(municipio.provincia as string);

const MUNI = {
  nombre: municipio.nombre as string,
  provincia: municipio.provincia as string,
  comunidad: municipio.comunidad as string,
  codigo: codigo as string,
};

// Mapa categoría → tipos de entidades relevantes
const CAT_TIPOS: Record<string, string[]> = {
  senderismo:    ['sendero'],
  ciclismo:      ['sendero', 'deporte', 'ruta'],
  agua:          ['agua', 'playa_fluvial', 'playa'],
  Playas:        ['playa', 'playa_urbana'],
  playas:        ['playa', 'playa_urbana'],
  naturaleza:    ['espacio', 'montaña', 'mirador', 'fauna'],
  camping:       ['camping'],
  historia:      ['castillo', 'yacimiento', 'monumento', 'conjunto', 'museo'],
  monumentos:    ['castillo', 'monumento', 'iglesia', 'catedral', 'yacimiento', 'palacio', 'ermita', 'conjunto_historico', 'fortaleza', 'torre'],
  castillos:     ['castillo', 'torre', 'fortaleza', 'alcazaba', 'muralla', 'conjunto_historico'],
  yacimientos:   ['yacimiento'],
  gastronomia:   ['gastronomia', 'producto'],
  fiestas:       ['fiesta'],
  festivales:    ['festival'],
  estrellas:     ['mirador', 'espacio'],
  birdwatching:  ['espacio', 'fauna'],
  aventura:      ['cueva', 'montaña', 'sendero'],
  escapada_rural:['espacio', 'mirador'],
  retiros:       ['balneario', 'espacio'],
  aceite:        ['producto'],
  vinos:         ['producto'],
};

// Entidades relevantes para la categoría de entrada
let desdeEntidades: any[] = [];
let desdePuntuacion: any = null;
let desdeWhyJson: string[] = [];
if (desde && desde !== 'ranking_global') {
  desdePuntuacion = (puntuaciones as any[]).find((p: any) => p.categoria === desde);

  // why_json highlights: fallback para cualquier categoría sin entidades propias
  try {
    desdeWhyJson = municipio.why_json ? JSON.parse(municipio.why_json as string) : [];
  } catch {
    desdeWhyJson = [];
  }

  // Entidades específicas de la categoría (cuando existen: monumentos, castillos, fiestas, etc.)
  const tiposDesde = CAT_TIPOS[desde] ?? [];
  if (tiposDesde.length) {
    const placeholders = tiposDesde.map(() => '?').join(',');
    const { results: de } = await DB.prepare(
      `SELECT tipo, nombre, nivel_sello, descripcion FROM entidades e
       WHERE e.codigo_ine = ? AND e.tipo IN (${placeholders})
         AND (e.tipo NOT IN ('espacio','parque_natural') OR (
           SELECT COUNT(DISTINCT e2.codigo_ine) FROM entidades e2
           WHERE e2.nombre = e.nombre AND e2.tipo = e.tipo
         ) <= 8)
       ORDER BY CASE nivel_sello WHEN 'UNESCO' THEN 1 WHEN 'Parque Nacional' THEN 2 WHEN 'BIC Nacional' THEN 3 ELSE 4 END, nombre LIMIT 12`
    ).bind(codigo, ...tiposDesde).all();
    desdeEntidades = de as any[];
  }
}

// Fallback: recursos generales del municipio (para categorías "solo puntuación" sin entidades propias)
const desdeFallbackEntidades = (entidades as any[]).slice(0, 5);

const desdeInfo = desde ? getCatInfo(desde) : null;

// Municipios cercanos por distancia geográfica (bounding box ~50km)
const lat = municipio.latitud as number | null;
const lon = municipio.longitud as number | null;
let cercanos: any[] = [];
if (lat && lon) {
  const { results: c } = await DB.prepare(`
    SELECT m.codigo_ine, m.nombre, m.provincia, p.puntuacion,
           ABS(m.latitud - ?) + ABS(m.longitud - ?) as dist_aprox
    FROM municipios m
    JOIN puntuaciones p ON p.codigo_ine = m.codigo_ine
    WHERE m.latitud BETWEEN ? AND ?
      AND m.longitud BETWEEN ? AND ?
      AND m.codigo_ine != ?
      AND p.categoria = 'ranking_global'
      AND p.puntuacion > 0
      AND COALESCE(m.es_duplicado, 0) = 0
    ORDER BY dist_aprox ASC
    LIMIT 5
  `).bind(lat, lon, lat - 0.45, lat + 0.45, lon - 0.6, lon + 0.6, codigo).all();
  cercanos = c as any[];
}
// Fallback: misma provincia si no hay coords
const { results: similares } = cercanos.length ? { results: [] } : await DB.prepare(`
  SELECT m.codigo_ine, m.nombre, m.provincia, p.puntuacion
  FROM municipios m JOIN puntuaciones p ON p.codigo_ine = m.codigo_ine
  WHERE m.provincia = ? AND m.codigo_ine != ? AND p.categoria = 'ranking_global' AND COALESCE(m.es_duplicado, 0) = 0
  ORDER BY p.puntuacion DESC LIMIT 5
`).bind(municipio.provincia, codigo).all();
const municipiosCercanos = cercanos.length ? cercanos : similares;

// Foto Wikipedia — usar la cacheada si existe, si no el gradiente
const fotoUrl = municipio.foto_url && municipio.foto_url !== 'NONE'
  ? municipio.foto_url as string
  : null;
---
<Base title={titleSeo} description={descSeo}
  ogTitle={topCatInfo && topCatPos ? `${municipio.nombre} · #${topCatPos} en ${topCatInfo.label} en ${municipio.provincia}` : `${municipio.nombre} — Ranking turístico`}
  ogDescription={descSeo}
  ogImage={`https://rankingspain.com/api/og/sello/${codigo}${desde && desde !== 'ranking_global' ? `?cat=${encodeURIComponent(desde)}` : ''}`}>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://rankingspain.com/" },
    { "@type": "ListItem", "position": 2, "name": municipio.provincia, "item": `https://rankingspain.com/provincia/${encodeURIComponent(municipio.provincia as string)}` },
    { "@type": "ListItem", "position": 3, "name": municipio.nombre },
  ]
})} />

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": municipio.nombre,
  "description": descSeo,
  "url": `https://rankingspain.com/municipio/${codigo}`,
  ...(fotoUrl ? { "image": fotoUrl } : {}),
  ...(municipio.latitud && municipio.longitud ? {
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": municipio.latitud,
      "longitude": municipio.longitud
    }
  } : {}),
  "containedInPlace": {
    "@type": "AdministrativeArea",
    "name": municipio.provincia,
    "containedInPlace": {
      "@type": "Country",
      "name": "España",
      "sameAs": "https://www.wikidata.org/wiki/Q29"
    }
  },
  ...(municipio.poblacion ? { "population": municipio.poblacion } : {}),
  "aggregateRating": globalScore ? {
    "@type": "AggregateRating",
    "ratingValue": Math.round((globalScore.puntuacion / 100) * 5 * 10) / 10,
    "bestRating": 5,
    "worstRating": 1,
    "ratingCount": 1032
  } : undefined,
  "touristType": why.slice(0, 3).map(w => ({ "@type": "Audience", "audienceType": w })),
})} />

<!-- ── HERO full-width ── -->
<div class="mun-hero" id="mun-hero"
  style={fotoUrl
    ? `background:url('${fotoUrl}') center/cover no-repeat`
    : `background:${heroGradient}`}>
  <div class="mun-hero-overlay"></div>
  <div class="mun-hero-content">
    <!-- Breadcrumb -->
    <nav class="mun-breadcrumb">
      <a href="/">Inicio</a>
      <span>›</span>
      <a href={`/provincia/${encodeURIComponent(municipio.provincia)}`}>{municipio.provincia}</a>
      <span>›</span>
      <span>{municipio.nombre}</span>
    </nav>
    <!-- Name -->
    <h1 class="mun-hero-name">{municipio.nombre}</h1>
    <div class="mun-hero-sub">{municipio.comarca ? `${municipio.comarca} · ` : ''}{municipio.comunidad}</div>
    <!-- Stats row -->
    <div class="mun-hero-stats">
      {municipio.poblacion && (
        <div class="mun-stat">
          <div class="mun-stat-val">{formatPob(municipio.poblacion)}</div>
          <div class="mun-stat-lbl">Habitantes</div>
        </div>
      )}
      {globalScore && (
        <div class="mun-stat">
          <div class="mun-stat-val">#{globalScore.ranking_provincial}</div>
          <div class="mun-stat-lbl">de {totalProv} en {municipio.provincia}</div>
        </div>
      )}
      {(globalScore as any)?.ranking_nacional && (
        <div class="mun-stat mun-stat-highlight">
          <div class="mun-stat-val">#{(globalScore as any).ranking_nacional} 🇪🇸</div>
          <div class="mun-stat-lbl">de {totalNacional} en España</div>
        </div>
      )}
      {globalScore && (
        <div class="mun-stat">
          <div class="mun-stat-val">⭐ {Number(globalScore.puntuacion).toFixed(1)}</div>
          <div class="mun-stat-lbl">Puntuación global</div>
        </div>
      )}
    </div>
    <div class="mun-hero-ctas">
      <a href={`/comparar?a=${codigo}`} class="mun-compare-cta">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" width="18" height="18"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
        Comparar {municipio.nombre} con otro municipio
      </a>
      {globalScore && ((globalScore as any).ranking_nacional || globalScore.ranking_provincial) && (
        <button class="mun-share-cta" type="button"
          data-cat="Ranking general"
          data-nac={(globalScore as any).ranking_nacional ?? ''}
          data-prov={globalScore.ranking_provincial ?? ''}
          data-pts={Number(globalScore.puntuacion).toFixed(0)}
          onclick="openSello(this)" aria-label="Compartir el puesto global">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="17" height="17"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
          Compartir mi puesto
        </button>
      )}
    </div>
  </div>
</div>

<!-- ── BODY ── -->
<div class="page-content">

  <!-- Bloque "desde categoría" -->
  {desdeInfo && (
    <div class="desde-block">
      <div class="desde-header">
        <span class="desde-icon"><Icon name={desdeInfo.icon} size={20} /></span>
        <div>
          <div class="desde-title">¿Por qué {municipio.nombre} destaca?</div>
          {desdePuntuacion && (
            <div class="desde-sub">
              Puntuación: <strong>{Number(desdePuntuacion.puntuacion).toFixed(1)}</strong> pts
              {desdePuntuacion.ranking_provincial && ` · #${desdePuntuacion.ranking_provincial} en ${municipio.provincia}`}
            </div>
          )}
        </div>
      </div>
      {desdeEntidades.length > 0 ? (
        <div class="desde-items">
          {(desdeEntidades as any[]).map((e: any) => (
            <div class="desde-item">
              <span class="desde-item-icon">{getTipoIcon(e.tipo)}</span>
              <div class="desde-item-content">
                <span class="desde-item-name">{e.nombre}</span>
                {e.descripcion && (
                  <div class="desde-item-desc">{e.descripcion}</div>
                )}
              </div>
              {e.nivel_sello && e.nivel_sello !== 'Normal' && (
                <span class="desde-sello" style={getSelloStyle(e.nivel_sello)}>{e.nivel_sello}</span>
              )}
            </div>
          ))}
        </div>
      ) : desdeWhyJson.length > 0 ? (
        <div class="desde-items">
          {desdeWhyJson.map((item: string) => (
            <div class="desde-item">
              <span class="desde-item-name">{item}</span>
            </div>
          ))}
        </div>
      ) : desdeFallbackEntidades.length > 0 ? (
        <>
          <p class="desde-fallback-note">Recursos y atractivos destacados de {municipio.nombre}:</p>
          <div class="desde-items">
            {desdeFallbackEntidades.map((e: any) => (
              <div class="desde-item">
                <span class="desde-item-icon">{getTipoIcon(e.tipo)}</span>
                <div class="desde-item-content">
                  <span class="desde-item-name">{e.nombre}</span>
                  {e.descripcion && (
                    <div class="desde-item-desc">{e.descripcion}</div>
                  )}
                </div>
                {e.nivel_sello && e.nivel_sello !== 'Normal' && (
                  <span class="desde-sello" style={getSelloStyle(e.nivel_sello)}>{e.nivel_sello}</span>
                )}
              </div>
            ))}
          </div>
        </>
      ) : (
        <p class="desde-empty">{municipio.nombre} destaca en {desdeInfo.label} en {municipio.provincia}. Descubre todo lo que ofrece en las secciones de abajo 👇</p>
      )}
      <div class="desde-footer">
        <a href={`/ranking/${desde}`} class="desde-back">← Volver al ranking de {desdeInfo.label}</a>
        {desdePuntuacion && (desdePuntuacion.ranking_nacional || desdePuntuacion.ranking_provincial) && (
          <button class="desde-share" type="button"
            data-cat={desdeInfo.label}
            data-nac={desdePuntuacion.ranking_nacional ?? ''}
            data-prov={desdePuntuacion.ranking_provincial ?? ''}
            data-pts={Number(desdePuntuacion.puntuacion).toFixed(0)}
            onclick="openSello(this)"
            aria-label={`Compartir el puesto en ${desdeInfo.label}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="15" height="15"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            <span>Compartir</span>
          </button>
        )}
      </div>
    </div>
  )}

  <!-- Entidades grid -->
  {entidades.length > 0 && (
    <section class="mun-section">
      <h2 class="mun-section-title">🗂️ Qué tiene este municipio</h2>
      <div class="entidades-grid">
        {(entidades as any[]).map(e => (
          <div class="entidad-card card">
            <div class="entidad-icon">{getTipoIcon(e.tipo)}</div>
            <div class="entidad-body">
              <div class="entidad-name">{e.nombre}</div>
              {e.descripcion && (
                <div class="entidad-desc">{e.descripcion}</div>
              )}
              <div class="entidad-badges">
                {e.nivel_sello && (
                  <span class="sello-badge" style={getSelloStyle(e.nivel_sello)}>
                    {e.nivel_sello}
                  </span>
                )}
                <span class="tipo-badge">{TIPO_LABEL[e.tipo] ?? e.tipo}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Rankings grid (metric cards) -->
  <section class="mun-section">
    <h2 class="mun-section-title">📊 Rankings por categoría</h2>
    <div class="rankings-grid">
      {fichaScores.map((p: any) => {
        const info = getCatInfo(p.categoria);
        const color = CAT_COLORS[p.categoria] ?? '#6366f1';
        const posNum = p.ranking_provincial;
        const medal = posNum === 1 ? '🥇' : posNum === 2 ? '🥈' : posNum === 3 ? '🥉' : null;
        return (
          <a href={`/ranking/${p.categoria}`} class="ranking-metric-card card">
            <div class="rmc-cat" style={`color:${color}`}><Icon name={info.icon} size={16} /> {info.label}</div>
            <div class="rmc-pos" style={`color:${color}`}>
              {medal ? medal : (posNum ? `#${posNum}` : '—')}
            </div>
            <div class="rmc-sub">de {totalProv} en {municipio.provincia}</div>
            {p.ranking_nacional && (
              <div class="rmc-nacional">
                <span style={`color:${color};font-weight:700`}>#{p.ranking_nacional}</span>
                <span class="rmc-nacional-lbl"> España 🇪🇸</span>
              </div>
            )}
            <div class="rmc-pts">{Number(p.puntuacion).toFixed(1)} pts</div>
            <button class="rmc-share" type="button"
              data-cat={info.label}
              data-nac={p.ranking_nacional ?? ''}
              data-prov={p.ranking_provincial ?? ''}
              data-pts={Number(p.puntuacion).toFixed(0)}
              onclick="event.preventDefault();event.stopPropagation();openSello(this)"
              aria-label={`Compartir el puesto en ${info.label}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="14" height="14"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
              <span>Compartir</span>
            </button>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Bar chart -->
  <section class="mun-section">
    <h2 class="mun-section-title">📈 Puntuaciones detalladas</h2>
    <div class="card" style="padding:20px">
      {(() => {
        const maxPts2 = detailScores.length ? Math.max(...detailScores.map((p:any)=>p.puntuacion)) : 100;
        return detailScores.map((p: any) => {
          const info = getCatInfo(p.categoria);
          const pts = Math.max(0, Number(p.puntuacion));
          const pct = maxPts2 > 0 ? Math.round((pts / maxPts2) * 100) : 0;
          const color = CAT_COLORS[p.categoria] || '#6366f1';
          return (
            <div class="detail-bar-row">
              <div class="detail-bar-label"><Icon name={info.icon} size={16} /> {info.label}</div>
              <div class="detail-bar-track">
                <div class="detail-bar-fill" style={`width:${pct}%;background:${color}`}></div>
              </div>
              <div class="detail-bar-pts" style={`color:${color}`}>{pts.toFixed(1)}</div>
              <div class="detail-bar-rank">#{p.ranking_provincial ?? '—'}</div>
            </div>
          );
        });
      })()}
    </div>
  </section>

  <!-- Comparar con pueblos cercanos -->
  {municipiosCercanos.length > 0 && (
    <section class="cercanos-section">
      <div class="cercanos-header">
        <div>
          <h2 class="mun-section-title" style="margin:0">⚖️ Compara con pueblos cercanos</h2>
          <p style="font-size:.8rem;color:#888;margin:4px 0 0">Selecciona uno para ver la comparativa</p>
        </div>
        <a href="/comparar" class="cercanos-all">Ver comparador →</a>
      </div>
      <div class="cercanos-grid">
        {municipiosCercanos.map((c: any) => (
          <a href={`/comparar?a=${codigo}&b=${c.codigo_ine}`} class="cercano-card">
            <div class="cercano-name">{c.nombre}</div>
            <div class="cercano-prov">{c.provincia !== municipio.provincia ? c.provincia : ''}</div>
            <div class="cercano-score">⭐ {Number(c.puntuacion).toFixed(1)}</div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Navigation -->
  <div class="mun-nav">
    <a href={`/provincia/${encodeURIComponent(municipio.provincia)}`} class="pgb">← {municipio.provincia}</a>
    <a href="/ranking/ranking_global" class="pgb">🏆 Ranking global</a>
    <a href="/" class="pgb">🔍 Buscador</a>
  </div>
</div>

<!-- FAB Share button -->
<button class="fab-share" onclick="openSello(null)" aria-label="Compartir">
  <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round">
    <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
  </svg>
</button>

<!-- Modal: sello compartible -->
<div class="sello-overlay" id="sello-overlay">
  <div class="sello-modal">
    <button class="sello-close" id="sello-close" aria-label="Cerrar">✕</button>
    <div class="sello-preview" id="sello-preview"></div>
    <div class="sello-scope" id="sello-scope"></div>
    <div class="sello-actions">
      <button class="sello-net wa"   data-net="whatsapp"><span>WhatsApp</span></button>
      <button class="sello-net fb"   data-net="facebook"><span>Facebook</span></button>
      <button class="sello-net x"    data-net="x"><span>X</span></button>
      <button class="sello-net tg"   data-net="telegram"><span>Telegram</span></button>
      <button class="sello-net dl wide"  id="sello-download"><span>⬇ Cuadrada</span></button>
      <button class="sello-net st wide"  id="sello-stories"><span>⬇ Stories</span></button>
      <button class="sello-net cp full"  id="sello-copy"><span>Copiar enlace</span></button>
    </div>
    <p class="sello-hint">Para Instagram: descarga la imagen (Stories = vertical) y súbela a tu historia 📸</p>
  </div>
</div>

<script define:vars={{ MUNI }}>
const PAGE_URL = `https://rankingspain.com/municipio/${MUNI.codigo}`;
let SELLO = { cat: '', pts: '', opts: [], scopeIdx: 0 };

function esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function fitFont(text, big, mid, small){
  const n = (text||'').length;
  return n > 16 ? small : n > 11 ? mid : big;
}

function tier(rankStr){
  const r = parseInt(rankStr) || 0;
  if (r === 1)  return { eyebrow: 'EL MEJOR EN',  hook: 'es el Nº1' };
  if (r <= 3)   return { eyebrow: 'TOP 3 EN',     hook: 'está en el TOP 3' };
  if (r <= 5)   return { eyebrow: 'TOP 5 EN',     hook: 'está en el TOP 5' };
  if (r <= 10)  return { eyebrow: 'TOP 10 EN',    hook: 'está en el TOP 10' };
  if (r <= 25)  return { eyebrow: 'TOP 25 EN',    hook: 'está en el TOP 25' };
  if (r <= 50)  return { eyebrow: 'TOP 50 EN',    hook: 'está en el TOP 50' };
  if (r <= 100) return { eyebrow: 'TOP 100 EN',   hook: 'está en el TOP 100' };
  return { eyebrow: 'DESTACA EN', hook: `es el Nº${r}` };
}

function buildSelloSVG(d){
  const scope = d.opts[d.scopeIdx] || { rank: '', label: '' };
  const eyebrow = tier(scope.rank).eyebrow;
  const zona = MUNI.comunidad ? `${MUNI.provincia} · ${MUNI.comunidad}` : MUNI.provincia;
  const nombreSize = fitFont(MUNI.nombre, 56, 48, 40);
  const zonaSize = (zona||'').length > 26 ? 18 : 22;
  const scopeUp = esc((scope.label||'').toUpperCase());
  const pillW = Math.max(150, scopeUp.length * 12 + 56);
  const pillX = 340 - pillW/2;
  return `<svg width="1080" height="1080" viewBox="0 0 680 680" xmlns="http://www.w3.org/2000/svg">
<rect x="2" y="2" width="676" height="676" rx="40" fill="#ffffff" stroke="#EBEBEB" stroke-width="2"/>
<rect x="2" y="2" width="676" height="14" rx="7" fill="#FF385C"/>
<circle cx="340" cy="168" r="104" fill="#FFF1F3"/>
<text x="340" y="66" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="22" font-weight="700" letter-spacing="2.5"><tspan fill="#FF385C">★ </tspan><tspan fill="#222222">RANKING SPAIN</tspan></text>
<circle cx="340" cy="170" r="58" fill="#ffffff" stroke="#FF385C" stroke-width="3.5"/>
<circle cx="340" cy="170" r="46" fill="none" stroke="#FF385C" stroke-width="1.5" stroke-opacity="0.4"/>
<text x="340" y="186" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="44" font-weight="800" fill="#E31C5F">Nº${esc(scope.rank)}</text>
<rect x="${pillX}" y="252" width="${pillW}" height="40" rx="20" fill="#FF385C"/>
<text x="340" y="278" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="17" font-weight="700" letter-spacing="2.5" fill="#ffffff">${scopeUp}</text>
<text x="340" y="346" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="15" font-weight="700" letter-spacing="4" fill="#717171">${eyebrow}</text>
<text x="340" y="392" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="${fitFont(d.cat,40,34,28)}" font-weight="800" fill="#FF385C">${esc(d.cat)}</text>
<line x1="250" y1="424" x2="430" y2="424" stroke="#EBEBEB" stroke-width="2"/>
<text x="340" y="486" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="${nombreSize}" font-weight="800" fill="#222222">${esc(MUNI.nombre)}</text>
<text x="340" y="522" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="${zonaSize}" font-weight="500" fill="#717171">${esc(zona)}</text>
<rect x="264" y="556" width="152" height="52" rx="26" fill="#FF385C"/>
<text x="340" y="590" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="24" font-weight="800" fill="#ffffff">${esc(d.pts)}<tspan font-size="15" font-weight="700" fill="#FFD6DE"> / 100</tspan></text>
<text x="340" y="652" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="17" font-weight="600" letter-spacing="1" fill="#717171">rankingspain.com</text>
</svg>`;
}

function shareText(){
  const s = SELLO.opts[SELLO.scopeIdx] || {};
  const h = tier(s.rank).hook;
  const emoji = parseInt(s.rank) === 1 ? '🥇' : '🏆';
  return `${emoji} ${MUNI.nombre} ${h} ${s.label} en ${SELLO.cat} según Ranking Spain 👇`;
}

function renderSello(){
  document.getElementById('sello-preview').innerHTML = buildSelloSVG(SELLO);
  const sc = document.getElementById('sello-scope');
  if (SELLO.opts.length > 1){
    sc.style.display = 'flex';
    sc.innerHTML = SELLO.opts.map((o,i)=>`<button class="scope-pill${i===SELLO.scopeIdx?' on':''}" data-i="${i}">Nº${o.rank} ${esc(o.label)}</button>`).join('');
    sc.querySelectorAll('.scope-pill').forEach(b=>b.addEventListener('click',()=>{ SELLO.scopeIdx=+b.getAttribute('data-i'); renderSello(); }));
  } else { sc.style.display='none'; sc.innerHTML=''; }
}

function openSello(btn){
  let cat='', nac='', prov='', pts='';
  if (btn){
    cat = btn.getAttribute('data-cat'); nac = btn.getAttribute('data-nac');
    prov = btn.getAttribute('data-prov'); pts = btn.getAttribute('data-pts');
  } else {
    const cards = Array.from(document.querySelectorAll('.rmc-share'));
    let best=null, bestNac=1e9;
    cards.forEach(c=>{ const n=parseInt(c.getAttribute('data-nac')||'0'); if(n && n<bestNac){bestNac=n;best=c;} });
    const t = best || cards[0];
    if(!t) return;
    cat=t.getAttribute('data-cat'); nac=t.getAttribute('data-nac'); prov=t.getAttribute('data-prov'); pts=t.getAttribute('data-pts');
  }
  const opts=[];
  if (nac) opts.push({ rank:nac, label:'de España' });
  if (prov) opts.push({ rank:prov, label:'de '+MUNI.provincia });
  if (!opts.length) return;
  let idx=0;
  if (opts.length>1){ const n=parseInt(nac); idx = (n && n<=100) ? 0 : 1; }
  cat = cat.charAt(0).toUpperCase() + cat.slice(1).toLowerCase();
  SELLO = { cat, pts, opts, scopeIdx: idx };
  renderSello();
  document.getElementById('sello-overlay').classList.add('open');
}
function closeSello(){ document.getElementById('sello-overlay').classList.remove('open'); }

function rasterize(svgStr, w, h){
  const url = URL.createObjectURL(new Blob([svgStr], {type:'image/svg+xml;charset=utf-8'}));
  return new Promise((res)=>{
    const img = new Image();
    img.onload = ()=>{
      const c = document.createElement('canvas'); c.width=w; c.height=h;
      const ctx = c.getContext('2d'); ctx.fillStyle='#fff'; ctx.fillRect(0,0,w,h);
      ctx.drawImage(img,0,0,w,h); URL.revokeObjectURL(url);
      c.toBlob(b=>res(b),'image/png');
    };
    img.onerror=()=>{ URL.revokeObjectURL(url); res(null); };
    img.src = url;
  });
}
async function selloBlob(){
  const svg = document.querySelector('#sello-preview svg');
  if(!svg) return null;
  return rasterize(new XMLSerializer().serializeToString(svg), 1080, 1080);
}
async function selloBlobVertical(){ return rasterize(buildSelloVertical(SELLO), 1080, 1920); }

async function deliverBlob(blob, suffix, span, orig){
  const fname = `rankingspain-${MUNI.nombre.toLowerCase().replace(/[^a-z0-9]+/g,'-')}${suffix}.png`;
  if (blob && navigator.canShare && navigator.canShare({ files:[new File([blob],fname,{type:'image/png'})] })){
    try { await navigator.share({ files:[new File([blob],fname,{type:'image/png'})], text: shareText() }); span.textContent=orig; return; } catch(_){}
  }
  if (blob){ const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download=fname; a.click(); setTimeout(()=>URL.revokeObjectURL(a.href),3000); }
  span.textContent=orig;
}

function buildSelloVertical(d){
  const scope = d.opts[d.scopeIdx] || { rank:'', label:'' };
  const eyebrow = tier(scope.rank).eyebrow;
  const zona = MUNI.comunidad ? `${MUNI.provincia} · ${MUNI.comunidad}` : MUNI.provincia;
  const nLen = (MUNI.nombre||'').length;
  const nombreSize = nLen>16 ? 76 : nLen>11 ? 92 : 104;
  const zonaSize = (zona||'').length > 26 ? 34 : 42;
  const scopeUp = esc((scope.label||'').toUpperCase());
  const pillW = Math.max(280, scopeUp.length*22 + 100);
  const pillX = 540 - pillW/2;
  return `<svg width="1080" height="1920" viewBox="0 0 1080 1920" xmlns="http://www.w3.org/2000/svg">
<rect x="0" y="0" width="1080" height="1920" fill="#ffffff"/>
<rect x="0" y="0" width="1080" height="26" fill="#FF385C"/>
<circle cx="540" cy="600" r="290" fill="#FFF1F3"/>
<text x="540" y="220" text-anchor="middle" font-family="Arial, sans-serif" font-size="46" font-weight="800" letter-spacing="2"><tspan fill="#FF385C">Ranking </tspan><tspan fill="#222222">Spain</tspan></text>
<circle cx="540" cy="600" r="150" fill="#ffffff" stroke="#FF385C" stroke-width="8"/>
<circle cx="540" cy="600" r="122" fill="none" stroke="#FF385C" stroke-width="3" stroke-opacity="0.4"/>
<text x="540" y="642" text-anchor="middle" font-family="Arial, sans-serif" font-size="116" font-weight="800" fill="#E31C5F">Nº${esc(scope.rank)}</text>
<rect x="${pillX}" y="800" width="${pillW}" height="74" rx="37" fill="#FF385C"/>
<text x="540" y="850" text-anchor="middle" font-family="Arial, sans-serif" font-size="34" font-weight="800" letter-spacing="3" fill="#ffffff">${scopeUp}</text>
<text x="540" y="990" text-anchor="middle" font-family="Arial, sans-serif" font-size="30" font-weight="700" letter-spacing="8" fill="#717171">${esc(eyebrow)}</text>
<text x="540" y="1090" text-anchor="middle" font-family="Arial, sans-serif" font-size="${esc((d.cat||'').length>16?64:(d.cat||'').length>11?78:90)}" font-weight="800" fill="#FF385C">${esc(d.cat)}</text>
<line x1="330" y1="1180" x2="750" y2="1180" stroke="#EBEBEB" stroke-width="3"/>
<text x="540" y="1370" text-anchor="middle" font-family="Arial, sans-serif" font-size="${nombreSize}" font-weight="800" fill="#222222">${esc(MUNI.nombre)}</text>
<text x="540" y="1448" text-anchor="middle" font-family="Arial, sans-serif" font-size="${zonaSize}" font-weight="600" fill="#717171">${esc(zona)}</text>
<rect x="400" y="1560" width="280" height="96" rx="48" fill="#FF385C"/>
<text x="540" y="1622" text-anchor="middle" font-family="Arial, sans-serif" font-size="44" font-weight="800" fill="#ffffff">${esc(d.pts)}<tspan font-size="28" font-weight="700" fill="#FFD6DE"> / 100</tspan></text>
<text x="540" y="1850" text-anchor="middle" font-family="Arial, sans-serif" font-size="34" font-weight="600" letter-spacing="1" fill="#717171">rankingspain.com</text>
</svg>`;
}

function wireSello(){
  document.getElementById('sello-close')?.addEventListener('click', closeSello);
  document.getElementById('sello-overlay')?.addEventListener('click', (e)=>{ if(e.target.id==='sello-overlay') closeSello(); });
  document.querySelectorAll('.sello-net[data-net]').forEach(b=>b.addEventListener('click', ()=>{
    const t = encodeURIComponent(shareText()+' '); const u = encodeURIComponent(PAGE_URL);
    const net = b.getAttribute('data-net');
    const urls = {
      whatsapp:`https://wa.me/?text=${t}${u}`,
      facebook:`https://www.facebook.com/sharer/sharer.php?u=${u}&quote=${t}`,
      x:`https://twitter.com/intent/tweet?text=${t}&url=${u}`,
      telegram:`https://t.me/share/url?url=${u}&text=${t}`,
    };
    window.open(urls[net], '_blank', 'noopener');
  }));
  document.getElementById('sello-copy')?.addEventListener('click', (e)=>{
    navigator.clipboard.writeText(shareText()+' '+PAGE_URL);
    const b=e.currentTarget; const s=b.querySelector('span'); const o=s.textContent; s.textContent='¡Copiado!'; setTimeout(()=>s.textContent=o,1800);
  });
  document.getElementById('sello-download')?.addEventListener('click', async (e)=>{
    const s=e.currentTarget.querySelector('span'); const o=s.textContent; s.textContent='Generando…';
    await deliverBlob(await selloBlob(), '', s, o);
  });
  document.getElementById('sello-stories')?.addEventListener('click', async (e)=>{
    const s=e.currentTarget.querySelector('span'); const o=s.textContent; s.textContent='Generando…';
    await deliverBlob(await selloBlobVertical(), '-stories', s, o);
  });
}
wireSello();
window.openSello = openSello;
</script>

