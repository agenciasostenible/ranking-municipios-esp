  const pillW = Math.max(280, scopeUp.length*22 + 100);
  const pillX = 540 - pillW/2;
  return `<svg width="1080" height="1920" viewBox="0 0 1080 1920" xmlns="http://www.w3.org/2000/svg">
<rect x="0" y="0" width="1080" height="1920" fill="#ffffff"/>
<rect x="0" y="0" width="1080" height="26" fill="#FF385C"/>
<circle cx="540" cy="600" r="290" fill="#FFF1F3"/>
<text x="540" y="220" text-anchor="middle" font-family="Arial, sans-serif" font-size="46" font-weight="800" letter-spacing="2"><tspan fill="#FF385C">Ranking </tspan><tspan fill="#222222">Spain</tspan></text>
<circle cx="540" cy="600" r="150" fill="#ffffff" stroke="#FF385C" stroke-width="8"/>
<circle cx="540" cy="600" r="122" fill="none" stroke="#FF385C" stroke-width="3" stroke-opacity="0.4"/>
<text x="540" y="642" text-anchor="middle" font-family="Arial, sans-serif" font-size="116" font-weight="800" fill="#E31C5F">Nº${esc(scope.rank)}</text>
<rect x="${pillX}" y="800" width="${pillW}" height="74" rx="37" fill="#FF385C"/>
<text x="540" y="850" text-anchor="middle" font-family="Arial, sans-serif" font-size="34" font-weight="800" letter-spacing="3" fill="#ffffff">${scopeUp}</text>
<text x="540" y="990" text-anchor="middle" font-family="Arial, sans-serif" font-size="30" font-weight="700" letter-spacing="8" fill="#717171">${esc(eyebrow)}</text>
<text x="540" y="1090" text-anchor="middle" font-family="Arial, sans-serif" font-size="${esc((d.cat||'').length>16?64:(d.cat||'').length>11?78:90)}" font-weight="800" fill="#FF385C">${esc(d.cat)}</text>
<line x1="330" y1="1180" x2="750" y2="1180" stroke="#EBEBEB" stroke-width="3"/>
<text x="540" y="1370" text-anchor="middle" font-family="Arial, sans-serif" font-size="${nombreSize}" font-weight="800" fill="#222222">${esc(MUNI.nombre)}</text>
<text x="540" y="1448" text-anchor="middle" font-family="Arial, sans-serif" font-size="${zonaSize}" font-weight="600" fill="#717171">${esc(zona)}</text>
<rect x="400" y="1560" width="280" height="96" rx="48" fill="#FF385C"/>
<text x="540" y="1622" text-anchor="middle" font-family="Arial, sans-serif" font-size="44" font-weight="800" fill="#ffffff">${esc(d.pts)}<tspan font-size="28" font-weight="700" fill="#FFD6DE"> / 100</tspan></text>
<text x="540" y="1850" text-anchor="middle" font-family="Arial, sans-serif" font-size="34" font-weight="600" letter-spacing="1" fill="#717171">rankingspain.com</text>
</svg>`;
}

function wireSello(){
  document.getElementById('sello-close')?.addEventListener('click', closeSello);
  document.getElementById('sello-overlay')?.addEventListener('click', (e)=>{ if(e.target.id==='sello-overlay') closeSello(); });
  document.querySelectorAll('.sello-net[data-net]').forEach(b=>b.addEventListener('click', ()=>{
    const t = encodeURIComponent(shareText()+' '); const u = encodeURIComponent(PAGE_URL);
    const net = b.getAttribute('data-net');
    const urls = {
      whatsapp:`https://wa.me/?text=${t}${u}`,
      facebook:`https://www.facebook.com/sharer/sharer.php?u=${u}&quote=${t}`,
      x:`https://twitter.com/intent/tweet?text=${t}&url=${u}`,
      telegram:`https://t.me/share/url?url=${u}&text=${t}`,
    };
    window.open(urls[net], '_blank', 'noopener');
  }));
  document.getElementById('sello-copy')?.addEventListener('click', (e)=>{
    navigator.clipboard.writeText(shareText()+' '+PAGE_URL);
    const b=e.currentTarget; const s=b.querySelector('span'); const o=s.textContent; s.textContent='¡Copiado!'; setTimeout(()=>s.textContent=o,1800);
  });
  document.getElementById('sello-download')?.addEventListener('click', async (e)=>{
    const s=e.currentTarget.querySelector('span'); const o=s.textContent; s.textContent='Generando…';
    await deliverBlob(await selloBlob(), '', s, o);
  });
  document.getElementById('sello-stories')?.addEventListener('click', async (e)=>{
    const s=e.currentTarget.querySelector('span'); const o=s.textContent; s.textContent='Generando…';
    await deliverBlob(await selloBlobVertical(), '-stories', s, o);
  });
}
wireSello();
window.openSello = openSello;
</script>

