.rmc-share {
  margin-top: 10px; width: 100%;
  display: inline-flex; align-items: center; justify-content: center; gap: 6px;
  background: #fff1f3; color: var(--primary);
  border: 1px solid rgba(255,56,92,.3); cursor: pointer;
  border-radius: 10px; padding: 8px 6px;
  font-size: .72rem; font-weight: 700; line-height: 1;
  transition: background .15s, color .15s;
}
.rmc-share span { line-height: 1; }
.rmc-share:hover { background: var(--primary); color: #fff; border-color: var(--primary); }

/* ── Modal sello compartible ── */
.sello-overlay {
  position: fixed; inset: 0; z-index: 1000;
  background: rgba(0,0,0,.55);
  display: none; align-items: center; justify-content: center;
  padding: 20px;
}
.sello-overlay.open { display: flex; }
.sello-modal {
  background: #fff; border-radius: 20px;
  padding: 18px; width: 100%; max-width: 420px;
  max-height: 92vh; overflow-y: auto;
  position: relative;
}
.sello-close {
  position: absolute; top: 12px; right: 12px;
  width: 32px; height: 32px; border-radius: 50%;
  border: none; background: var(--bg); color: var(--text);
  font-size: 1rem; cursor: pointer; z-index: 2;
}
.sello-preview { width: 100%; border-radius: 14px; overflow: hidden; }
.sello-preview svg { width: 100%; height: auto; display: block; }
.sello-scope { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-top: 12px; }
.scope-pill {
  font-size: .78rem; font-weight: 600; cursor: pointer;
  padding: 6px 12px; border-radius: 999px;
  border: 1.5px solid var(--border); background: #fff; color: var(--text-2);
}
.scope-pill.on { border-color: var(--primary); background: #fff1f3; color: var(--primary); }
.sello-actions {
  display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px;
}
.sello-net {
  flex: 1 1 calc(25% - 6px);
  display: flex; align-items: center; justify-content: center;
  padding: 11px 6px; border-radius: 12px; border: none; cursor: pointer;
  font-size: .82rem; font-weight: 700; color: #fff;
}
.sello-net span { line-height: 1; }
.sello-net.wide { flex: 1 1 calc(50% - 4px); }
.sello-net.full { flex: 1 1 100%; }
.sello-net.wa { background: #25D366; }
.sello-net.fb { background: #1877F2; }
.sello-net.x  { background: #000; }
.sello-net.tg { background: #229ED9; }
.sello-net.dl { background: var(--primary); }
.sello-net.st { background: var(--primary-dark); }
.sello-net.cp { background: var(--text); }
.sello-net:hover { opacity: .9; }
.sello-hint { text-align: center; font-size: .78rem; color: var(--text-2); margin: 12px 0 2px; }
.rmc-cat { font-size: .72rem; font-weight: 600; margin-bottom: 6px; }
.rmc-pos { font-size: 2rem; font-weight: 800; line-height: 1; margin-bottom: 4px; }
.rmc-sub { font-size: .68rem; color: var(--text-2); margin-bottom: 8px; }
.rmc-nacional { font-size: .82rem; margin-bottom: 4px; }
.rmc-nacional-lbl { font-size: .72rem; color: var(--text-2); }
.rmc-pts { font-size: .7rem; color: #ccc; margin-top: auto; }

/* ── Detail bars ── */
.detail-bar-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 8px;
}
.detail-bar-label {
  width: 180px;
  font-size: .78rem;
  color: var(--text-2);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex-shrink: 0;
}
.detail-bar-track {
  flex: 1;
  background: #F0F0F0;
  border-radius: 4px;
  height: 8px;
}
.detail-bar-fill { height: 8px; border-radius: 4px; transition: width .4s; }
.detail-bar-pts { width: 38px; text-align: right; font-size: .78rem; font-weight: 700; }
.detail-bar-rank { width: 44px; text-align: right; font-size: .72rem; color: #ccc; }

/* ── Nav ── */
.mun-nav { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 8px; margin-bottom: 80px; }

/* ── Cercanos / Comparar ── */
.cercanos-section { margin-top: 28px; }
.cercanos-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; gap: 12px; }
.cercanos-all { font-size: .82rem; font-weight: 600; color: var(--primary); text-decoration: none; white-space: nowrap; }
.cercanos-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
.cercano-card {
  display: flex; flex-direction: column; gap: 4px;
  padding: 14px 12px;
  background: #fff; border: 1.5px solid var(--border); border-radius: 14px;
  text-decoration: none; color: var(--text);
  transition: border-color .15s, box-shadow .15s;
}
.cercano-card:hover { border-color: var(--primary); box-shadow: 0 4px 16px rgba(255,56,92,.12); }
.cercano-name { font-size: .88rem; font-weight: 700; color: var(--text); line-height: 1.2; }
.cercano-prov { font-size: .72rem; color: #888; min-height: 14px; }
.cercano-score { font-size: .8rem; color: var(--text-2); margin-top: 4px; }
@media (max-width: 768px) { .cercanos-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 480px) { .cercanos-grid { grid-template-columns: repeat(2, 1fr); gap: 8px; } .cercano-card { padding: 12px 10px; } }

/* ── FAB Share ── */
.fab-share {
  position: fixed;
  bottom: 28px;
  right: 28px;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--primary);
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 20px rgba(255,56,92,.4);
  transition: background .2s, transform .2s, box-shadow .2s;
  z-index: 100;
}
.fab-share:hover {
  background: var(--primary-dark);
  transform: scale(1.08);
  box-shadow: 0 6px 28px rgba(255,56,92,.5);
}
.fab-share svg { width: 22px; height: 22px; }

/* Responsive */
@media (max-width: 768px) {
  .mun-hero { min-height: 240px; }
  .mun-hero-name { font-size: 1.75rem; }
  .mun-hero-content { padding: 16px 16px 24px; }
  .mun-stat-val { font-size: 1rem; }
  .rankings-grid { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 8px; }
  .rmc-pos { font-size: 1.6rem; }
  .entidades-grid { grid-template-columns: 1fr; }
  .detail-bar-label { width: 130px; }
  .fab-share { bottom: 20px; right: 20px; width: 50px; height: 50px; }
}
/* Hero con foto */
.mun-hero-photo { background-size: cover; background-position: center; }
.mun-hero-photo .mun-hero-overlay { background: linear-gradient(to top, rgba(0,0,0,.75) 0%, rgba(0,0,0,.35) 60%, rgba(0,0,0,.1) 100%); }
.hero-photo-credit { position: absolute; bottom: 8px; right: 12px; font-size: .65rem; color: rgba(255,255,255,.55); }
</style>

<style is:global>
.sello-preview svg { width: 100% !important; height: auto !important; display: block; }
.scope-pill { font-size: .78rem; font-weight: 600; cursor: pointer; padding: 6px 12px; border-radius: 999px; border: 1.5px solid #EBEBEB; background: #fff; color: #717171; }
.scope-pill.on { border-color: #FF385C; background: #fff1f3; color: #FF385C; }
</style>

<script define:vars={{ fotoUrl }}>
if (fotoUrl) document.getElementById('mun-hero')?.classList.add('mun-hero-photo');
</script>
</Base>
