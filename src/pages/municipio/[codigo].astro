// Scroll automático al bloque "desde" cuando venimos del buscador con ?desde=
if (new URLSearchParams(location.search).get('desde')) {
  const el = document.getElementById('desde-block');
  if (el) {
    // Espera a que la página esté pintada y luego sube al bloque compensando el header sticky
    const doScroll = () => {
      const top = el.getBoundingClientRect().top + window.scrollY - 64;
      window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
