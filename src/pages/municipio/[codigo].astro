<script define:vars={{ MUNI }}>
const PAGE_URL = `https://rankingspain.com/municipio/${MUNI.codigo}`;
let SELLO = { cat: '', pts: '', opts: [], scopeIdx: 0 };

function esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function fitFont(text, big, mid, small){
  const n = (text||'').length;
  return n > 16 ? small : n > 11 ? mid : big;
}

function tier(rankStr){
  const r = parseInt(rankStr) || 0;
  if (r === 1)  return { eyebrow: 'EL MEJOR EN',  hook: 'es el Nº1' };
  if (r <= 3)   return { eyebrow: 'TOP 3 EN',     hook: 'está en el TOP 3' };
  if (r <= 5)   return { eyebrow: 'TOP 5 EN',     hook: 'está en el TOP 5' };
  if (r <= 10)  return { eyebrow: 'TOP 10 EN',    hook: 'está en el TOP 10' };
  if (r <= 25)  return { eyebrow: 'TOP 25 EN',    hook: 'está en el TOP 25' };
  if (r <= 50)  return { eyebrow: 'TOP 50 EN',    hook: 'está en el TOP 50' };
  if (r <= 100) return { eyebrow: 'TOP 100 EN',   hook: 'está en el TOP 100' };
  return { eyebrow: 'DESTACA EN', hook: `es el Nº${r}` };
}

function buildSelloSVG(d){
  const scope = d.opts[d.scopeIdx] || { rank: '', label: '' };
  const eyebrow = tier(scope.rank).eyebrow;
  const zona = MUNI.comunidad ? `${MUNI.provincia} · ${MUNI.comunidad}` : MUNI.provincia;
  const nombreSize = fitFont(MUNI.nombre, 56, 48, 40);
  const zonaSize = (zona||'').length > 26 ? 18 : 22;
  const scopeUp = esc((scope.label||'').toUpperCase());
  const pillW = Math.max(150, scopeUp.length * 12 + 56);
  const pillX = 340 - pillW/2;
  return `<svg width="1080" height="1080" viewBox="0 0 680 680" xmlns="http://www.w3.org/2000/svg">
<rect x="2" y="2" width="676" height="676" rx="40" fill="#ffffff" stroke="#EBEBEB" stroke-width="2"/>
<rect x="2" y="2" width="676" height="14" rx="7" fill="#FF385C"/>
<circle cx="340" cy="168" r="104" fill="#FFF1F3"/>
<text x="340" y="66" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="22" font-weight="700" letter-spacing="2.5"><tspan fill="#FF385C">★ </tspan><tspan fill="#222222">RANKING SPAIN</tspan></text>
<circle cx="340" cy="170" r="58" fill="#ffffff" stroke="#FF385C" stroke-width="3.5"/>
<circle cx="340" cy="170" r="46" fill="none" stroke="#FF385C" stroke-width="1.5" stroke-opacity="0.4"/>
<text x="340" y="186" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="44" font-weight="800" fill="#E31C5F">Nº${esc(scope.rank)}</text>
<rect x="${pillX}" y="252" width="${pillW}" height="40" rx="20" fill="#FF385C"/>
<text x="340" y="278" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="17" font-weight="700" letter-spacing="2.5" fill="#ffffff">${scopeUp}</text>
<text x="340" y="346" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="15" font-weight="700" letter-spacing="4" fill="#717171">${eyebrow}</text>
<text x="340" y="392" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="${fitFont(d.cat,40,34,28)}" font-weight="800" fill="#FF385C">${esc(d.cat)}</text>
<line x1="250" y1="424" x2="430" y2="424" stroke="#EBEBEB" stroke-width="2"/>
<text x="340" y="486" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="${nombreSize}" font-weight="800" fill="#222222">${esc(MUNI.nombre)}</text>
<text x="340" y="522" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="${zonaSize}" font-weight="500" fill="#717171">${esc(zona)}</text>
<rect x="264" y="556" width="152" height="52" rx="26" fill="#FF385C"/>
<text x="340" y="590" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="24" font-weight="800" fill="#ffffff">${esc(d.pts)}<tspan font-size="15" font-weight="700" fill="#FFD6DE"> / 100</tspan></text>
<text x="340" y="652" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="17" font-weight="600" letter-spacing="1" fill="#717171">rankingspain.com</text>
</svg>`;
}

function shareText(){
  const s = SELLO.opts[SELLO.scopeIdx] || {};
  const h = tier(s.rank).hook;
  const emoji = parseInt(s.rank) === 1 ? '🥇' : '🏆';
  return `${emoji} ${MUNI.nombre} ${h} ${s.label} en ${SELLO.cat} según Ranking Spain 👇`;
}

function renderSello(){
  document.getElementById('sello-preview').innerHTML = buildSelloSVG(SELLO);
  const sc = document.getElementById('sello-scope');
  if (SELLO.opts.length > 1){
    sc.style.display = 'flex';
    sc.innerHTML = SELLO.opts.map((o,i)=>`<button class="scope-pill${i===SELLO.scopeIdx?' on':''}" data-i="${i}">Nº${o.rank} ${esc(o.label)}</button>`).join('');
    sc.querySelectorAll('.scope-pill').forEach(b=>b.addEventListener('click',()=>{ SELLO.scopeIdx=+b.getAttribute('data-i'); renderSello(); }));
  } else { sc.style.display='none'; sc.innerHTML=''; }
}

function openSello(btn){
  let cat='', nac='', prov='', pts='', prefer='';
  if (btn){
    cat = btn.getAttribute('data-cat'); nac = btn.getAttribute('data-nac');
    prov = btn.getAttribute('data-prov'); pts = btn.getAttribute('data-pts');
    prefer = btn.getAttribute('data-prefer') || '';
  } else {
    const cards = Array.from(document.querySelectorAll('.rmc-share'));
    let best=null, bestNac=1e9;
    cards.forEach(c=>{ const n=parseInt(c.getAttribute('data-nac')||'0'); if(n && n<bestNac){bestNac=n;best=c;} });
    const t = best || cards[0];
    if(!t) return;
    cat=t.getAttribute('data-cat'); nac=t.getAttribute('data-nac'); prov=t.getAttribute('data-prov'); pts=t.getAttribute('data-pts');
  }
  const opts=[];
  if (nac) opts.push({ rank:nac, label:'de España' });
  if (prov) opts.push({ rank:prov, label:'de '+MUNI.provincia });
  if (!opts.length) return;
  let idx=0;
  if (opts.length>1){
    if (prefer==='es') idx = 0;          // 'de España' siempre va primero
    else { const n=parseInt(nac); idx = (n && n<=100) ? 0 : 1; }
  }
  cat = cat.charAt(0).toUpperCase() + cat.slice(1).toLowerCase();
  SELLO = { cat, pts, opts, scopeIdx: idx };
  renderSello();
  document.getElementById('sello-overlay').classList.add('open');
}
function closeSello(){ document.getElementById('sello-overlay').classList.remove('open'); }

function rasterize(svgStr, w, h){
  const url = URL.createObjectURL(new Blob([svgStr], {type:'image/svg+xml;charset=utf-8'}));
  const img = new Image(); img.width = w; img.height = h;
  // decode() espera al render COMPLETO del SVG antes de pintarlo: evita que iOS
  // descarte texto al rasterizar (lo que ocurría en la imagen de compartir).
  const draw = ()=>{
    const c = document.createElement('canvas'); c.width=w; c.height=h;
    const ctx = c.getContext('2d'); ctx.fillStyle='#fff'; ctx.fillRect(0,0,w,h);
    ctx.drawImage(img,0,0,w,h); URL.revokeObjectURL(url);
    return new Promise(res=>c.toBlob(b=>res(b),'image/png'));
  };
  img.src = url;
  if (img.decode) return img.decode().then(draw).catch(()=>{ URL.revokeObjectURL(url); return null; });
  return new Promise((res)=>{ img.onload=()=>draw().then(res); img.onerror=()=>{ URL.revokeObjectURL(url); res(null); }; });
}
async function selloBlob(){
  const svg = document.querySelector('#sello-preview svg');
  if(!svg) return null;
  return rasterize(new XMLSerializer().serializeToString(svg), 1080, 1080);
}
async function selloBlobVertical(){ return rasterize(buildSelloVertical(SELLO), 1080, 1920); }

async function deliverBlob(blob, suffix, span, orig){
  const fname = `rankingspain-${MUNI.nombre.toLowerCase().replace(/[^a-z0-9]+/g,'-')}${suffix}.png`;
  if (blob && navigator.canShare && navigator.canShare({ files:[new File([blob],fname,{type:'image/png'})] })){
    try { await navigator.share({ files:[new File([blob],fname,{type:'image/png'})], text: shareText() }); span.textContent=orig; return; } catch(_){}
  }
  if (blob){ const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download=fname; a.click(); setTimeout(()=>URL.revokeObjectURL(a.href),3000); }
  span.textContent=orig;
}

function buildSelloVertical(d){
  const scope = d.opts[d.scopeIdx] || { rank:'', label:'' };
  const eyebrow = tier(scope.rank).eyebrow;
  const zona = MUNI.comunidad ? `${MUNI.provincia} · ${MUNI.comunidad}` : MUNI.provincia;
