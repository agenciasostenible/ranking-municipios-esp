---
import { DB } from '../../lib/d1client';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getCatInfo, formatPob, LABELS, FICHA_CATS, DETAIL_CATS } from '../../lib/db';
import { getTipoIcon, getTipoIconName, getSelloStyle, TIPO_LABEL, tieneFichaMaps, gmapsUrl } from '../../lib/entidades';
import { getProvGradient, CAT_COLORS } from '../../lib/utils';
import { getAnunciosMunicipio, ANUNCIO_TIPOS } from '../../lib/anuncios';
// @ts-ignore

const { codigo } = Astro.params;
const desde = Astro.url.searchParams.get('desde') ?? '';
const entBuscada = (Astro.url.searchParams.get('ent') ?? '').toLowerCase();

// Dedup por nombre: una misma entidad puede existir en varios tipos (p.ej. la
// Fortaleza de la Mota como 'fortaleza' y como 'monumento'), y como una categoría
// agrupa varios tipos, saldría DOS veces en la misma lista. Nos quedamos con la
// mejor (con sello oficial / descripción más completa) y conservamos el orden.
const _norm = (s: string) => (s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9 ]/g, ' ').replace(/\s+/g, ' ').trim();
function dedupByName<T extends { nombre: string; nivel_sello?: any; descripcion?: any }>(rows: T[]): T[] {
  const score = (e: T) => (e.nivel_sello && !['Normal', '—', ''].includes(String(e.nivel_sello)) ? 1000 : 0) + (e.descripcion ? String(e.descripcion).length : 0);
  // Mejor primero, para quedarnos con el de más sello/descripción al colapsar.
  const ranked = [...rows].sort((a, b) => score(b) - score(a));
  const kept: T[] = [];
  for (const e of ranked) {
    const ne = _norm(e.nombre);
    // Mismo nombre, o uno contiene al otro (p.ej. "Etnosur" ⊂ "Festival Etnosur").
    const dup = kept.some((k) => {
      const nk = _norm(k.nombre);
      return ne === nk || (ne.length >= 6 && nk.length >= 6 && (nk.includes(ne) || ne.includes(nk)));
    });
    if (!dup) kept.push(e);
  }
  const chosen = new Set(kept);
  return rows.filter((e) => chosen.has(e)); // conserva el orden original de visualización
}

const municipio = await DB.prepare(`SELECT * FROM municipios WHERE codigo_ine = ?`).bind(codigo).first();
if (!municipio) return Astro.redirect('/');

const { results: puntuaciones } = await DB.prepare(
  `SELECT categoria, puntuacion, ranking_provincial, ranking_nacional
   FROM puntuaciones WHERE codigo_ine = ? ORDER BY puntuacion DESC`
).bind(codigo).all();

const totalNacionalRow = await DB.prepare(`SELECT COUNT(*) as n FROM municipios`).first();
const totalNacional = totalNacionalRow?.n ?? 0;

let { results: entidades } = await DB.prepare(
  `SELECT tipo, nombre, nivel_sello, descripcion FROM entidades e
   WHERE e.codigo_ine = ?
     AND COALESCE(e.fuente,'') NOT IN ('guia_repsol_solete','gastronomia_ampliacion','guia_michelin','vias_verdes','eurovelo','caminos_naturales','camino_cid','pirinexus','centros_btt','hoteles_encanto','starlight','balnearios','cuevas','pueblos_mas_bonitos','bandera_azul','unesco','wikidata_museos')
     AND (e.tipo NOT IN ('espacio','parque_natural') OR (
       SELECT COUNT(DISTINCT e2.codigo_ine) FROM entidades e2
       WHERE e2.nombre = e.nombre AND e2.tipo = e.tipo
     ) <= 8)
   ORDER BY
     CASE nivel_sello
       WHEN 'UNESCO' THEN 1 WHEN 'IT Internacional' THEN 2
       WHEN 'Parque Nacional' THEN 3 WHEN 'BIC Nacional' THEN 4
       WHEN 'IT Nacional' THEN 5 ELSE 6
     END, tipo, nombre
   LIMIT 40`
).bind(codigo).all();

// Museos: sección dedicada (separada del grid general para no ahogar el contenido)
const { results: museosRows } = await DB.prepare(
  `SELECT nombre, descripcion, nivel_sello, latitud, longitud, enlace FROM entidades
   WHERE codigo_ine = ? AND fuente = 'wikidata_museos'
   ORDER BY nombre LIMIT 20`
).bind(codigo).all();
const museos = museosRows as any[];
entidades = dedupByName(entidades as any[]);

// "Dónde comer": UN solo listado que unifica todas las distinciones gastronómicas
// (Estrella Michelin, Solete Guía Repsol, y recomendados verificados). Cada sitio
// lleva su(s) etiqueta(s); los futuros buenos restaurantes sin distinción entran aquí igual.
const { results: comerRows } = await DB.prepare(
  `SELECT tipo, nombre, descripcion, enlace, nivel_sello, fuente FROM entidades
   WHERE codigo_ine = ? AND fuente IN ('guia_michelin','guia_repsol_solete','gastronomia_ampliacion')`
).bind(codigo).all();

const michelinStars = (nivel: string | null) =>
  nivel === '3 Estrellas Michelin' ? 3 : nivel === '2 Estrellas Michelin' ? 2 : nivel ? 1 : 0;
const normName = (s: string) => (s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();

// Fusiona por nombre: un sitio que sea Estrella + Solete muestra ambas etiquetas
const comerMap = new Map<string, any>();
for (const r of comerRows as any[]) {
  const k = normName(r.nombre);
  const stars = r.fuente === 'guia_michelin' ? michelinStars(r.nivel_sello) : 0;
  let it = comerMap.get(k);
  if (!it) {
    it = { nombre: r.nombre, descripcion: '', tipo: 'restaurante', enlace: null, stars: 0, solete: false, reco: false };
    comerMap.set(k, it);
  }
  if (r.fuente === 'guia_michelin') it.stars = Math.max(it.stars, stars);
  if (r.fuente === 'guia_repsol_solete') { it.solete = true; it.tipo = r.tipo || it.tipo; }
  if (r.fuente === 'gastronomia_ampliacion') it.reco = true;
  if (r.enlace && !it.enlace) it.enlace = r.enlace;
  // descripción: preferimos una real (solete/recomendado) frente a la genérica de Michelin
  const isGoodDesc = r.descripcion && r.fuente !== 'guia_michelin';
  if (isGoodDesc && (!it.descripcion || it._descFromMichelin)) { it.descripcion = r.descripcion; it._descFromMichelin = false; }
  else if (r.descripcion && !it.descripcion) { it.descripcion = r.descripcion; it._descFromMichelin = (r.fuente === 'guia_michelin'); }
}
// prioridad: 3★,2★,1★ → Solete → Recomendado; dentro, alfabético
const prio = (it: any) => it.stars ? 10 - it.stars : it.solete ? 20 : 30;
const comer = [...comerMap.values()].sort((a, b) => prio(a) - prio(b) || a.nombre.localeCompare(b.nombre, 'es'));

// Cicloturismo: rutas ciclistas oficiales/homologadas que pasan por el municipio
const { results: rutasBiciRows } = await DB.prepare(
  `SELECT nombre, descripcion, fuente FROM entidades
   WHERE codigo_ine = ? AND fuente IN ('vias_verdes','eurovelo','caminos_naturales','camino_cid','pirinexus','centros_btt')
   ORDER BY CASE fuente WHEN 'centros_btt' THEN 0 WHEN 'eurovelo' THEN 1 WHEN 'vias_verdes' THEN 2
                        WHEN 'caminos_naturales' THEN 3 WHEN 'camino_cid' THEN 4 WHEN 'pirinexus' THEN 5 ELSE 6 END, nombre`
).bind(codigo).all();
const rutasBici = rutasBiciRows as any[];
// etiqueta + color por red
const RUTA_BADGE: Record<string, { label: string; bg: string; fg: string }> = {
  vias_verdes:       { label: 'Vía Verde',      bg: '#e6f5ea', fg: '#1f7a3d' },
  eurovelo:          { label: 'EuroVelo',        bg: '#e7eefc', fg: '#1b4fb3' },
  caminos_naturales: { label: 'Camino Natural',  bg: '#e3f4f1', fg: '#0f7a6b' },
  camino_cid:        { label: 'Camino del Cid',   bg: '#f5ecdf', fg: '#9a6b1e' },
  pirinexus:         { label: 'Pirinexus',        bg: '#efe7fa', fg: '#6a3db3' },
  centros_btt:       { label: 'Centro BTT',       bg: '#fdeede', fg: '#c2620f' },
};

// Alojamientos con encanto: Paradores + hoteles boutique/lujo (Llave Michelin)
const { results: hotelesRows } = await DB.prepare(
  `SELECT nombre, descripcion, nivel_sello FROM entidades
   WHERE codigo_ine = ? AND fuente = 'hoteles_encanto'
   ORDER BY CASE nivel_sello
     WHEN '3 Llaves Michelin' THEN 1 WHEN '2 Llaves Michelin' THEN 2
     WHEN 'Relais & Châteaux' THEN 3
     WHEN '1 Llave Michelin' THEN 4 WHEN 'Parador histórico' THEN 5 ELSE 6 END, nombre`
).bind(codigo).all();
const hotelesEncanto = hotelesRows as any[];

// Astroturismo: certificaciones Starlight (Reservas y Destinos) del municipio
const { results: starlightRows } = await DB.prepare(
  `SELECT nombre, descripcion, nivel_sello FROM entidades
   WHERE codigo_ine = ? AND fuente = 'starlight' ORDER BY nivel_sello, nombre`
).bind(codigo).all();
const starlight = starlightRows as any[];

// Balnearios y termalismo (ANBAL: aguas mineromedicinales)
const { results: balneariosRows } = await DB.prepare(
  `SELECT nombre, descripcion FROM entidades
   WHERE codigo_ine = ? AND fuente = 'balnearios' ORDER BY nombre`
).bind(codigo).all();
const balnearios = balneariosRows as any[];

// Cuevas y minas turísticas (ACTE)
const { results: cuevasRows } = await DB.prepare(
  `SELECT nombre, descripcion FROM entidades
   WHERE codigo_ine = ? AND fuente = 'cuevas' ORDER BY nombre`
).bind(codigo).all();
const cuevasTuristicas = cuevasRows as any[];

// Los Pueblos más Bonitos de España (asociación oficial)
const pueblosMasBonitosRow = await DB.prepare(
  `SELECT descripcion FROM entidades
   WHERE codigo_ine = ? AND fuente = 'pueblos_mas_bonitos' LIMIT 1`
).bind(codigo).first();
const puebloMasBonito = pueblosMasBonitosRow as any;

// Bandera Azul 2026 (ADEAC)
const banderaAzulRow = await DB.prepare(
  `SELECT descripcion FROM entidades
   WHERE codigo_ine = ? AND fuente = 'bandera_azul' LIMIT 1`
).bind(codigo).first();
const banderaAzul = banderaAzulRow as any;

// Patrimonio Mundial UNESCO (puede haber varios sitios por municipio)
const { results: unescoRows } = await DB.prepare(
  `SELECT nombre, descripcion FROM entidades
   WHERE codigo_ine = ? AND fuente = 'unesco' ORDER BY nombre`
).bind(codigo).all();
const unesco = unescoRows as any[];

const totalProvRow = await DB.prepare(`SELECT COUNT(*) as n FROM municipios WHERE provincia = ?`).bind(municipio.provincia).first();
const totalProv = totalProvRow?.n ?? 0;

// Instagramers que recomiendan este municipio
// Mapa categoría → especialidades instagramer
const CAT_ESP: Record<string, string[]> = {
  gastronomia: ['gastronomia'], soletes: ['gastronomia'], vinos: ['gastronomia'], oleoturismo: ['gastronomia'],
  senderismo: ['senderismo','naturaleza','aventura'], naturaleza: ['naturaleza','aventura'],
  Playas: ['playa'], turismo_activo: ['aventura','naturaleza'],
  monumentos: ['cultura'], castillos: ['cultura'], museos: ['cultura'], festivales: ['cultura','festivales'], fiestas: ['cultura','festivales'],
  TurismoRural: ['rural'], pueblo_bonito: ['rural','cultura'],
  estrellas: ['naturaleza'], hoteles_encanto: ['lujo'], lujo: ['lujo'],
};
const espFiltros = desde && CAT_ESP[desde] ? CAT_ESP[desde] : [];
const espCond = espFiltros.length > 0
  ? `AND (${espFiltros.map(() => `(',' || COALESCE(i.especialidad,'') || ',') LIKE '%,' || ? || ',%'`).join(' OR ')})`
  : '';
const { results: instagramersRows } = await DB.prepare(
  `SELECT DISTINCT i.id, i.handle, i.nombre, i.avatar_url, i.especialidad, i.seguidores,
          (i.avatar_data IS NOT NULL) AS has_avatar
   FROM instagramers i
   JOIN instagramer_municipios im ON im.instagramer_id = i.id
   WHERE i.verificado = 1
     AND (im.codigo_ine = ? OR im.provincia = ?)
     ${espCond}
   ORDER BY i.seguidores DESC, i.id DESC
   LIMIT 6`
).bind(...espFiltros, codigo, municipio.provincia, ...espFiltros).all();
const instagramersMuni = (instagramersRows as any[]).map((r) => ({
  ...r,
  avatar_url: r.has_avatar ? `/api/instagramer-foto?id=${r.id}` : (r.avatar_url || null),
}));

const globalScore = puntuaciones.find((p: any) => p.categoria === 'ranking_global');
const fichaScores = (puntuaciones as any[]).filter((p: any) => FICHA_CATS.includes(p.categoria));
const detailScores = (puntuaciones as any[]).filter((p: any) => DETAIL_CATS.includes(p.categoria));

const why: string[] = municipio.why_json
  ? (() => { try { return JSON.parse(municipio.why_json as string); } catch { return []; } })()
  : [];

// No mostrar "POR QUÉ VISITAR" si ya está en la sección "¿Por qué destaca?" (Campings, TurismoRural)
const whyToDisplay: string[] = (desde === 'Campings' || desde === 'TurismoRural') ? [] : why;

const topCat = fichaScores.filter((p: any) => p.categoria !== 'ranking_global')
  .sort((a: any, b: any) => (a.ranking_provincial ?? 999) - (b.ranking_provincial ?? 999))[0];
const topCatInfo = topCat ? getCatInfo(topCat.categoria) : null;
const topCatPos = topCat?.ranking_provincial ?? null;

const titleSeo = topCatInfo && topCatPos
  ? `${municipio.nombre} - Ranking turístico · #${topCatPos} en ${topCatInfo.label} en ${municipio.provincia}`
  : `${municipio.nombre} — Ranking turístico · ${municipio.provincia}`;
const whyText = why.slice(0,3).join(', ');
const descSeo = `${municipio.nombre} (${municipio.poblacion ? formatPob(municipio.poblacion as number)+' hab.' : ''}) está en el puesto #${globalScore?.ranking_provincial ?? '—'} de ${totalProv} municipios en ${municipio.provincia}.${whyText ? ' Destaca en: ' + whyText + '.' : ''}`;

const heroGradient = getProvGradient(municipio.provincia as string);

const MUNI = {
  nombre: municipio.nombre as string,
  provincia: municipio.provincia as string,
  comunidad: municipio.comunidad as string,
  codigo: codigo as string,
};

// Mapa categoría → tipos de entidades relevantes
const CAT_TIPOS: Record<string, string[]> = {
  senderismo:    ['sendero'],
  ciclismo:      ['ciclismo', 'sendero', 'deporte', 'ruta'],
  cuevas:        ['cueva'],
  balnearios:    ['balneario'],
  hoteles_encanto: ['alojamiento'],
  agua:          ['agua', 'playa_fluvial', 'playa'],
  Playas:        ['playa', 'playa_urbana'],
  playas:        ['playa', 'playa_urbana'],
  naturaleza:    ['espacio', 'montaña', 'fauna'],
  camping:       ['camping'],
  historia:      ['castillo', 'yacimiento', 'monumento', 'conjunto', 'museo'],
  monumentos:    ['castillo', 'monumento', 'iglesia', 'catedral', 'yacimiento', 'palacio', 'ermita', 'conjunto_historico', 'fortaleza', 'torre'],
  castillos:     ['castillo', 'torre', 'fortaleza', 'alcazaba', 'muralla', 'conjunto_historico'],
  yacimientos:   ['yacimiento'],
  gastronomia:   ['gastronomia', 'producto'],
  soletes:       ['restaurante', 'bar', 'cafeteria', 'chiringuito', 'vinoteca', 'heladeria', 'fast_good'],
  fiestas:       ['fiesta'],
  festivales:    ['festival'],
  turismo_religioso: ['religioso'],
  turismo_lgtbi:     ['lgtbi'],
  museos:            ['Museo', 'museo'],
  miradores:         ['mirador'],
  vinos:             ['vino', 'bodega'],
  oleoturismo:       ['almazara', 'oleoturismo'],
  misterioso:        ['misterio'],
  estrellas:         ['starlight', 'reserva'],
  lujo:              ['lujo'],
  pueblo_bonito:     ['pueblo_bonito'],
  TurismoRural:      ['rural', 'casa_rural'],
  turismo_mascotas:  ['mascotas'],
  turismo_activo:    ['activo'],
  oleoturismo:       ['oleoturismo'],
  TurismoRural:      ['rural'],
  estrellas:     ['astro'],
  birdwatching:  ['espacio', 'fauna'],
  aventura:      ['cueva', 'montaña', 'sendero'],
  escapada_rural:['espacio', 'mirador'],
  retiros:       ['balneario', 'espacio'],
  aceite:        ['producto'],
  vinos:         ['vino', 'producto'],
  miradores:     ['mirador'],
  lujo:          ['lujo'],
  solteros:      ['soltero'],
  misterioso:    ['misterio'],
};

// Entidades relevantes para la categoría de entrada
let desdeEntidades: any[] = [];
let desdePuntuacion: any = null;
let desdeWhyJson: string[] = [];
if (desde && desde !== 'ranking_global') {
  desdePuntuacion = (puntuaciones as any[]).find((p: any) => p.categoria === desde);

  // why_json highlights: fallback para cualquier categoría sin entidades propias
  try {
    desdeWhyJson = municipio.why_json ? JSON.parse(municipio.why_json as string) : [];
  } catch {
    desdeWhyJson = [];
  }

  // Entidades específicas de la categoría (cuando existen: monumentos, castillos, fiestas, etc.)
  const tiposDesde = CAT_TIPOS[desde] ?? [];
  if (tiposDesde.length) {
    const placeholders = tiposDesde.map(() => '?').join(',');
    const { results: de } = await DB.prepare(
      `SELECT tipo, nombre, nivel_sello, descripcion FROM entidades e
       WHERE e.codigo_ine = ? AND e.tipo IN (${placeholders})
         AND (e.tipo NOT IN ('espacio','parque_natural') OR (
           SELECT COUNT(DISTINCT e2.codigo_ine) FROM entidades e2
           WHERE e2.nombre = e.nombre AND e2.tipo = e.tipo
         ) <= 8)
       ORDER BY
         CASE WHEN ? != '' AND LOWER(e.nombre) LIKE '%'||LOWER(?)||'%' THEN 0 ELSE 1 END,
         CASE nivel_sello
           WHEN 'UNESCO' THEN 1 WHEN 'Parque Nacional' THEN 2 WHEN 'BIC Nacional' THEN 3
           WHEN '3 Estrellas Michelin' THEN 4 WHEN '2 Estrellas Michelin' THEN 5 WHEN '1 Estrella Michelin' THEN 6
           WHEN '3 Llaves Michelin' THEN 4 WHEN '2 Llaves Michelin' THEN 5 WHEN '1 Llave Michelin' THEN 6
           WHEN 'Reserva Starlight' THEN 5 WHEN 'IT Internacional' THEN 6 WHEN 'IT Nacional' THEN 7
           ELSE 8 END,
         CASE WHEN COALESCE(e.fuente,'')='guia_michelin' THEN 0
              WHEN COALESCE(e.fuente,'')='guia_repsol_solete' THEN 1
              WHEN COALESCE(e.fuente,'')='gastronomia_ampliacion' THEN 2 ELSE 3 END,
         nombre LIMIT 15`
    ).bind(codigo, ...tiposDesde, entBuscada, entBuscada).all();
    desdeEntidades = dedupByName(de as any[]);
    // Poner la entidad buscada primera si viene de búsqueda específica
    if (entBuscada) {
      desdeEntidades.sort((a: any, b: any) => {
        const aM = a.nombre.toLowerCase().includes(entBuscada) ? 0 : 1;
        const bM = b.nombre.toLowerCase().includes(entBuscada) ? 0 : 1;
        return aM - bM;
      });
    }
  }
}

// Fallback: recursos generales del municipio (para categorías "solo puntuación" sin entidades propias)
const desdeFallbackEntidades = (entidades as any[]).slice(0, 5);

const desdeInfo = desde ? getCatInfo(desde) : null;

// Variables para la desde-card (computadas en frontmatter, no en template)
const desdeItems = desdeEntidades.length > 0 ? desdeEntidades : desdeWhyJson.map((w: string) => ({ nombre: w }));
const desdeEstrella: any = desdeItems[0] ?? null;
const desdeResto: any[] = desdeItems.slice(1, 5);

// Municipios cercanos por distancia geográfica (bounding box ~50km)
const lat = municipio.latitud as number | null;
const lon = municipio.longitud as number | null;
let cercanos: any[] = [];
if (lat && lon) {
  const { results: c } = await DB.prepare(`
    SELECT m.codigo_ine, m.nombre, m.provincia, p.puntuacion,
           ABS(m.latitud - ?) + ABS(m.longitud - ?) as dist_aprox
    FROM municipios m
    JOIN puntuaciones p ON p.codigo_ine = m.codigo_ine
    WHERE m.latitud BETWEEN ? AND ?
      AND m.longitud BETWEEN ? AND ?
      AND m.codigo_ine != ?
      AND p.categoria = 'ranking_global'
      AND p.puntuacion > 0
      AND COALESCE(m.es_duplicado, 0) = 0
    ORDER BY dist_aprox ASC
    LIMIT 5
  `).bind(lat, lon, lat - 0.45, lat + 0.45, lon - 0.6, lon + 0.6, codigo).all();
  cercanos = c as any[];
}
// Fallback: misma provincia si no hay coords
const { results: similares } = cercanos.length ? { results: [] } : await DB.prepare(`
  SELECT m.codigo_ine, m.nombre, m.provincia, p.puntuacion
  FROM municipios m JOIN puntuaciones p ON p.codigo_ine = m.codigo_ine
  WHERE m.provincia = ? AND m.codigo_ine != ? AND p.categoria = 'ranking_global' AND COALESCE(m.es_duplicado, 0) = 0
  ORDER BY p.puntuacion DESC LIMIT 5
`).bind(municipio.provincia, codigo).all();
const municipiosCercanos = cercanos.length ? cercanos : similares;

// Foto Wikipedia — usar la cacheada si existe, si no el gradiente
const fotoUrl = municipio.foto_url && municipio.foto_url !== 'NONE'
  ? municipio.foto_url as string
  : null;

const recomendados = await getAnunciosMunicipio(codigo);
---
<Base title={titleSeo} description={descSeo}
  ogTitle={topCatInfo && topCatPos ? `${municipio.nombre} · #${topCatPos} en ${topCatInfo.label} en ${municipio.provincia}` : `${municipio.nombre} — Ranking turístico`}
  ogDescription={descSeo}
  ogImage={`https://rankingspain.com/api/og/sello/${codigo}${desde && desde !== 'ranking_global' ? `?cat=${encodeURIComponent(desde)}` : ''}`}>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://rankingspain.com/" },
    { "@type": "ListItem", "position": 2, "name": municipio.provincia, "item": `https://rankingspain.com/provincia/${encodeURIComponent(municipio.provincia as string)}` },
    { "@type": "ListItem", "position": 3, "name": municipio.nombre },
  ]
})} />

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": municipio.nombre,
  "description": descSeo,
  "url": `https://rankingspain.com/municipio/${codigo}`,
  ...(fotoUrl ? { "image": fotoUrl } : {}),
  ...(municipio.latitud && municipio.longitud ? {
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": municipio.latitud,
      "longitude": municipio.longitud
    }
  } : {}),
  "containedInPlace": {
    "@type": "AdministrativeArea",
    "name": municipio.provincia,
    "containedInPlace": {
      "@type": "Country",
      "name": "España",
      "sameAs": "https://www.wikidata.org/wiki/Q29"
    }
  },
  ...(municipio.poblacion ? { "population": municipio.poblacion } : {}),
  "aggregateRating": globalScore ? {
    "@type": "AggregateRating",
    "ratingValue": Math.round((globalScore.puntuacion / 100) * 5 * 10) / 10,
    "bestRating": 5,
    "worstRating": 1,
    "ratingCount": 1032
  } : undefined,
