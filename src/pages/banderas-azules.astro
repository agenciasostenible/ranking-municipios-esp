---
import { DB } from '../lib/d1client';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const { results } = await DB.prepare(
  `SELECT m.codigo_ine, m.nombre, m.provincia, m.comunidad
   FROM entidades e JOIN municipios m ON m.codigo_ine = e.codigo_ine
   WHERE e.fuente = 'bandera_azul' AND COALESCE(m.es_duplicado,0)=0
   ORDER BY m.comunidad, m.provincia, m.nombre`
).all();
const rows = results as any[];
const total = rows.length;

const groups: Record<string, any[]> = {};
for (const r of rows) (groups[r.comunidad || 'Otras'] ||= []).push(r);
const comunidades = Object.keys(groups).sort((a, b) => groups[b].length - groups[a].length || a.localeCompare(b, 'es'));
---
<Base
  title="Municipios con Bandera Azul 2026 — listado completo"
  description={`Los ${total} municipios de España con playas galardonadas con la Bandera Azul 2026 (ADEAC), agrupados por comunidad autónoma.`}>

  <main class="ba-page">
    <header class="ba-head">
      <div class="ba-chip"><Icon name="beach_access" size={16} /> Sello ADEAC 2026</div>
      <h1>Municipios con Bandera Azul 2026</h1>
      <p class="ba-sub">
        <strong>{total} municipios</strong> tienen playas con la <strong>Bandera Azul 2026</strong>, la distinción internacional
        de ADEAC que certifica calidad del agua, servicios, seguridad y gestión sostenible. Pulsa cualquiera para ver su ficha.
      </p>
      <a class="ba-link" href="/ranking/playas">Ver el ranking de playas →</a>
    </header>

    {comunidades.map(c => (
      <section class="ba-group">
        <h2>{c} <span class="ba-count">{groups[c].length}</span></h2>
        <div class="ba-grid">
          {groups[c].map(r => (
            <a class="ba-card" href={`/municipio/${r.codigo_ine}`}>
              <span class="ba-name">{r.nombre}</span>
              <span class="ba-prov">{r.provincia}</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>
</Base>

<style>
.ba-page { max-width: 1040px; margin: 0 auto; padding: 24px 16px 60px; }
.ba-head { text-align: center; margin: 12px 0 34px; }
.ba-chip { display: inline-flex; align-items: center; gap: 5px; font-size: .72rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: .5px; color: #155f93; background: #e8f4fd; border: 1px solid #b9ddf6;
  padding: 5px 11px; border-radius: 999px; }
.ba-head h1 { font-size: 1.9rem; font-weight: 700; letter-spacing: -.02em; margin: 14px 0 8px; }
.ba-sub { color: #555; max-width: 660px; margin: 0 auto 14px; line-height: 1.6; font-size: 1rem; }
.ba-link { color: #155f93; font-weight: 600; text-decoration: none; }
.ba-link:hover { text-decoration: underline; }
.ba-group { margin-bottom: 30px; }
.ba-group h2 { font-size: 1.05rem; font-weight: 700; letter-spacing: -.01em; margin: 0 0 14px;
  display: flex; align-items: center; gap: 8px; border-bottom: 1px solid #eee; padding-bottom: 8px; }
.ba-count { font-size: .8rem; font-weight: 700; color: #155f93; background: #e8f4fd; border-radius: 999px; padding: 2px 9px; }
.ba-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 10px; }
.ba-card { display: flex; flex-direction: column; gap: 2px; padding: 11px 13px; border: 1px solid #eee;
  border-radius: 12px; text-decoration: none; background: #fff; transition: border-color .15s, transform .15s; }
.ba-card:hover { border-color: #1b7fc4; transform: translateY(-1px); }
.ba-name { font-weight: 600; color: #222; letter-spacing: -.01em; }
.ba-prov { font-size: .8rem; color: #888; }
</style>
