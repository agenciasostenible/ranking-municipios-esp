---
import Base from '../../layouts/Base.astro';
---
<Base
  title="Únete como instagramer de viajes — Ranking Spain"
  description="¿Creas contenido sobre turismo en España? Regístrate en nuestro directorio de instagramers y comparte dónde eres experto."
>
<div class="uni-page">
  <div class="uni-hero">
    <span class="uni-kicker">📸 Instagramers</span>
    <h1>Únete a nuestra comunidad de creadores</h1>
    <p>Si creas contenido sobre turismo en España, regístrate y aparece en nuestro directorio. Cuéntanos en qué zonas y temáticas eres experto.</p>
  </div>

  <form class="uni-form" id="uni-form">
    <div class="uni-field">
      <label>Tu usuario de Instagram *</label>
      <input id="u-handle" type="text" maxlength="60" placeholder="@tucuenta" required autocomplete="off" />
    </div>

    <div class="uni-field">
      <label>Tu nombre <span class="uni-opt">(opcional)</span></label>
      <input id="u-nombre" type="text" maxlength="80" placeholder="Ej. María García" autocomplete="off" />
    </div>

    <div class="uni-field">
      <label>Tu número de seguidores <span class="uni-opt">(opcional)</span></label>
      <input id="u-seg" type="number" min="0" placeholder="Ej. 83200" autocomplete="off" />
    </div>

    <div class="uni-sep"><span>Tus especialidades</span></div>
    <p class="uni-hint">Selecciona todas las que apliquen.</p>
    <div class="uni-checks" id="u-esps">
      <label class="uni-check"><input type="checkbox" value="gastronomia" /> 🍽️ Gastronomía</label>
      <label class="uni-check"><input type="checkbox" value="naturaleza" /> 🌿 Naturaleza</label>
      <label class="uni-check"><input type="checkbox" value="playa" /> 🏖️ Playa</label>
      <label class="uni-check"><input type="checkbox" value="cultura" /> 🏛️ Cultura e historia</label>
      <label class="uni-check"><input type="checkbox" value="aventura" /> 🧗 Aventura y deporte</label>
      <label class="uni-check"><input type="checkbox" value="rural" /> 🏡 Turismo rural</label>
      <label class="uni-check"><input type="checkbox" value="fotografía" /> 📷 Fotografía</label>
      <label class="uni-check"><input type="checkbox" value="lujo" /> 💎 Lujo y hoteles</label>
      <label class="uni-check"><input type="checkbox" value="familia" /> 👨‍👩‍👧 Familia y niños</label>
      <label class="uni-check"><input type="checkbox" value="senderismo" /> 🥾 Senderismo</label>
      <label class="uni-check"><input type="checkbox" value="vinos" /> 🍷 Vinos y bodegas</label>
      <label class="uni-check"><input type="checkbox" value="festivales" /> 🎉 Fiestas y festivales</label>
      <label class="uni-check"><input type="checkbox" value="general" /> 🗺️ Viajes en general</label>
    </div>
    <div class="uni-field" style="margin-top:4px">
      <label>Otra especialidad <span class="uni-opt">(escribe la tuya si no está arriba)</span></label>
      <input id="u-esp-custom" type="text" maxlength="40" placeholder="Ej. Astroturismo, Esquí, Surf…" autocomplete="off" />
    </div>

    <div class="uni-field">
      <label>Mini bio <span class="uni-opt">(opcional, máx. 200 car.)</span></label>
      <textarea id="u-bio" maxlength="200" rows="2" placeholder="Ej. Recorro pueblos con encanto de España buscando los rincones más auténticos."></textarea>
    </div>

    <div class="uni-sep"><span>Zonas donde eres experto/a</span></div>
    <p class="uni-hint">Añade entre 1 y 5 provincias, ciudades o comunidades autónomas donde creas contenido.</p>

    <div id="u-munis-list">
      <div class="u-muni-row" data-idx="0">
        <div class="uni-field uni-field-ac">
          <label>Zona 1 *</label>
          <input class="u-muni-input" type="text" maxlength="80" placeholder="Ej. Granada, Andalucía, Madrid…" autocomplete="off" />
          <div class="u-ac"></div>
          <span class="u-matched" hidden></span>
        </div>
      </div>
    </div>

    <button type="button" id="u-add" class="uni-add">+ Añadir otra zona</button>

    <!-- honeypot -->
    <input id="u-website" type="text" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />

    <button type="submit" class="uni-go" id="u-go">Enviar mi registro</button>
    <p class="uni-note">Revisaremos tu solicitud y te añadiremos al directorio en 24-48 horas.</p>
  </form>

  <div class="uni-ok" id="uni-ok" hidden>
    <div class="uni-ok-ic">🎉</div>
    <h2>¡Solicitud enviada!</h2>
    <p>Revisaremos tu perfil y te añadiremos al directorio pronto. ¡Gracias por unirte!</p>
    <a href="/instagramers" class="uni-ok-back">Ver directorio de instagramers</a>
  </div>
</div>

<script>
  const $ = (id: string) => document.getElementById(id) as any;

  const muniData: Record<number, { nombre_sitio: string; codigo_ine: string; provincia: string }> = {};
  let activeAc: HTMLElement | null = null;

  function igEsc(s: string) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  function igHl(str: string, q: string) {
    const i = str.toLowerCase().indexOf(q.toLowerCase());
    if (i < 0) return igEsc(str);
    return igEsc(str.slice(0,i)) + `<strong>${igEsc(str.slice(i,i+q.length))}</strong>` + igEsc(str.slice(i+q.length));
  }

  // Cierra todos los dropdowns al hacer clic fuera (un solo listener global)
  document.addEventListener('click', (e: any) => {
    document.querySelectorAll('.u-ac').forEach((ac: any) => {
      const input = ac.closest('.uni-field-ac')?.querySelector('.u-muni-input');
      if (!ac.contains(e.target) && e.target !== input) ac.innerHTML = '';
    });
  });

  function setupRow(row: HTMLElement, idx: number) {
    muniData[idx] = { nombre_sitio: '', codigo_ine: '', provincia: '' };
    const input = row.querySelector('.u-muni-input') as HTMLInputElement;
    const ac    = row.querySelector('.u-ac') as HTMLElement;
    const matched = row.querySelector('.u-matched') as HTMLElement;

    let tmr: any;
    input.addEventListener('input', () => {
      muniData[idx] = { nombre_sitio: input.value.trim(), codigo_ine: '', provincia: input.value.trim() };
      matched.hidden = true;
      clearTimeout(tmr);
      const q = input.value.trim();
      if (q.length < 2) { ac.innerHTML = ''; return; }
      tmr = setTimeout(async () => {
        try {
          const d: any[] = await fetch('/api/search?q=' + encodeURIComponent(q)).then(r => r.json());
          const provs = (d || []).filter((x: any) => x.tipo === 'provincia' || x.tipo === 'comunidad').slice(0, 4);
          const munis = (d || []).filter((x: any) => x.tipo === 'municipio').slice(0, 3);
          ac.innerHTML = [...provs, ...munis].map((m: any) => {
            const sub  = m.tipo === 'provincia' ? 'Provincia' : m.tipo === 'comunidad' ? 'Comunidad autónoma' : (m.provincia || '');
            const icon = m.tipo === 'municipio' ? '🏘️' : '📍';
            const bg   = m.tipo === 'municipio' ? '#fff1f3' : '#f3f0ff';
            const prov = m.tipo === 'municipio' ? (m.provincia || m.nombre) : m.nombre;
            return `<a href="#" data-n="${igEsc(m.nombre)}" data-c="${igEsc(m.codigo_ine||'')}" data-p="${igEsc(prov)}"
              style="display:flex;align-items:center;gap:10px;padding:10px 13px;border-top:1px solid #f0f0f0;text-decoration:none;color:#222;background:#fff">
              <span style="flex-shrink:0;width:28px;height:28px;border-radius:7px;background:${bg};display:flex;align-items:center;justify-content:center;font-size:.85rem">${icon}</span>
              <span style="flex:1;min-width:0">
                <span style="display:block;font-size:.88rem;font-weight:600">${igHl(m.nombre, q)}</span>
                ${sub ? `<span style="display:block;font-size:.74rem;color:#888">${igEsc(sub)}</span>` : ''}
              </span></a>`;
          }).join('');
        } catch {}
      }, 200);
    });

    ac.addEventListener('click', (e: any) => {
      e.preventDefault();
      const a = e.target.closest('a[data-n]'); if (!a) return;
      const nombre = a.getAttribute('data-n') || '';
      const prov   = a.getAttribute('data-p') || nombre;
      input.value = nombre;
      muniData[idx] = { nombre_sitio: nombre, codigo_ine: a.getAttribute('data-c') || '', provincia: prov };
      matched.textContent = '✓ ' + nombre;
      matched.hidden = false;
      ac.innerHTML = '';
    });
  }

  setupRow(document.querySelector('.u-muni-row') as HTMLElement, 0);

  let rowCount = 1;
  $('u-add').addEventListener('click', () => {
    if (rowCount >= 5) { $('u-add').disabled = true; return; }
    const idx = rowCount++;
    const div = document.createElement('div');
    div.className = 'u-muni-row';
    div.innerHTML = `<div class="uni-field uni-field-ac">
      <label>Zona ${idx + 1}</label>
      <input class="u-muni-input" type="text" maxlength="80" placeholder="Ej. Sevilla, Cataluña, Barcelona…" autocomplete="off" />
      <div class="u-ac"></div>
      <span class="u-matched" hidden></span>
    </div>`;
    $('u-munis-list').appendChild(div);
    setupRow(div, idx);
    if (rowCount >= 5) $('u-add').disabled = true;
    // Scroll y foco al nuevo input
    setTimeout(() => {
      const newInput = div.querySelector('.u-muni-input') as HTMLInputElement;
      newInput?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      newInput?.focus();
    }, 80);
  });

  $('uni-form').addEventListener('submit', async (e: any) => {
    e.preventDefault();
    const handle = $('u-handle').value.trim().replace(/^@/, '');
    const zonas = Object.values(muniData).filter((m: any) => m.nombre_sitio.trim().length > 0);
    if (!handle || zonas.length === 0) {
      alert('Pon tu Instagram y al menos una zona.');
      return;
    }
    const esps = Array.from(document.querySelectorAll('#u-esps input:checked')).map((cb: any) => cb.value);
    const custom = $('u-esp-custom').value.trim();
    if (custom) esps.push(custom);
    const payload = {
      handle,
      nombre:      $('u-nombre').value.trim() || undefined,
      especialidad: esps.join(',') || undefined,
      seguidores:  parseInt($('u-seg').value) || undefined,
      bio:         $('u-bio').value.trim() || undefined,
      municipios:  zonas,
      website:     $('u-website').value,
    };
    $('u-go').disabled = true; $('u-go').textContent = 'Enviando…';
    try {
      const r = await fetch('/api/instagramers', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!r.ok) throw new Error();
      $('uni-form').style.display = 'none';
      $('uni-ok').hidden = false;
    } catch {
      $('u-go').disabled = false;
      $('u-go').textContent = 'Enviar mi registro';
      alert('No se pudo enviar. Inténtalo de nuevo.');
    }
  });
</script>

<style>
  .uni-page { max-width: 600px; margin: 0 auto; padding: 28px 16px 60px; }
  .uni-kicker { display: inline-block; background: #f3f0ff; color: #7c3aed; font-weight: 800; font-size: .78rem; letter-spacing: .04em; padding: 5px 12px; border-radius: 20px; margin-bottom: 12px; }
  .uni-hero h1 { font-size: 1.55rem; font-weight: 700; letter-spacing: -0.02em; color: #222; margin: 0 0 10px; line-height: 1.2; }
  .uni-hero p { color: #555; font-size: .95rem; line-height: 1.55; margin: 0 0 24px; }
  .uni-form { display: flex; flex-direction: column; gap: 18px; }
  .uni-field { display: flex; flex-direction: column; gap: 6px; position: relative; }
  .uni-field label { font-size: .85rem; font-weight: 700; color: #333; }
  .uni-opt { font-weight: 500; color: #999; }
  .uni-field input[type="text"], .uni-field input[type="number"], .uni-field textarea {
    padding: 12px 13px; border: 1.5px solid #ddd; border-radius: 12px; font-size: .98rem; font-family: inherit;
  }
  .uni-field input:focus, .uni-field textarea:focus { outline: none; border-color: #7c3aed; }
  .uni-field textarea { resize: vertical; min-height: 60px; }
  .uni-checks { display: flex; flex-wrap: wrap; gap: 10px; }
  .uni-check { display: flex; align-items: center; gap: 7px; background: #faf9ff; border: 1.5px solid #e0d9ff; border-radius: 10px; padding: 8px 13px; cursor: pointer; font-size: .9rem; font-weight: 600; color: #444; transition: border-color .15s, background .15s; }
  .uni-check:has(input:checked) { background: #f3f0ff; border-color: #7c3aed; color: #7c3aed; }
  .uni-check input { display: none; }
  .uni-field-ac { position: relative; }
  .u-ac { position: absolute; top: 100%; left: 0; right: 0; z-index: 20; background: #fff; border-radius: 0 0 12px 12px; box-shadow: 0 8px 24px rgba(0,0,0,.12); overflow: hidden; }
  .u-ac a:first-child { border-top: none !important; }
  .u-ac a:hover { background: #f3f0ff !important; }
  .u-matched { font-size: .82rem; color: #16a34a; font-weight: 700; }
  .uni-sep { display: flex; align-items: center; gap: 10px; color: #888; font-size: .82rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
  .uni-sep::before, .uni-sep::after { content: ''; flex: 1; height: 1px; background: #e5e5e5; }
  .uni-hint { color: #888; font-size: .85rem; margin: -8px 0 0; }
  .uni-add { background: none; border: 1.5px dashed #c4b5fd; color: #7c3aed; font-weight: 700; font-size: .9rem; border-radius: 12px; padding: 11px; cursor: pointer; font-family: inherit; }
  .uni-add:hover { background: #f3f0ff; }
  .uni-add:disabled { opacity: .4; cursor: default; }
  .uni-go { padding: 15px; background: #7c3aed; color: #fff; border: none; border-radius: 12px; font-size: 1.02rem; font-weight: 800; cursor: pointer; margin-top: 4px; font-family: inherit; }
  .uni-go:disabled { opacity: .6; }
  .uni-note { font-size: .78rem; color: #999; text-align: center; margin: 0; line-height: 1.5; }
  .uni-ok { text-align: center; padding: 48px 0; }
  .uni-ok-ic { font-size: 3.2rem; }
  .uni-ok h2 { font-size: 1.35rem; color: #222; margin: 8px 0; }
  .uni-ok p { color: #666; line-height: 1.5; }
  .uni-ok-back { display: inline-block; margin-top: 14px; color: #7c3aed; font-weight: 800; text-decoration: none; }
</style>
</Base>
