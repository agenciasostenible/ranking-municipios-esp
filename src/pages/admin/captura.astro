---
const env = (k: string) =>
  (import.meta as any).env?.[k] ?? (typeof process !== 'undefined' ? (process as any).env[k] : undefined);
const key = Astro.url.searchParams.get('key') ?? '';
const ok = env('ADMIN_KEY') && key === env('ADMIN_KEY');
---
<html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Captura → post · Redes</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<style>
  :root{ --rausch:#FF385C; --line:#e7dfd3; --muted:#8a7f70; }
  *{ box-sizing:border-box; }
  body{ margin:0; font-family:"Plus Jakarta Sans","Helvetica Neue",Arial,system-ui,sans-serif; background:#faf8f5; color:#171412; }
  .bar{ padding:13px 16px; border-bottom:1px solid var(--line); display:flex; align-items:center; gap:14px; }
  .bar h1{ font-size:16px; margin:0; font-weight:800; letter-spacing:-.02em; }
  .bar a{ font-size:13px; color:var(--muted); text-decoration:none; }
  .wrap{ max-width:520px; margin:0 auto; padding:16px; display:flex; flex-direction:column; gap:16px; }
  label.fld{ display:flex; flex-direction:column; gap:5px; font-size:12px; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); font-weight:700; }
  input[type=text], textarea, select{ font:inherit; font-size:16px; padding:11px 12px; border-radius:11px; border:1px solid #d9cfc0; background:#fff; width:100%; color:#171412; }
  textarea{ min-height:120px; resize:vertical; text-transform:none; letter-spacing:0; }
  .row{ display:flex; gap:8px; flex-wrap:wrap; }
  .btn{ font:inherit; font-size:15px; padding:12px 14px; border-radius:12px; border:1px solid #d9cfc0; background:#fff; cursor:pointer; flex:1; text-align:center; }
  .btn.primary{ background:var(--rausch); color:#fff; border:0; font-weight:700; }
  .btn.ok{ background:#0a7d3c; color:#fff; border:0; font-weight:700; }
  .up{ display:block; text-align:center; padding:26px 12px; border:2px dashed #d9cfc0; border-radius:14px; color:var(--muted); font-size:14px; cursor:pointer; background:#fff; }
  .up.set{ border-style:solid; color:#171412; }
  .presets{ display:flex; gap:7px; flex-wrap:wrap; }
  .pchip{ font-size:14px; padding:8px 13px; border-radius:999px; border:1px solid #d9cfc0; background:#fff; cursor:pointer; }
  .pchip.on{ background:#171412; color:#fff; border-color:#171412; }
  canvas#post{ width:100%; max-width:340px; margin:0 auto; display:block; border-radius:14px; box-shadow:0 10px 30px rgba(0,0,0,.16); }
  .hint{ font-size:13px; color:var(--muted); line-height:1.5; }
  .msg{ font-size:14px; padding:10px 12px; border-radius:10px; display:none; }
  .msg.ok{ background:#e4f4ea; color:#0a5c2c; display:block; }
  .msg.err{ background:#fbe6e6; color:#a12; display:block; }
  .noauth{ padding:60px 20px; text-align:center; color:var(--muted); }
  input[type=file]{ display:none; }
</style></head>
<body>
{ !ok ? (
  <div class="noauth">Acceso restringido. Añade <code>?key=TU_ADMIN_KEY</code> a la URL.</div>
) : (
<div>
  <div class="bar"><a href={`/admin?key=${key}`} style="font-size:20px;text-decoration:none">←</a><h1>📲 Captura → post</h1><button id="reset" type="button" style="margin-left:auto;font:inherit;font-size:13px;font-weight:700;padding:8px 12px;border-radius:10px;border:1px solid #d9cfc0;background:#fff;cursor:pointer">🔄 Nueva captura</button></div>
  <div class="wrap">
    <input type="hidden" id="key" value={key} />

    <div class="hint" style="margin-bottom:-4px">Sube <b>dos capturas</b>: la <b>foto</b> del sitio y la <b>captura del texto</b> (la leo yo y saco la descripción).</div>
    <div>
      <label class="up" id="fotoUp" for="fotoInp"><span id="fotoTxt">① 📷 Captura / foto del sitio<br><small style="opacity:.65;text-transform:none;letter-spacing:0">será la imagen del post</small></span></label>
      <input type="file" id="fotoInp" accept="image/*" />
    </div>
    <div>
      <label class="up" id="capUp" for="capInp"><span id="capTxt">② 📝 Captura del texto<br><small style="opacity:.65;text-transform:none;letter-spacing:0">la leo y relleno la descripción</small></span></label>
      <input type="file" id="capInp" accept="image/*" />
    </div>

    <div>
      <label class="fld">Color de la foto</label>
      <div class="presets" id="presets">
        <span class="pchip on" data-p="vivo">Vivo</span>
        <span class="pchip" data-p="calido">Cálido</span>
        <span class="pchip" data-p="cine">Cine</span>
        <span class="pchip" data-p="byn">B/N</span>
        <span class="pchip" data-p="none">Original</span>
      </div>
    </div>

    <canvas id="post" width="1080" height="1350"></canvas>

    <label class="fld">Nombre del sitio (opcional)
      <input type="text" id="nombre" placeholder="Ej: Playa de Bolonia" />
    </label>
    <label class="fld">Municipio
      <input type="text" id="municipio" placeholder="Ej: Tarifa" />
    </label>
    <label class="fld">Gancho <span style="text-transform:none;font-weight:400;color:#b3a690">— frase corta que sale en la imagen</span>
      <input type="text" id="gancho" placeholder="Ej: El paraíso escondido de Galicia" maxlength="46" />
    </label>

    <div class="row">
      <label class="fld" style="flex:2">Categoría (dónde rankea)
        <select id="categoria">
          <option value="naturaleza">Naturaleza</option>
          <option value="Playas">Playas</option>
          <option value="senderismo">Senderismo</option>
          <option value="miradores">Miradores</option>
          <option value="cuevas">Cuevas</option>
          <option value="pozas">Pozas y cascadas</option>
          <option value="monumentos">Monumentos</option>
          <option value="castillos">Castillos</option>
          <option value="museos">Museos</option>
          <option value="gastronomia">Gastronomía</option>
          <option value="turismo_activo">Turismo activo</option>
          <option value="estrellas">Astroturismo</option>
          <option value="turismo_religioso">Religioso</option>
          <option value="pueblo_bonito">Pueblo bonito</option>
        </select>
      </label>
      <label class="fld" style="flex:1">Puntos
        <input type="number" id="puntuacion" min="0" max="100" step="1" value="82" />
      </label>
    </div>
    <div class="hint" style="margin-top:-6px">El municipio sube en esa categoría con estos puntos (nunca baja los que ya tenga). Todo va también a Naturaleza.</div>

    <div>
      <label class="fld">Descripción</label>
      <textarea id="desc" placeholder="Aquí saldrá el texto de tu captura (o pégalo tú mismo)"></textarea>
      <div class="row" style="margin-top:8px">
        <button class="btn" type="button" id="genfoto">🖼️ Generar texto desde la foto</button>
        <button class="btn" type="button" id="limpiar">✨ Limpiar texto</button>
      </div>
      <div class="row" style="margin-top:8px">
        <button class="btn primary" type="button" id="copiar">📋 Copiar texto para Instagram</button>
      </div>
      <div class="hint" style="margin-top:6px">El texto para Instagram nombra el municipio y añade el enlace y los hashtags. Si el lector automático falla: mantén pulsado el texto de tu captura en el móvil, “Copiar”, y pégalo aquí.</div>
    </div>

    <div class="msg" id="msg"></div>
    <div class="row">
      <button class="btn primary" type="button" id="descargar">📲 Descargar / Compartir</button>
      <button class="btn ok" type="button" id="guardar">💾 Guardar en la web</button>
    </div>
  </div>
</div>
) }

<script>
  const FF = '"Plus Jakarta Sans","Helvetica Neue",Arial,sans-serif';
  const RAUSCH = '#FF385C';
  // Color + etiqueta de la pastilla según la categoría que se publicita
  const CAT_STYLE = {
    naturaleza:       { color:'#2E7D32', label:'NATURALEZA' },
    Playas:           { color:'#0277BD', label:'PLAYA' },
    senderismo:       { color:'#558B2F', label:'SENDERISMO' },
    miradores:        { color:'#00838F', label:'MIRADOR' },
    cuevas:           { color:'#5D4037', label:'CUEVA' },
    pozas:            { color:'#0097A7', label:'POZAS Y CASCADAS' },
    monumentos:       { color:'#8D6E63', label:'MONUMENTO' },
    castillos:        { color:'#6D4C41', label:'CASTILLO' },
    museos:           { color:'#5E35B1', label:'MUSEO' },
    gastronomia:      { color:'#E65100', label:'GASTRONOMÍA' },
    turismo_activo:   { color:'#F4511E', label:'TURISMO ACTIVO' },
    estrellas:        { color:'#283593', label:'CIELO ESTRELLADO' },
    turismo_religioso:{ color:'#7B1FA2', label:'PATRIMONIO' },
    pueblo_bonito:    { color:'#FF385C', label:'PUEBLO BONITO' },
  };
  const FILTERS = { vivo:'saturate(1.4) contrast(1.08)', calido:'saturate(1.25) contrast(1.05) sepia(.12)', cine:'contrast(1.18) saturate(.92) brightness(.97)', byn:'grayscale(1) contrast(1.12)', none:'none' };
  let postImg = null, preset = 'vivo', fotoFile = null;
  const $ = (id) => document.getElementById(id);
  const key = $('key')?.value || '';

  function wrap(ctx,text,maxW){ const w=(text||'').split(/\s+/),l=[]; let ln=''; for(const x of w){ const t=ln?ln+' '+x:x; if(ctx.measureText(t).width>maxW&&ln){l.push(ln);ln=x;}else ln=t;} if(ln)l.push(ln); return l; }
  function cover(ctx,im,W,H){ const ir=im.width/im.height,cr=W/H; let dw,dh,dx,dy; if(ir>cr){dh=H;dw=H*ir;dx=(W-dw)/2;dy=0;}else{dw=W;dh=W/ir;dx=0;dy=(H-dh)/2;} ctx.drawImage(im,dx,dy,dw,dh); }
  function shortDesc(t){ t=(t||'').replace(/#\S+/g,'').replace(/\s+/g,' ').trim(); if(t.length>170){ t=t.slice(0,168); t=t.replace(/[,;.\s]+\S*$/,'')+'…'; } return t; }
  function roundRect(ctx,x,y,w,h,r){ r=Math.min(r,h/2,w/2); ctx.beginPath(); ctx.moveTo(x+r,y); ctx.arcTo(x+w,y,x+w,y+h,r); ctx.arcTo(x+w,y+h,x,y+h,r); ctx.arcTo(x,y+h,x,y,r); ctx.arcTo(x,y,x+w,y,r); ctx.closePath(); }
  function setLS(ctx,v){ try{ ctx.letterSpacing=v; }catch(_){} }

  function render(){
    const cv=$('post'); if(!cv) return; const ctx=cv.getContext('2d'); const W=1080,H=1350,P=78;
    ctx.clearRect(0,0,W,H); setLS(ctx,'0px'); ctx.textAlign='left'; ctx.textBaseline='alphabetic';
    if(postImg){ ctx.filter=FILTERS[preset]||'none'; cover(ctx,postImg,W,H); ctx.filter='none'; }
    else { const gg=ctx.createLinearGradient(0,0,W,H); gg.addColorStop(0,'#3a3a3a'); gg.addColorStop(1,'#17120e'); ctx.fillStyle=gg; ctx.fillRect(0,0,W,H);
           ctx.fillStyle='rgba(255,255,255,.5)'; ctx.font=`500 34px ${FF}`; ctx.textAlign='center'; ctx.fillText('Elige una foto arriba', W/2, H/2); ctx.textAlign='left'; }
    // Scrim: oscurece arriba (marca) y sobre todo abajo (texto) para máxima legibilidad
    const g=ctx.createLinearGradient(0,0,0,H); g.addColorStop(0,'rgba(0,0,0,.3)'); g.addColorStop(.28,'rgba(0,0,0,0)'); g.addColorStop(.62,'rgba(0,0,0,.05)'); g.addColorStop(.85,'rgba(0,0,0,.46)'); g.addColorStop(1,'rgba(0,0,0,.58)'); ctx.fillStyle=g; ctx.fillRect(0,0,W,H);

    // Marca arriba
    ctx.shadowColor='rgba(0,0,0,.45)'; ctx.shadowBlur=14; ctx.shadowOffsetY=2;
    ctx.fillStyle=RAUSCH; ctx.beginPath(); ctx.arc(P+20,P+18,20,0,7); ctx.fill();
    ctx.fillStyle='#fff'; ctx.font=`700 40px ${FF}`; setLS(ctx,'-.5px'); ctx.fillText('rankingspain.com',P+52,P+31); setLS(ctx,'0px');
    ctx.shadowColor='transparent';

    const nombre = ($('nombre')?.value||'').trim() || ($('municipio')?.value||'').trim() || 'Tu sitio';
    const muni = ($('municipio')?.value||'').trim();
    let gancho = ($('gancho')?.value||'').trim();
    if(!gancho){ gancho = shortDesc($('desc')?.value||''); if(gancho.length>62){ gancho=gancho.slice(0,60).replace(/[,;.\s]+\S*$/,'')+'…'; } }

    // Bloque inferior, construido de abajo hacia arriba.
    // Dejamos MARGEN abajo (~230px) para que Instagram no tape el texto con el 👁 de visualizaciones.
    const tShadow=()=>{ ctx.shadowColor='rgba(0,0,0,.6)'; ctx.shadowBlur=22; ctx.shadowOffsetY=3; };
    let y=H-232;
    // Gancho (subtítulo)
    if(gancho){ ctx.font=`600 46px ${FF}`; setLS(ctx,'-.3px'); ctx.fillStyle='rgba(255,255,255,.97)'; tShadow(); const dl=wrap(ctx,gancho,W-2*P).slice(0,2); for(let i=dl.length-1;i>=0;i--){ctx.fillText(dl[i],P,y);y-=56;} setLS(ctx,'0px'); ctx.shadowColor='transparent'; y-=8; }
    // Municipio con pin
    if(muni){ ctx.font=`700 42px ${FF}`; setLS(ctx,'-.3px'); tShadow(); ctx.fillStyle='#fff'; ctx.fillText('📍 '+muni,P,y); setLS(ctx,'0px'); ctx.shadowColor='transparent'; y-=66; }
    // Nombre grande
    ctx.font=`800 98px ${FF}`; setLS(ctx,'-2.5px'); ctx.fillStyle='#fff'; tShadow(); const nl=wrap(ctx,nombre,W-2*P).slice(0,3); for(let i=nl.length-1;i>=0;i--){ctx.fillText(nl[i],P,y);y-=100;} setLS(ctx,'0px'); ctx.shadowColor='transparent'; y-=28;
    // Pastilla: COLOR según la categoría, pero el TEXTO siempre fijo "SITIO TOP" (blanco sobre color, GRANDE)
    const st = CAT_STYLE[($('categoria')?.value||'')] || { color:RAUSCH };
    const label='SITIO TOP'; ctx.font=`800 48px ${FF}`; setLS(ctx,'2px');
    const tw=ctx.measureText(label).width, padX=36, padY=23, bh=48+padY*2, bw=tw+padX*2, bx=P, by=y-bh;
    ctx.shadowColor='rgba(0,0,0,.45)'; ctx.shadowBlur=20; ctx.shadowOffsetY=5;
    ctx.fillStyle=st.color; roundRect(ctx,bx,by,bw,bh,bh/2); ctx.fill(); ctx.shadowColor='transparent';
    ctx.fillStyle='#fff'; ctx.textBaseline='middle'; ctx.fillText(label,bx+padX,by+bh/2+2); ctx.textBaseline='alphabetic'; setLS(ctx,'0px');
  }

  function loadFile(file, cb){ const im=new Image(); im.onload=()=>cb(im); im.src=URL.createObjectURL(file); }

  $('fotoInp')?.addEventListener('change', e => { const f=e.target.files[0]; if(!f)return; fotoFile=f; loadFile(f, im=>{ postImg=im; $('fotoUp').classList.add('set'); $('fotoTxt').textContent='✅ Foto elegida — toca para cambiarla'; render(); }); });
  document.querySelectorAll('#presets .pchip').forEach(ch => ch.addEventListener('click', () => { document.querySelectorAll('#presets .pchip').forEach(c=>c.classList.remove('on')); ch.classList.add('on'); preset=ch.getAttribute('data-p'); render(); }));
  ['nombre','municipio','gancho','desc'].forEach(id => $(id)?.addEventListener('input', render));
  $('categoria')?.addEventListener('change', render);

  // 🔄 Nueva captura: limpia TODO para empezar un sitio nuevo
  function resetAll(){
    postImg=null; fotoFile=null; preset='vivo';
    ['nombre','municipio','gancho','desc'].forEach(id=>{ if($(id)) $(id).value=''; });
    if($('categoria')) $('categoria').value='naturaleza';
    if($('puntuacion')) $('puntuacion').value='82';
    document.querySelectorAll('#presets .pchip').forEach(c=>c.classList.toggle('on', c.getAttribute('data-p')==='vivo'));
    $('fotoUp')?.classList.remove('set'); if($('fotoTxt')) $('fotoTxt').innerHTML='① 📷 Captura / foto del sitio<br><small style="opacity:.65;text-transform:none;letter-spacing:0">será la imagen del post</small>';
    $('capUp')?.classList.remove('set'); if($('capTxt')) $('capTxt').innerHTML='② 📝 Captura del texto<br><small style="opacity:.65;text-transform:none;letter-spacing:0">la leo y relleno la descripción</small>';
    if($('fotoInp')) $('fotoInp').value=''; if($('capInp')) $('capInp').value='';
    const m=$('msg'); if(m){ m.className='msg'; m.textContent=''; }
    render(); window.scrollTo(0,0);
  }
  $('reset')?.addEventListener('click', resetAll);

  $('limpiar')?.addEventListener('click', () => {
    let t=$('desc').value||''; t=t.replace(/#\S+/g,'').replace(/@\S+/g,'').replace(/https?:\/\/\S+/g,'');
    t=t.replace(/[📍✨🌊🏖️⛰️🌅😍🔥👇➡️•·|]+/gu,' ').replace(/\n{2,}/g,'\n').replace(/[ \t]{2,}/g,' ').trim();
    $('desc').value=t; render();
  });

  // 📋 Copiar pie para Instagram: encabezado con municipio + descripción + enlace + hashtags
  function slug(s){ return (s||'').normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[^A-Za-z0-9]/g,''); }
  function buildCaption(){
    const nombre=($('nombre')?.value||'').trim(), muni=($('municipio')?.value||'').trim(), desc=($('desc')?.value||'').trim();
    const cab = nombre ? `📍 ${nombre}${muni?` — ${muni}`:''}` : (muni?`📍 ${muni}`:'');
    const tagMuni = muni ? ' #'+slug(muni) : '';
    return [ cab, cab?'':null, desc, '', '👉 Descúbrelo en rankingspain.com', `#España #turismo #viajar #escapada${tagMuni}` ].filter(x=>x!==null).join('\n');
  }
  $('copiar')?.addEventListener('click', async e => {
    const btn=e.target; const desc=($('desc')?.value||'').trim();
    if(desc.length<10){ showMsg('Primero genera o escribe la descripción.', false); return; }
    const cap=buildCaption();
    try{ await navigator.clipboard.writeText(cap); }
    catch(_){ const ta=document.createElement('textarea'); ta.value=cap; document.body.appendChild(ta); ta.select(); try{document.execCommand('copy');}catch(__){} ta.remove(); }
    const o=btn.textContent; btn.textContent='✓ Copiado — pégalo en Instagram'; setTimeout(()=>btn.textContent=o,1800);
  });

  // 🖼️ Generar texto mirando la FOTO del sitio (cuando no hay captura de texto)
  $('genfoto')?.addEventListener('click', async e => {
    const btn=e.target;
    if(!fotoFile){ showMsg('Primero sube la ① foto del sitio.', false); return; }
    const nombre=($('nombre')?.value||'').trim(), municipio=($('municipio')?.value||'').trim();
    const pista=[nombre?('nombre: '+nombre):'', municipio?('municipio: '+municipio):''].filter(Boolean).join(', ');
    const old=btn.textContent; btn.textContent='Mirando la foto…'; btn.disabled=true;
    const ctrl=new AbortController(); const to=setTimeout(()=>ctrl.abort(),45000);
    try{
      const dataURL=await fileToScaledDataURL(fotoFile,1400);
      const r=await fetch('/api/admin/leer-captura?key='+encodeURIComponent(key), { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ imageBase64:dataURL, mediaType:'image/jpeg', modo:'foto', pista }), signal:ctrl.signal });
      const d=await r.json();
      if(d.ok){
        if(d.nombre && !nombre) $('nombre').value=d.nombre;
        if(d.municipio && !municipio) $('municipio').value=d.municipio;
        if(d.gancho) $('gancho').value=d.gancho;
        if(d.descripcion) $('desc').value=d.descripcion;
        render();
        const falta=(!($('municipio').value||'').trim())?' Escribe tú el municipio (la foto sola no basta para saberlo).':'';
        showMsg('Texto generado a partir de la foto. Revísalo y ajústalo.'+falta, true);
      } else showMsg('⚠️ '+(d.error||'No se pudo generar el texto.'), false);
    }catch(err){ showMsg(err&&err.name==='AbortError' ? 'Tardó demasiado, prueba otra vez.' : 'Error de red al generar el texto.', false); }
    finally{ clearTimeout(to); btn.textContent=old; btn.disabled=false; }
  });

  // fichero -> dataURL JPEG REDUCIDO (móvil sube capturas enormes: escalamos para que vaya rápido y barato)
  function fileToScaledDataURL(file, maxDim){ return new Promise((res,rej)=>{ const im=new Image(); im.onload=()=>{ try{ let w=im.width,h=im.height; const s=Math.min(1, maxDim/Math.max(w,h)); w=Math.round(w*s); h=Math.round(h*s); const c=document.createElement('canvas'); c.width=w; c.height=h; c.getContext('2d').drawImage(im,0,0,w,h); res(c.toDataURL('image/jpeg',0.82)); }catch(err){ rej(err); } }; im.onerror=()=>rej(new Error('img')); im.src=URL.createObjectURL(file); }); }

  // Lee la captura del texto con Claude Vision: saca nombre/municipio y REESCRIBE la descripción en nuestro estilo
  $('capInp')?.addEventListener('change', async e => {
    const f=e.target.files[0]; if(!f) return;
    $('capUp').classList.add('set'); $('capTxt').innerHTML='② 📝 Leyendo la captura con Claude…';
    const ctrl = new AbortController(); const to = setTimeout(()=>ctrl.abort(), 45000);
    try{
      const dataURL = await fileToScaledDataURL(f, 1400);
      const r = await fetch('/api/admin/leer-captura?key='+encodeURIComponent(key), { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ imageBase64:dataURL, mediaType:'image/jpeg' }), signal:ctrl.signal });
      const d = await r.json();
      if(d.ok){
        if(d.nombre) $('nombre').value=d.nombre;
        if(d.municipio) $('municipio').value=d.municipio;
        if(d.gancho) $('gancho').value=d.gancho;
        if(d.descripcion) $('desc').value=d.descripcion;
        $('capTxt').innerHTML='② ✅ Leído y reescrito — revísalo abajo'; render();
        showMsg('Descripción reescrita en nuestro estilo. Revísala y ajusta lo que quieras antes de guardar.', true);
      } else {
        $('capTxt').innerHTML='② ⚠️ No pude leerla — pega el texto abajo';
        showMsg('⚠️ '+(d.error||'No se pudo leer la captura.'), false);
      }
    }catch(err){ $('capTxt').innerHTML='② ⚠️ Error — pega el texto abajo'; showMsg(err&&err.name==='AbortError' ? 'La lectura tardó demasiado. Prueba otra vez o pega el texto a mano.' : 'Error de red al leer la captura. Copia el texto en tu móvil y pégalo en la descripción.', false); }
    finally{ clearTimeout(to); e.target.value=''; }
  });

  function showMsg(t, isOk){ const m=$('msg'); m.textContent=t; m.className='msg '+(isOk?'ok':'err'); }

  function dataURLtoBlob(durl){ const p=durl.split(','); const mime=(p[0].match(/:(.*?);/)||[])[1]||'image/png'; const bin=atob(p[1]); const n=bin.length; const u8=new Uint8Array(n); for(let i=0;i<n;i++) u8[i]=bin.charCodeAt(i); return new Blob([u8],{type:mime}); }

  $('descargar')?.addEventListener('click', async () => {
    render();
    const fname=(( $('municipio')?.value||'post').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'')||'post')+'-rankingspain.png';
    // toBlob SINCRONO desde dataURL para no perder el "gesto" del usuario (iOS es exigente)
    const durl=$('post').toDataURL('image/png');
    const blob=dataURLtoBlob(durl);
    const file=new File([blob],fname,{type:'image/png'});
    // 1) Compartir nativo del móvil: permite "Guardar imagen" en Fotos o enviar a Instagram
    if(navigator.canShare && navigator.canShare({files:[file]})){
      try{ await navigator.share({files:[file], title:'Ranking Spain'}); return; }
      catch(err){ if(err && err.name==='AbortError') return; /* si falla, sigue al plan B */ }
    }
    // 2) Descarga clásica (ordenador y navegadores que la soporten)
    const url=URL.createObjectURL(blob);
    const a=document.createElement('a'); a.download=fname; a.href=url; document.body.appendChild(a); a.click(); a.remove();
    setTimeout(()=>URL.revokeObjectURL(url),5000);
    showMsg('Si no se ha descargado, mantén pulsada la imagen del post de arriba y elige “Guardar imagen”.', true);
  });

  $('guardar')?.addEventListener('click', async e => {
    const btn=e.target; const municipio=($('municipio')?.value||'').trim(); const descripcion=($('desc')?.value||'').trim(); const nombre=($('nombre')?.value||'').trim();
    if(!municipio){ showMsg('Escribe el municipio antes de guardar.', false); return; }
    if(descripcion.length<20){ showMsg('La descripción es muy corta.', false); return; }
    const categoria=($('categoria')?.value||'naturaleza'); const puntuacion=Number($('puntuacion')?.value||0);
    btn.textContent='Guardando…'; btn.disabled=true;
    try{
      // la foto del sitio (reducida) para guardarla en la web junto al texto
      let foto=null; if(fotoFile){ try{ foto=await fileToScaledDataURL(fotoFile,1280); }catch(_){ foto=null; } }
      const r=await fetch('/api/admin/captura?key='+encodeURIComponent(key), { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ municipio, nombre, descripcion, categoria, puntuacion, foto }) });
      const d=await r.json();
      if(d.ok){
        const rk = d.rankea ? ` y rankea en ${d.categoria} con ${d.puntuacion} pts` : '';
        const ft = d.conFoto ? ' 📷 con foto' : '';
        showMsg(`✅ ${d.creado?'Sitio creado':'Actualizado'}${ft}: “${d.nombre}” en la ficha de ${d.municipio}${d.provincia?' ('+d.provincia+')':''}${rk}.`, true);
      }
      else showMsg('⚠️ '+(d.error||'No se pudo guardar.'), false);
    }catch(err){ showMsg('Error de red al guardar.', false); }
    finally{ btn.textContent='💾 Guardar en la web'; btn.disabled=false; }
  });

  render();
  // Redibuja cuando Plus Jakarta Sans esté lista (canvas necesita la fuente cargada)
  if(document.fonts && document.fonts.load){
    Promise.all([
      document.fonts.load('800 94px "Plus Jakarta Sans"'),
      document.fonts.load('700 40px "Plus Jakarta Sans"'),
      document.fonts.load('600 44px "Plus Jakarta Sans"')
    ]).then(()=>render()).catch(()=>{});
    document.fonts.ready.then(()=>render()).catch(()=>{});
  }
</script>
</body></html>
