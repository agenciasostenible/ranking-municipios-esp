---
/**
 * /admin/alimentar — "Añadir sitio a la web" desde el móvil.
 * Subes ① la captura del TEXTO (Claude la lee, la reescribe a nuestro estilo, la
 * amplía y propone categoría y puntuación) y ② la FOTO (opcional, se guarda tal
 * cual). Se publica en la ficha del municipio, en la sección que le corresponde.
 * NO genera post de Instagram: esto solo alimenta la web.
 */
const env = (k: string) =>
  (import.meta as any).env?.[k] ?? (typeof process !== 'undefined' ? (process as any).env[k] : undefined);
const key = Astro.url.searchParams.get('key') ?? '';
const ok = env('ADMIN_KEY') && key === env('ADMIN_KEY');

const CATS: { v: string; l: string }[] = [
  { v: 'naturaleza', l: '🌿 Naturaleza (parajes, bosques, montaña)' },
  { v: 'senderismo', l: '🥾 Rutas y senderos' },
  { v: 'Playas', l: '🏖️ Playas y calas' },
  { v: 'pozas', l: '💦 Pozas, cascadas y ríos' },
  { v: 'cuevas', l: '🕳️ Cuevas' },
  { v: 'miradores', l: '🌄 Miradores' },
  { v: 'gastronomia', l: '🍽️ Restaurantes y bares' },
  { v: 'hoteles_encanto', l: '🏨 Hoteles y alojamientos con encanto' },
  { v: 'TurismoRural', l: '🏡 Casas rurales' },
  { v: 'Campings', l: '⛺ Campings' },
  { v: 'festivales', l: '🎸 Festivales' },
  { v: 'fiestas', l: '🎉 Fiestas populares' },
  { v: 'monumentos', l: '🏛️ Monumentos' },
  { v: 'castillos', l: '🏰 Castillos' },
  { v: 'museos', l: '🖼️ Museos' },
  { v: 'turismo_activo', l: '🧗 Turismo activo y aventura' },
  { v: 'ciclismo', l: '🚴 Rutas en bici' },
  { v: 'vinos', l: '🍷 Bodegas y enoturismo' },
  { v: 'oleoturismo', l: '🫒 Oleoturismo' },
  { v: 'balnearios', l: '♨️ Balnearios' },
  { v: 'turismo_religioso', l: '⛪ Turismo religioso' },
  { v: 'estrellas', l: '✨ Astroturismo' },
];
---
<html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Añadir sitio a la web</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<style>
  :root{ --rausch:#FF385C; --line:#e7dfd3; --muted:#8a7f70; --ok:#0a7d3c; }
  *{ box-sizing:border-box; }
  body{ margin:0; font-family:"Plus Jakarta Sans","Helvetica Neue",Arial,system-ui,sans-serif; background:#faf8f5; color:#171412; }
  .bar{ padding:13px 16px; border-bottom:1px solid var(--line); display:flex; align-items:center; gap:12px; }
  .bar h1{ font-size:16px; margin:0; font-weight:800; letter-spacing:-.02em; }
  .bar a{ font-size:20px; color:#171412; text-decoration:none; }
  .bar button{ margin-left:auto; font:inherit; font-size:13px; font-weight:700; padding:8px 12px; border-radius:10px; border:1px solid #d9cfc0; background:#fff; cursor:pointer; }
  .wrap{ max-width:560px; margin:0 auto; padding:16px; display:flex; flex-direction:column; gap:14px; }
  .intro{ font-size:13.5px; color:var(--muted); line-height:1.5; }
  label.fld{ display:flex; flex-direction:column; gap:5px; font-size:12px; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); font-weight:700; }
  input[type=text], input[type=number], textarea, select{ font:inherit; font-size:16px; padding:11px 12px; border-radius:11px; border:1px solid #d9cfc0; background:#fff; width:100%; color:#171412; text-transform:none; letter-spacing:0; }
  textarea{ min-height:150px; resize:vertical; }
  .up{ display:block; text-align:center; padding:22px 12px; border:2px dashed #d9cfc0; border-radius:14px; color:var(--muted); font-size:14px; cursor:pointer; background:#fff; }
  .up.set{ border-style:solid; color:#171412; }
  input[type=file]{ display:none; }
  .row{ display:flex; gap:8px; flex-wrap:wrap; }
  .btn{ font:inherit; font-size:15px; padding:12px 14px; border-radius:12px; border:1px solid #d9cfc0; background:#fff; cursor:pointer; flex:1; text-align:center; font-weight:600; }
  .btn.primary{ background:var(--rausch); color:#fff; border:0; font-weight:700; }
  .btn.ok{ background:var(--ok); color:#fff; border:0; font-weight:700; }
  .msg{ font-size:14px; padding:11px 13px; border-radius:11px; display:none; line-height:1.5; }
  .msg.ok{ background:#e4f4ea; color:#0a5c2c; display:block; }
  .msg.err{ background:#fbe6e6; color:#a12; display:block; }
  .msg a{ color:inherit; font-weight:700; }
  .prev{ display:none; width:100%; border-radius:12px; margin-top:8px; }
  .hint{ font-size:12.5px; color:var(--muted); line-height:1.45; }
  .noauth{ padding:60px 20px; text-align:center; color:var(--muted); }
</style></head>
<body>
{ !ok ? (
  <div class="noauth">Acceso restringido. Añade <code>?key=TU_CLAVE</code> a la URL.</div>
) : (
<div>
  <div class="bar"><a href={`/admin?key=${key}`}>←</a><h1>➕ Añadir sitio a la web</h1><button id="reset" type="button">🔄 Otro sitio</button></div>
  <div class="wrap">
    <input type="hidden" id="key" value={key} />
    <div class="intro">Sube la <b>captura del texto</b> y yo lo reescribo a nuestro estilo, lo amplío con lo que sepa del sitio y propongo categoría y puntuación. La <b>foto es opcional</b>. Se publica en la ficha del municipio, en su sección.</div>

    <div>
      <label class="up" id="capUp" for="capInp"><span id="capTxt">① 📝 Captura del texto<br><small style="opacity:.65">la leo y redacto la ficha</small></span></label>
      <input type="file" id="capInp" accept="image/*" />
    </div>
    <div>
      <label class="up" id="fotoUp" for="fotoInp"><span id="fotoTxt">② 📷 Foto del sitio <small style="opacity:.65">(opcional)</small></span></label>
      <input type="file" id="fotoInp" accept="image/*" />
      <img class="prev" id="fotoPrev" alt="" />
    </div>

    <label class="fld">Nombre del sitio
      <input type="text" id="nombre" placeholder="Ej: Cascada del Sorrosal" />
    </label>
    <label class="fld">Municipio
      <input type="text" id="municipio" placeholder="Ej: Broto" />
    </label>
    <div class="row">
      <label class="fld" style="flex:2">Sección de la ficha
        <select id="categoria">
          {CATS.map((c) => <option value={c.v}>{c.l}</option>)}
        </select>
      </label>
      <label class="fld" style="flex:1">Puntos
        <input type="number" id="puntuacion" min="0" max="100" step="1" value="90" />
      </label>
    </div>
    <div class="hint" style="margin-top:-6px">El municipio sube en esa categoría con estos puntos (nunca baja los que ya tenga). Los sitios al aire libre puntúan también en Naturaleza.</div>

    <label class="fld">Descripción (la que se publica)
      <textarea id="desc" placeholder="Saldrá aquí al leer la captura; puedes retocarla"></textarea>
    </label>
    <label class="fld">Enlace web oficial <span style="text-transform:none;font-weight:400;color:#b3a690">— opcional</span>
      <input type="text" id="enlace" placeholder="https://…" />
    </label>
    <div class="hint" style="margin-top:-6px">El botón “Ver en Google Maps” se genera solo en la ficha con el nombre y el municipio.</div>

    <div class="msg" id="msg"></div>
    <div class="row">
      <button class="btn ok" type="button" id="guardar">✅ Publicar en la web</button>
    </div>
  </div>
</div>
) }

<script>
  const $ = (id) => document.getElementById(id);
  const key = $('key')?.value || '';
  let fotoFile = null;

  function showMsg(html, isOk){ const m=$('msg'); m.innerHTML=html; m.className='msg '+(isOk?'ok':'err'); }

  // reduce la imagen antes de enviarla (las capturas del móvil pesan mucho)
  function fileToScaledDataURL(file, maxDim){
    return new Promise((res,rej)=>{ const im=new Image();
      im.onload=()=>{ try{ let w=im.width,h=im.height; const s=Math.min(1,maxDim/Math.max(w,h));
        w=Math.round(w*s); h=Math.round(h*s); const c=document.createElement('canvas'); c.width=w; c.height=h;
        c.getContext('2d').drawImage(im,0,0,w,h); res(c.toDataURL('image/jpeg',0.82)); }catch(e){ rej(e); } };
      im.onerror=()=>rej(new Error('img')); im.src=URL.createObjectURL(file); });
  }

  // ① captura del texto → Claude redacta la ficha
  $('capInp')?.addEventListener('change', async (e) => {
    const f=e.target.files[0]; if(!f) return;
    $('capUp').classList.add('set'); $('capTxt').innerHTML='① 📝 Leyendo y redactando…';
    const ctrl=new AbortController(); const to=setTimeout(()=>ctrl.abort(),45000);
    try{
      const dataURL=await fileToScaledDataURL(f,1400);
      const pista=[($('nombre').value||'').trim() && ('nombre: '+$('nombre').value.trim()),
                   ($('municipio').value||'').trim() && ('municipio: '+$('municipio').value.trim())].filter(Boolean).join(', ');
      const r=await fetch('/api/admin/leer-captura?key='+encodeURIComponent(key), {
        method:'POST', headers:{'Content-Type':'application/json'},
        body:JSON.stringify({ imageBase64:dataURL, mediaType:'image/jpeg', modo:'ficha', pista }), signal:ctrl.signal });
      const d=await r.json();
      if(d.ok){
        if(d.nombre) $('nombre').value=d.nombre;
        if(d.municipio) $('municipio').value=d.municipio;
        if(d.descripcion) $('desc').value=d.descripcion;
        if(d.categoria && [...$('categoria').options].some(o=>o.value===d.categoria)) $('categoria').value=d.categoria;
        if(d.puntuacion) $('puntuacion').value=d.puntuacion;
        $('capTxt').innerHTML='① ✅ Ficha redactada — revísala abajo';
        showMsg('Texto reescrito y ampliado. Revisa la sección y los puntos antes de publicar.', true);
      } else {
        $('capTxt').innerHTML='① ⚠️ No pude leerla — escribe a mano';
        showMsg('⚠️ '+(d.error||'No se pudo leer la captura.'), false);
      }
    }catch(err){
      $('capTxt').innerHTML='① ⚠️ Error — escribe a mano';
      showMsg(err&&err.name==='AbortError' ? 'Tardó demasiado, prueba otra vez.' : 'Error de red al leer la captura.', false);
    } finally { clearTimeout(to); e.target.value=''; }
  });

  // ② foto (opcional)
  $('fotoInp')?.addEventListener('change', (e) => {
    const f=e.target.files[0]; if(!f) return;
    fotoFile=f; $('fotoUp').classList.add('set'); $('fotoTxt').innerHTML='② ✅ Foto elegida — toca para cambiarla';
    const p=$('fotoPrev'); p.src=URL.createObjectURL(f); p.style.display='block';
  });

  // publicar
  $('guardar')?.addEventListener('click', async (e) => {
    const btn=e.target;
    const municipio=($('municipio').value||'').trim(), nombre=($('nombre').value||'').trim();
    const descripcion=($('desc').value||'').trim(), categoria=$('categoria').value;
    const puntuacion=Number($('puntuacion').value||0), enlace=($('enlace').value||'').trim();
    if(!nombre){ showMsg('Falta el nombre del sitio.', false); return; }
    if(!municipio){ showMsg('Falta el municipio.', false); return; }
    if(descripcion.length<40){ showMsg('La descripción es muy corta (mínimo 40 caracteres).', false); return; }
    btn.disabled=true; btn.textContent='Publicando…';
    try{
      let foto=null; if(fotoFile){ try{ foto=await fileToScaledDataURL(fotoFile,1280); }catch(_){ foto=null; } }
      const r=await fetch('/api/admin/alimentar?key='+encodeURIComponent(key), {
        method:'POST', headers:{'Content-Type':'application/json'},
        body:JSON.stringify({ municipio, nombre, descripcion, categoria, puntuacion, foto, enlace }) });
      const d=await r.json();
      if(d.ok){
        showMsg(`✅ <b>${d.nombre}</b> publicado en <b>${d.municipio}</b> (${d.provincia}${d.comunidad?', '+d.comunidad:''})`
          + `${d.conFoto?' 📷 con foto':''}${d.rankea?` · puntúa ${d.puntuacion} en ${d.categoria}`:''}.<br>`
          + `<a href="${d.ficha}" target="_blank" rel="noopener">Ver la ficha →</a>`, true);
      } else showMsg('⚠️ '+(d.error||'No se pudo publicar.'), false);
    }catch(err){ showMsg('Error de red al publicar.', false); }
    finally{ btn.disabled=false; btn.textContent='✅ Publicar en la web'; }
  });

  // limpiar para el siguiente sitio
  $('reset')?.addEventListener('click', () => {
    fotoFile=null;
    ['nombre','municipio','desc','enlace'].forEach(id=>{ if($(id)) $(id).value=''; });
    $('puntuacion').value='90'; $('categoria').selectedIndex=0;
    $('capUp').classList.remove('set'); $('capTxt').innerHTML='① 📝 Captura del texto<br><small style="opacity:.65">la leo y redacto la ficha</small>';
    $('fotoUp').classList.remove('set'); $('fotoTxt').innerHTML='② 📷 Foto del sitio <small style="opacity:.65">(opcional)</small>';
    $('fotoPrev').style.display='none'; $('fotoPrev').src='';
    $('capInp').value=''; $('fotoInp').value='';
    $('msg').className='msg'; window.scrollTo(0,0);
  });
</script>
</body></html>
