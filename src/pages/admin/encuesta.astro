---
import { DB } from '../../lib/d1client';

const env = (k: string) =>
  (import.meta as any).env?.[k] ?? (typeof process !== 'undefined' ? (process as any).env[k] : undefined);

const key = Astro.url.searchParams.get('key') ?? '';
const ok = env('ADMIN_KEY') && key === env('ADMIN_KEY');

let pendientes: any[] = [];
let publicados: any[] = [];
if (ok) {
  pendientes = (await DB.prepare(
    `SELECT id, handle, sitio, provincia, frase, creado_at, (avatar_data IS NOT NULL) AS has_avatar
     FROM encuesta WHERE publicado=0 ORDER BY creado_at DESC`
  ).all()).results as any[];
  publicados = (await DB.prepare(
    `SELECT id, handle, sitio, provincia, frase, creado_at, (avatar_data IS NOT NULL) AS has_avatar
     FROM encuesta WHERE publicado=1 ORDER BY creado_at DESC`
  ).all()).results as any[];
}
const link = (id: any, accion: string) => `/api/encuesta-moderar?key=${encodeURIComponent(key)}&id=${id}&accion=${accion}`;
const img = (id: any) => `/api/og/encuesta/${id}`;
const fecha = (s: string) => (s ? String(s).slice(0, 10) : '');
---
<html lang="es">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Encuesta — recomendaciones de instagramers</title>
<style>
  body { font-family: system-ui, sans-serif; max-width: 820px; margin: 0 auto; padding: 24px 16px 60px; color: #222; background: #fafafa; }
  h1 { font-size: 1.5rem; } h2 { font-size: 1.1rem; margin-top: 32px; }
  .muted { color: #777; font-size: .9rem; }
  .card { background: #fff; border: 1px solid #e5e5e5; border-radius: 14px; padding: 16px; margin-bottom: 14px; display: flex; gap: 16px; }
  .thumb { width: 120px; flex-shrink: 0; }
  .thumb img { width: 120px; height: 213px; object-fit: cover; border-radius: 8px; border: 1px solid #eee; background: #f4f4f4; }
  .body { flex: 1; min-width: 0; }
  .head { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
  .av { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; background: #fdf0f6; }
  .av.ph { display: flex; align-items: center; justify-content: center; color: #d63384; font-weight: 800; }
  .h { color: #d63384; font-weight: 800; font-size: 1.02rem; text-decoration: none; }
  .sitio { font-size: 1.15rem; font-weight: 800; color: #222; margin: 4px 0; }
  .prov { color: #777; font-weight: 600; font-size: .9rem; }
  .frase { color: #555; font-style: italic; margin: 6px 0; font-size: .92rem; }
  .when { color: #999; font-size: .78rem; margin-top: 4px; }
  .acts { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 8px; }
  .acts a { display: inline-block; padding: 9px 15px; border-radius: 9px; text-decoration: none; font-weight: 700; font-size: .85rem; }
  .dl { background: #16a34a; color: #fff; }
  .pub { background: #fff; color: #2563eb; border: 1.5px solid #2563eb; }
  .unpub { background: #fff; color: #e8a200; border: 1.5px solid #e8a200; }
  .del { background: #fff; color: #dc2626; border: 1.5px solid #dc2626; }
  .ig { background: #fff; color: #444; border: 1.5px solid #ddd; }
  .empty { color: #999; padding: 16px 0; }
  .tip { background: #fdf0f6; border: 1px solid #f3b6d3; border-radius: 12px; padding: 12px 14px; font-size: .9rem; color: #8a2a5e; margin-bottom: 8px; }
  .tip code { background: #fff; padding: 1px 6px; border-radius: 5px; }
</style>
</head>
<body>
{!ok ? (
  <p>🔒 Acceso restringido. Añade <code>?key=TU_CLAVE</code> a la URL.</p>
) : (
  <>
    <h1>📸 Recomendaciones de instagramers</h1>
    <p class="tip">Enlace para compartir en tu bio/Stories: <code>{Astro.url.origin}/encuesta</code>. Pulsa <b>⬇️ Descargar imagen</b> para bajar el PNG vertical y publicarlo. Marca <b>✓ Publicado</b> cuando lo subas para no repetir.</p>

    <h2>Sin publicar ({pendientes.length})</h2>
    {pendientes.length === 0 && <p class="empty">No hay nada nuevo todavía.</p>}
    {pendientes.map((c) => (
      <div class="card">
        <div class="thumb"><img src={img(c.id)} alt={`Imagen de @${c.handle}`} loading="lazy" /></div>
        <div class="body">
          <div class="head">
            {c.has_avatar
              ? <img class="av" src={`/api/encuesta-foto?id=${c.id}`} alt="" />
              : <span class="av ph">{String(c.handle || '?')[0].toUpperCase()}</span>}
            <a class="h" href={`https://instagram.com/${c.handle}`} target="_blank" rel="noopener">@{c.handle}</a>
          </div>
          <div class="sitio">{c.sitio} {c.provincia && <span class="prov">· {c.provincia}</span>}</div>
          {c.frase && <div class="frase">“{c.frase}”</div>}
          <div class="when">{fecha(c.creado_at)}</div>
          <div class="acts">
            <a class="dl" href={`${img(c.id)}?dl=1`} download={`recomendacion-${c.handle}.png`}>⬇️ Descargar imagen</a>
            <a class="ig" href={`https://instagram.com/${c.handle}`} target="_blank" rel="noopener">Ver Instagram</a>
            <a class="pub" href={link(c.id, 'publicado')}>✓ Marcar publicado</a>
            <a class="del" href={link(c.id, 'borrar')} onclick="return confirm('¿Borrar esta recomendación?')">🗑️ Borrar</a>
          </div>
        </div>
      </div>
    ))}

    <h2>Ya publicados ({publicados.length})</h2>
    {publicados.length === 0 && <p class="empty">Aún no has marcado ninguno como publicado.</p>}
    {publicados.map((c) => (
      <div class="card" style="opacity:.78">
        <div class="thumb"><img src={img(c.id)} alt={`Imagen de @${c.handle}`} loading="lazy" /></div>
        <div class="body">
          <div class="head">
            {c.has_avatar
              ? <img class="av" src={`/api/encuesta-foto?id=${c.id}`} alt="" />
              : <span class="av ph">{String(c.handle || '?')[0].toUpperCase()}</span>}
            <a class="h" href={`https://instagram.com/${c.handle}`} target="_blank" rel="noopener">@{c.handle}</a>
          </div>
          <div class="sitio">{c.sitio} {c.provincia && <span class="prov">· {c.provincia}</span>}</div>
          {c.frase && <div class="frase">“{c.frase}”</div>}
          <div class="when">{fecha(c.creado_at)}</div>
          <div class="acts">
            <a class="dl" href={`${img(c.id)}?dl=1`} download={`recomendacion-${c.handle}.png`}>⬇️ Descargar de nuevo</a>
            <a class="unpub" href={link(c.id, 'nopublicado')}>↩︎ Marcar sin publicar</a>
            <a class="del" href={link(c.id, 'borrar')} onclick="return confirm('¿Borrar esta recomendación?')">🗑️ Borrar</a>
          </div>
        </div>
      </div>
    ))}
  </>
)}
</body>
</html>
