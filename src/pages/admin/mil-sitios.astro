---
import { DB } from '../../lib/d1client';
import SITIOS from '../../data/mil_sitios.json';
const env = (k: string) =>
  (import.meta as any).env?.[k] ?? (typeof process !== 'undefined' ? (process as any).env[k] : undefined);
const key = Astro.url.searchParams.get('key') ?? '';
const ok = env('ADMIN_KEY') && key === env('ADMIN_KEY');

const all = SITIOS as any[];
// temas únicos (clave -> etiqueta) ordenados por nº de sitios desc
const temaCount: Record<string, { label: string; n: number }> = {};
for (const s of all) { const t = temaCount[s.tema] ??= { label: s.temaLabel, n: 0 }; t.n++; }
const temas = Object.entries(temaCount).sort((a,b)=> b[1].n - a[1].n).map(([k,v])=>({ k, label:v.label, n:v.n }));

const tema = Astro.url.searchParams.get('tema') || (temas[0]?.k ?? 'escalada');
const idx  = Math.max(0, parseInt(Astro.url.searchParams.get('i') || '0'));
const HASH: Record<string,string> = {
  escalada:'escalada', ferrata:'viaferrata', surf:'surf', nieve:'nieve', barranquismo:'barranquismo',
  kayak:'kayak', buceo:'buceo', ciclismo:'cicloturismo', senderismo:'senderismo', montanismo:'montanismo',
  cuevas:'cuevas', cascadas:'cascadas', lagos:'lagos', montanas:'montanas', faros:'faros', playas:'playa',
  fauna:'fauna', caballo:'rutasacaballo', aire:'parapente', navegar:'navegar', noche:'astroturismo',
  trail:'trailrunning', camino:'caminodesantiago',
};

let cands: any[] = [], sel: any = null, foto = '', taglines: string[] = [], captionIG = '';
if (ok) {
  cands = all.filter(s => s.tema === tema);
  sel = cands[Math.min(idx, cands.length-1)] || null;
  if (sel) {
    const r = await DB.prepare(`SELECT foto_url FROM municipios WHERE codigo_ine=?`).bind(sel.codigo).first() as any;
    foto = /^https:\/\/upload\.wikimedia\.org\//.test(r?.foto_url || '') ? r.foto_url : '';
    const frase1 = (sel.descFull || '').split(/(?<=[.!?])\s/)[0].trim();
    taglines = [
      frase1 || sel.desc,
      `Uno de los mejores sitios de España para ${sel.para}.`,
      `¿Ya conocías ${sel.nombre}? ${frase1 || 'Un imprescindible.'}`,
      `Apúntalo para tu próxima escapada.`,
      sel.municipios && sel.municipios.length > 1 ? `Atraviesa ${sel.municipios.slice(0,4).join(', ')} y más.` : (frase1 || sel.desc),
    ].map(t => (t||'').replace(/\s+/g,' ').trim()).filter((t,i,a)=> t && a.indexOf(t)===i);
    const hash = HASH[tema] || 'espana';
    captionIG = [
      `📍 ${sel.nombre} — ${sel.municipio}${sel.provincia?` (${sel.provincia})`:''}`,
      '',
      sel.descFull || sel.desc,
      `\n✨ Perfecto para ${sel.para}`,
      `👉 Descúbrelo en rankingspain.com`,
      `\n#${hash} #España #turismo #viajar #escapada`,
    ].join('\n');
  }
}
const color = '#00897b';
---
<html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>1000 sitios · Redes</title>
<style>
  :root{ --rausch:#FF385C; }
  *{ box-sizing:border-box; }
  body{ margin:0; font-family:"Plus Jakarta Sans","Helvetica Neue",Arial,system-ui,sans-serif; background:#faf8f5; color:#171412; }
  .bar{ padding:14px 20px; border-bottom:1px solid #e7dfd3; display:flex; align-items:center; gap:16px; }
  .bar h1{ font-size:17px; margin:0; font-weight:800; letter-spacing:-.02em; }
  .bar a.back{ font-size:13px; color:#8a7f70; text-decoration:none; }
  .subtitle{ padding:10px 20px; font-size:13px; color:#8a7f70; border-bottom:1px solid #e7dfd3; background:#fff; }
  .layout{ display:flex; gap:26px; align-items:flex-start; padding:22px 20px 60px; flex-wrap:wrap; }
  .temas{ display:flex; flex-wrap:wrap; gap:7px; padding:14px 20px; background:#fff; border-bottom:1px solid #e7dfd3; }
  .tchip{ font-size:13px; padding:6px 12px; border-radius:999px; border:1px solid #d9cfc0; text-decoration:none; color:#171412; }
  .tchip.on{ background:var(--tc,#00897b); color:#fff; border-color:transparent; font-weight:700; }
  .tchip .c{ opacity:.6; font-size:11px; }
  .cell{ display:flex; flex-direction:column; gap:8px; }
  .cap{ display:flex; align-items:center; gap:10px; font-size:12px; color:#8a7f70; }
  .cap input[type=file]{ display:none; }
  .cap .up{ color:var(--rausch); cursor:pointer; text-decoration:underline; }
  .btn{ font:inherit; font-size:13px; padding:7px 11px; border-radius:9px; border:1px solid #d9cfc0; background:#fff; cursor:pointer; }
  .picker{ flex:1; min-width:240px; max-width:360px; }
  .picker h3{ font-size:11px; text-transform:uppercase; letter-spacing:.08em; color:#8a7f70; margin:0 0 8px; }
  .plist{ display:flex; flex-direction:column; gap:2px; max-height:440px; overflow:auto; }
  .plist a{ padding:8px 10px; border-radius:8px; text-decoration:none; font-size:13px; color:#171412; }
  .plist a.on{ font-weight:700; }
  .plist a .m{ color:#8a7f70; }

  .slide{ width:360px; height:450px; overflow:hidden; position:relative; color:#fff; box-shadow:0 12px 34px rgba(0,0,0,.18); }
  .slide .ph{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .scrim{ position:absolute; inset:0; background:linear-gradient(180deg,rgba(0,0,0,.5),rgba(0,0,0,.08) 42%,rgba(0,0,0,.86)); }
  .pad{ position:absolute; inset:0; padding:26px; display:flex; flex-direction:column; }
  .brand{ display:flex; align-items:center; gap:8px; font-weight:800; font-size:15px; }
  .dot{ width:18px; height:18px; border-radius:50%; background:var(--tc,#00897b); }
  .kick{ font-size:15px; letter-spacing:.14em; text-transform:uppercase; font-weight:800; color:var(--tc,#4fd1b5); }
  .name{ font-size:36px; font-weight:800; letter-spacing:-.03em; line-height:1.02; margin-top:8px; }
  .place{ font-size:15px; opacity:.92; margin-top:7px; }
  .tag{ font-size:15px; line-height:1.4; opacity:.9; margin-top:12px; }
  .foot{ margin-top:auto; font-size:12px; opacity:.75; }
  .noauth{ padding:60px; text-align:center; color:#8a7f70; }
</style></head>
<body>
{ !ok ? (
  <div class="noauth">Acceso restringido. Añade <code>?key=TU_ADMIN_KEY</code> a la URL.</div>
) : (
<div>
  <div class="bar"><h1>🗺️ 1000 sitios curados</h1><a class="back" href={`/admin?key=${key}`}>← Panel</a></div>
  <div class="subtitle">521 sitios de naturaleza muy curados, divididos por tema. Elige un tema y un sitio, y saca el post: “Sitio increíble para…”. Pulsa “✨ otra frase”, “cambiar foto” y “📋 copiar pie”.</div>

  <div class="temas">
    {temas.map(t => (
      <a class={`tchip ${t.k===tema?'on':''}`} style={`--tc:${color}`} href={`/admin/mil-sitios?key=${key}&tema=${t.k}&i=0`}>
        {t.label} <span class="c">{t.n}</span>
      </a>
    ))}
  </div>

  {sel && (
  <div class="layout">
    <div class="cell">
      <div class="slide" data-slide="spot" style={`--tc:${color}`}>
        {foto && <img class="ph" crossorigin="anonymous" src={foto} />}
        <div class="scrim"></div>
        <div class="pad">
          <div class="brand"><span class="dot"></span>rankingspain.com</div>
          <div style="margin-top:auto">
            <div class="kick">Sitio increíble para {sel.para}</div>
            <div class="name">{sel.nombre}</div>
            <div class="place">📍 {sel.municipio}{sel.provincia?` · ${sel.provincia}`:''}</div>
            <div class="tag" id="spot-tag">{taglines[0]}</div>
          </div>
          <div class="foot">rankingspain.com</div>
        </div>
      </div>
      <div class="cap">
        <span class="up" data-for="spot">cambiar foto</span>
        <input type="file" accept="image/*" data-file="spot" />
        <button class="btn" type="button" id="spot-frase">✨ otra frase</button>
        <button class="btn" type="button" id="spot-copiar">📋 copiar pie</button>
        <button class="btn" type="button" id="spot-dl">⬇ descargar</button>
      </div>
    </div>

    <div class="picker">
      <h3>Sitios de “{temaCount[tema]?.label}” ({cands.length})</h3>
      <div class="plist">
        {cands.map((c, i) => (
          <a class={i===Math.min(idx,cands.length-1)?'on':''} style={i===Math.min(idx,cands.length-1)?`background:${color}20;color:${color}`:''}
             href={`/admin/mil-sitios?key=${key}&tema=${tema}&i=${i}`}>
            {c.nombre} <span class="m">· {c.municipio}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
  )}
</div>
) }

<script type="application/json" id="postdata" set:html={JSON.stringify({ color, sel, foto, taglines, captionIG })}></script>
<script>
  const D = JSON.parse(document.getElementById('postdata')?.textContent || '{}');
  const FF = '"Helvetica Neue",Arial,sans-serif';
  const slug = (s) => (s||'post').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');

  document.querySelectorAll('.up').forEach(el => el.addEventListener('click', () =>
    document.querySelector(`input[data-file="${el.getAttribute('data-for')}"]`)?.click()));
  document.querySelectorAll('input[data-file]').forEach(inp => inp.addEventListener('change', () => {
    const f = inp.files?.[0]; if (!f) return;
    const slide = document.querySelector('.slide');
    let img = slide?.querySelector('img.ph');
    if (!img) { img = document.createElement('img'); img.className='ph'; slide?.insertBefore(img, slide.firstChild); }
    img.removeAttribute('crossorigin'); img.src = URL.createObjectURL(f);
  }));

  function loadImg(src){ return new Promise(res=>{ if(!src) return res(null); const im=new Image(); if(!src.startsWith('data:')&&!src.startsWith('blob:')) im.crossOrigin='anonymous'; im.onload=()=>res(im.naturalWidth?im:null); im.onerror=()=>res(null); im.src=src; setTimeout(()=>res(im.complete&&im.naturalWidth?im:null),5000); }); }
  function cover(ctx,im,W,H){ const ir=im.width/im.height,cr=W/H; let dw,dh,dx,dy; if(ir>cr){dh=H;dw=H*ir;dx=(W-dw)/2;dy=0;}else{dw=W;dh=W/ir;dx=0;dy=(H-dh)/2;} ctx.drawImage(im,dx,dy,dw,dh); }
  function rr(ctx,x,y,w,h,r){ ctx.beginPath(); ctx.moveTo(x+r,y); ctx.arcTo(x+w,y,x+w,y+h,r); ctx.arcTo(x+w,y+h,x,y+h,r); ctx.arcTo(x,y+h,x,y,r); ctx.arcTo(x,y,x+w,y,r); ctx.closePath(); }
  function wrap(ctx,text,maxW){ const words=(text||'').split(/\s+/),lines=[]; let line=''; for(const w of words){ const t=line?line+' '+w:w; if(ctx.measureText(t).width>maxW&&line){lines.push(line);line=w;}else line=t; } if(line)lines.push(line); return lines; }

  async function renderPNG(){
    const W=1080,H=1350,P=78,tc=D.color||'#00897b'; const s=D.sel||{};
    const cv=document.createElement('canvas'); cv.width=W; cv.height=H; const ctx=cv.getContext('2d');
    const domImg=document.querySelector('.slide img.ph');
    const im=await loadImg(domImg?.getAttribute('src')||D.foto||'');
    if(im) cover(ctx,im,W,H);
    else { const g=ctx.createLinearGradient(0,0,W*0.4,H); g.addColorStop(0,tc); g.addColorStop(0.85,'#12201c'); ctx.fillStyle=g; ctx.fillRect(0,0,W,H); }
    const g=ctx.createLinearGradient(0,0,0,H); g.addColorStop(0,'rgba(0,0,0,.5)'); g.addColorStop(.42,'rgba(0,0,0,.08)'); g.addColorStop(1,'rgba(0,0,0,.86)'); ctx.fillStyle=g; ctx.fillRect(0,0,W,H);
    ctx.shadowColor='rgba(0,0,0,.35)'; ctx.shadowBlur=10; ctx.shadowOffsetY=2; ctx.textBaseline='alphabetic';
    ctx.fillStyle=tc; ctx.beginPath(); ctx.arc(P+22,P+20,22,0,7); ctx.fill();
    ctx.fillStyle='#fff'; ctx.font=`bold 42px ${FF}`; ctx.fillText('rankingspain.com',P+58,P+34);
    ctx.font=`400 30px ${FF}`; ctx.fillStyle='rgba(255,255,255,.72)'; ctx.textAlign='right'; ctx.fillText('rankingspain.com',W-P,H-P-14); ctx.textAlign='left';
    const tag=(document.getElementById('spot-tag')?.textContent||(D.taglines||[])[0]||'').trim();
    let y=H-P-118;
    if(tag){ ctx.font=`400 40px ${FF}`; ctx.fillStyle='rgba(255,255,255,.90)'; const dl=wrap(ctx,tag,W-2*P).slice(0,4); for(let i=dl.length-1;i>=0;i--){ctx.fillText(dl[i],P,y);y-=50;} y-=8; }
    ctx.font=`400 40px ${FF}`; ctx.fillStyle='rgba(255,255,255,.92)'; ctx.fillText(`${s.municipio||''}${s.provincia?' · '+s.provincia:''}`,P,y); y-=22;
    ctx.font=`800 88px ${FF}`; ctx.fillStyle='#fff'; const nl=wrap(ctx,s.nombre||'',W-2*P); for(let i=nl.length-1;i>=0;i--){ctx.fillText(nl[i],P,y);y-=88;} y-=14;
    ctx.font=`800 34px ${FF}`; const kick=`SITIO INCREÍBLE PARA ${(s.para||'').toUpperCase()}`;
    // color del tema para el kicker
    const kl=wrap(ctx,kick,W-2*P); ctx.fillStyle=tc; for(let i=kl.length-1;i>=0;i--){ctx.fillText(kl[i],P,y);y-=40;}
    ctx.shadowColor='transparent';
    return cv;
  }
  document.getElementById('spot-dl')?.addEventListener('click', async (e)=>{
    const btn=e.currentTarget; btn.textContent='…';
    try{ const cv=await renderPNG(); const a=document.createElement('a'); a.download=`${slug((D.sel||{}).nombre)}-rankingspain.png`; a.href=cv.toDataURL('image/png'); a.click(); }
    catch(err){ alert('Error: '+err.message); } finally{ btn.textContent='⬇ descargar'; }
  });
  let ti=0;
  document.getElementById('spot-frase')?.addEventListener('click', ()=>{ const t=D.taglines||[]; if(!t.length)return; ti=(ti+1)%t.length; const el=document.getElementById('spot-tag'); if(el) el.textContent=t[ti]; });
  document.getElementById('spot-copiar')?.addEventListener('click', async (e)=>{
    const btn=e.currentTarget;
    try{ await navigator.clipboard.writeText(D.captionIG||''); }catch{ const ta=document.createElement('textarea'); ta.value=D.captionIG||''; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove(); }
    btn.textContent='✓ copiado'; setTimeout(()=>btn.textContent='📋 copiar pie',1500);
  });
</script>
</body></html>
