---
import { DB } from '../../lib/d1client';

const env = (k: string) =>
  (import.meta as any).env?.[k] ?? (typeof process !== 'undefined' ? (process as any).env[k] : undefined);

const key = Astro.url.searchParams.get('key') ?? '';
const ok = env('ADMIN_KEY') && key === env('ADMIN_KEY');

let ranking: any[] = [];
let totalVotos = 0;
if (ok) {
  ranking = (await DB.prepare(
    `SELECT codigo_ine, nombre, provincia, votos, updated_at
       FROM votos WHERE votos > 0
       ORDER BY votos DESC, nombre ASC`
  ).all()).results as any[];
  totalVotos = ranking.reduce((s, r) => s + Number(r.votos || 0), 0);
}
const fecha = (s: string) => (s ? String(s).slice(0, 16).replace('T', ' ') : '');
---
<html lang="es">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Voto del público — ranking completo</title>
<style>
  body { font-family: system-ui, sans-serif; max-width: 760px; margin: 0 auto; padding: 24px 16px 60px; color: #222; background: #fafafa; }
  h1 { font-size: 1.45rem; margin-bottom: 4px; }
  .sub { color: #777; font-size: .9rem; margin-bottom: 18px; }
  .stats { display: flex; gap: 12px; margin-bottom: 20px; }
  .stat { background: #fff; border: 1px solid #e5e5e5; border-radius: 12px; padding: 12px 18px; flex: 1; text-align: center; }
  .stat .n { font-size: 1.6rem; font-weight: 800; color: #FF385C; }
  .stat .l { font-size: .78rem; color: #777; }
  .tip { background: #fff1f3; border: 1px solid #f3b6c4; border-radius: 12px; padding: 11px 14px; font-size: .88rem; color: #c01c47; margin-bottom: 18px; }
  .tip code { background: #fff; padding: 1px 6px; border-radius: 5px; }
  table { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid #e5e5e5; border-radius: 12px; overflow: hidden; }
  th, td { padding: 10px 12px; text-align: left; font-size: .9rem; border-top: 1px solid #f0f0f0; }
  th { background: #f7f7f7; font-size: .76rem; text-transform: uppercase; letter-spacing: .03em; color: #666; }
  td.pos { width: 44px; font-weight: 800; color: #999; }
  td.votos { text-align: right; font-weight: 800; color: #FF385C; font-size: 1rem; }
  td a { color: #222; font-weight: 700; text-decoration: none; }
  td a:hover { color: #FF385C; }
  .prov { color: #888; font-weight: 500; font-size: .82rem; }
  .when { color: #bbb; font-size: .74rem; }
  .empty { color: #999; padding: 20px 0; }
  .refresh { display: inline-block; margin-bottom: 16px; color: #FF385C; font-weight: 700; text-decoration: none; font-size: .9rem; }
</style>
</head>
<body>
{!ok ? (
  <p>🔒 Acceso restringido. Añade <code>?key=TU_CLAVE</code> a la URL.</p>
) : (
  <>
    <h1>🏆 Voto del público</h1>
    <div class="sub">Ranking completo — todos los municipios que han recibido al menos un voto.</div>
    <p class="tip">Enlace para compartir: <code>{Astro.url.origin}/votar</code>. Recarga para ver el recuento actualizado (los datos son en directo).</p>
    <div class="stats">
      <div class="stat"><div class="n">{totalVotos.toLocaleString('es-ES')}</div><div class="l">Votos totales</div></div>
      <div class="stat"><div class="n">{ranking.length.toLocaleString('es-ES')}</div><div class="l">Municipios votados</div></div>
    </div>
    <a class="refresh" href={`/admin/votos?key=${encodeURIComponent(key)}`}>🔄 Refrescar</a>
    {ranking.length === 0 ? (
      <p class="empty">Todavía no hay votos.</p>
    ) : (
      <table>
        <thead><tr><th>#</th><th>Municipio</th><th style="text-align:right">Votos</th></tr></thead>
        <tbody>
          {ranking.map((r, i) => (
            <tr>
              <td class="pos">{i + 1}</td>
              <td>
                <a href={`/municipio/${r.codigo_ine}`} target="_blank" rel="noopener">{r.nombre}</a>
                <span class="prov"> · {r.provincia}</span>
                <div class="when">últ. {fecha(r.updated_at)}</div>
              </td>
              <td class="votos">{r.votos}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </>
)}
</body>
</html>
