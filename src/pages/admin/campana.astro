---
import { DB } from '../../lib/d1client';
const env = (k: string) =>
  (import.meta as any).env?.[k] ?? (typeof process !== 'undefined' ? (process as any).env[k] : undefined);
const key = Astro.url.searchParams.get('key') ?? '';
const ok = env('ADMIN_KEY') && key === env('ADMIN_KEY');

let stats = { total: 0, con_email: 0, enviados: 0, pendientes: 0, con_error: 0 };
if (ok) {
  const r = await DB.prepare(
    `SELECT
       COUNT(*) AS total,
       SUM(CASE WHEN email LIKE '%@%' THEN 1 ELSE 0 END) AS con_email,
       SUM(CASE WHEN email_enviado_at IS NOT NULL THEN 1 ELSE 0 END) AS enviados,
       SUM(CASE WHEN email LIKE '%@%' AND email_enviado_at IS NULL THEN 1 ELSE 0 END) AS pendientes,
       SUM(CASE WHEN email_error IS NOT NULL THEN 1 ELSE 0 END) AS con_error
     FROM ayuntamientos_contacto`
  ).first();
  stats = { ...stats, ...(r as any) };
}
const k = encodeURIComponent(key);
---
<html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Campaña ayuntamientos — Panel</title>
<style>
  body { font-family: system-ui, sans-serif; max-width: 640px; margin: 0 auto; padding: 20px 16px 60px; background: #fafafa; color: #222; }
  a.back { display: inline-flex; gap: 6px; text-decoration: none; color: #7c3aed; font-weight: 700; font-size: .88rem; background: #f3f0ff; border: 1.5px solid #e0d9ff; border-radius: 999px; padding: 7px 14px; margin-bottom: 16px; }
  h1 { font-size: 1.4rem; margin: 0 0 4px; }
  .sub { color: #777; font-size: .9rem; margin-bottom: 20px; }
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 22px; }
  .card { background: #fff; border: 1px solid #e5e5e5; border-radius: 12px; padding: 12px; text-align: center; }
  .card .n { font-size: 1.5rem; font-weight: 800; }
  .card .l { font-size: .72rem; color: #888; margin-top: 2px; }
  .card.env .n { color: #16a34a; }
  .card.pen .n { color: #d97706; }
  .box { background: #fff; border: 1px solid #e5e5e5; border-radius: 14px; padding: 18px; margin-bottom: 16px; }
  .box h2 { font-size: 1.05rem; margin: 0 0 6px; }
  .box p { font-size: .88rem; color: #666; margin: 0 0 14px; }
  button { font: inherit; font-weight: 700; border: none; border-radius: 10px; padding: 11px 18px; cursor: pointer; }
  .b-test { background: #222; color: #fff; }
  .b-real { background: #FF385C; color: #fff; }
  button:disabled { opacity: .5; cursor: default; }
  input[type=number] { font: inherit; width: 90px; padding: 10px; border: 1.5px solid #ddd; border-radius: 10px; }
  .row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .warn { background: #fff7ed; border: 1.5px solid #fed7aa; color: #9a3412; border-radius: 10px; padding: 11px 14px; font-size: .84rem; margin-bottom: 16px; }
  #out { font-size: .86rem; margin-top: 14px; white-space: pre-wrap; padding: 12px; border-radius: 10px; background: #f4f4f5; display: none; }
</style></head>
<body>
{!ok ? (
  <p>🔒 Acceso restringido. Añade <code>?key=TU_CLAVE</code> a la URL.</p>
) : (
  <>
    <a class="back" href={`/admin?key=${k}`}>← Panel principal</a>
    <h1>📣 Campaña ayuntamientos</h1>
    <div class="sub">Aviso a los ayuntamientos para que revisen su ficha. Se envía desde <b>info@rankingspain.com</b>.</div>

    <div class="grid">
      <div class="card"><div class="n">{stats.total}</div><div class="l">total</div></div>
      <div class="card"><div class="n">{stats.con_email}</div><div class="l">con email</div></div>
      <div class="card env"><div class="n">{stats.enviados}</div><div class="l">enviados</div></div>
      <div class="card pen"><div class="n">{stats.pendientes}</div><div class="l">pendientes</div></div>
    </div>

    <div class="warn">⚠️ El plan de Resend limita el volumen diario. Envía en tandas y ve viendo cómo llegan. Empieza SIEMPRE por una prueba a ti mismo.</div>

    <div class="box">
      <h2>1 · Prueba a ti mismo</h2>
      <p>Envía un correo de muestra (datos de Guadix) a tu propio buzón. No cuenta como enviado a nadie.</p>
      <button class="b-test" id="btnTest">Enviar prueba a mí</button>
    </div>

    <div class="box">
      <h2>2 · Enviar tanda real</h2>
      <p>Coge los próximos N ayuntamientos pendientes y les envía el correo de verdad. Máximo 100 por tanda.</p>
      <div class="row">
        <input type="number" id="lim" value="25" min="1" max="100" />
        <button class="b-real" id="btnReal">Enviar tanda</button>
      </div>
    </div>

    <div id="out"></div>

    <script is:inline define:vars={{ k }}>
      const out = document.getElementById('out');
      function show(txt) { out.style.display = 'block'; out.textContent = txt; }
      async function call(modo, limite) {
        const body = JSON.stringify({ modo, limite });
        const r = await fetch('/api/admin/campana?key=' + k, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body });
        return r.json();
      }
      document.getElementById('btnTest').onclick = async (e) => {
        e.target.disabled = true; show('Enviando prueba…');
        try { const j = await call('test'); show(j.ok ? '✅ Prueba enviada a ' + j.destino + '. Revisa tu bandeja.' : '❌ Error: ' + JSON.stringify(j)); }
        catch (err) { show('❌ ' + err.message); }
        e.target.disabled = false;
      };
      document.getElementById('btnReal').onclick = async (e) => {
        const limite = parseInt(document.getElementById('lim').value) || 25;
        if (!confirm('Vas a enviar el correo REAL a ' + limite + ' ayuntamientos. ¿Seguro?')) return;
        e.target.disabled = true; show('Enviando tanda de ' + limite + '…');
        try {
          const j = await call('real', limite);
          if (j.ok) { show('✅ Enviados: ' + j.enviados + (j.nota ? ' (' + j.nota + ')' : '') + '. Recarga para ver los contadores.'); }
          else { show('❌ Error: ' + JSON.stringify(j)); }
        } catch (err) { show('❌ ' + err.message); }
        e.target.disabled = false;
      };
    </script>
  </>
)}
</body></html>
