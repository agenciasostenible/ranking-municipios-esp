---
import { DB } from '../../lib/d1client';
import { TIPO_LABEL } from '../../lib/entidades';
import { ALL_CATS, LABELS } from '../../lib/db';
const env = (k: string) =>
  (import.meta as any).env?.[k] ?? (typeof process !== 'undefined' ? (process as any).env[k] : undefined);
const key = Astro.url.searchParams.get('key') ?? '';
const ok = env('ADMIN_KEY') && key === env('ADMIN_KEY');
const codigo = Astro.url.searchParams.get('codigo') ?? '';
const k = encodeURIComponent(key);

// Catálogo de categorías puntuables (para el editor de valoraciones)
const CATS = [
  { key: 'ranking_global', label: 'Ranking global' },
  ...ALL_CATS.map((c: any) => ({ key: c.key, label: c.label ?? LABELS[c.key] ?? c.key })),
].filter((c, i, a) => a.findIndex(x => x.key === c.key) === i);
const catLabel = (kk: string) => CATS.find(c => c.key === kk)?.label ?? LABELS[kk] ?? kk;

let muni: any = null; let ents: any[] = []; let scores: any[] = [];
if (ok && codigo) {
  muni = await DB.prepare(`SELECT codigo_ine, nombre, provincia FROM municipios WHERE codigo_ine=?`).bind(codigo).first();
  if (muni) {
    const { results } = await DB.prepare(
      `SELECT id, nombre, tipo, descripcion, enlace, latitud, longitud, foto_url, fuente, (foto_data IS NOT NULL) AS tiene_foto
       FROM entidades WHERE codigo_ine=? ORDER BY tipo, nombre`
    ).bind(codigo).all();
    ents = results as any[];
    const { results: sc } = await DB.prepare(
      `SELECT categoria, puntuacion, ranking_provincial, ranking_nacional FROM puntuaciones
       WHERE codigo_ine=? ORDER BY puntuacion DESC`
    ).bind(codigo).all();
    scores = sc as any[];
  }
}
const TIPOS = ['monumento','castillo','torre','iglesia','ermita','catedral','palacio','museo','mirador','espacio','sendero','playa','poza','castillo','fiesta','festival','gastronomia','restaurante','bar','cafeteria','vino','rural','camping','balneario','cueva','religioso','activo','mascotas','lgtbi','lujo','oleoturismo','ocio_nocturno','otro'];
---
<html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Editar ficha — Panel</title>
<style>
  body { font-family: system-ui, sans-serif; max-width: 820px; margin: 0 auto; padding: 20px 16px 80px; background: #fafafa; color: #222; }
  a.back { display: inline-flex; gap: 6px; text-decoration: none; color: #7c3aed; font-weight: 700; font-size: .88rem; background: #f3f0ff; border: 1.5px solid #e0d9ff; border-radius: 999px; padding: 7px 14px; margin-bottom: 16px; }
  h1 { font-size: 1.5rem; margin: 0 0 2px; }
  .sub { color: #777; font-size: .9rem; margin-bottom: 18px; }
  .search { display: flex; gap: 8px; margin-bottom: 8px; }
  .search input { flex: 1; padding: 12px 14px; border: 1.5px solid #ddd; border-radius: 12px; font-size: 1rem; }
  .ac { background: #fff; border: 1px solid #e5e5e5; border-radius: 12px; overflow: hidden; margin-bottom: 20px; }
  .ac a { display: block; padding: 11px 15px; text-decoration: none; color: #222; border-bottom: 1px solid #f2f2f2; font-weight: 600; }
  .ac a:hover { background: #fff1f3; }
  .ent { background: #fff; border: 1px solid #e5e5e5; border-radius: 14px; padding: 15px 16px; margin-bottom: 12px; }
  .ent-h { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  .ent-h .src { font-size: .7rem; color: #aaa; }
  .fld { display: block; font-size: .76rem; font-weight: 700; color: #555; margin: 10px 0 4px; }
  .ent input, .ent select, .ent textarea { width: 100%; box-sizing: border-box; padding: 9px 11px; border: 1.5px solid #ddd; border-radius: 9px; font-size: .9rem; font-family: inherit; }
  .row2 { display: flex; gap: 10px; }
  .row2 > div { flex: 1; }
  .fotorow { display: flex; align-items: center; gap: 12px; margin-top: 10px; }
  .fotorow img { width: 68px; height: 68px; object-fit: cover; border-radius: 10px; background: #f0f0f0; }
  .acts { display: flex; gap: 8px; margin-top: 12px; }
  .acts button, .acts a { border: none; cursor: pointer; font-weight: 700; font-size: .83rem; padding: 9px 15px; border-radius: 9px; text-decoration: none; }
  .b-save { background: #16a34a; color: #fff; }
  .b-del { background: #fff; color: #dc2626; border: 1.5px solid #f0b4b4 !important; }
  .b-maps { background: #eef; color: #2563eb; }
  .saved { color: #16a34a; font-weight: 700; font-size: .82rem; align-self: center; }
  .addbox { background: #f0fff4; border: 1.5px dashed #86efac; border-radius: 14px; padding: 16px; margin-top: 20px; }
  .addbox h3 { margin: 0 0 10px; font-size: 1rem; }
  .scorebox { background: #fffbeb; border: 1.5px solid #fde68a; border-radius: 14px; padding: 16px; margin: 0 0 24px; }
  .scorebox h3 { margin: 0 0 6px; font-size: 1rem; }
  .scorenote { font-size: .78rem; color: #7a6a3a; margin: 0 0 12px; line-height: 1.4; }
  .scorerow { display: flex; align-items: center; gap: 8px; padding: 6px 0; border-bottom: 1px solid #f3e9c6; flex-wrap: wrap; }
  .scorelbl { flex: 1; min-width: 130px; font-weight: 700; font-size: .85rem; }
  .scorecat { font-weight: 400; color: #b9a35a; font-size: .72rem; }
  .s-val { width: 78px; padding: 7px 8px; border: 1.5px solid #ddd; border-radius: 8px; font-size: .88rem; }
  .s-rank { font-size: .72rem; color: #8a7a45; min-width: 118px; }
  .s-save, .s-del { padding: 7px 11px !important; font-size: .8rem; }
  .scoreadd { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; align-items: center; }
  .scoreadd select { flex: 1; min-width: 160px; padding: 8px 10px; border: 1.5px solid #ddd; border-radius: 8px; font-size: .85rem; }
  .scoreadd input { width: 90px; padding: 8px 10px; border: 1.5px solid #ddd; border-radius: 8px; font-size: .85rem; }
</style></head>
<body>
{!ok ? (<p>🔒 Añade <code>?key=TU_CLAVE</code> a la URL.</p>) : (
<>
  <a class="back" href={`/admin?key=${k}`}>← Panel principal</a>
  {!muni ? (
    <>
      <h1>✏️ Editar ficha de un municipio</h1>
      <div class="sub">Busca el municipio cuya ficha quieres editar.</div>
      <div class="search"><input id="mbuscar" type="text" placeholder="Escribe un municipio… (Maracena, Granada…)" autocomplete="off" /></div>
      <div class="ac" id="mac"></div>
      <script is:inline define:vars={{ k }}>
        var inp=document.getElementById('mbuscar'), ac=document.getElementById('mac'), t;
        inp.addEventListener('input',function(){var q=inp.value.trim();clearTimeout(t);if(q.length<2){ac.innerHTML='';return;}
          t=setTimeout(function(){fetch('/api/search?q='+encodeURIComponent(q)).then(function(r){return r.json();}).then(function(d){
            ac.innerHTML=(d||[]).filter(function(x){return x.tipo==='municipio';}).slice(0,8).map(function(m){
              return '<a href="/admin/municipio?key='+k+'&codigo='+m.codigo_ine+'">'+m.nombre+' <span style=\"color:#999;font-weight:400\">'+(m.provincia||'')+'</span></a>';}).join('');
          });},180);
        });
      </script>
    </>
  ) : (
    <>
      <h1>✏️ {muni.nombre}</h1>
      <div class="sub">{muni.provincia} · {ents.length} sitios en la ficha. Edita, elimina o añade. <a href={`/municipio/${muni.codigo_ine}`} target="_blank" style="color:#FF385C">Ver ficha pública ↗</a></div>

      <!-- ── Valoraciones / puntuaciones por categoría ── -->
      <div class="scorebox">
        <h3>⭐ Valoraciones (puntuación 0–100)</h3>
        <p class="scorenote">Modifica la valoración de cualquier categoría o añade una nueva. Al guardar se recalcula el puesto de <strong>{muni.nombre}</strong> en su provincia y en España. El <em>ranking global</em> ponderado se recalcula aparte.</p>
        {scores.map((s: any) => (
          <div class="scorerow" data-cat={s.categoria}>
            <div class="scorelbl">{catLabel(s.categoria)} <span class="scorecat">{s.categoria}</span></div>
            <input class="s-val" type="number" min="0" max="100" step="0.1" value={Number(s.puntuacion).toFixed(1)} />
            <span class="s-rank">#{s.ranking_provincial ?? '—'} prov · #{s.ranking_nacional ?? '—'} Esp</span>
            <button class="b-save s-save" type="button">💾</button>
            <a class="b-del s-del" href={`/api/entidad-admin?key=${k}&accion=score-eliminar&codigo=${muni.codigo_ine}&categoria=${s.categoria}`} onclick="return confirm('¿Borrar esta valoración?')">🗑</a>
            <span class="saved s-ok" hidden>✓</span>
          </div>
        ))}
        <div class="scoreadd">
          <select id="s-newcat">{CATS.map((c: any) => <option value={c.key}>{c.label} ({c.key})</option>)}</select>
          <input id="s-newval" type="number" min="0" max="100" step="0.1" placeholder="0–100" />
          <button id="s-newsave" class="b-save" type="button">➕ Añadir valoración</button>
        </div>
      </div>

      {ents.map((e) => (
        <div class="ent" data-id={e.id}>
          <div class="ent-h"><strong>{TIPO_LABEL[e.tipo] ?? e.tipo}</strong><span class="src">{e.fuente}</span></div>
          <label class="fld">Nombre</label>
          <input class="f-nombre" value={e.nombre} />
          <div class="row2">
            <div><label class="fld">Tipo</label>
              <select class="f-tipo">{[...new Set([e.tipo, ...TIPOS])].map(tp => <option value={tp} selected={tp===e.tipo}>{tp}</option>)}</select>
            </div>
            <div><label class="fld">Enlace (web / Google Maps)</label><input class="f-enlace" value={e.enlace ?? ''} placeholder="https://…" /></div>
          </div>
          <label class="fld">Descripción</label>
          <textarea class="f-desc" rows="3">{e.descripcion ?? ''}</textarea>
          <div class="row2">
            <div><label class="fld">Latitud</label><input class="f-lat" value={e.latitud ?? ''} /></div>
            <div><label class="fld">Longitud</label><input class="f-lon" value={e.longitud ?? ''} /></div>
          </div>
          <div class="fotorow">
            <img class="f-prev" src={e.tiene_foto ? `/api/entidad-foto?id=${e.id}` : (e.foto_url && e.foto_url !== 'NONE' ? e.foto_url : '')} alt="" />
            <div><label class="fld" style="margin:0 0 4px">Subir/cambiar foto</label><input class="f-foto" type="file" accept="image/*" /></div>
          </div>
          <div class="acts">
            <button class="b-save" type="button">💾 Guardar</button>
            <a class="b-del" href={`/api/entidad-admin?key=${k}&accion=eliminar&id=${e.id}`} onclick="return confirm('¿Eliminar este sitio de la ficha?')">🗑 Eliminar</a>
            <span class="saved" hidden>✓ Guardado</span>
          </div>
        </div>
      ))}

      <div class="addbox">
        <h3>➕ Añadir un sitio nuevo a {muni.nombre}</h3>
        <label class="fld">Nombre</label><input id="a-nombre" placeholder="Ej: Castillo de…" />
        <div class="row2">
          <div><label class="fld">Tipo</label><select id="a-tipo">{TIPOS.map(tp => <option value={tp}>{tp}</option>)}</select></div>
          <div><label class="fld">Enlace</label><input id="a-enlace" placeholder="https://…" /></div>
        </div>
        <label class="fld">Descripción</label><textarea id="a-desc" rows="3"></textarea>
        <div class="row2"><div><label class="fld">Latitud</label><input id="a-lat" /></div><div><label class="fld">Longitud</label><input id="a-lon" /></div></div>
        <div class="fotorow"><img id="a-prev" src="" alt="" /><div><label class="fld" style="margin:0 0 4px">Foto</label><input id="a-foto" type="file" accept="image/*" /></div></div>
        <div class="acts"><button id="a-save" class="b-save" type="button">➕ Añadir sitio</button></div>
      </div>

      <script is:inline define:vars={{ k, codigo: muni.codigo_ine }}>
        function comprimir(file, cb){
          var img=new Image();
          img.onload=function(){var max=1200,q=0.82;
            function render(){var w=img.width,h=img.height;if(w>max||h>max){var r=Math.min(max/w,max/h);w=Math.round(w*r);h=Math.round(h*r);}
              var c=document.createElement('canvas');c.width=w;c.height=h;c.getContext('2d').drawImage(img,0,0,w,h);return c.toDataURL('image/jpeg',q);}
            var d=render();while(d.length>1400000&&(q>0.42||max>640)){if(q>0.46)q-=0.1;else max=Math.round(max*0.85);d=render();}cb(d);};
          img.src=URL.createObjectURL(file);
        }
        // preview al elegir foto
        document.querySelectorAll('.f-foto, #a-foto').forEach(function(inp){
          inp.addEventListener('change',function(e){var f=e.target.files[0];if(!f)return;
            comprimir(f,function(d){inp._data=d;var prev=inp.closest('.ent, .addbox').querySelector('.f-prev, #a-prev');if(prev)prev.src=d;});});
        });
        // guardar entidad
        document.querySelectorAll('.ent').forEach(function(row){
          row.querySelector('.b-save').addEventListener('click',function(){
            var btn=this;btn.disabled=true;btn.textContent='Guardando…';
            fetch('/api/entidad-admin?key='+k+'&accion=editar',{method:'POST',headers:{'Content-Type':'application/json'},
              body:JSON.stringify({id:row.dataset.id,nombre:row.querySelector('.f-nombre').value,tipo:row.querySelector('.f-tipo').value,
                descripcion:row.querySelector('.f-desc').value,enlace:row.querySelector('.f-enlace').value,
                latitud:row.querySelector('.f-lat').value,longitud:row.querySelector('.f-lon').value,
                foto:row.querySelector('.f-foto')._data||null})})
              .then(function(r){return r.json();}).then(function(j){btn.disabled=false;btn.textContent='💾 Guardar';
                if(j.ok){var s=row.querySelector('.saved');s.hidden=false;setTimeout(function(){s.hidden=true;},2000);}else alert('Error al guardar');});
          });
        });
        // añadir
        document.getElementById('a-save').addEventListener('click',function(){
          var n=document.getElementById('a-nombre').value.trim();if(!n){alert('Pon un nombre');return;}
          var btn=this;btn.disabled=true;btn.textContent='Añadiendo…';
          fetch('/api/entidad-admin?key='+k+'&accion=crear',{method:'POST',headers:{'Content-Type':'application/json'},
            body:JSON.stringify({codigo_ine:codigo,nombre:n,tipo:document.getElementById('a-tipo').value,
              descripcion:document.getElementById('a-desc').value,enlace:document.getElementById('a-enlace').value,
              latitud:document.getElementById('a-lat').value,longitud:document.getElementById('a-lon').value,
              foto:document.getElementById('a-foto')._data||null})})
            .then(function(r){return r.json();}).then(function(j){if(j.ok)location.reload();else{alert('Error al añadir');btn.disabled=false;btn.textContent='➕ Añadir sitio';}});
        });
        // guardar valoración existente
        function saveScore(cat,val,cb){
          fetch('/api/entidad-admin?key='+k+'&accion=score',{method:'POST',headers:{'Content-Type':'application/json'},
            body:JSON.stringify({codigo_ine:codigo,categoria:cat,puntuacion:val})})
            .then(function(r){return r.json();}).then(cb).catch(function(){cb({ok:false});});
        }
        document.querySelectorAll('.scorerow').forEach(function(row){
          row.querySelector('.s-save').addEventListener('click',function(){
            var v=parseFloat(row.querySelector('.s-val').value);
            if(isNaN(v)){alert('Pon un número 0–100');return;}
            var btn=this;btn.disabled=true;
            saveScore(row.dataset.cat,v,function(j){btn.disabled=false;
              if(j.ok){var o=row.querySelector('.s-ok');o.hidden=false;
                row.querySelector('.s-rank').textContent='#'+(j.ranking_provincial||'—')+' prov · #'+(j.ranking_nacional||'—')+' Esp';
                setTimeout(function(){o.hidden=true;},1800);}else alert('Error al guardar');});
          });
        });
        // añadir valoración nueva
        document.getElementById('s-newsave').addEventListener('click',function(){
          var cat=document.getElementById('s-newcat').value;
          var v=parseFloat(document.getElementById('s-newval').value);
          if(isNaN(v)){alert('Pon un número 0–100');return;}
          var btn=this;btn.disabled=true;btn.textContent='Añadiendo…';
          saveScore(cat,v,function(j){if(j.ok)location.reload();else{alert('Error al añadir valoración');btn.disabled=false;btn.textContent='➕ Añadir valoración';}});
        });
      </script>
    </>
  )}
</>
)}
</body></html>
