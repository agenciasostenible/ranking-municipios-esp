---
import { DB } from '../../lib/d1client';
const env = (k: string) =>
  (import.meta as any).env?.[k] ?? (typeof process !== 'undefined' ? (process as any).env[k] : undefined);
const key = Astro.url.searchParams.get('key') ?? '';
const ok = env('ADMIN_KEY') && key === env('ADMIN_KEY');

let filas: any[] = [];
let stats = { total: 0, enviados: 0, pendientes: 0 };
if (ok) {
  const r = await DB.prepare(
    `SELECT c.codigo_ine, COALESCE(m.nombre, c.nombre_bdgel) AS nombre, m.provincia,
            c.instagram, c.ig_dm_enviado_at
       FROM ayuntamientos_contacto c
       LEFT JOIN municipios m ON m.codigo_ine = c.codigo_ine
      WHERE c.instagram IS NOT NULL AND c.instagram != ''
      ORDER BY m.provincia, nombre`
  ).all();
  filas = (r.results as any[]) || [];
  stats.total = filas.length;
  stats.enviados = filas.filter((f) => f.ig_dm_enviado_at).length;
  stats.pendientes = stats.total - stats.enviados;
}
const k = encodeURIComponent(key);
---
<html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Instagram ayuntamientos — Panel</title>
<style>
  body { font-family: system-ui, sans-serif; max-width: 680px; margin: 0 auto; padding: 20px 16px 60px; background: #fafafa; color: #222; }
  a.back { display: inline-flex; gap: 6px; text-decoration: none; color: #7c3aed; font-weight: 700; font-size: .88rem; background: #f3f0ff; border: 1.5px solid #e0d9ff; border-radius: 999px; padding: 7px 14px; margin-bottom: 16px; }
  h1 { font-size: 1.4rem; margin: 0 0 4px; }
  .sub { color: #777; font-size: .9rem; margin-bottom: 20px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 18px; }
  .card { background: #fff; border: 1px solid #e5e5e5; border-radius: 12px; padding: 12px; text-align: center; }
  .card .n { font-size: 1.5rem; font-weight: 800; }
  .card .l { font-size: .72rem; color: #888; margin-top: 2px; }
  .card.env .n { color: #16a34a; }
  .card.pen .n { color: #d97706; }
  .warn { background: #fff7ed; border: 1.5px solid #fed7aa; color: #9a3412; border-radius: 10px; padding: 11px 14px; font-size: .84rem; margin-bottom: 16px; }
  input[type=search] { font: inherit; width: 100%; padding: 11px 14px; border: 1.5px solid #ddd; border-radius: 12px; margin-bottom: 14px; box-sizing: border-box; }
  .item { background: #fff; border: 1px solid #e5e5e5; border-radius: 14px; padding: 12px 14px; margin-bottom: 10px; }
  .item.done { opacity: .55; background: #f6fef8; border-color: #bbf7d0; }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; }
  .nom { font-weight: 700; font-size: .95rem; }
  .prov { color: #999; font-weight: 400; font-size: .8rem; }
  .handles { margin: 6px 0 10px; display: flex; gap: 6px; flex-wrap: wrap; }
  .handles a { text-decoration: none; font-size: .82rem; font-weight: 700; color: #be185d; background: #fdf2f8; border: 1.5px solid #fbcfe8; border-radius: 999px; padding: 4px 11px; }
  .acts { display: flex; gap: 8px; flex-wrap: wrap; }
  .acts button { font: inherit; font-size: .8rem; font-weight: 700; border: none; border-radius: 9px; padding: 8px 13px; cursor: pointer; }
  .b-copy { background: #f4f4f5; color: #333; }
  .b-mark { background: #16a34a; color: #fff; }
  .b-unmark { background: #fff; color: #b91c1c; border: 1.5px solid #fecaca !important; }
  .when { font-size: .74rem; color: #16a34a; font-weight: 700; }
  .empty { text-align: center; color: #999; padding: 30px 0; }
</style></head>
<body>
{!ok ? (
  <p>🔒 Acceso restringido. Añade <code>?key=TU_CLAVE</code> a la URL.</p>
) : (
  <>
    <a class="back" href={`/admin?key=${k}`}>← Panel principal</a>
    <h1>📸 Instagram ayuntamientos</h1>
    <div class="sub">DMs a los ayuntamientos con cuenta de Instagram. El envío es manual: abre el perfil, copia el texto, envía y marca. Si escribes tú a alguno por tu cuenta, márcalo aquí también.</div>

    <div class="grid">
      <div class="card"><div class="n">{stats.total}</div><div class="l">con instagram</div></div>
      <div class="card env"><div class="n">{stats.enviados}</div><div class="l">DM enviado</div></div>
      <div class="card pen"><div class="n">{stats.pendientes}</div><div class="l">pendientes</div></div>
    </div>

    <div class="warn">⚠️ Instagram penaliza los envíos masivos: máximo <b>10-20 DMs al día</b>, con pausas y variando algo el texto. Las cuentas marcadas como <i>no_oficial_verificar</i> en el CSV pueden no ser del ayuntamiento.</div>

    <input type="search" id="buscar" placeholder="Buscar municipio…" />

    {filas.length === 0 && <div class="empty">No hay ayuntamientos con Instagram cargados todavía.</div>}
    {filas.map((f) => {
      const handles = String(f.instagram).split(';').filter(Boolean);
      return (
        <div class={`item ${f.ig_dm_enviado_at ? 'done' : ''}`} data-nombre={`${f.nombre} ${f.provincia || ''}`.toLowerCase()} data-codigo={f.codigo_ine}>
          <div class="top">
            <div class="nom">{f.nombre} <span class="prov">{f.provincia}</span></div>
            {f.ig_dm_enviado_at && <span class="when">✓ {String(f.ig_dm_enviado_at).slice(0, 10)}</span>}
          </div>
          <div class="handles">
            {handles.map((h) => <a href={`https://www.instagram.com/${h}/`} target="_blank" rel="noopener">@{h}</a>)}
          </div>
          <div class="acts">
            <button class="b-copy" data-copy={f.codigo_ine} data-muni={f.nombre}>📋 Copiar texto</button>
            {f.ig_dm_enviado_at
              ? <button class="b-unmark" data-mark={f.codigo_ine} data-to="0">✕ Desmarcar</button>
              : <button class="b-mark" data-mark={f.codigo_ine} data-to="1">✓ Marcar enviado</button>}
          </div>
        </div>
      );
    })}

    <script is:inline define:vars={{ k }}>
      const plantilla = (muni, codigo) =>
        `Hola 👋 Somos Ranking Spain (rankingspain.com): ordenamos los más de 8.000 municipios de España con datos verificados, no opiniones. ${muni} ya tiene su ficha pública con sus rankings por provincia y categoría: https://rankingspain.com/municipio/${codigo}\n\nComo nadie conoce ${muni} mejor que vosotros, nos encantaría que le echarais un vistazo. Si falta algo o hay que corregir, se hace en 2 minutos aquí: https://rankingspain.com/revisar/${codigo}\n\nEs gratuito y sin contrapartidas: solo queremos que el municipio esté bien representado. ¡Gracias! 🙌`;

      document.querySelectorAll('[data-copy]').forEach((b) => {
        b.onclick = async () => {
          await navigator.clipboard.writeText(plantilla(b.dataset.muni, b.dataset.copy));
          b.textContent = '✅ Copiado'; setTimeout(() => (b.textContent = '📋 Copiar texto'), 1600);
        };
      });
      document.querySelectorAll('[data-mark]').forEach((b) => {
        b.onclick = async () => {
          b.disabled = true;
          const r = await fetch('/api/admin/instagram-dm?key=' + k, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ codigo_ine: b.dataset.mark, enviado: b.dataset.to === '1' }),
          });
          const j = await r.json().catch(() => ({}));
          if (j.ok) location.reload(); else { alert('Error al guardar'); b.disabled = false; }
        };
      });
      document.getElementById('buscar').oninput = (e) => {
        const q = e.target.value.toLowerCase().trim();
        document.querySelectorAll('.item').forEach((it) => {
          it.style.display = !q || it.dataset.nombre.includes(q) ? '' : 'none';
        });
      };
    </script>
  </>
)}
</body></html>
