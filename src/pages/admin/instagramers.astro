---
import { DB } from '../../lib/d1client';

const env = (k: string) =>
  (import.meta as any).env?.[k] ?? (typeof process !== 'undefined' ? (process as any).env[k] : undefined);

const key = Astro.url.searchParams.get('key') ?? '';
const ok = env('ADMIN_KEY') && key === env('ADMIN_KEY');

let pendientes: any[] = [], aprobados: any[] = [];
let munisByInsta: Record<number, any[]> = {};

if (ok) {
  const allInsta = (await DB.prepare(
    `SELECT i.*, COUNT(im.id) AS n_munis
     FROM instagramers i
     LEFT JOIN instagramer_municipios im ON im.instagramer_id = i.id
     GROUP BY i.id ORDER BY i.orden ASC, i.seguidores DESC, i.creado_at DESC`
  ).all()).results as any[];

  pendientes = allInsta.filter((i) => i.verificado === 0);
  aprobados  = allInsta.filter((i) => i.verificado === 1);

  const allMunis = (await DB.prepare(
    `SELECT instagramer_id, nombre_sitio, provincia FROM instagramer_municipios ORDER BY id`
  ).all()).results as any[];

  for (const m of allMunis) {
    if (!munisByInsta[m.instagramer_id]) munisByInsta[m.instagramer_id] = [];
    munisByInsta[m.instagramer_id].push(m);
  }
}

const action = (id: number, accion: string) =>
  `/api/instagramers-moderar?key=${encodeURIComponent(key)}&id=${id}&accion=${accion}`;
const fecha = (s: string) => (s ? String(s).slice(0, 10) : '');
---
<html lang="es">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Admin — Instagramers</title>
<style>
  body { font-family: system-ui, sans-serif; max-width: 860px; margin: 0 auto; padding: 24px 16px 80px; color: #222; background: #fafafa; }
  h1 { font-size: 1.5rem; } h2 { font-size: 1.1rem; margin-top: 32px; border-bottom: 1px solid #eee; padding-bottom: 6px; }
  .muted { color: #777; font-size: .9rem; }
  .card { background: #fff; border: 1px solid #e5e5e5; border-radius: 14px; padding: 16px; margin-bottom: 14px; }
  .head { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; flex-wrap: wrap; }
  .av { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; background: #f3f0ff; display: flex; align-items: center; justify-content: center; color: #7c3aed; font-weight: 800; font-size: 1.1rem; flex-shrink: 0; }
  .h { color: #7c3aed; font-weight: 800; font-size: 1rem; text-decoration: none; }
  .nombre { color: #555; font-size: .88rem; }
  .tag { display: inline-block; background: #f3f0ff; color: #7c3aed; font-size: .72rem; font-weight: 700; padding: 2px 7px; border-radius: 10px; margin-left: 4px; }
  .seg { font-size: .78rem; color: #16a34a; font-weight: 700; margin-left: 6px; }
  .bio { color: #666; font-style: italic; font-size: .88rem; margin: 6px 0; }
  .munis { margin: 6px 0; font-size: .85rem; color: #444; }
  .munis span { background: #f0f0f0; border-radius: 6px; padding: 2px 7px; margin-right: 4px; display: inline-block; }
  .when { color: #999; font-size: .78rem; }
  .acts { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .acts a, .acts button { display: inline-block; padding: 8px 14px; border-radius: 9px; text-decoration: none; font-weight: 700; font-size: .82rem; cursor: pointer; font-family: inherit; border: none; }
  .apr { background: #7c3aed; color: #fff; }
  .del { background: #fff; color: #dc2626; border: 1.5px solid #dc2626 !important; }
  .unapr { background: #fff; color: #e8a200; border: 1.5px solid #e8a200 !important; }
  .ig { background: #fff; color: #444; border: 1.5px solid #ddd !important; }
  .ord-wrap { display: flex; align-items: center; gap: 4px; margin-left: auto; }
  .ord-label { font-size: .78rem; color: #888; }
  .ord-input { width: 54px; padding: 6px 8px; border: 1.5px solid #ddd; border-radius: 8px; font-size: .88rem; text-align: center; }
  .ord-btn { background: #7c3aed; color: #fff; padding: 7px 10px !important; border-radius: 8px; font-size: .78rem; }
  .empty { color: #999; padding: 16px 0; }
  .tip { background: #f3f0ff; border: 1px solid #c4b5fd; border-radius: 12px; padding: 12px 14px; font-size: .9rem; color: #5b21b6; margin-bottom: 8px; }
  .tip code { background: #fff; padding: 1px 6px; border-radius: 5px; }
  /* Edit form */
  details { margin-top: 10px; }
  summary { cursor: pointer; font-size: .82rem; color: #7c3aed; font-weight: 700; }
  .edit-form { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 10px; }
  .edit-form label { font-size: .78rem; color: #555; font-weight: 600; display: flex; flex-direction: column; gap: 3px; }
  .edit-form input, .edit-form textarea, .edit-form select { padding: 7px 9px; border: 1.5px solid #ddd; border-radius: 8px; font-size: .88rem; font-family: inherit; width: 100%; box-sizing: border-box; }
  .edit-form .full { grid-column: 1/-1; }
  .edit-save { background: #16a34a; color: #fff; padding: 9px 16px; border-radius: 9px; font-weight: 700; font-size: .85rem; border: none; cursor: pointer; margin-top: 4px; }
  .edit-ok { font-size: .82rem; color: #16a34a; font-weight: 700; display: none; }
</style>
</head>
<body>
{!ok ? (
  <p>🔒 Acceso restringido. Añade <code>?key=TU_CLAVE</code> a la URL.</p>
) : (
  <div>
    <a href={`/admin?key=${key}`} style="display:inline-flex;align-items:center;gap:6px;text-decoration:none;color:#7c3aed;font-weight:700;font-size:.88rem;background:#f3f0ff;border:1.5px solid #e0d9ff;border-radius:999px;padding:7px 14px;margin-bottom:18px">← Panel principal</a>
    <h1>📸 Panel de Instagramers</h1>
    <p class="tip">Público: <code>{Astro.url.origin}/instagramers</code> · Registro: <code>{Astro.url.origin}/instagramers/unirme</code></p>

    <h2>Pendientes de aprobación ({pendientes.length})</h2>
    {pendientes.length === 0 && <p class="empty">Sin solicitudes pendientes.</p>}
    {pendientes.map((ig) => (
      <div class="card">
        <div class="head">
          {ig.avatar_url
            ? <img class="av" src={ig.avatar_url} alt="" />
            : <div class="av">{String(ig.handle || '?')[0].toUpperCase()}</div>
          }
          <div>
            <a class="h" href={`https://instagram.com/${ig.handle}`} target="_blank" rel="noopener">@{ig.handle}</a>
            {ig.nombre && <span class="nombre"> — {ig.nombre}</span>}
            {ig.especialidad && ig.especialidad.split(',').slice(0,3).map((e: string) => <span class="tag">{e.trim()}</span>)}
            {ig.seguidores > 0 && <span class="seg">{ig.seguidores >= 1000 ? Math.round(ig.seguidores/1000)+'K' : ig.seguidores} seg.</span>}
          </div>
        </div>
        {ig.bio && <div class="bio">"{ig.bio}"</div>}
        {(munisByInsta[ig.id] || []).length > 0 && (
          <div class="munis">
            {(munisByInsta[ig.id] || []).map((m) => (
              <span>{m.nombre_sitio}{m.provincia && m.provincia !== m.nombre_sitio ? ` (${m.provincia})` : ''}</span>
            ))}
          </div>
        )}
        <div class="when">{fecha(ig.creado_at)}</div>
        <div class="acts">
          <a class="apr" href={action(ig.id, 'aprobar')}>✓ Aprobar</a>
          <a class="del" href={action(ig.id, 'eliminar')}>✕ Eliminar</a>
          <a class="ig" href={`https://instagram.com/${ig.handle}`} target="_blank" rel="noopener">Ver Instagram</a>
        </div>
      </div>
    ))}

    <h2>Aprobados ({aprobados.length}) — arrastra el número para reordenar</h2>
    {aprobados.length === 0 && <p class="empty">Nadie aprobado todavía.</p>}
    {aprobados.map((ig) => (
      <div class="card" id={`card-${ig.id}`}>
        <div class="head">
          {ig.avatar_url
            ? <img class="av" src={ig.avatar_url} alt="" />
            : <div class="av">{String(ig.handle || '?')[0].toUpperCase()}</div>
          }
          <div style="flex:1">
            <a class="h" href={`https://instagram.com/${ig.handle}`} target="_blank" rel="noopener">@{ig.handle}</a>
            {ig.nombre && <span class="nombre"> — {ig.nombre}</span>}
            {ig.especialidad && ig.especialidad.split(',').slice(0,3).map((e: string) => <span class="tag">{e.trim()}</span>)}
            {ig.seguidores > 0 && <span class="seg">{ig.seguidores >= 1000 ? Math.round(ig.seguidores/1000)+'K' : ig.seguidores} seg.</span>}
          </div>
          <div class="ord-wrap">
            <span class="ord-label">Orden:</span>
            <input class="ord-input" type="number" value={ig.orden ?? 99} min="1" max="999" data-id={ig.id} />
            <button class="ord-btn" onclick={`guardarOrden(${ig.id},this)`}>↑↓</button>
          </div>
        </div>
        {ig.bio && <div class="bio">"{ig.bio}"</div>}
        {(munisByInsta[ig.id] || []).length > 0 && (
          <div class="munis">
            {(munisByInsta[ig.id] || []).map((m) => (
              <span>{m.nombre_sitio}{m.provincia && m.provincia !== m.nombre_sitio ? ` (${m.provincia})` : ''}</span>
            ))}
          </div>
        )}

        <details>
          <summary>✏️ Editar ficha</summary>
          <div class="edit-form" id={`ef-${ig.id}`}>
            <label>Handle<input type="text" name="handle" value={ig.handle} /></label>
            <label>Nombre<input type="text" name="nombre" value={ig.nombre || ''} /></label>
            <label>Seguidores<input type="number" name="seguidores" value={ig.seguidores || 0} /></label>
            <label>Orden<input type="number" name="orden" value={ig.orden ?? 99} /></label>
            <label class="full">Especialidades (separadas por coma)<input type="text" name="especialidad" value={ig.especialidad || ''} /></label>
            <label class="full">Bio<textarea name="bio" rows="2">{ig.bio || ''}</textarea></label>
            <label class="full">Avatar URL (o sube foto abajo)<input type="text" name="avatar_url" value={ig.avatar_url || ''} /></label>
            <div class="full">
              <label style="font-size:.78rem;color:#555;font-weight:600;display:block;margin-bottom:4px">📷 Subir foto de perfil</label>
              <input type="file" accept="image/jpeg,image/png,image/webp" class="foto-file" data-id={ig.id} style="padding:8px;border:1.5px solid #ddd;border-radius:8px;width:100%;box-sizing:border-box;font-family:inherit;cursor:pointer" />
              <div class="foto-preview" id={`fp-${ig.id}`} style="margin-top:6px;display:flex;align-items:center;gap:8px"></div>
            </div>
            <div class="full" style="display:flex;align-items:center;gap:10px">
              <button class="edit-save" onclick={`guardarEdicion(${ig.id},this)`}>💾 Guardar cambios</button>
              <span class="edit-ok" id={`ok-${ig.id}`}>✓ Guardado</span>
            </div>
          </div>
        </details>

        <div class="acts" style="margin-top:10px">
          <a class="unapr" href={action(ig.id, 'desaprobar')}>↩ Desaprobar</a>
          <a class="del" href={action(ig.id, 'eliminar')}>✕ Eliminar</a>
          <a class="ig" href={`https://instagram.com/${ig.handle}`} target="_blank" rel="noopener">Ver Instagram</a>
        </div>
      </div>
    ))}
  </div>
)}

<script define:vars={{ adminKey: Astro.url.searchParams.get('key') }}>
// Preview foto al seleccionar
document.addEventListener('change', function(e) {
  const input = e.target;
  if (!input.classList.contains('foto-file')) return;
  const id = input.getAttribute('data-id');
  const file = input.files[0];
  if (!file) return;
  if (file.size > 3 * 1024 * 1024) { alert('Máx 3MB'); input.value = ''; return; }
  const reader = new FileReader();
  reader.onload = function(ev) {
    const prev = document.getElementById('fp-' + id);
    prev.innerHTML = `<img src="${ev.target.result}" style="width:60px;height:60px;border-radius:50%;object-fit:cover;border:2px solid #c4b5fd"><span style="font-size:.78rem;color:#16a34a;font-weight:700">✓ Lista para guardar</span>`;
  };
  reader.readAsDataURL(file);
});

async function guardarOrden(id, btn) {
  const input = document.querySelector(`#card-${id} .ord-input`);
  const orden = parseInt(input.value) || 99;
  btn.textContent = '…';
  try {
    await fetch(`/api/instagramers-moderar?key=${encodeURIComponent(adminKey)}&id=${id}&accion=orden&valor=${orden}`);
    btn.textContent = '✓';
    setTimeout(() => btn.textContent = '↑↓', 1500);
  } catch { btn.textContent = '↑↓'; }
}

async function guardarEdicion(id, btn) {
  const form = document.getElementById(`ef-${id}`);
  const get = (name) => form.querySelector(`[name="${name}"]`)?.value?.trim() || '';

  // Leer foto si se seleccionó
  const fotoFile = form.querySelector('.foto-file');
  let avatar = null;
  if (fotoFile && fotoFile.files[0]) {
    avatar = await new Promise((res) => {
      const r = new FileReader();
      r.onload = (e) => res(e.target.result);
      r.readAsDataURL(fotoFile.files[0]);
    });
  }

  const data = {
    handle: get('handle'), nombre: get('nombre'), bio: get('bio'),
    especialidad: get('especialidad'), seguidores: parseInt(get('seguidores')) || 0,
    orden: parseInt(get('orden')) || 99, avatar_url: get('avatar_url'),
    avatar,
  };
  btn.disabled = true; btn.textContent = 'Guardando…';
  try {
    const r = await fetch(`/api/instagramers-moderar?key=${encodeURIComponent(adminKey)}&id=${id}&accion=editar`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data),
    });
    if (!r.ok) throw new Error();
    document.getElementById(`ok-${id}`).style.display = 'inline';
    setTimeout(() => document.getElementById(`ok-${id}`).style.display = 'none', 2500);
    // Limpiar input foto
    if (fotoFile) fotoFile.value = '';
  } catch { alert('Error al guardar'); }
  btn.disabled = false; btn.textContent = '💾 Guardar cambios';
}
</script>
</body>
</html>
