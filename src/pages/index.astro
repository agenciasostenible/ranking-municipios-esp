---
import { DB } from '../lib/d1client';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { TABS, SIDEBAR_GROUPS, formatPob, getSubtitle } from '../lib/db';
import { getProvGradient } from '../lib/utils';
// @ts-ignore


const { results: rankingGlobal } = await DB.prepare(`
  SELECT m.codigo_ine, m.nombre, m.provincia, m.comunidad, m.comarca, m.poblacion,
         m.why_json, m.foto_url, p.puntuacion, p.ranking_provincial
  FROM puntuaciones p
  JOIN municipios m ON p.codigo_ine = m.codigo_ine
  WHERE p.categoria = 'ranking_global' AND COALESCE(m.es_duplicado, 0) = 0
  ORDER BY p.puntuacion DESC
  LIMIT 20
`).all();

const { results: provincias } = await DB.prepare(
  `SELECT DISTINCT provincia FROM municipios ORDER BY provincia`
).all();

const { results: ccaas } = await DB.prepare(
  `SELECT DISTINCT comunidad FROM municipios ORDER BY comunidad`
).all();

const totalRow = await DB.prepare(`SELECT COUNT(*) as n FROM municipios`).first();
const total = totalRow?.n ?? 0;

// Experiencias del planificador de rutas (mismas claves que /ruta)
const ROUTE_EXP = [
  { key: 'monumentos',        icon: 'account_balance', label: 'Monumentos' },
  { key: 'castillos',         icon: 'castle',          label: 'Castillos' },
  { key: 'TurismoRural',      icon: 'cottage',         label: 'Turismo rural' },
  { key: 'oleoturismo',       icon: 'opacity',         label: 'Oleoturismo' },
  { key: 'turismo_activo',    icon: 'mountain',        label: 'Turismo activo' },
  { key: 'senderismo',        icon: 'hiking',          label: 'Senderismo' },
  { key: 'turismo_religioso', icon: 'church',          label: 'Turismo religioso' },
  { key: 'turismo_mascotas',  icon: 'pets',            label: 'Con mascotas' },
  { key: 'turismo_lgtbi',     icon: 'rainbow',         label: 'LGTBI' },
  { key: 'vinos',             icon: 'wine_bar',        label: 'Vinos y bodegas' },
  { key: 'miradores',         icon: 'binoculars',      label: 'Miradores' },
  { key: 'lujo',              icon: 'diamond',         label: 'Turismo de lujo' },
  { key: 'solteros',          icon: 'nightlife',       label: 'Solteros' },
  { key: 'misterioso',        icon: 'dark_mode',       label: 'Turismo misterioso' },
];

const municipios = (rankingGlobal as any[]).map(r => ({
  ...r,
  why: r.why_json ? (() => { try { return JSON.parse(r.why_json); } catch { return []; } })() : [],
  gradient: getProvGradient(r.provincia),
  foto: r.foto_url && r.foto_url !== 'NONE' ? r.foto_url : null,
}));
---
<Base title="Ranking Municipios España 2025 — Mejores pueblos y destinos turísticos"
  description="Descubre cuál es el mejor pueblo de España para tu próximo viaje. Rankings por historia, naturaleza, gastronomía, fiestas y más. Compara entre 8.000+ municipios.">

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Ranking Spain",
  "url": "https://rankingspain.com",
  "description": "Ranking turístico de todos los municipios de España. Descubre el mejor pueblo para tu viaje.",
  "inLanguage": "es",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://rankingspain.com/ranking/ranking_global?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
})} />

<!-- ── HERO ── -->
<section class="hero-section">
  <div class="hero-inner">
    <h1 class="hero-title">El ranking de los municipios de España</h1>
    <p class="hero-sub">Ordenados con datos verificados, no opiniones.<br /><strong class="hero-sub-cta">Elige una experiencia para ver el ranking</strong></p>

    <!-- Paso 1: Categorías -->
    <div class="hero-cats-wrap">
      <div class="hero-cats" id="hero-cats">
        {[
          {key:'senderismo',        icon:'hiking',          label:'Senderismo'},
          {key:'naturaleza',        icon:'landscape',       label:'Naturaleza'},
          {key:'monumentos',        icon:'account_balance', label:'Monumentos'},
          {key:'castillos',         icon:'castle',          label:'Castillos'},
          {key:'gastronomia',       icon:'restaurant',      label:'Gastronomía'},
          // --- el resto se despliega con "Ver más" ---
          {key:'TurismoRural',      icon:'cottage',         label:'Turismo Rural'},
          {key:'pueblo_bonito',     icon:'auto_awesome',    label:'Pueblos bonitos'},
          {key:'turismo_activo',    icon:'mountain',        label:'Turismo activo'},
          {key:'Playas',            icon:'beach_access',    label:'Playas'},
          {key:'Campings',          icon:'camping',         label:'Camping'},
          {key:'vinos',             icon:'wine_bar',        label:'Vinos'},
          {key:'miradores',         icon:'binoculars',      label:'Miradores'},
          {key:'lujo',              icon:'diamond',         label:'Turismo de lujo'},
          {key:'solteros',          icon:'nightlife',       label:'Solteros'},
          {key:'misterioso',        icon:'dark_mode',       label:'Turismo misterioso'},
          {key:'oleoturismo',       icon:'opacity',         label:'Oleoturismo'},
          {key:'fiestas',           icon:'celebration',     label:'Fiestas'},
          {key:'festivales',        icon:'festival',        label:'Festivales'},
          {key:'turismo_religioso', icon:'church',          label:'Turismo religioso'},
          {key:'turismo_mascotas',  icon:'pets',            label:'Turismo con mascotas'},
          {key:'turismo_lgtbi',     icon:'rainbow',         label:'Turismo LGTBI'},
          {key:'notoriedad_instagram', icon:'trending_up',  label:'Popularidad en redes'},
        ].map((c, i) => (
          <button class={`hero-cat-pill${i >= 5 ? ' hero-cat-extra' : ''}`} data-key={c.key}>
            <span class="hero-cat-ic"><Icon name={c.icon} size={17} /></span>
            <span class="hero-cat-label">{c.label}</span>
          </button>
        ))}
        <button type="button" class="hero-cat-more" id="hero-cat-more">Ver más ▾</button>
      </div>
    </div>

    <!-- Buscar por categoría + acceso al ranking completo -->
    <div class="hero-all-wrap">
      <div class="hero-find-label">¿Dónde quieres buscar? <span class="hero-find-cat" id="hero-find-cat"></span></div>
      <div class="hero-find-box">
        <div class="hero-find-pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2.2" stroke-linecap="round" width="18" height="18"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <input id="hf-input" type="text" placeholder="Comunidad, provincia o municipio…" autocomplete="off" />
        </div>
        <div id="hf-ac" class="hero-find-ac"></div>
      </div>
      <a href="/ranking/ranking_global" id="hero-all-btn" class="hero-all-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" width="18" height="18"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        Ver toda España
      </a>
    </div>

    <!-- Paso 2: Zona opcional + CTA (solo desktop) -->
    <div class="hero-search-wrap hero-search-desktop">
      <div class="hero-search-pill">
        <input id="si" type="text" placeholder="Provincia, comunidad o zona (opcional)" autocomplete="off" class="hsp-input" />
        <button id="btn-search" class="hsp-btn" aria-label="Buscar">
          <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </button>
      </div>
      <!-- Autocomplete desktop -->
      <div id="ac" class="hero-ac"></div>
    </div>
  </div>
</section>

<!-- ── QUÉ VER CERCA DE TI (destacado, geolocalización) ── -->
<section class="nearby">
  <div class="nearby-card">
    <span class="nearby-eyebrow">📍 A tu lado · Nuevo</span>
    <h2 class="nearby-title">¿Qué ver cerca de ti?</h2>
    <p class="nearby-sub">Comparte tu ubicación y descubre al instante <strong>todo lo que tienes al lado para visitar</strong>.</p>
    <a href="/cerca" id="home-cerca-btn" class="nearby-btn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" width="20" height="20"><path d="M12 21s-7-6.3-7-11a7 7 0 0 1 14 0c0 4.7-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg>
      Ver qué hay cerca de mí
    </a>
    <div class="nearby-tags">
      <span><Icon name="account_balance" size={14} /> Monumentos</span>
      <span><Icon name="landscape" size={14} /> Naturaleza</span>
      <span><Icon name="binoculars" size={14} /> Miradores</span>
      <span><Icon name="castle" size={14} /> Castillos</span>
      <span><Icon name="dark_mode" size={14} /> Misterio</span>
    </div>
  </div>
</section>
<script is:inline>
  (function () {
    var b = document.getElementById('home-cerca-btn');
    if (!b) return;
    b.addEventListener('click', function (e) {
      if (!navigator.geolocation) return; // deja navegar a /cerca
      e.preventDefault();
      b.style.opacity = '.75';
      navigator.geolocation.getCurrentPosition(
        function (p) { window.location.href = '/cerca?lat=' + p.coords.latitude.toFixed(4) + '&lon=' + p.coords.longitude.toFixed(4); },
        function () { window.location.href = '/cerca'; },
        { enableHighAccuracy: false, timeout: 8000, maximumAge: 600000 }
      );
    });
  })();
</script>

<!-- ── PLANIFICADOR DE RUTAS (destacado) ── -->
<section class="route-promo">
  <form class="rp-card" method="get" action="/ruta" id="rp-card" data-mode="zona">
    <div class="rp-head">
      <span class="rp-ic"><Icon name="map" size={21} /></span>
      <div>
        <span class="rp-eyebrow">Nuevo · Planifica tu ruta</span>
        <h2 class="rp-title">Monta tu viaje real en 1 minuto</h2>
      </div>
    </div>
    <p class="rp-sub">Te decimos <strong>qué visitar</strong>, <strong>dónde comer</strong> y <strong>dónde dormir</strong>, con la valoración de Google. Elige una <strong>zona</strong>… o el <strong>plan de un día</strong> dentro de un solo pueblo.</p>

    <div class="rp-modes" role="tablist">
      <button type="button" class="rp-mode on" data-mode="zona">🧭 Por la zona</button>
      <button type="button" class="rp-mode" data-mode="pueblo">📍 Un día en un pueblo</button>
    </div>

    <button type="button" class="rp-label rp-chips-toggle" id="rp-chips-toggle">
      <span>¿Qué quieres hacer? <span class="rp-hint-zona">(elige una o varias)</span><span class="rp-hint-pueblo">(opcional)</span> <span class="rp-pick-count" id="rp-pick-count"></span></span>
      <span class="rp-chev">▾</span>
    </button>
    <div class="rp-chips">
      {ROUTE_EXP.map(e => (
        <label class="rp-chip">
          <input type="checkbox" name="cat" value={e.key} />
          <span class="rp-chip-ic"><Icon name={e.icon} size={15} /></span>
          {e.label}
        </label>
      ))}
    </div>

    <div class="rp-row rp-block-zona">
      <select name="prov" class="rp-prov">
        <option value="">Elige provincia…</option>
        {(provincias as any[]).map(p => <option value={p.provincia}>{p.provincia}</option>)}
      </select>
      <input type="hidden" name="dias" value="2" />
      <button type="submit" class="rp-go"><Icon name="map" size={17} /> Generar ruta</button>
    </div>

    <div class="rp-block-pueblo">
      <div class="rp-ac-wrap">
        <input type="text" id="rp-pueblo-input" class="rp-prov" placeholder="Escribe un municipio… (Granada, Alcalá la Real…)" autocomplete="off" />
        <div class="rp-ac" id="rp-pueblo-ac"></div>
      </div>
    </div>
  </form>
</section>
<script>
  const rpCard = document.querySelector('.rp-card') as HTMLFormElement | null;
  // Desplegable de experiencias (compacto): abrir/cerrar + contador
  const rpToggle = document.getElementById('rp-chips-toggle');
  const rpCount = document.getElementById('rp-pick-count');
  rpToggle?.addEventListener('click', () => rpCard?.classList.toggle('chips-open'));
  function rpUpdateCount() {
    const n = rpCard?.querySelectorAll('.rp-chip input:checked').length || 0;
    if (rpCount) rpCount.textContent = n ? `· ${n} elegida${n > 1 ? 's' : ''}` : '';
  }
  rpCard?.querySelectorAll('.rp-chip input').forEach((inp) => {
    inp.addEventListener('change', (e) => {
      const el = e.target as HTMLInputElement;
      el.closest('.rp-chip')?.classList.toggle('on', el.checked);
      rpUpdateCount();
    });
  });
  rpCard?.addEventListener('submit', (e) => {
    if (rpCard.getAttribute('data-mode') !== 'zona') { e.preventDefault(); return; }
    const any = rpCard.querySelectorAll('.rp-chip input:checked').length > 0;
    if (!any) {
      e.preventDefault();
      rpCard.classList.add('chips-open');   // abre el desplegable para que elija
      rpCard.querySelector('.rp-label')?.animate(
        [{ color: '#FF385C' }, { color: '' }], { duration: 1200 }
      );
      (rpCard.querySelector('.rp-chip') as HTMLElement)?.focus();
    }
  });

  // Conmutador de modo: "Por la zona" / "Un día en un pueblo"
  rpCard?.querySelectorAll('.rp-mode').forEach((b) => {
    b.addEventListener('click', () => {
      const m = b.getAttribute('data-mode') || 'zona';
      rpCard.setAttribute('data-mode', m);
      rpCard.querySelectorAll('.rp-mode').forEach((x) => x.classList.toggle('on', x === b));
      if (m === 'pueblo') (document.getElementById('rp-pueblo-input') as HTMLInputElement | null)?.focus();
    });
  });

  // Autocompletado de municipio para el modo "un día en un pueblo"
  const rpInput = document.getElementById('rp-pueblo-input') as HTMLInputElement | null;
  const rpAc = document.getElementById('rp-pueblo-ac');
  const rpCats = () => {
    const ks = Array.from(rpCard?.querySelectorAll('.rp-chip input:checked') ?? [])
      .map((i) => (i as HTMLInputElement).value);
    return ks.length ? '&' + ks.map((k) => 'cat=' + encodeURIComponent(k)).join('&') : '';
  };
  let rpTimer: any;
  rpInput?.addEventListener('input', () => {
    const q = rpInput.value.trim();
    clearTimeout(rpTimer);
    if (q.length < 2) { if (rpAc) rpAc.innerHTML = ''; return; }
    rpTimer = setTimeout(async () => {
      try {
        const res = await fetch('/api/search?q=' + encodeURIComponent(q));
        const data = await res.json();
        const muns = ((data as any[]) || []).filter((d) => d.tipo === 'municipio').slice(0, 6);
        if (rpAc) rpAc.innerHTML = muns.map((m) => {
          const nom = String(m.nombre || '').replace(/[&<>]/g, '');
          const prov = String(m.provincia || '').replace(/[&<>]/g, '');
          return `<a href="/ruta?pueblo=${m.codigo_ine}${rpCats()}" style="display:flex;align-items:center;gap:10px;padding:11px 15px;text-decoration:none;border-bottom:1px solid #f2f2f2;background:#fff;cursor:pointer" onmouseover="this.style.background='#fff1f3'" onmouseout="this.style.background='#fff'"><span style="flex-shrink:0">📍</span><span style="flex:1;min-width:0;font-size:.92rem;font-weight:700;color:#222;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${nom}<span style="font-weight:400;color:#888;font-size:.82rem;margin-left:7px">${prov}</span></span></a>`;
        }).join('');
      } catch (e) { if (rpAc) rpAc.innerHTML = ''; }
    }, 180);
  });
  document.addEventListener('click', (e) => {
    if (rpAc && !rpAc.contains(e.target as Node) && e.target !== rpInput) rpAc.innerHTML = '';
  });
</script>

<!-- Paso 2 móvil: elegir zona tras pulsar categoría -->
<div class="mcs-overlay" id="mob-cat-sheet">
  <div class="mcs-head">
    <button class="mcs-back" id="mcs-close" aria-label="Volver">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" width="22" height="22"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <div class="mcs-title"><span id="mcs-cat-ic"></span><span id="mcs-cat">Categoría</span></div>
  </div>
  <div class="mcs-body">
    <div class="mcs-sub">¿Dónde quieres buscar?</div>
    <div class="mcs-search">
      <svg viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2.2" stroke-linecap="round" width="18" height="18"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      <input id="mcs-input" type="text" placeholder="Comunidad, provincia o municipio..." autocomplete="off" />
    </div>
    <button class="mcs-all" id="mcs-all">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="18" height="18"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
      Ver toda España
    </button>
    <div id="mcs-ac" class="mcs-ac"></div>
  </div>
</div>

<!-- ── CATEGORY CHIPS (Airbnb style) ── -->
<div class="chips-wrap">
  <button class="chips-arrow chips-arrow-left" id="chips-prev" aria-label="Anterior">&#8249;</button>
  <div class="chips-bar" id="chips-bar">
    <div class="chips-inner">
      {TABS.map((t) => (
        <a href={`/ranking/${t.key}`} class="chip-cat">
          <Icon name={t.icon} size={20} />
          {t.label}
        </a>
      ))}
    </div>
  </div>
  <button class="chips-arrow chips-arrow-right" id="chips-next" aria-label="Siguiente">&#8250;</button>
</div>
<script>
  const bar = document.getElementById('chips-bar');
  document.getElementById('chips-prev')?.addEventListener('click', () => bar?.scrollBy({ left: -300, behavior: 'smooth' }));
  document.getElementById('chips-next')?.addEventListener('click', () => bar?.scrollBy({ left: 300, behavior: 'smooth' }));
</script>

<!-- ── JOYAS SIN MASIFICAR (destacado) ── -->
<a href="/joyas" class="joyas-promo">
  <span class="jp-gem">💎</span>
  <span class="jp-txt">
    <span class="jp-eyebrow">Nuevo · Antimasificación</span>
    <span class="jp-title">Joyas sin masificar</span>
    <span class="jp-sub">Lo que de verdad merece la pena y <strong>aún puedes disfrutar sin colas</strong>. ¿Ese destino famoso lo vale… o hay algo mejor al lado?</span>
    <span class="jp-cta">Descubrir joyas →</span>
  </span>
</a>

<!-- ── EXPLORAR POR CATEGORÍA (agrupado) ── -->
<section class="cat-explore">
  <h2 class="cx-title">Explora por categoría</h2>
  {SIDEBAR_GROUPS.map((g) => (
    <div class="cx-group">
      <div class="cx-group-title"><Icon name={g.icon} size={15} /> {g.title}</div>
      <div class="cx-cards">
        {g.items.map((it) => (
          <a href={`/ranking/${it.key}`} class="cx-card">
            <span class="cx-ic"><Icon name={it.icon} size={20} /></span>
            <span class="cx-text">
              <span class="cx-label">{it.label}</span>
              {getSubtitle(it.key) && <span class="cx-sub">{getSubtitle(it.key)}</span>}
            </span>
          </a>
        ))}
      </div>
    </div>
  ))}
</section>

<!-- ── TOP MUNICIPIOS GRID ── -->
<div class="page-content">
  <!-- Stats -->
  <div class="info-bar">
    <div class="istat"><div class="n">{total.toLocaleString('es-ES')}</div><div class="l">Municipios</div></div>
    <div class="istat"><div class="n">{provincias.length}</div><div class="l">Provincias</div></div>
    <div class="istat"><div class="n">{ccaas.length}</div><div class="l">CC.AA.</div></div>
  </div>

  <div class="result-header">
    <div>
      <h2>🏆 Top municipios de España</h2>
      <div class="sub">Los mejores destinos según nuestro ranking global</div>
    </div>
    <a href="/ranking/ranking_global" class="pgb">Ver ranking completo →</a>
  </div>

  <!-- Grid de tarjetas -->
  <div class="mun-grid">
    {municipios.map((m, i) => {
      const pos = i + 1;
      const whyChips = (m.why as string[]).slice(0, 3);
      return (
        <a href={`/municipio/${m.codigo_ine}`} class="mun-card"
          data-codigo={m.foto ? null : m.codigo_ine}>
          <!-- Background: foto real o gradiente -->
          <div class="mun-card-bg" style={m.foto
            ? `background:url('${m.foto}') center/cover no-repeat`
            : `background:${m.gradient}`}
            data-gradient={m.foto ? null : m.gradient}>
            <div class="mun-card-overlay"></div>
            <div class="mun-card-pos">#{pos}</div>
          </div>
          <!-- Card content -->
          <div class="mun-card-body">
            <div class="mun-card-comarca">{m.comarca ?? m.provincia}</div>
            <div class="mun-card-name">{m.nombre}</div>
            <div class="mun-card-score">
              <span class="mun-score-star">⭐</span>
              <span class="mun-score-val">{Number(m.puntuacion).toFixed(1)}</span>
              <span class="mun-card-pob">{m.poblacion ? '· ' + formatPob(m.poblacion) + ' hab.' : ''}</span>
            </div>
          </div>
        </a>
      );
    })}
  </div>

  <div style="text-align:center; margin-top:32px; display:flex; gap:12px; justify-content:center; flex-wrap:wrap">
    <button class="btn-ver-mas" id="btn-mas" onclick="loadMore()">Ver más municipios ↓</button>
    <a href="/ranking/ranking_global" class="btn-ver-mas btn-secondary">Ver tabla de rankings →</a>
  </div>
</div>

<script>
// ── Ver más municipios ────────────────────────────────────────────────────────
let currentPage = 1;
const PER_PAGE = 20;
let isLoading = false;
let totalLoaded = 20; // ya hay 20 cargados en SSR
let totalMunicipios = 0;

async function loadMore() {
  if (isLoading) return;
  isLoading = true;
  const btn = document.getElementById('btn-mas') as HTMLButtonElement;
  if (btn) { btn.textContent = 'Cargando...'; btn.classList.add('btn-loading'); }

  currentPage++;
  const res = await fetch(`/api/rankings?cat=ranking_global&page=${currentPage}&per=${PER_PAGE}`)
    .then(r => r.json()).catch(() => null);

  if (!res) {
    isLoading = false;
    if (btn) { btn.textContent = 'Ver más municipios ↓'; btn.classList.remove('btn-loading'); }
    return;
  }
  totalMunicipios = res.total;

  const grid = document.querySelector('.mun-grid')!;
  res.data.forEach((m: any, i: number) => {
    const pos = totalLoaded + i + 1;
    const foto = m.foto_url && m.foto_url !== 'NONE' ? m.foto_url : null;
    const bgStyle = foto ? `background:url('${escHtml(foto)}') center/cover no-repeat` : `background:#e0e0e0`;

    const card = document.createElement('a');
    card.href = `/municipio/${m.codigo_ine}`;
    card.className = 'mun-card';
    if (!foto) card.setAttribute('data-codigo', m.codigo_ine);
    card.innerHTML = `
      <div class="mun-card-bg" style="${bgStyle}">
        <div class="mun-card-overlay"></div>
        <div class="mun-card-pos">#${pos}</div>
      </div>
      <div class="mun-card-body">
        <div class="mun-card-comarca">${escHtml(m.comarca ?? m.provincia)}</div>
        <div class="mun-card-name">${escHtml(m.nombre)}</div>
        <div class="mun-card-score">
          <span class="mun-score-star">⭐</span>
          <span class="mun-score-val">${Number(m.puntuacion).toFixed(1)}</span>
          ${m.poblacion ? `<span class="mun-card-pob">· ${formatPobJs(m.poblacion)} hab.</span>` : ''}
        </div>
      </div>`;
    grid.appendChild(card);
  });

  totalLoaded += res.data.length;

  if (btn) {
    if (totalLoaded >= totalMunicipios) {
      btn.textContent = 'Ya los has visto todos ✓';
      btn.disabled = true;
      btn.classList.add('btn-loading');
    } else {
      btn.textContent = `Ver más municipios ↓ (${totalLoaded}/${totalMunicipios})`;
      btn.classList.remove('btn-loading');
    }
  }
  isLoading = false;
}

function formatPobJs(n: number) {
  if (n >= 1000000) return (n/1000000).toFixed(1) + 'M';
  if (n >= 1000) return Math.round(n/1000) + 'K';
  return String(n);
}
// Exponer al scope global para el onclick inline
(window as any).loadMore = loadMore;
// ─────────────────────────────────────────────────────────────────────────────

const si  = document.getElementById('si') as HTMLInputElement;
const ac  = document.getElementById('ac')!;

function escHtml(s: string) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function highlight(str: string, q: string) {
  const i = str.toLowerCase().indexOf(q.toLowerCase());
  if (i < 0) return escHtml(str);
  return escHtml(str.slice(0,i)) + `<strong>${escHtml(str.slice(i,i+q.length))}</strong>` + escHtml(str.slice(i+q.length));
}
const PIN_SVG  = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FF385C" stroke-width="2"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>`;
const PROV_SVG = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5c6bc0" stroke-width="2"><path d="M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3V6z"/><path d="M9 3v15M15 6v15"/></svg>`;
const CCAA_SVG = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#43a047" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>`;
function getIcon(tipo: string) { return tipo==='provincia'?PROV_SVG:tipo==='comunidad'?CCAA_SVG:PIN_SVG; }
function getIconBg(tipo: string) { return tipo==='provincia'?'#eef0fb':tipo==='comunidad'?'#e8f5e9':'#fff0f2'; }
function getSubtitle(m: any) {
  if (m.tipo === 'provincia') return 'Provincia';
  if (m.tipo === 'comunidad') return 'Comunidad autónoma';
  const p = m.provincia;
  return (p && p !== 'undefined' && p !== 'null') ? p : '';
}
async function fetchResults(q: string): Promise<any[]> {
  if (q.length < 2) return [];
  return fetch(`/api/search?q=${encodeURIComponent(q)}`).then(r => r.json());
}
function renderItems(container: HTMLElement, data: any[], q: string) {
  container.innerHTML = data.map(m => {
    const subtitle = getSubtitle(m);
    const bg = getIconBg(m.tipo);
    const cat = selectedCat || 'ranking_global';
    let href = m.url ?? `/municipio/${m.codigo_ine}`;
    if (m.tipo === 'provincia') href = `/provincia/${encodeURIComponent(m.nombre)}?categoria=${cat}`;
    else if (m.tipo === 'comunidad') href = `/ranking/${cat}?ccaa=${encodeURIComponent(m.nombre)}`;
    else if (selectedCat) href = `/municipio/${m.codigo_ine}?desde=${selectedCat}`;
    return `<a href="${escHtml(href)}"
      style="display:flex;align-items:center;gap:14px;padding:12px 20px;text-decoration:none;color:#222;border-bottom:1px solid #f5f5f5;background:#fff;cursor:pointer"
      onmouseover="this.style.background='#fafafa'" onmouseout="this.style.background='#fff'">
      <span style="flex-shrink:0;width:36px;height:36px;border-radius:9px;background:${bg};display:flex;align-items:center;justify-content:center">${getIcon(m.tipo)}</span>
      <span style="flex:1;min-width:0;font-size:.9rem;font-weight:600;color:#222;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
        ${highlight(m.nombre, q)}${subtitle ? `<span style="font-weight:400;color:#888;margin-left:8px;font-size:.82rem">${escHtml(subtitle)}</span>` : ''}
      </span>
    </a>`;
  }).join('');
}

// ── Autocomplete desktop hero ──
let timer: ReturnType<typeof setTimeout>;
si.addEventListener('input', () => {
  const q = si.value.trim();
  clearTimeout(timer);
  if (!q || q.length < 2) { ac.classList.remove('open'); return; }
  timer = setTimeout(async () => {
    const data = await fetchResults(q);
    if (!data.length) { ac.classList.remove('open'); return; }
    renderItems(ac, data, q);
    ac.classList.add('open');
  }, 200);
});
si.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') ac.classList.remove('open');
  if (e.key === 'Enter') doSearch();
});
document.getElementById('btn-search')!.addEventListener('click', doSearch);
document.addEventListener('click', (e) => {
  if (!(e.target as Element)?.closest?.('.hero-search-wrap')) ac.classList.remove('open');
});

// ── Category pills → eligen categoría y enfocan el buscador "por categoría" ──
let selectedCat = '';
const heroAllBtn = document.getElementById('hero-all-btn') as HTMLAnchorElement | null;
const heroFindCat = document.getElementById('hero-find-cat');
const heroAllWrap = document.querySelector('.hero-all-wrap');
function setHeroCat(cat: string, label: string) {
  selectedCat = cat;
  if (heroAllBtn) heroAllBtn.href = `/ranking/${cat || 'ranking_global'}`;
  if (heroFindCat) heroFindCat.textContent = label ? `en ${label}` : '';
}
document.querySelectorAll('.hero-cat-pill').forEach(pill => {
  pill.addEventListener('click', () => {
    const cat = (pill as HTMLElement).dataset.key || '';
    const label = (pill.querySelector('.hero-cat-label') as HTMLElement)?.textContent?.trim() || '';
    document.querySelectorAll('.hero-cat-pill').forEach(p => p.classList.remove('selected'));
    pill.classList.add('selected');
    setHeroCat(cat, label);
    heroAllWrap?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    setTimeout(() => (document.getElementById('hf-input') as HTMLInputElement)?.focus(), 300);
  });
});

// Buscador "por categoría" (inline): autocompletado que respeta la categoría elegida
const hfInput = document.getElementById('hf-input') as HTMLInputElement | null;
const hfAc = document.getElementById('hf-ac');
let hfTimer: ReturnType<typeof setTimeout>;
hfInput?.addEventListener('input', () => {
  const q = hfInput.value.trim();
  clearTimeout(hfTimer);
  if (q.length < 2) { if (hfAc) hfAc.innerHTML = ''; return; }
  hfTimer = setTimeout(async () => {
    const data = await fetchResults(q);
    if (hfAc) renderItems(hfAc, data, q);
  }, 200);
});
document.addEventListener('click', (e) => {
  if (hfAc && !(e.target as Element)?.closest?.('.hero-all-wrap')) hfAc.innerHTML = '';
});

// "Ver más / Ver menos" de las categorías del hero
const heroMore = document.getElementById('hero-cat-more');
const heroCats = document.getElementById('hero-cats');
heroMore?.addEventListener('click', () => {
  const exp = heroCats!.classList.toggle('expanded');
  heroMore.textContent = exp ? 'Ver menos ▴' : 'Ver más ▾';
});

// ── Paso 2 móvil: hoja de selección de zona ──
const mcs = document.getElementById('mob-cat-sheet')!;
const mcsInput = document.getElementById('mcs-input') as HTMLInputElement;
const mcsAc = document.getElementById('mcs-ac')!;
function openCatSheet(cat: string, label: string, ic: string) {
  selectedCat = cat;
  document.getElementById('mcs-cat')!.textContent = label;
  document.getElementById('mcs-cat-ic')!.innerHTML = ic;
  mcsInput.value = ''; mcsAc.innerHTML = '';
  mcs.classList.add('open');
  document.body.style.overflow = 'hidden';
  setTimeout(() => mcsInput.focus(), 250);
}
function closeCatSheet() { mcs.classList.remove('open'); document.body.style.overflow = ''; }
document.getElementById('mcs-close')!.addEventListener('click', closeCatSheet);
document.getElementById('mcs-all')!.addEventListener('click', () => {
  window.location.href = `/ranking/${selectedCat || 'ranking_global'}`;
});
let mcsTimer: ReturnType<typeof setTimeout>;
mcsInput.addEventListener('input', () => {
  const q = mcsInput.value.trim();
  clearTimeout(mcsTimer);
  if (!q || q.length < 2) { mcsAc.innerHTML = ''; return; }
  mcsTimer = setTimeout(async () => {
    const data = await fetchResults(q);
    renderItems(mcsAc, data, q);
  }, 200);
});

function doSearch() {
  const q = si.value.trim();
  const cat = selectedCat || 'ranking_global';
  ac.classList.remove('open');
  if (q.length >= 2) {
    fetchResults(q).then((data: any[]) => {
      const first = data[0];
      if (!first) { window.location.href = `/ranking/${cat}`; return; }
      if (first.tipo === 'provincia') {
        window.location.href = `/ranking/${cat}?provincia=${encodeURIComponent(first.nombre)}`;
      } else if (first.tipo === 'comunidad') {
        window.location.href = `/ranking/${cat}?ccaa=${encodeURIComponent(first.nombre)}`;
      } else {
        window.location.href = selectedCat
          ? `/municipio/${first.codigo_ine}?desde=${selectedCat}`
          : `/municipio/${first.codigo_ine}`;
      }
    });
  } else {
    window.location.href = `/ranking/${cat}`;
  }
}
</script>

