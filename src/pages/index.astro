---
import { DB } from '../lib/d1client';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { TABS, SIDEBAR_GROUPS, formatPob, getSubtitle } from '../lib/db';
import { getProvGradient } from '../lib/utils';
import { getBanner } from '../lib/banners';

const bannerTop = await getBanner('home_top');
const bannerCats = await getBanner('home_cats');
const pmbCount = (await DB.prepare(`SELECT COUNT(DISTINCT codigo_ine) n FROM entidades WHERE fuente='pueblos_mas_bonitos'`).first() as any)?.n ?? 0;
const baCount  = (await DB.prepare(`SELECT COUNT(DISTINCT codigo_ine) n FROM entidades WHERE fuente='bandera_azul'`).first() as any)?.n ?? 0;
const unCount  = (await DB.prepare(`SELECT COUNT(DISTINCT nombre) n FROM entidades WHERE fuente='unesco'`).first() as any)?.n ?? 0;
// @ts-ignore


const { results: rankingGlobal } = await DB.prepare(`
  SELECT m.codigo_ine, m.nombre, m.provincia, m.comunidad, m.comarca, m.poblacion,
         m.why_json, m.foto_url, p.puntuacion, p.ranking_provincial
  FROM puntuaciones p
  JOIN municipios m ON p.codigo_ine = m.codigo_ine
  WHERE p.categoria = 'ranking_global' AND COALESCE(m.es_duplicado, 0) = 0
  ORDER BY p.puntuacion DESC
  LIMIT 20
`).all();

// Datos para el mapa embebido (top 500 por ranking global, con coordenadas)
const { results: mapRows } = await DB.prepare(`
  SELECT m.codigo_ine, m.nombre, m.provincia, m.latitud, m.longitud, ROUND(p.puntuacion,1) AS s
  FROM puntuaciones p
  JOIN municipios m ON m.codigo_ine = p.codigo_ine
  WHERE p.categoria = 'ranking_global' AND COALESCE(m.es_duplicado,0) = 0
    AND m.latitud IS NOT NULL AND m.latitud <> 0 AND p.puntuacion > 0
  ORDER BY p.puntuacion DESC
  LIMIT 500
`).all();
const homeMapData = JSON.stringify((mapRows as any[]).map(r => ({
  c: r.codigo_ine, n: r.nombre, p: r.provincia,
  lat: Math.round(r.latitud * 10000) / 10000, lon: Math.round(r.longitud * 10000) / 10000, s: r.s,
})));

const { results: provincias } = await DB.prepare(
  `SELECT DISTINCT provincia FROM municipios ORDER BY provincia`
).all();

const { results: ccaas } = await DB.prepare(
  `SELECT DISTINCT comunidad FROM municipios ORDER BY comunidad`
).all();

const totalRow = await DB.prepare(`SELECT COUNT(*) as n FROM municipios`).first();
const total = totalRow?.n ?? 0;

// Instagramers para home: directo de instagramers (verificado=1), ya incluye los migrados de creadores
const { results: _igAll } = await DB.prepare(
  `SELECT id, handle, nombre, avatar_url, especialidad, seguidores, (avatar_data IS NOT NULL) AS has_avatar
   FROM instagramers WHERE verificado=1 ORDER BY orden ASC, seguidores DESC LIMIT 6`
).all();
const igHome = (_igAll as any[]).map((c) => ({
  ...c,
  handle: String(c.handle || '').replace(/^@/, ''),
  // Foto subida (avatar_data) → se sirve por el endpoint; si no, la avatar_url externa
  avatar_url: c.has_avatar ? `/api/instagramer-foto?id=${c.id}` : (c.avatar_url || null),
}));

// Top 3 del voto del público (para el CTA de la home)
const { results: topVotosRows } = await DB.prepare(
  `SELECT codigo_ine, nombre, provincia, votos FROM votos WHERE votos > 0 ORDER BY votos DESC, nombre ASC LIMIT 3`
).all();
const topVotos = (topVotosRows as any[]) ?? [];
const medallas = ['🥇', '🥈', '🥉'];

// Experiencias del planificador de rutas (mismas claves que /ruta)
const ROUTE_EXP = [
  { key: 'monumentos',        icon: 'account_balance', label: 'Monumentos' },
  { key: 'castillos',         icon: 'castle',          label: 'Castillos' },
  { key: 'museos',            icon: 'museum',          label: 'Museos' },
  { key: 'TurismoRural',      icon: 'cottage',         label: 'Turismo rural' },
  { key: 'oleoturismo',       icon: 'opacity',         label: 'Oleoturismo' },
  { key: 'turismo_activo',    icon: 'mountain',        label: 'Turismo activo' },
  { key: 'senderismo',        icon: 'hiking',          label: 'Senderismo' },
  { key: 'turismo_religioso', icon: 'church',          label: 'Turismo religioso' },
  { key: 'turismo_mascotas',  icon: 'pets',            label: 'Con mascotas' },
  { key: 'turismo_lgtbi',     icon: 'rainbow',         label: 'LGTBI' },
  { key: 'vinos',             icon: 'wine_bar',        label: 'Vinos y bodegas' },
  { key: 'miradores',         icon: 'binoculars',      label: 'Miradores' },
  { key: 'lujo',              icon: 'diamond',         label: 'Turismo de lujo' },
  { key: 'solteros',          icon: 'nightlife',       label: 'Solteros' },
  { key: 'misterioso',        icon: 'dark_mode',       label: 'Turismo misterioso' },
];

// Carruseles rotativos: cada día se muestran categorías y zonas distintas (determinista por fecha)
const POOL_CATS = [
  { key: 'senderismo',  label: 'Top senderismo',   icon: 'hiking',        sub: 'rutas señalizadas para caminar' },
  { key: 'naturaleza',  label: 'Top naturaleza',   icon: 'landscape',     sub: 'parques, gargantas y parajes' },
  { key: 'Playas',      label: 'Top playas',       icon: 'beach_access',  sub: 'costa, calas y baño' },
  { key: 'gastronomia', label: 'Top gastronomía',  icon: 'restaurant',    sub: 'dónde se come mejor' },
  { key: 'monumentos',  label: 'Top monumentos',   icon: 'fort',          sub: 'patrimonio e historia' },
  { key: 'fiestas',     label: 'Top fiestas',      icon: 'celebration',   sub: 'ferias, romerías y tradición' },
  { key: 'castillos',   label: 'Top castillos',    icon: 'castle',        sub: 'fortalezas y torres' },
  { key: 'museos',      label: 'Top museos',       icon: 'museum',        sub: 'arte, historia y ciencia' },
  { key: 'pozas',       label: 'Top pozas y baños naturales', icon: 'water', sub: 'cascadas y baño de agua dulce' },
  { key: 'miradores',   label: 'Top miradores',    icon: 'binoculars',    sub: 'las mejores vistas' },
  { key: 'TurismoRural',label: 'Top turismo rural',icon: 'cottage',       sub: 'pueblos para desconectar' },
  { key: 'ciclismo',    label: 'Top cicloturismo', icon: 'pedal_bike',    sub: 'vías verdes y rutas en bici' },
  { key: 'balnearios',  label: 'Top balnearios y termas', icon: 'hot_tub', sub: 'aguas termales y bienestar' },
  { key: 'misterioso',  label: 'Top misterio',     icon: 'dark_mode',     sub: 'leyendas y megalitos' },
  { key: 'turismo_religioso', label: 'Top turismo religioso', icon: 'church', sub: 'santuarios y devoción' },
  { key: 'festivales',  label: 'Top festivales',   icon: 'festival',      sub: 'música, cine y cultura' },
  { key: 'hoteles_encanto', label: 'Top hoteles con encanto', icon: 'cottage', sub: 'dormir en sitios únicos' },
  { key: 'vinos',       label: 'Top vinos y bodegas', icon: 'wine_bar',   sub: 'enoturismo' },
  { key: 'oleoturismo', label: 'Top oleoturismo',  icon: 'opacity',       sub: 'almazaras y mar de olivos' },
  { key: 'turismo_mascotas', label: 'Top con mascotas', icon: 'pets',     sub: 'viajar con tu perro' },
  { key: 'estrellas',   label: 'Top astroturismo', icon: 'nights_stay',   sub: 'cielos para ver estrellas' },
  { key: 'turismo_activo', label: 'Top turismo activo', icon: 'mountain', sub: 'ferratas, escalada y aventura' },
  { key: 'lujo',        label: 'Top lujo',         icon: 'diamond',       sub: 'hoteles 5 estrellas y exclusividad' },
  { key: 'pueblo_bonito', label: 'Top pueblos bonitos', icon: 'auto_awesome', sub: 'los pueblos con más encanto' },
  { key: 'cuevas',      label: 'Top cuevas',       icon: 'mountain',      sub: 'cuevas turísticas' },
];
const dia = Math.floor(Date.now() / 86400000);
const pick = (arr: any[], n: number, salt: number) => {
  const out: any[] = [];
  for (let i = 0; out.length < n && i < arr.length; i++) {
    out.push(arr[(dia * 7 + salt + i * 5) % arr.length]);
    // evitar repetidos
    if (new Set(out.map((x: any) => x.key ?? x)).size < out.length) out.pop();
  }
  return out;
};
const catsHoy = pick(POOL_CATS, 4, 3);

// zona del día: una comunidad y una provincia
const ccaaHoy = (ccaas as any[]).map(r => r.comunidad).filter(Boolean)[(dia * 3) % (ccaas as any[]).length];
const provHoy = (provincias as any[]).map(r => r.provincia).filter(Boolean)[(dia * 11) % (provincias as any[]).length];

const carruseles: any[] = [];
for (const c of catsHoy) {
  const { results } = await DB.prepare(`
    SELECT m.codigo_ine, m.nombre, m.provincia, m.comarca, m.poblacion, m.foto_url, p.puntuacion
    FROM puntuaciones p JOIN municipios m ON p.codigo_ine = m.codigo_ine
    WHERE p.categoria = ? AND p.puntuacion > 0 AND COALESCE(m.es_duplicado,0) = 0
    ORDER BY p.puntuacion DESC LIMIT 10
  `).bind(c.key).all();
  carruseles.push({ ...c, href: `/ranking/${c.key}`, items: (results as any[]).map(r => ({
    ...r, gradient: getProvGradient(r.provincia), foto: r.foto_url && r.foto_url !== 'NONE' ? r.foto_url : null,
  })) });
}
// ── LOS MEJORES SITIOS (ranking por NOMBRE de sitio, no por municipio) ──
const SITIOS_CATS = [
  { cat: 'naturaleza', tipos: ['espacio'], label: 'Sitios de naturaleza', emoji: '🌿' },
  { cat: 'senderismo', tipos: ['sendero'], label: 'Rutas de senderismo', emoji: '🥾' },
  { cat: 'Playas', tipos: ['playa'], label: 'Playas', emoji: '🏖️' },
  { cat: 'cuevas', tipos: ['cueva'], label: 'Cuevas', emoji: '🕳️' },
  { cat: 'miradores', tipos: ['mirador'], label: 'Miradores', emoji: '🌄' },
  { cat: 'pozas', tipos: ['poza', 'cascada'], label: 'Pozas y cascadas', emoji: '💦' },
  { cat: 'turismo_activo', tipos: ['activo'], label: 'Aventura', emoji: '🧗' },
];
const sitiosHome: any[] = [];
for (const sc of SITIOS_CATS) {
  const { results } = await DB.prepare(`
    SELECT e.nombre, e.foto_url, m.foto_url AS muni_foto, m.nombre AS municipio, m.provincia, e.puntuacion
    FROM entidades e JOIN municipios m ON m.codigo_ine = e.codigo_ine
    WHERE e.puntuacion IS NOT NULL AND e.tipo IN (${sc.tipos.map(() => '?').join(',')})
      AND COALESCE(m.es_duplicado,0)=0
    GROUP BY LOWER(e.nombre)
    ORDER BY e.puntuacion DESC LIMIT 10
  `).bind(...sc.tipos).all();
  const lista = (results as any[]) || [];
  // se muestran los 3 primeros, pero la foto puede venir de cualquiera del top-10
  if (lista.length >= 3) sitiosHome.push({
    ...sc, href: `/entidades/${sc.cat}`, top: lista.slice(0, 3),
    foto: lista.find(t => t.foto_url && t.foto_url.startsWith('https://upload.wikimedia.org'))?.foto_url
       // respaldo: foto del municipio del mejor sitio (p. ej. los senderos rara vez tienen foto propia)
       || lista.find(t => t.muni_foto && t.muni_foto.startsWith('https://upload.wikimedia.org'))?.muni_foto
       || null,
  });
}

// carruseles geográficos (por ranking global dentro de la zona)
for (const zona of [
  { campo: 'comunidad', valor: ccaaHoy, label: `Top ${ccaaHoy}`, icon: 'emoji_events', sub: 'los mejores municipios de la comunidad', href: `/ranking/ranking_global?ccaa=${encodeURIComponent(ccaaHoy)}` },
  { campo: 'provincia', valor: provHoy, label: `Top ${provHoy}`, icon: 'map_pin', sub: 'los mejores municipios de la provincia', href: `/ranking/ranking_global?provincia=${encodeURIComponent(provHoy)}` },
]) {
  const { results } = await DB.prepare(`
    SELECT m.codigo_ine, m.nombre, m.provincia, m.comarca, m.poblacion, m.foto_url, p.puntuacion
    FROM puntuaciones p JOIN municipios m ON p.codigo_ine = m.codigo_ine
    WHERE p.categoria = 'ranking_global' AND p.puntuacion > 0 AND COALESCE(m.es_duplicado,0) = 0 AND m.${zona.campo} = ?
    ORDER BY p.puntuacion DESC LIMIT 10
  `).bind(zona.valor).all();
  carruseles.push({ key: 'ranking_global', label: zona.label, icon: zona.icon, sub: zona.sub, href: zona.href, items: (results as any[]).map(r => ({
    ...r, gradient: getProvGradient(r.provincia), foto: r.foto_url && r.foto_url !== 'NONE' ? r.foto_url : null,
  })) });
}
// intercalar: 2 categorías, CCAA, 2 categorías, provincia
const ordenados = [carruseles[0], carruseles[1], carruseles[4], carruseles[2], carruseles[3], carruseles[5]].filter(c => c && c.items.length >= 4);
carruseles.length = 0; carruseles.push(...ordenados);

const municipios = (rankingGlobal as any[]).map(r => ({
  ...r,
  why: r.why_json ? (() => { try { return JSON.parse(r.why_json); } catch { return []; } })() : [],
  gradient: getProvGradient(r.provincia),
  foto: r.foto_url && r.foto_url !== 'NONE' ? r.foto_url : null,
}));
---
<Base title="Ranking Municipios España 2025 — Mejores pueblos y destinos turísticos"
  description="Descubre cuál es el mejor pueblo de España para tu próximo viaje. Rankings por historia, naturaleza, gastronomía, fiestas y más. Compara entre 8.000+ municipios.">

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Ranking Spain",
  "url": "https://rankingspain.com",
  "description": "Ranking turístico de todos los municipios de España. Descubre el mejor pueblo para tu viaje.",
  "inLanguage": "es",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://rankingspain.com/ranking/ranking_global?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
})} />

<!-- ── HERO ── -->
<section class="hero-section">
  <div class="hero-inner">
    <h1 class="hero-title">El ranking de los municipios de España</h1>
    <p class="hero-sub">Ordenados con datos verificados, no opiniones.</p>

    <!-- Acción principal -->
    <a href="/ranking/ranking_global" class="hero-cta-main">
      <Icon name="emoji_events" size={20} class="hcm-trophy" />
      <span>Ver el ranking de España</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" width="18" height="18"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>

    <!-- Categorías: desplegable "Elige una experiencia" -->
    <div class="hero-cats-wrap">
      <button type="button" class="hero-cats-toggle" id="hero-cats-toggle" aria-expanded="false">Elige una experiencia <span class="hct-arrow">▾</span></button>
      <div class="hero-cats" id="hero-cats" hidden>
        {[
          {key:'senderismo',        icon:'hiking',          label:'Senderismo'},
          {key:'naturaleza',        icon:'landscape',       label:'Naturaleza'},
          {key:'monumentos',        icon:'account_balance', label:'Monumentos'},
          {key:'castillos',         icon:'castle',          label:'Castillos'},
          {key:'museos',            icon:'museum',          label:'Museos'},
          {key:'gastronomia',       icon:'restaurant',      label:'Gastronomía'},
          // --- el resto se despliega con "Ver más" ---
          {key:'hoteles_encanto',   icon:'cottage',         label:'Hoteles con encanto'},
          {key:'ciclismo',          icon:'pedal_bike',      label:'Cicloturismo'},
          {key:'estrellas',         icon:'nights_stay',     label:'Astroturismo'},
          {key:'balnearios',        icon:'hot_tub',         label:'Balnearios y termas'},
          {key:'cuevas',            icon:'mountain',        label:'Cuevas turísticas'},
          {key:'TurismoRural',      icon:'cottage',         label:'Turismo Rural'},
          {key:'pueblo_bonito',     icon:'auto_awesome',    label:'Pueblos bonitos'},
          {key:'turismo_activo',    icon:'mountain',        label:'Turismo activo'},
          {key:'Playas',            icon:'beach_access',    label:'Playas'},
          {key:'Campings',          icon:'camping',         label:'Camping'},
          {key:'vinos',             icon:'wine_bar',        label:'Vinos'},
          {key:'miradores',         icon:'binoculars',      label:'Miradores'},
          {key:'lujo',              icon:'diamond',         label:'Turismo de lujo'},
          {key:'solteros',          icon:'nightlife',       label:'Solteros'},
          {key:'misterioso',        icon:'dark_mode',       label:'Turismo misterioso'},
          {key:'oleoturismo',       icon:'opacity',         label:'Oleoturismo'},
          {key:'fiestas',           icon:'celebration',     label:'Fiestas'},
          {key:'festivales',        icon:'festival',        label:'Festivales'},
          {key:'turismo_religioso', icon:'church',          label:'Turismo religioso'},
          {key:'turismo_mascotas',  icon:'pets',            label:'Turismo con mascotas'},
          {key:'turismo_lgtbi',     icon:'rainbow',         label:'Turismo LGTBI'},
          {key:'notoriedad_instagram', icon:'trending_up',  label:'Popularidad en redes'},
        ].map((c) => (
          <a class="hero-cat-pill" href={`/ranking/${c.key}`}>
            <span class="hero-cat-ic"><Icon name={c.icon} size={17} /></span>
            <span class="hero-cat-label">{c.label}</span>
          </a>
        ))}
      </div>
    </div>

  </div>
</section>

<!-- ── ¿EN QUÉ ES CAMPEÓN TU MUNICIPIO? ── -->
<section class="campeon-sec">
  <div class="campeon-card">
    <div class="campeon-left">
      <span class="campeon-eyebrow">🏆 Nuevo</span>
      <h2 class="campeon-title">¿En qué es campeón tu municipio?</h2>
      <p class="campeon-sub">Escríbelo y descubre al instante en qué es de los mejores de España. Compártelo con quien más presume de pueblo.</p>
    </div>
    <div class="campeon-right">
      <div class="campeon-search-wrap">
        <div class="campeon-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2.2" stroke-linecap="round" width="19" height="19"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <input id="campeon-input" type="text" placeholder="Tu municipio… (Frigiliana, Cazorla…)" autocomplete="off" />
        </div>
        <div id="campeon-ac" class="campeon-ac"></div>
      </div>
    </div>
  </div>
</section>
<script is:inline>
  (function () {
    var input = document.getElementById('campeon-input');
    var ac = document.getElementById('campeon-ac');
    if (!input || !ac) return;
    var timer;
    input.addEventListener('input', function () {
      var q = input.value.trim();
      clearTimeout(timer);
      if (q.length < 2) { ac.innerHTML = ''; return; }
      timer = setTimeout(function () {
        fetch('/api/search?q=' + encodeURIComponent(q))
          .then(function (r) { return r.json(); })
          .then(function (data) {
            var muns = (data || []).filter(function (d) { return d.tipo === 'municipio'; }).slice(0, 6);
            ac.innerHTML = muns.map(function (m) {
              var nom = String(m.nombre || '').replace(/[&<>]/g, '');
              var prov = String(m.provincia || '').replace(/[&<>]/g, '');
              return '<a href="/campeon/' + m.codigo_ine + '" style="display:flex;align-items:center;gap:10px;padding:12px 16px;text-decoration:none;border-bottom:1px solid #f2f2f2;background:#fff" onmouseover="this.style.background=\'#fff1f3\'" onmouseout="this.style.background=\'#fff\'">'
                + '<span style="font-size:1rem">🏆</span>'
                + '<span style="flex:1;font-size:.93rem;font-weight:700;color:#222;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + nom + '<span style="font-weight:400;color:#888;font-size:.8rem;margin-left:7px">' + prov + '</span></span>'
                + '<span style="color:#FF385C;font-weight:700">→</span></a>';
            }).join('');
          })
          .catch(function () { ac.innerHTML = ''; });
      }, 180);
    });
    document.addEventListener('click', function (e) {
      if (!ac.contains(e.target) && e.target !== input) ac.innerHTML = '';
    });
  })();
</script>

<!-- ── TOP MUNICIPIOS: CARRUSELES ── -->
<div class="page-content">
  <div class="info-bar">
    <div class="istat"><div class="n">{total.toLocaleString('es-ES')}</div><div class="l">Municipios</div></div>
    <div class="istat"><div class="n">{provincias.length}</div><div class="l">Provincias</div></div>
    <div class="istat"><div class="n">{ccaas.length}</div><div class="l">CC.AA.</div></div>
  </div>

  <div class="result-header">
    <div>
      <h2><Icon name="emoji_events" size={20} /> Top ranking España</h2>
      <div class="sub">Los mejores destinos según nuestro ranking global</div>
    </div>
    <a href="/ranking/ranking_global" class="car-verlink">Ver todo el ranking →</a>
  </div>
  <div class="car-wrap">
  <button class="car-arrow car-prev" aria-label="Anterior">‹</button>
  <div class="car-row">
    {municipios.slice(0, 14).map((m, i) => (
      <a href={`/municipio/${m.codigo_ine}`} class="mun-card" data-codigo={m.foto ? null : m.codigo_ine}>
        <div class="mun-card-bg" style={m.foto ? `background:url('${m.foto}') center/cover no-repeat` : `background:${m.gradient}`} data-gradient={m.foto ? null : m.gradient}>
          <div class="mun-card-overlay"></div>
          <div class="mun-card-pos">#{i + 1}</div>
        </div>
        <div class="mun-card-body">
          <div class="mun-card-comarca">{m.comarca ?? m.provincia}</div>
          <div class="mun-card-name">{m.nombre}</div>
          <div class="mun-card-score">
            <span class="mun-score-star">⭐</span>
            <span class="mun-score-val">{Number(m.puntuacion).toFixed(1)}</span>
            <span class="mun-card-pob">{m.poblacion ? '· ' + formatPob(m.poblacion) + ' hab.' : ''}</span>
          </div>
        </div>
      </a>
    ))}
    <a href="/ranking/ranking_global" class="car-more-card">Ver todo el ranking →</a>
  </div>
  <button class="car-arrow car-next" aria-label="Siguiente">›</button>
  <div class="car-hint">desliza <span>→</span></div>
  </div>

  {carruseles.map(c => (
    <>
      <div class="result-header car-header">
        <div>
          <h2><Icon name={c.icon} size={20} /> {c.label}</h2>
          <div class="sub">{c.sub}</div>
        </div>
        <a href={c.href} class="car-verlink">Ver ranking completo →</a>
      </div>
      <div class="car-wrap">
      <button class="car-arrow car-prev" aria-label="Anterior">‹</button>
