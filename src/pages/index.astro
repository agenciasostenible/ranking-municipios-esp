<section class="route-promo">
  <form class="rp-card" method="get" action="/ruta" id="rp-card" data-mode="zona">
    <div class="rp-head">
      <span class="rp-ic"><Icon name="map" size={21} /></span>
      <div>
        <span class="rp-eyebrow">Nuevo · Planifica tu ruta</span>
        <h2 class="rp-title">Monta tu viaje real en 1 minuto</h2>
      </div>
    </div>
    <p class="rp-sub">Te decimos <strong>qué visitar</strong>, <strong>dónde comer</strong> y <strong>dónde dormir</strong>, con la valoración de Google. Elige una <strong>zona</strong>… o el <strong>plan de un día</strong> dentro de un solo pueblo.</p>

    <div class="rp-modes" role="tablist">
      <button type="button" class="rp-mode on" data-mode="zona"><Icon name="compass" size={15} /> Por la zona</button>
      <button type="button" class="rp-mode" data-mode="pueblo"><Icon name="map_pin" size={15} /> Un día en un pueblo</button>
    </div>

    <button type="button" class="rp-label rp-chips-toggle" id="rp-chips-toggle">
      <span>¿Qué quieres hacer? <span class="rp-hint-zona">(elige una o varias)</span><span class="rp-hint-pueblo">(opcional)</span> <span class="rp-pick-count" id="rp-pick-count"></span></span>
      <span class="rp-chev">▾</span>
    </button>
    <div class="rp-chips">
      {ROUTE_EXP.map(e => (
        <label class="rp-chip">
          <input type="checkbox" name="cat" value={e.key} />
          <span class="rp-chip-ic"><Icon name={e.icon} size={15} /></span>
          {e.label}
        </label>
      ))}
    </div>

    <div class="rp-row rp-block-zona">
      <select name="prov" class="rp-prov">
        <option value="">Elige provincia…</option>
        {(provincias as any[]).map(p => <option value={p.provincia}>{p.provincia}</option>)}
      </select>
      <input type="hidden" name="dias" value="2" />
      <button type="submit" class="rp-go"><Icon name="map" size={17} /> Generar ruta</button>
    </div>

    <div class="rp-block-pueblo">
      <div class="rp-ac-wrap">
        <input type="text" id="rp-pueblo-input" class="rp-prov" placeholder="Escribe un municipio… (Granada, Alcalá la Real…)" autocomplete="off" />
        <div class="rp-ac" id="rp-pueblo-ac"></div>
      </div>
    </div>
  </form>
</section>
<script>
  const rpCard = document.querySelector('.rp-card') as HTMLFormElement | null;
  // Desplegable de experiencias (compacto): abrir/cerrar + contador
  const rpToggle = document.getElementById('rp-chips-toggle');
  const rpCount = document.getElementById('rp-pick-count');
  rpToggle?.addEventListener('click', () => rpCard?.classList.toggle('chips-open'));
  function rpUpdateCount() {
    const n = rpCard?.querySelectorAll('.rp-chip input:checked').length || 0;
    if (rpCount) rpCount.textContent = n ? `· ${n} elegida${n > 1 ? 's' : ''}` : '';
  }
  rpCard?.querySelectorAll('.rp-chip input').forEach((inp) => {
    inp.addEventListener('change', (e) => {
      const el = e.target as HTMLInputElement;
      el.closest('.rp-chip')?.classList.toggle('on', el.checked);
      rpUpdateCount();
    });
  });
  rpCard?.addEventListener('submit', (e) => {
    if (rpCard.getAttribute('data-mode') !== 'zona') { e.preventDefault(); return; }
    const any = rpCard.querySelectorAll('.rp-chip input:checked').length > 0;
    if (!any) {
      e.preventDefault();
      rpCard.classList.add('chips-open');   // abre el desplegable para que elija
      rpCard.querySelector('.rp-label')?.animate(
        [{ color: '#FF385C' }, { color: '' }], { duration: 1200 }
      );
      (rpCard.querySelector('.rp-chip') as HTMLElement)?.focus();
    }
  });

  // Conmutador de modo: "Por la zona" / "Un día en un pueblo"
  rpCard?.querySelectorAll('.rp-mode').forEach((b) => {
    b.addEventListener('click', () => {
      const m = b.getAttribute('data-mode') || 'zona';
      rpCard.setAttribute('data-mode', m);
      rpCard.querySelectorAll('.rp-mode').forEach((x) => x.classList.toggle('on', x === b));
      if (m === 'pueblo') (document.getElementById('rp-pueblo-input') as HTMLInputElement | null)?.focus();
    });
  });

  // Autocompletado de municipio para el modo "un día en un pueblo"
  const rpInput = document.getElementById('rp-pueblo-input') as HTMLInputElement | null;
  const rpAc = document.getElementById('rp-pueblo-ac');
  const rpCats = () => {
    const ks = Array.from(rpCard?.querySelectorAll('.rp-chip input:checked') ?? [])
      .map((i) => (i as HTMLInputElement).value);
    return ks.length ? '&' + ks.map((k) => 'cat=' + encodeURIComponent(k)).join('&') : '';
  };
  let rpTimer: any;
  rpInput?.addEventListener('input', () => {
    const q = rpInput.value.trim();
    clearTimeout(rpTimer);
    if (q.length < 2) { if (rpAc) rpAc.innerHTML = ''; return; }
    rpTimer = setTimeout(async () => {
      try {
        const res = await fetch('/api/search?q=' + encodeURIComponent(q));
        const data = await res.json();
        const muns = ((data as any[]) || []).filter((d) => d.tipo === 'municipio').slice(0, 6);
        if (rpAc) rpAc.innerHTML = muns.map((m) => {
          const nom = String(m.nombre || '').replace(/[&<>]/g, '');
          const prov = String(m.provincia || '').replace(/[&<>]/g, '');
          return `<a href="/ruta?pueblo=${m.codigo_ine}${rpCats()}" style="display:flex;align-items:center;gap:10px;padding:11px 15px;text-decoration:none;border-bottom:1px solid #f2f2f2;background:#fff;cursor:pointer" onmouseover="this.style.background='#fff1f3'" onmouseout="this.style.background='#fff'"><span style="flex-shrink:0;color:#FF385C;line-height:0"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg></span><span style="flex:1;min-width:0;font-size:.92rem;font-weight:700;color:#222;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${nom}<span style="font-weight:400;color:#888;font-size:.82rem;margin-left:7px">${prov}</span></span></a>`;
        }).join('');
      } catch (e) { if (rpAc) rpAc.innerHTML = ''; }
    }, 180);
  });
  document.addEventListener('click', (e) => {
    if (rpAc && !rpAc.contains(e.target as Node) && e.target !== rpInput) rpAc.innerHTML = '';
  });
</script>

