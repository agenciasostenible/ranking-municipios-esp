/* Municipio grid */
.mun-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-bottom: 8px;
}

:global(.mun-card) {
  background: var(--card);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow);
  text-decoration: none;
  color: var(--text);
  transition: transform .22s ease, box-shadow .22s ease;
  display: flex;
  flex-direction: column;
}
:global(.mun-card:hover) {
  transform: translateY(-4px);
  box-shadow: var(--shadow-hover);
}
:global(.mun-card-bg) {
  height: 160px;
  position: relative;
  flex-shrink: 0;
  transition: transform .55s cubic-bezier(.2, .6, .2, 1);
  will-change: transform;
}
/* Toque Airbnb: la foto hace zoom suave al pasar el ratón (la tarjeta recorta) */
:global(.mun-card:hover .mun-card-bg) { transform: scale(1.06); }
:global(.mun-card:hover .mun-card-pos) { transform: scale(.943); }
:global(.mun-card-overlay) {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,.1) 0%, rgba(0,0,0,.35) 100%);
}
:global(.mun-card-pos) {
  position: absolute;
  top: 10px;
  left: 12px;
  transform-origin: top left;
  transition: transform .55s cubic-bezier(.2, .6, .2, 1);
  background: rgba(0,0,0,.4);
  color: #fff;
  font-size: .75rem;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 20px;
  backdrop-filter: blur(4px);
}
:global(.mun-card-body) {
  padding: 14px 16px;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
:global(.mun-card-comarca) {
  font-size: .72rem;
  color: var(--text-2);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: .3px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
:global(.mun-card-name) {
  font-size: 1rem;
  font-weight: 700;
  color: var(--text);
  line-height: 1.2;
}
:global(.mun-card-score) {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: .82rem;
  color: var(--text-2);
  margin-top: 2px;
}
:global(.mun-score-star) { font-size: .85rem; }
:global(.mun-score-val) { font-weight: 700; color: var(--text); }
:global(.mun-card-pob) { font-size: .75rem; }
:global(.mun-card-chips) {
  display: flex;
  gap: 5px;
  flex-wrap: wrap;
  margin-top: 4px;
}

