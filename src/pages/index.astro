<style>
.car-wrap { position: relative; }
.car-wrap::after { content: ''; position: absolute; top: 0; right: 0; bottom: 14px; width: 60px; background: linear-gradient(to left, var(--bg, #fafafa), transparent); pointer-events: none; }
.car-row { display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 4px 2px 14px; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
.car-row::-webkit-scrollbar { display: none; }
.car-arrow { position: absolute; top: 42%; transform: translateY(-50%); z-index: 5; width: 40px; height: 40px; border-radius: 50%; border: 1px solid #e5e5e5; background: #fff; color: #222; font-size: 1.4rem; font-weight: 700; cursor: pointer; box-shadow: 0 3px 12px rgba(0,0,0,.14); display: flex; align-items: center; justify-content: center; }
.car-prev { left: -14px; }
.car-next { right: -14px; }
.car-arrow:hover { background: #FF385C; color: #fff; border-color: #FF385C; }
@media (max-width: 760px) { .car-arrow { display: none; } .car-wrap::after { width: 36px; } }
.car-hint { display: flex; justify-content: flex-end; align-items: center; gap: 4px; font-size: .78rem; font-weight: 700; color: #b0b0b0; margin: -8px 4px 0 0; }
.car-hint span { display: inline-block; animation: carNudge 1.6s ease-in-out infinite; color: #FF385C; font-size: .95rem; }
@keyframes carNudge { 0%,100% { transform: translateX(0); } 50% { transform: translateX(5px); } }
.car-row::-webkit-scrollbar { height: 8px; }
.car-row::-webkit-scrollbar-thumb { background: #ddd; border-radius: 99px; }
.car-row .mun-card { flex: 0 0 235px; scroll-snap-align: start; }
.car-header { margin-top: 30px; }
.car-verlink { color: var(--primary, #FF385C); font-weight: 700; font-size: .9rem; text-decoration: none; white-space: nowrap; }
.car-verlink:hover { text-decoration: underline; }
.car-more-card { flex: 0 0 170px; scroll-snap-align: start; display: flex; align-items: center; justify-content: center; text-align: center; border: 2px dashed #e0e0e0; border-radius: 16px; color: var(--primary, #FF385C); font-weight: 700; font-size: .92rem; text-decoration: none; padding: 16px; }
.car-more-card:hover { border-color: var(--primary, #FF385C); background: #fff8f9; }
@media (max-width: 600px) { .car-row .mun-card { flex: 0 0 200px; } }
</style>
<script is:inline>
  document.querySelectorAll('.car-wrap').forEach(function (w) {
    var row = w.querySelector('.car-row');
    if (!row) return;
    var prev = w.querySelector('.car-prev'), next = w.querySelector('.car-next');
    if (prev) prev.addEventListener('click', function () { row.scrollBy({ left: -520, behavior: 'smooth' }); });
    if (next) next.addEventListener('click', function () { row.scrollBy({ left: 520, behavior: 'smooth' }); });
  });
</script>
