<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="" is:inline></script>
<script is:inline>
  (function () {
    var raw = document.getElementById('home-map-data');
    var el = document.getElementById('home-map');
    if (!raw || !el || !window.L) return;
    var items = JSON.parse(raw.textContent);
    if (!items.length) return;
    var scores = items.map(function (d) { return d.s; });
    var lo = Math.min.apply(null, scores), hi = Math.max.apply(null, scores);
    var norm = function (s) { return hi > lo ? (s - lo) / (hi - lo) : 1; };
    var map = L.map('home-map', { scrollWheelZoom: false, zoomControl: true }).setView([40.2, -3.6], 5);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 18, attribution: '&copy; OpenStreetMap' }).addTo(map);
    function esc(t) { return String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
    items.forEach(function (d) {
      var t = norm(d.s);
      var color = t >= 0.66 ? '#FF385C' : t >= 0.33 ? '#FF8A5C' : '#9aa0a6';
      L.circleMarker([d.lat, d.lon], { radius: 4 + t * 8, fillColor: color, color: '#fff', weight: 1.2, fillOpacity: 0.85 })
        .bindPopup('<div style="text-align:center;min-width:140px"><div style="font-weight:700;font-size:1rem;color:#222">' + esc(d.n) + '</div><div style="font-size:.78rem;color:#717171;margin:2px 0 6px">' + esc(d.p) + ' · ' + d.s + ' pts</div><a href="/municipio/' + d.c + '" style="display:inline-block;background:#FF385C;color:#fff;font-weight:700;font-size:.82rem;padding:7px 14px;border-radius:999px;text-decoration:none">Ver ficha →</a></div>')
        .addTo(map);
    });
  })();
</script>

