{canShareRanking && (
<script define:vars={{ TOP: shareTop, CATL: shareCatLabel, SCOPE: scopeLabel, RC: catColor, PAGEURL: shareUrl }}>
  function esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  function roundRect(ctx,x,y,w,h,r){
    ctx.beginPath(); ctx.moveTo(x+r,y);
    ctx.arcTo(x+w,y,x+w,y+h,r); ctx.arcTo(x+w,y+h,x,y+h,r);
    ctx.arcTo(x,y+h,x,y,r); ctx.arcTo(x,y,x+w,y,r); ctx.closePath();
  }

  // Imagen vertical (Stories) dibujada DIRECTAMENTE en canvas. No usamos SVG
  // rasterizado porque iOS Safari descarta texto al convertir SVG->PNG.
  function makeCanvas(){
    var W=1080, H=1920, F="Arial, Helvetica, sans-serif";
    var cv=document.createElement('canvas'); cv.width=W; cv.height=H;
    var ctx=cv.getContext('2d'); ctx.textBaseline='alphabetic';
    ctx.fillStyle='#fff'; ctx.fillRect(0,0,W,H);
    ctx.fillStyle=RC; ctx.fillRect(0,0,W,26);

    ctx.font='700 46px '+F;
    var w1=ctx.measureText('Ranking ').width, w2=ctx.measureText('Spain').width;
    var sx=540-(w1+w2)/2; ctx.textAlign='left';
    ctx.fillStyle=RC; ctx.fillText('Ranking ', sx, 150);
    ctx.fillStyle='#222'; ctx.fillText('Spain', sx+w1, 150);

    ctx.textAlign='center';
    ctx.font='700 30px '+F; ctx.fillStyle='#888'; ctx.fillText('TOP '+TOP.length, 540, 300);
    var titleLen=(CATL||'').length, titleSize=titleLen>22?56:titleLen>16?70:84;
    ctx.font='800 '+titleSize+'px '+F; ctx.fillStyle=RC; ctx.fillText(CATL||'', 540, 392);
    ctx.font='600 34px '+F; ctx.fillStyle='#717171'; ctx.fillText(SCOPE||'', 540, 452);
    ctx.strokeStyle='#EBEBEB'; ctx.lineWidth=3;
    ctx.beginPath(); ctx.moveTo(90,510); ctx.lineTo(990,510); ctx.stroke();

    var startY=600, rowH=124;
    TOP.forEach(function(it,i){
      var cy=startY+i*rowH, pos=it.rank;
      var badgeFill=pos===1?'#F5C518':pos===2?'#B9C0C7':pos===3?'#CD8B45':'#FFF1F3';
      var badgeTxt=pos<=3?'#ffffff':RC;
      var nm=(it.nombre||''); if(nm.length>20) nm=nm.slice(0,19)+'…';
      ctx.beginPath(); ctx.arc(150,cy,46,0,Math.PI*2); ctx.fillStyle=badgeFill; ctx.fill();
      ctx.textAlign='center'; ctx.font='800 42px '+F; ctx.fillStyle=badgeTxt; ctx.fillText(String(pos),150,cy+15);
      ctx.textAlign='left'; ctx.font='800 44px '+F; ctx.fillStyle='#222'; ctx.fillText(nm,232,cy+4);
      ctx.font='500 28px '+F; ctx.fillStyle='#888'; ctx.fillText(it.prov||'',232,cy+42);
      roundRect(ctx,852,cy-34,150,68,34); ctx.fillStyle=RC; ctx.fill();
      ctx.textAlign='center'; ctx.font='800 34px '+F; ctx.fillStyle='#fff'; ctx.fillText(String(it.pts),927,cy+12);
    });

    ctx.textAlign='center'; ctx.font='600 32px '+F; ctx.fillStyle='#717171'; ctx.fillText('rankingspain.com',540,1865);
    return cv;
  }

  function shareText(){ return '🏆 Top '+TOP.length+' '+CATL+' '+SCOPE+' según Ranking Spain 👇'; }

  function canvasBlob(cv){ return new Promise(function(res){ cv.toBlob(function(b){ res(b); }, 'image/png'); }); }

  async function deliverStories(span, orig){
    var blob = await canvasBlob(makeCanvas());
    var fname = 'ranking-spain-'+(CATL||'').toLowerCase().replace(/[^a-z0-9]+/g,'-')+'.png';
    if (blob && navigator.canShare && navigator.canShare({ files:[new File([blob],fname,{type:'image/png'})] })){
      try { await navigator.share({ files:[new File([blob],fname,{type:'image/png'})], text: shareText()+'\n'+PAGEURL }); span.textContent=orig; return; } catch(_){}
    }
    if (blob){ var a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download=fname; a.click(); setTimeout(function(){ URL.revokeObjectURL(a.href); },3000); }
    span.textContent=orig;
  }

  var overlay = document.getElementById('rks-overlay');
  function openRks(){
    var p=document.getElementById('rks-preview'); p.innerHTML='';
    var cv=makeCanvas(); cv.style.width='100%'; cv.style.height='auto'; cv.style.display='block'; cv.style.borderRadius='12px';
    p.appendChild(cv); overlay.classList.add('open');
  }
  function closeRks(){ overlay.classList.remove('open'); }

  document.getElementById('rank-share-btn').addEventListener('click', openRks);
  document.getElementById('rks-close').addEventListener('click', closeRks);
  overlay.addEventListener('click', function(e){ if (e.target === overlay) closeRks(); });

  document.getElementById('rks-stories').addEventListener('click', function(){
    var span = this.querySelector('span'); var orig = span.textContent; span.textContent='Preparando…';
    deliverStories(span, orig);
  });
  document.getElementById('rks-wa').addEventListener('click', function(){
    window.open('https://wa.me/?text='+encodeURIComponent(shareText()+'\n'+PAGEURL), '_blank');
  });
  document.getElementById('rks-copy').addEventListener('click', function(){
    var span = this.querySelector('span'); var orig = span.textContent;
    navigator.clipboard.writeText(PAGEURL).then(function(){ span.textContent='✓ Copiado'; setTimeout(function(){ span.textContent=orig; },1500); });
  });
</script>
)}

