async function loadScores(codigo) {
  if (scoresCache[codigo]) return scoresCache[codigo];
  const data = await fetch(`/api/municipio-scores/${codigo}`).then(r => r.json());
  scoresCache[codigo] = data;
  return data;
}
async function loadEntidades(codigo) {
  if (entidadesCache[codigo] !== undefined) return entidadesCache[codigo];
  const data = await fetch(`/api/entidades/${codigo}`).then(r => r.json());
  entidadesCache[codigo] = data;
  return data;
}

function renderDesdeEntidades(el, entidades) {
  if (!entidades.length) {
    el.outerHTML = '<div style="font-size:.8rem;color:#aaa;font-style:italic;margin-top:6px">Sin recursos específicos registrados aún.</div>';
    return;
  }
  const items = entidades.slice(0, 6).map(e => {
    const icon = TIPO_ICONS_JS[e.tipo] || '📍';
    const selloStyle = SELLO_STYLES[e.nivel_sello] || '';
    const selloHtml = e.nivel_sello
      ? `<span style="${selloStyle};padding:1px 7px;border-radius:8px;font-size:.62rem;font-weight:700;margin-left:6px">${e.nivel_sello}</span>`
      : '';
    return `<div style="display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid #f0f0f0">
      <span style="font-size:1.1rem;flex-shrink:0">${icon}</span>
      <span style="font-size:.82rem;font-weight:600;color:#222">${e.nombre}</span>${selloHtml}
    </div>`;
  }).join('');
  el.outerHTML = `<div class="desde-entidades-loaded" style="margin-top:8px">${items}</div>`;
}

function renderEntidades(el, entidades) {
  if (!entidades.length) {
    el.innerHTML = '<div style="font-size:.8rem;color:#aaa;font-style:italic">Sin datos de recursos</div>';
    return;
  }
  el.innerHTML = `<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:8px">${
    entidades.map(e => {
      const icon = TIPO_ICONS_JS[e.tipo] || '📍';
      const selloStyle = SELLO_STYLES[e.nivel_sello] || 'background:#f0f0f0;color:#666';
      const selloHtml = e.nivel_sello
        ? `<span style="${selloStyle};padding:2px 8px;border-radius:8px;font-size:.65rem;font-weight:700">${e.nivel_sello}</span>`
        : '';
      const descHtml = e.descripcion
        ? `<div style="font-size:.73rem;color:#717171;margin-bottom:5px;line-height:1.4">${e.descripcion}</div>`
        : '';
      return `<div style="background:#fff;border-radius:10px;padding:10px 12px;border:1px solid #EBEBEB;display:flex;gap:10px">
        <div style="font-size:1.4rem;flex-shrink:0;line-height:1.2">${icon}</div>
        <div>
          <div style="font-weight:600;color:#222;font-size:.82rem;margin-bottom:3px">${e.nombre}</div>
          ${descHtml}${selloHtml}
        </div>
      </div>`;
    }).join('')
  }</div>`;
}

function renderBars(el, scores) {
  const top = scores.filter(s => CAT_LABELS_JS[s.categoria] && s.puntuacion > 0)
    .sort((a, b) => b.puntuacion - a.puntuacion).slice(0, 12);
  const max = top[0]?.puntuacion || 100;
  el.innerHTML = top.map(s => {
    const color = CAT_COLORS_JS[s.categoria] || '#FF385C';
    const pct = Math.round((s.puntuacion / max) * 100);
    const label = CAT_LABELS_JS[s.categoria] || s.categoria;
    return `<div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
      <div style="width:130px;font-size:.74rem;color:#555;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${label}</div>
      <div style="flex:1;background:#F0F0F0;border-radius:3px;height:6px">
        <div style="width:${pct}%;background:${color};height:6px;border-radius:3px;transition:width .4s"></div>
      </div>
      <div style="width:32px;text-align:right;font-size:.74rem;font-weight:700;color:${color}">${s.puntuacion.toFixed(1)}</div>
    </div>`;
  }).join('');
}

async function toggleExpand(codigo) {
  const expandRow = document.getElementById(`expand-${codigo}`);

  if (openCodigo && openCodigo !== codigo) {
    const prev = document.getElementById(`expand-${openCodigo}`);
    if (prev) prev.style.display = 'none';
    const prevRow = document.querySelector(`.rank-row[data-codigo="${openCodigo}"]`);
    if (prevRow) prevRow.classList.remove('row-open');
  }

  if (openCodigo === codigo) {
    expandRow.style.display = 'none';
    document.querySelector(`.rank-row[data-codigo="${codigo}"]`)?.classList.remove('row-open');
    openCodigo = null;
    return;
  }

  openCodigo = codigo;
  expandRow.style.display = 'table-row';
  document.querySelector(`.rank-row[data-codigo="${codigo}"]`)?.classList.add('row-open');

  const desdeEntEl = expandRow.querySelector('.desde-entidades-loading');
  const barsEl = expandRow.querySelector('.bars-loading');

  const [entidades, scores] = await Promise.all([
    desdeEntEl ? loadEntidades(codigo) : Promise.resolve(null),
    barsEl ? loadScores(codigo) : Promise.resolve(null),
  ]);

  // Para Campings, mostrar why_json en lugar de entidades
  if (categoria === 'Campings') {
    if (desdeEntEl && scores && scores.length > 0) {
      const currentScore = scores.find(s => s.categoria === 'Campings');
      if (currentScore && currentScore.why_json) {
        const whyData = typeof currentScore.why_json === 'string'
          ? JSON.parse(currentScore.why_json)
          : currentScore.why_json;
        const whyText = Array.isArray(whyData) ? whyData[0] : whyData;
        if (whyText) {
          desdeEntEl.innerHTML = `<div style="font-size:.82rem;color:#222;line-height:1.5;margin-top:8px">${whyText}</div>`;
          desdeEntEl.className = 'desde-entidades-loaded';
        }
      }
    }
  } else if (desdeEntEl && entidades !== null) {
    const tipos = CAT_TIPOS_JS[categoria] || [];
    const filtradas = tipos.length
      ? entidades.filter(e => tipos.includes(e.tipo))
      : entidades;
    renderDesdeEntidades(desdeEntEl, filtradas);
  }
  if (barsEl && scores !== null) {
    barsEl.className = 'bars-loaded';
    renderBars(barsEl, scores);
  }
}

document.querySelectorAll('.rank-row').forEach(row => {
  row.style.cursor = 'pointer';
  row.addEventListener('click', () => {
    const codigo = row.getAttribute('data-codigo');
    if (codigo) window.location.href = `/municipio/${codigo}?desde=${categoria}`;
