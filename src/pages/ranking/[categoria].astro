<script define:vars={{ categoria }}>
function buildQs(cat) {
  const p = document.getElementById('fProv').value;
  const c = document.getElementById('fCCAA').value;
  const t = document.getElementById('fTam').value;
  const qs = [
    p && `provincia=${encodeURIComponent(p)}`,
    !p && c && `ccaa=${encodeURIComponent(c)}`,
    t && `tamano=${t}`,
  ].filter(Boolean).join('&');
  return `/ranking/${cat || categoria}${qs ? '?' + qs : ''}`;
}

document.getElementById('fProv').addEventListener('change', function() {
  if (this.value) document.getElementById('fCCAA').value = '';
  window.location.href = buildQs(categoria);
});
document.getElementById('fCCAA').addEventListener('change', function() {
  if (this.value) document.getElementById('fProv').value = '';
  window.location.href = buildQs(categoria);
});
document.getElementById('fTam').addEventListener('change', () => window.location.href = buildQs(categoria));
document.getElementById('fCat').addEventListener('change', function() {
  window.location.href = buildQs(this.value);
});

// Update nav links with current filters
function updateNavLinks() {
  const qs = buildQs('__CAT__').split('__CAT__')[1];
  document.querySelectorAll('a.chip-cat').forEach(a => {
    const href = a.getAttribute('href') || '';
    const m = href.match(/\/ranking\/([^?]+)/);
    if (m) a.setAttribute('href', `/ranking/${m[1]}${qs}`);
  });
}
