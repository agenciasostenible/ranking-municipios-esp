  historia:'🏛️ Historia',castillos:'🏰 Castillos',yacimientos:'⚱️ Arqueología',
  fiestas:'🎉 Fiestas',naturaleza:'🌿 Naturaleza',senderismo:'🥾 Senderismo',
  agua:'💧 Agua',gastronomia:'🍽️ Gastronomía',restaurantes_top:'⭐ Rest. top',
  estrellas:'🌌 Astroturismo',birdwatching:'🦅 Birdwatching',aceite:'🫒 Aceite',
  vinos:'🍷 Vinos',museos:'🖼️ Museos',camping:'⛺ Camping',aventura:'🧗 Aventura',
  ninos:'👨‍👩‍👧 Familias',escapada_rural:'🏡 Rural',pareja:'💑 Parejas',retiros:'🧘 Retiros',
  ciclismo:'🚵 Cicloturismo',escalada:'🧗 Escalada',pesca:'🎣 Pesca',
  playas:'🏖️ Playas',miradores:'🔭 Miradores',cuevas:'🕳️ Cuevas',
  semana_santa:'✝️ Semana Santa',lujo:'💎 Lujo',accesible:'♿ Accesible',festivales:'🎸 Festivales',
  pueblo_bonito:'🏘️ Pueblos bonitos',
};

const TIPO_ICONS_JS = {
  castillo:'🏰',monumento:'🏛️',conjunto:'🏘️',yacimiento:'⚱️',
  fiesta:'🎉',espacio:'🌿',gastronomia:'🍽️',producto:'🧀',
  sendero:'🥾',mirador:'🔭',iglesia:'⛪',museo:'🖼️',
  agua:'💧',playa_fluvial:'🏖️',playa:'🏖️',montaña:'⛰️',fauna:'🦅',
  cueva:'🕳️',camping:'⛺',balneario:'♨️',ruta:'🗺️',deporte:'🚵',festival:'🎸',
};
