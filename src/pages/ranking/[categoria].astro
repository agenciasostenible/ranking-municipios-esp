---
import { DB } from '../../lib/d1client';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { TABS, SIDEBAR_GROUPS, ALL_CATS, getCatInfo, LABELS, formatPob, getSubtitle } from '../../lib/db';
import { CAT_COLORS } from '../../lib/utils';
import { getCreadores } from '../../lib/creadores';
// @ts-ignore

let { categoria } = Astro.params;

// Normalizar categoría: playas -> Playas
if (categoria === 'campings') categoria = 'Campings';
if (categoria === 'playas') categoria = 'Playas';
if (categoria === 'turismo_rural') categoria = 'TurismoRural';
if (categoria === 'soletes') return Astro.redirect('/ranking/gastronomia', 301);

const url = Astro.url;
const prov    = url.searchParams.get('provincia') ?? '';
const ccaa    = url.searchParams.get('ccaa') ?? '';
const comarca = url.searchParams.get('comarca') ?? '';
const tam     = url.searchParams.get('tamano') ?? '';
const page    = parseInt(url.searchParams.get('page') ?? '1');
const perPage = 50;
const offset  = (page - 1) * perPage;

const catLabel = LABELS[categoria!] ?? categoria!;
const creadores = await getCreadores(categoria!, prov, ccaa);
const catInfo  = getCatInfo(categoria!);
const catColor = CAT_COLORS[categoria!] ?? '#FF385C';

// Build WHERE
const whereClauses = [`p.categoria = ?`, `p.puntuacion > 0`, `COALESCE(m.es_duplicado, 0) = 0`];
const params: any[] = [categoria];
if (prov)   { whereClauses.push(`m.provincia = ?`);  params.push(prov); }
if (ccaa)   { whereClauses.push(`m.comunidad = ?`);  params.push(ccaa); }
if (comarca){ whereClauses.push(`m.comarca = ?`);    params.push(comarca); }
if (tam === 'micro') whereClauses.push(`m.poblacion < 500`);
else if (tam === 'peq') whereClauses.push(`m.poblacion >= 500 AND m.poblacion < 5000`);
else if (tam === 'med') whereClauses.push(`m.poblacion >= 5000 AND m.poblacion < 20000`);
else if (tam === 'grd') whereClauses.push(`m.poblacion >= 20000`);
const where = whereClauses.join(' AND ');

const countRow = await DB.prepare(
  `SELECT COUNT(*) as n FROM puntuaciones p JOIN municipios m ON p.codigo_ine=m.codigo_ine WHERE ${where}`
).bind(...params).first();
const totalRows = countRow?.n ?? 0;
const totalPages = Math.max(1, Math.ceil(totalRows / perPage));

const { results: rankingRaw } = await DB.prepare(`
  SELECT m.codigo_ine, m.nombre, m.provincia, m.comunidad, m.comarca, m.poblacion,
         CASE WHEN p.categoria IN ('Campings', 'TurismoRural') THEN m.why_json ELSE NULL END as why_json,
         m.foto_url, p.puntuacion, p.ranking_provincial
  FROM puntuaciones p
  JOIN municipios m ON p.codigo_ine = m.codigo_ine
  WHERE ${where}
  ORDER BY p.puntuacion DESC
  LIMIT ${perPage} OFFSET ${offset}
`).bind(...params).all();

const ranking = (rankingRaw as any[]).map(r => ({
  ...r,
  why: r.why_json ? (() => { try { return JSON.parse(r.why_json); } catch { return []; } })() : [],
  foto: r.foto_url && r.foto_url !== 'NONE' ? r.foto_url : null,
}));

const { results: provincias } = await DB.prepare(`SELECT DISTINCT provincia FROM municipios ORDER BY provincia`).all();
const { results: ccaas }     = await DB.prepare(`SELECT DISTINCT comunidad FROM municipios ORDER BY comunidad`).all();

// Count de entidades individuales para el banner de descubrimiento
const CAT_FUENTES_ENT: Record<string,string[]> = {
  castillos:['inventario_castillos_pdf','inventario_monumentos_pdf','monumentos_osm'], monumentos:['inventario_monumentos_pdf','monumentos_osm'],
  naturaleza:['inventario_naturaleza_pdf'], museos:['wikidata_museos'],
  fiestas:['inventario_fiestas_pdf'], festivales:['inventario_festivales_pdf'],
  miradores:['inventario_miradores_pdf'], oleoturismo:['inventario_oleoturismo_pdf'],
  misterioso:['inventario_misterioso_pdf','misterio_osm'], estrellas:['starlight'], senderismo:['senderos_osm','excel_curado'],
  balnearios:['balnearios','agua_osm'],
  Playas:['bandera_azul','inventario_playas_pdf'], hoteles_encanto:['hoteles_encanto'],
  TurismoRural:['rural_osm'], ciclismo:['vias_verdes','caminos_naturales','eurovelo','centros_btt','camino_cid','pirinexus'],
  vinos:['inventario_vinos_pdf','rutas_vino'], pueblo_bonito:['pueblos_mas_bonitos'],
  turismo_religioso:['inventario_turismo_religioso_pdf'], lujo:['inventario_lujo_pdf'],
  gastronomia:['guia_michelin','gastronomia_ampliacion','guia_repsol_solete','restaurantes_osm'],
  pozas:['pozas_bano','agua_osm'], cuevas:['cuevas'],
  solteros:['ocio_osm'], turismo_mascotas:['inventario_turismo_mascotas_pdf'],
  turismo_lgtbi:['inventario_turismo_lgtbi_pdf','lgtbi_osm'], turismo_activo:['inventario_turismo_activo_pdf'],
};
const ENT_PREGUNTAS: Record<string,string> = {
  castillos:'¿Cuál es el castillo más impresionante?',
  monumentos:'¿Cuál es el monumento más destacado?',
  naturaleza:'¿Cuál es el espacio natural más espectacular?',
  museos:'¿Cuál es el museo más importante?',
  fiestas:'¿Cuál es la fiesta más popular?',
  festivales:'¿Cuál es el mejor festival de España?',
  miradores:'¿Cuál es el mirador con mejores vistas?',
  oleoturismo:'¿Cuál es la mejor ruta del aceite?',
  misterioso:'¿Cuál es el lugar más misterioso?',
  estrellas:'¿Dónde ver mejor el cielo estrellado?',
  senderismo:'¿Cuál es el mejor sendero señalizado?',
  Playas:'¿Cuál es la mejor playa de España?',
  hoteles_encanto:'¿Cuál es el hotel con más encanto?',
  TurismoRural:'¿Cuál es el mejor alojamiento rural?',
  ciclismo:'¿Cuál es la mejor ruta ciclista?',
  vinos:'¿Cuál es la mejor ruta del vino?',
  pueblo_bonito:'¿Cuál es el pueblo más bonito?',
  turismo_religioso:'¿Cuál es el lugar religioso más emblemático?',
  lujo:'¿Cuál es la experiencia de lujo más exclusiva?',
  soletes:'¿Cuál es el restaurante más recomendado?',
  gastronomia:'¿Cuál es el mejor restaurante de España?',
  pozas:'¿Cuál es la mejor poza natural para bañarse?',
  cuevas:'¿Cuál es la cueva más espectacular?',
  balnearios:'¿Cuál es el mejor balneario?',
  solteros:'¿Cuál es el mejor destino para solteros?',
  turismo_mascotas:'¿Cuál es el mejor destino con mascotas?',
  turismo_lgtbi:'¿Cuál es el mejor destino LGTBI?',
  turismo_activo:'¿Cuál es la mejor experiencia de turismo activo?',
};
const CAT_TIPOS_ENT: Record<string,string[]> = { balnearios: ['balneario','termas'], senderismo: ['sendero'], castillos: ['castillo','torre','fortaleza','alcazaba','muralla'] };
const ENT_PLURAL: Record<string,string> = {
  senderismo:'senderos', gastronomia:'sitios para comer', soletes:'sitios para comer', ciclismo:'rutas ciclistas',
  oleoturismo:'rutas del aceite', turismo_religioso:'lugares religiosos', turismo_activo:'experiencias',
  turismo_mascotas:'sitios pet-friendly', turismo_lgtbi:'locales, playas y destinos LGTBI', TurismoRural:'alojamientos rurales',
  hoteles_encanto:'hoteles', misterioso:'lugares de misterio y leyenda', estrellas:'cielos Starlight',
  lujo:'experiencias de lujo', solteros:'discotecas, pubs y beach clubs', pueblo_bonito:'pueblos', vinos:'bodegas y rutas',
  balnearios:'balnearios y termas', pozas:'pozas y baños', cuevas:'cuevas', fiestas:'fiestas',
  festivales:'festivales', monumentos:'monumentos', castillos:'castillos', museos:'museos',
  miradores:'miradores', Playas:'playas', naturaleza:'espacios naturales',
};
const entFuentes = CAT_FUENTES_ENT[categoria!];
const entTipos = CAT_TIPOS_ENT[categoria!];

// Categorías hermanas: atajos "quizá buscabas…" entre categorías relacionadas
const RELATED: Record<string, { key: string; hint: string }[]> = {
  naturaleza: [ { key:'senderismo', hint:'¿Buscas rutas a pie?' }, { key:'ciclismo', hint:'¿En bici?' }, { key:'pozas', hint:'¿Baño natural?' } ],
  senderismo: [ { key:'naturaleza', hint:'¿Parajes que ver?' }, { key:'ciclismo', hint:'¿En bici?' }, { key:'turismo_activo', hint:'¿Más aventura?' } ],
  ciclismo:   [ { key:'senderismo', hint:'¿A pie?' }, { key:'naturaleza', hint:'¿Parajes que ver?' } ],
  pozas:      [ { key:'Playas', hint:'¿Playa de mar?' }, { key:'balnearios', hint:'¿Termas y spa?' }, { key:'naturaleza', hint:'¿Parajes?' } ],
  balnearios: [ { key:'pozas', hint:'¿Baño en la naturaleza?' } ],
  Playas:     [ { key:'pozas', hint:'¿Baño de interior?' } ],
  monumentos: [ { key:'castillos', hint:'¿Solo castillos?' }, { key:'museos', hint:'¿Museos?' } ],
  castillos:  [ { key:'monumentos', hint:'¿Todo el patrimonio?' } ],
  museos:     [ { key:'monumentos', hint:'¿Monumentos?' } ],
  gastronomia:[ { key:'vinos', hint:'¿Bodegas?' }, { key:'oleoturismo', hint:'¿Aceite?' } ],
};
const related = (RELATED[categoria!] ?? []).map(r => ({ ...r, info: getCatInfo(r.key), color: CAT_COLORS[r.key] ?? '#FF385C' }));
let entCount = 0;
if (entFuentes) {
  const entCountRow = await DB.prepare(
    `SELECT COUNT(DISTINCT LOWER(e.nombre)||'|'||e.codigo_ine) AS n FROM entidades e JOIN municipios m ON m.codigo_ine=e.codigo_ine WHERE e.fuente IN (${entFuentes.map(()=>'?').join(',')})${entTipos ? ` AND e.tipo IN (${entTipos.map(()=>'?').join(',')})` : ''} AND COALESCE(m.es_duplicado,0)=0`
  ).bind(...entFuentes, ...(entTipos ?? [])).first() as any;
  entCount = entCountRow?.n ?? 0;
}

const maxPts: number = ranking.length ? Math.max(...(ranking as any[]).map((r: any) => r.puntuacion ?? 0)) : 100;

// Datos para "Compartir ranking" (imagen Stories/cuadrada). Solo en la 1ª página
// (es donde está el Top real). Top 10 con su puesto, nombre, provincia y nota.
const scopeLabel = prov ? `de ${prov}` : ccaa ? `de ${ccaa}` : comarca ? `de ${comarca}` : 'de España';
const shareTop = (ranking as any[]).slice(0, 10).map((r: any, i: number) => ({
  rank: offset + i + 1, nombre: r.nombre, prov: r.provincia, pts: Number(r.puntuacion ?? 0).toFixed(1),
}));
const canShareRanking = page === 1 && shareTop.length >= 3;
const shareCatLabel = catInfo.label;
const shareUrl = url.href.replace('https://ranking-municipios-esp.pages.dev', 'https://rankingspain.com');

function buildUrl(overrides: Record<string, string | number>) {
  const p: Record<string, string> = { provincia: prov, ccaa, comarca, tamano: tam };
  Object.assign(p, Object.fromEntries(Object.entries(overrides).map(([k,v]) => [k, String(v)])));
  const qs = Object.entries(p).filter(([,v]) => v && v !== '1').map(([k,v]) => `${k}=${encodeURIComponent(v)}`).join('&');
  return `/ranking/${categoria}${qs ? '?' + qs : ''}`;
}
---
<Base
  title={`Mejores pueblos de España por ${catLabel} ${new Date().getFullYear()} — Ranking Spain`}
  description={`Ranking de los ${totalRows} mejores municipios de España por ${catInfo.label.toLowerCase()}. Descubre qué pueblo visitar, compara destinos y encuentra el viaje perfecto.`}
>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `Mejores pueblos de España por ${catLabel} ${new Date().getFullYear()}`,
  "description": `Ranking de los ${totalRows} mejores municipios de España por ${catLabel.toLowerCase()}.`,
  "url": `https://rankingspain.com/ranking/${categoria}`,
  "numberOfItems": totalRows,
  "itemListElement": ranking.slice(0, 10).map((r: any, i: number) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": r.nombre,
    "url": `https://rankingspain.com/municipio/${r.codigo_ine}`,
  })),
})} />

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://rankingspain.com/" },
    { "@type": "ListItem", "position": 2, "name": `Ranking ${catLabel}`, "item": `https://rankingspain.com/ranking/${categoria}` },
  ]
})} />

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `¿Cuál es el mejor pueblo de España para ${catLabel.toLowerCase()}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": ranking.length > 0
          ? `Según nuestro ranking, el mejor municipio de España para ${catLabel.toLowerCase()} es ${(ranking as any[])[0].nombre} (${(ranking as any[])[0].provincia}), con una puntuación de ${Number((ranking as any[])[0].puntuacion).toFixed(1)} puntos. Le siguen ${(ranking as any[]).slice(1,3).map((r:any)=>r.nombre).join(' y ')}.`
          : `Consulta el ranking actualizado en rankingspain.com/ranking/${categoria}`
      }
    },
    {
      "@type": "Question",
      "name": `¿Cuántos municipios tiene el ranking de ${catLabel.toLowerCase()}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `El ranking de ${catLabel.toLowerCase()} incluye ${totalRows} municipios de toda España, evaluados y ordenados por puntuación. Puedes filtrar por provincia, comunidad autónoma o tamaño del municipio.`
      }
    },
    {
      "@type": "Question",
      "name": `¿Cómo se calcula el ranking de ${catLabel.toLowerCase()}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `La puntuación se calcula a partir de datos objetivos: entidades registradas en OpenStreetMap, bienes de interés cultural, visitas a Wikipedia y otros indicadores públicos. El ranking se actualiza periódicamente.`
      }
    }
  ]
})} />

<!-- Category chips -->
<div class="chips-wrap">
  <button class="chips-arrow chips-arrow-left" id="chips-prev" aria-label="Anterior">&#8249;</button>
  <div class="chips-bar" id="chips-bar">
    <div class="chips-inner">
      {TABS.map(t => (
        <a href={`/ranking/${t.key}`} class={`chip-cat${t.key === categoria ? ' active' : ''}`}>
          <Icon name={t.icon} size={20} />
          {t.label}
        </a>
      ))}
    </div>
  </div>
  <button class="chips-arrow chips-arrow-right" id="chips-next" aria-label="Siguiente">&#8250;</button>
</div>
<script>
  const bar = document.getElementById('chips-bar');
  document.getElementById('chips-prev')?.addEventListener('click', () => bar?.scrollBy({ left: -300, behavior: 'smooth' }));
  document.getElementById('chips-next')?.addEventListener('click', () => bar?.scrollBy({ left: 300, behavior: 'smooth' }));
</script>

<!-- Filters -->
<div class="filters-bar">
  <div class="filter-group">
    <label>Categoría</label>
    <select id="fCat">
      {SIDEBAR_GROUPS.map(g => (
        <optgroup label={g.title}>
          {g.items.map(t => (
            <option value={t.key} selected={t.key === categoria}>{t.label}</option>
          ))}
        </optgroup>
      ))}
    </select>
  </div>
  <div class="filter-group">
    <label>Provincia</label>
    <select id="fProv">
      <option value="">Todas las provincias</option>
      {provincias.map((p: any) => <option value={p.provincia} selected={p.provincia === prov}>{p.provincia}</option>)}
    </select>
  </div>
  <div class="filter-group">
    <label>CC.AA.</label>
    <select id="fCCAA">
      <option value="">Todas</option>
      {ccaas.map((c: any) => <option value={c.comunidad} selected={c.comunidad === ccaa}>{c.comunidad}</option>)}
    </select>
  </div>
  <div class="filter-group">
    <label>Tamaño</label>
    <select id="fTam">
      <option value="" selected={!tam}>Cualquiera</option>
      <option value="micro" selected={tam==='micro'}>Micro (&lt;500)</option>
      <option value="peq" selected={tam==='peq'}>Pequeño (500–5k)</option>
      <option value="med" selected={tam==='med'}>Mediano (5k–20k)</option>
      <option value="grd" selected={tam==='grd'}>Grande (&gt;20k)</option>
    </select>
  </div>
  <a href={`/ranking/${categoria}`} class="btn-reset">✕ Limpiar</a>
</div>

<!-- Content -->
<div class="page-content">
  <div class="info-bar">
    <div class="istat"><div class="n">{totalRows.toLocaleString('es-ES')}</div><div class="l">Municipios</div></div>
    <div class="istat" style={`border-left: 3px solid ${catColor}`}>
      <div class="n" style={`color:${catColor}`}><Icon name={catInfo.icon} size={18} /> {catInfo.label}</div>
      <div class="l">Categoría activa</div>
    </div>
    {(prov || ccaa) && (
      <div class="istat"><div class="n">{prov || ccaa}</div><div class="l">Filtro geográfico</div></div>
    )}
    <div class="istat"><div class="n">{page}/{totalPages}</div><div class="l">Página</div></div>
  </div>

  <div class="top-municipios-label">🏆 Top Municipios</div>

  <div class="result-header">
    <div>
      <h2>{catLabel}</h2>
      {getSubtitle(categoria!) && <div class="cat-tagline">{getSubtitle(categoria!)}</div>}
      <div class="sub">
        {totalRows.toLocaleString('es-ES')} municipios ·
        Mostrando {(page-1)*perPage+1}–{Math.min(page*perPage, totalRows)}
        {prov ? ` en ${prov}` : ccaa ? ` en ${ccaa}` : ''}
      </div>
      {entFuentes && entCount > 0 && (
        <div class="vista-btns" style={`--ec:${catColor}`}>
          <span class="vista-btn on">Ver {catLabel} por municipios</span>
          <a href={`/entidades/${categoria}${prov ? `?provincia=${encodeURIComponent(prov)}` : ''}`} class="vista-btn">
            Ver los {entCount.toLocaleString('es-ES')} {ENT_PLURAL[categoria!] ?? catLabel.toLowerCase()} uno a uno →
          </a>
        </div>
      )}
      {related.length > 0 && (
        <div class="rel-cats">
          {related.map(r => (
            <a href={`/ranking/${r.key}${prov ? `?provincia=${encodeURIComponent(prov)}` : ''}`} class="rel-cat" style={`--rc:${r.color}`}>
              <span class="rel-hint">{r.hint}</span>
              <span class="rel-label"><Icon name={r.info.icon} size={15} /> {r.info.label} →</span>
            </a>
          ))}
        </div>
      )}
    </div>
    {canShareRanking && (
      <button type="button" class="rank-share-btn" id="rank-share-btn" style={`--rc:${catColor}`}>📲 Compartir ranking</button>
    )}
    {totalPages > 1 && (
      <div class="pg">
        {page > 1 && <a href={buildUrl({ page: page - 1 })} class="pgb">‹</a>}
        {Array.from({ length: Math.min(totalPages, 7) }, (_, i) => {
          const s = Math.max(1, page - 3);
          const p2 = s + i;
          if (p2 > totalPages) return null;
          return <a href={buildUrl({ page: p2 })} class={`pgb${p2 === page ? ' active' : ''}`}>{p2}</a>;
        })}
        {page < totalPages && <a href={buildUrl({ page: page + 1 })} class="pgb">›</a>}
        <span class="pg-info">{totalRows.toLocaleString('es-ES')} total</span>
      </div>
    )}
  </div>

  <table class="ranking-table" id="ranking-table">
    <thead>
      <tr>
        <th style="width:46px">#</th>
        <th>Municipio</th>
        <th style="width:96px">Puntuación</th>
        <th>Provincia</th>
        <th>CC.AA.</th>
        <th style="width:80px">Hab.</th>
      </tr>
    </thead>
    <tbody>
      {(ranking as any[]).map((r, i) => {
        const pos = offset + i + 1;
        const pct = maxPts > 0 ? Math.round((r.puntuacion / maxPts) * 100) : 0;
        const cls = pos === 1 ? 'pos g' : pos === 2 ? 'pos s' : pos === 3 ? 'pos b' : 'pos';
        const med: any = pos === 1 ? '🥇' : pos === 2 ? '🥈' : pos === 3 ? '🥉' : '';
        return (
          <>
            <tr class="rank-row" data-codigo={r.codigo_ine}>
              <td><span class={cls}>{med && <span class="pos-medal">{med}</span>}<span class="pos-num">{pos}</span></span></td>
              <td>
                <div style="display:flex;align-items:center;gap:10px">
                  <div class="row-thumb"
                    style={r.foto ? `background:url('${r.foto}') center/cover no-repeat` : 'background:#e8e8e8'}
                    data-codigo={r.foto ? null : r.codigo_ine}>
                  </div>
                  <div>
                    <div class="row-name-line">
                      <a href={`/municipio/${r.codigo_ine}?desde=${categoria}`}
                         style={`color:var(--text);font-weight:600;font-size:.875rem`}
                         onclick="event.stopPropagation()">{r.nombre}</a>
                      <a href={`/municipio/${r.codigo_ine}?desde=${categoria}`}
                         class="ver-todo-btn" onclick="event.stopPropagation()">Ver por qué destaca →</a>
                    </div>
                    <div style="font-size:.72rem;color:var(--text-2);margin-top:1px">{r.comarca ?? ''}</div>
                    <div class="row-meta">{r.provincia}{r.comunidad ? ` · ${r.comunidad}` : ''}</div>
                  </div>
                </div>
              </td>
              <td>
                <div class="score-cell">
                  <span class="pts" style={`color:${catColor}`}>{Number(r.puntuacion).toFixed(1)}</span>
                  <span class="pts-sub">sobre 100</span>
                </div>
              </td>
              <td><span class="prov-tag">{r.provincia}</span></td>
              <td><span class="ctag">{r.comunidad}</span></td>
              <td><span style="color:var(--text-2);font-size:.78rem">{formatPob(r.poblacion)}</span></td>
            </tr>
          </>
        );
      })}
    </tbody>
  </table>

  {totalPages > 1 && (
    <div class="pg" style="margin-top:20px;justify-content:center">
      {page > 1 && <a href={buildUrl({ page: page - 1 })} class="pgb">‹ Anterior</a>}
      <span class="pg-info">Página {page} de {totalPages}</span>
      {page < totalPages && <a href={buildUrl({ page: page + 1 })} class="pgb">Siguiente ›</a>}
    </div>
  )}

  {creadores.length > 0 && (
    <div class="cre-block">
      <div class="cre-head">
