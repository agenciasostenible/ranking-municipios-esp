---
import { DB } from '../../lib/d1client';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getCatInfo, LABELS } from '../../lib/db';
import { CAT_COLORS } from '../../lib/utils';
import { gmapsUrl, gmapsUrlAt, CAT_FUENTES, CAT_TIPOS_F, ORDER_SITIOS } from '../../lib/entidades';
// @ts-ignore

const { cat } = Astro.params;
if (cat === 'soletes') return Astro.redirect('/entidades/gastronomia', 301);

// etiquetas legibles para distinciones que no están en nivel_sello
const SELLO_LABEL: Record<string,string> = { Solete: 'Solete Repsol', Balneario: 'Balneario', Cueva_ACTE: 'Cueva turística' };
const FUENTE_LABEL: Record<string,string> = { bandera_azul: 'Bandera Azul', pueblos_mas_bonitos: 'Pueblo más bonito' };

const fuentes = CAT_FUENTES[cat!];
const tiposF = CAT_TIPOS_F[cat!];
if (!fuentes) return Astro.redirect('/ranking/ranking_global');

const url = Astro.url;
const prov = url.searchParams.get('provincia') ?? url.searchParams.get('prov') ?? '';
const q    = (url.searchParams.get('q') ?? '').trim();
const page = Math.max(1, parseInt(url.searchParams.get('page') ?? '1'));
const perPage = 50;
const offset  = (page - 1) * perPage;

const catInfo  = getCatInfo(cat!);
const catLabel = LABELS[cat!] ?? cat!;
const catColor = CAT_COLORS[cat!] ?? '#FF385C';
// Sustantivo plural para los contadores ("3.991 senderos", no "3.991 senderismo")
const PLURAL: Record<string, string> = {
  senderismo: 'senderos', gastronomia: 'sitios para comer',
  ciclismo: 'rutas ciclistas', balnearios: 'balnearios y termas', oleoturismo: 'almazaras y experiencias del aceite',
  turismo_religioso: 'santuarios, monasterios y lugares de devoción', turismo_activo: 'ferratas, escalada, parapente, buceo y esquí',
  turismo_mascotas: 'hoteles, playas y sitios para ir con tu perro', turismo_lgtbi: 'locales, playas y destinos LGTBI',
  TurismoRural: 'alojamientos rurales', hoteles_encanto: 'hoteles con encanto',
  misterioso: 'lugares de misterio y leyenda', estrellas: 'miradores de estrellas',
  lujo: 'hoteles 5 estrellas, casinos y compras de lujo', solteros: 'discotecas, pubs y beach clubs',
  pueblo_bonito: 'pueblos bonitos', vinos: 'bodegas y rutas del vino',
};
const catPlural = PLURAL[cat!] ?? catLabel.toLowerCase();

// Lista de provincias para el filtro
const { results: provRows } = await DB.prepare(
  `SELECT DISTINCT m.provincia FROM municipios m
   JOIN entidades e ON e.codigo_ine = m.codigo_ine
   WHERE e.fuente IN (${fuentes.map(()=>'?').join(',')})${tiposF ? ` AND e.tipo IN (${tiposF.map(()=>'?').join(',')})` : ''} AND COALESCE(m.es_duplicado,0)=0
   ORDER BY m.provincia`
).bind(...fuentes, ...(tiposF ?? [])).all();
const provincias = (provRows as any[]).map(r => r.provincia);

// Condiciones extra
const provCond  = prov ? `AND m.provincia = ?` : '';
const qNorm     = q ? q.normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase() : '';
const qCond     = q ? `AND (LOWER(e.nombre) LIKE LOWER(?) OR REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(LOWER(e.nombre),'á','a'),'é','e'),'í','i'),'ó','o'),'ú','u') LIKE ?)` : '';

const bindParams: any[] = [...fuentes, ...(tiposF ?? [])];
if (prov) bindParams.push(prov);
if (q)    bindParams.push(`%${q}%`, `%${qNorm}%`);

// Total para paginación (cuenta grupos: las rutas mil_lugares que cruzan varios
// municipios cuentan una sola vez)
const countSql = `
  SELECT COUNT(*) AS n FROM (
    SELECT 1 FROM entidades e
    JOIN municipios m ON m.codigo_ine = e.codigo_ine
    WHERE e.fuente IN (${fuentes.map(()=>'?').join(',')})
      ${tiposF ? `AND e.tipo IN (${tiposF.map(()=>'?').join(',')})` : ''}
      AND COALESCE(m.es_duplicado,0)=0
      ${provCond} ${qCond}
    GROUP BY LOWER(e.nombre), CASE WHEN e.fuente='mil_lugares' THEN '' ELSE m.codigo_ine END
  ) t`;
const totalRow = await DB.prepare(countSql).bind(...bindParams).first() as any;
const total = totalRow?.n ?? 0;
const totalPages = Math.ceil(total / perPage);

// Entidades con puntuación del municipio en esa categoría
const bindAll = [...bindParams, perPage, offset];
const { results: rows } = await DB.prepare(`
  SELECT MIN(e.nombre) AS nombre, MIN(e.descripcion) AS descripcion, MIN(e.nivel_sello) AS nivel_sello,
         MIN(e.latitud) AS latitud, MIN(e.longitud) AS longitud, MIN(e.enlace) AS enlace,
         MIN(e.sello_oficial) AS sello_of, MIN(e.fuente) AS fuente_g,
         MIN(CASE WHEN e.foto_url LIKE 'https://upload.wikimedia.org%' THEN e.foto_url END) AS foto_url,
         MAX(CASE WHEN e.foto_data IS NOT NULL THEN e.id END) AS foto_ent_id,
         -- juntos para que código, municipio y provincia salgan SIEMPRE de la misma
         -- fila del grupo (con GROUP BY + agregados SQLite no lo garantiza)
         MIN(m.codigo_ine || '|' || m.nombre || '|' || COALESCE(m.provincia,'')) AS muni_pack,
         MAX(e.puntuacion) AS ent_score,
         COALESCE(MAX(e.puntuacion), p.puntuacion, 0) AS puntuacion
  FROM entidades e
  JOIN municipios m ON m.codigo_ine = e.codigo_ine
  LEFT JOIN puntuaciones p ON p.codigo_ine = m.codigo_ine AND p.categoria = ?
  WHERE e.fuente IN (${fuentes.map(()=>'?').join(',')})
    ${tiposF ? `AND e.tipo IN (${tiposF.map(()=>'?').join(',')})` : ''}
    AND COALESCE(m.es_duplicado,0)=0
    ${provCond} ${qCond}
  GROUP BY LOWER(e.nombre), CASE WHEN e.fuente='mil_lugares' THEN '' ELSE m.codigo_ine END
  ORDER BY ${ORDER_SITIOS}
  LIMIT ? OFFSET ?
`).bind(cat!, ...bindAll).all();

const entidades = (rows as any[]).map((r) => {
  const [codigo_ine, municipio, provincia] = String(r.muni_pack || '||').split('|');
  return { ...r, codigo_ine, municipio, provincia };
});

function setParam(key: string, val: string | null) {
  const p = new URLSearchParams(url.search);
  if (val === null) p.delete(key); else p.set(key, val);
  p.delete('page');
  return `/entidades/${cat}?${p.toString()}`;
}
function pageUrl(n: number) {
  const p = new URLSearchParams(url.search);
  p.set('page', String(n));
  return `/entidades/${cat}?${p.toString()}`;
}

const selloColor: Record<string,string> = {
  'UNESCO': '#d4af37', 'Parque Nacional': '#2e7d32', 'BIC Nacional': '#6a1b9a',
  '3 Estrellas Michelin': '#e31c5f', '2 Estrellas Michelin': '#e31c5f', '1 Estrella Michelin': '#e31c5f',
  'Reserva Starlight': '#1a237e', 'Destino Starlight': '#283593',
};
---

<Base title={`${catLabel} de España — Ranking Spain`} description={`Lista completa de ${catLabel.toLowerCase()} de España ordenados por importancia.`}>
<div class="ent-page">

  <div class="ent-hero" style={`background:${catColor}`}>
    <div class="vista-btns-ent">
      <a href={`/ranking/${cat}`} class="vt-e">Ver {catLabel} por municipios</a>
      <span class="vt-e on">{total.toLocaleString('es-ES')} {catPlural} uno a uno</span>
    </div>
    <div class="ent-hero-ic"><Icon name={catInfo.icon} size={28} /></div>
    <h1 class="ent-title">{catLabel} de España</h1>
    <p class="ent-sub">{total.toLocaleString('es-ES')} {catPlural} · ordenados por importancia</p>
  </div>

  <div class="ent-controls">
    <form method="get" action={`/entidades/${cat}`} class="ent-form">
      <input type="text" name="q" value={q} placeholder={`Buscar ${catPlural}…`} class="ent-q" />
      {prov && <input type="hidden" name="prov" value={prov} />}
      <button type="submit" class="ent-submit">Buscar</button>
    </form>
    <div class="ent-filters">
      <select class="ent-sel" onchange={`window.location='/entidades/${cat}?prov='+this.value+(${JSON.stringify(q)}?'&q='+encodeURIComponent(${JSON.stringify(q)}):'')+'&page=1'`}>
        <option value="">Todas las provincias</option>
        {provincias.map(p => <option value={p} selected={p===prov}>{p}</option>)}
      </select>
      {(prov || q) && <a href={`/entidades/${cat}`} class="ent-clear">✕ Limpiar</a>}
    </div>
  </div>

  {entidades.length === 0 && (
    <p class="ent-empty">No hay resultados para esta búsqueda.</p>
  )}

  <ol class="ent-list" start={(page-1)*perPage+1}>
    {entidades.map((e, i) => {
      // "distinguido" = tiene nota propia de sitio (curado), sello, o distinción oficial -> va arriba (ranking).
      // El resto solo hereda la nota del municipio: se lista por zona, sin nota por sitio.
      const isReal = (v: any) => v.ent_score != null
        || (v.nivel_sello && v.nivel_sello !== '')
        || (v.sello_of && v.sello_of !== '')
        || v.fuente_g === 'bandera_azul' || v.fuente_g === 'pueblos_mas_bonitos';
      // nota numérica solo cuando es una nota real de sitio o un sello graduado (Michelin/llaves/Starlight)
      const graded = e.ent_score != null || (e.nivel_sello && e.nivel_sello !== '');
      const badge = e.nivel_sello || SELLO_LABEL[e.sello_of] || FUENTE_LABEL[e.fuente_g] || '';
      const real = isReal(e);
      const prevReal = i > 0 ? isReal(entidades[i-1]) : (page === 1);
      const showDivider = !real && prevReal;
      return (<>
      {showDivider && (
        <li class="ent-divider">
          {i === 0
            ? `Ordenados por calidad del municipio · sin distinción por sitio`
            : `Más ${catPlural} de la zona · ordenados por calidad del municipio`}
        </li>
      )}
      <li class="ent-row">
        <span class="ent-num">{(page-1)*perPage + i + 1}</span>
        {(e.foto_ent_id || e.foto_url) && (
          <img class="ent-foto" src={e.foto_ent_id ? `/api/entidad-foto?id=${e.foto_ent_id}` : e.foto_url} alt={e.nombre} loading="lazy" />
        )}
        <div class="ent-body">
          <a href={`/municipio/${e.codigo_ine}?desde=${cat}`} class="ent-name">{e.nombre}</a>
          {badge && (
            <span class="ent-sello" style={`background:${selloColor[badge]??catColor}20;color:${selloColor[badge]??catColor}`}>
              {badge}
            </span>
          )}
          <div class="ent-meta">
            <a href={`/municipio/${e.codigo_ine}?desde=${cat}`} class="ent-muni">📍 {e.municipio}</a>
            <span class="ent-prov">{e.provincia}</span>
            {graded && e.puntuacion > 0 && (
              <a href={`/municipio/${e.codigo_ine}?desde=${cat}`} class="ent-nota" style={`color:${catColor}`}>
                · {Number(e.puntuacion).toFixed(1)} en {catLabel.toLowerCase()}
              </a>
            )}
          </div>
          {e.descripcion && (
            <p class="ent-desc">{e.descripcion}</p>
          )}
          <div class="ent-links">
            <a class="ent-gmaps" target="_blank" rel="noopener"
               href={e.latitud != null
                 ? gmapsUrlAt(e.nombre, e.latitud, e.longitud)
                 : gmapsUrl(e.nombre, e.municipio, e.provincia)}>
              📍 Ver en Google Maps
            </a>
            {e.enlace && (
              <a class="ent-gmaps" target="_blank" rel="noopener" href={e.enlace}>🌐 Web oficial</a>
            )}
          </div>
        </div>

      </li>
      </>);
    })}
  </ol>

  {totalPages > 1 && (
    <div class="ent-pag">
      {page > 1 && <a href={pageUrl(page-1)} class="ent-pg">← Anterior</a>}
      <span class="ent-pg-info">Página {page} de {totalPages}</span>
      {page < totalPages && <a href={pageUrl(page+1)} class="ent-pg">Siguiente →</a>}
    </div>
  )}

</div>

<style>
.ent-page { max-width: 860px; margin: 0 auto; padding: 0 0 60px; }
.ent-hero {
  padding: 36px 24px 28px;
  text-align: center;
  color: #fff;
  border-radius: 0 0 20px 20px;
  margin-bottom: 24px;
}
.ent-back { display: inline-block; color: rgba(255,255,255,.8); font-size: .82rem; text-decoration: none; margin-bottom: 12px; }
.ent-back:hover { color: #fff; }
.ent-hero-ic { font-size: 2rem; margin-bottom: 8px; opacity: .9; }
.ent-title { font-size: clamp(1.4rem,4vw,1.9rem); font-weight: 700; letter-spacing:-.02em; margin: 0 0 6px; }
.ent-sub { color: rgba(255,255,255,.82); font-size: .9rem; margin: 0; }

.ent-controls { padding: 0 16px 16px; display: flex; flex-direction: column; gap: 10px; }
.ent-form { display: flex; gap: 8px; }
.ent-q { flex: 1; border: 1.5px solid var(--border); border-radius: 10px; padding: 10px 14px; font-family: inherit; font-size: .9rem; outline: none; }
.ent-q:focus { border-color: var(--primary); }
.ent-submit { background: var(--primary); color: #fff; border: none; border-radius: 10px; padding: 10px 18px; font-family: inherit; font-size: .88rem; font-weight: 700; cursor: pointer; }
.ent-filters { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.ent-sel { border: 1.5px solid var(--border); border-radius: 10px; padding: 8px 12px; font-family: inherit; font-size: .85rem; background: #fff; cursor: pointer; }
.ent-clear { font-size: .82rem; color: #888; text-decoration: none; padding: 6px 10px; border: 1px solid var(--border); border-radius: 8px; }
.ent-clear:hover { color: var(--primary); border-color: var(--primary); }

.ent-empty { text-align: center; color: #888; padding: 40px 16px; }

.ent-list { list-style: none; margin: 0; padding: 0 16px; display: flex; flex-direction: column; gap: 0; }
.ent-divider {
  margin: 22px 0 6px; padding: 8px 0; font-size: 13px; font-weight: 600;
  color: var(--muted, #888); text-transform: uppercase; letter-spacing: .04em;
  border-top: 2px solid var(--border);
}
.ent-row {
  display: flex; align-items: flex-start; gap: 14px;
  padding: 16px 0; border-bottom: 1px solid var(--border);
}
.ent-num { font-size: .82rem; font-weight: 700; color: #bbb; min-width: 28px; padding-top: 3px; text-align: right; }
.ent-foto { width: 108px; height: 84px; object-fit: cover; border-radius: 10px; flex-shrink: 0; background: #f0ece5; }
@media (max-width: 560px) { .ent-foto { width: 86px; height: 70px; } }
.ent-body { flex: 1; min-width: 0; }
.ent-name {
  display: block; font-size: .97rem; font-weight: 700; color: var(--text);
  text-decoration: none; line-height: 1.3; margin-bottom: 3px;
}
.ent-name:hover { color: var(--primary); }
.ent-sello {
  display: inline-block; font-size: .72rem; font-weight: 700; padding: 2px 8px;
  border-radius: 20px; margin-bottom: 4px;
}
.ent-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 4px; }
.ent-muni { font-size: .82rem; color: var(--primary); text-decoration: none; font-weight: 600; }
.ent-muni:hover { text-decoration: underline; }
.ent-prov { font-size: .78rem; color: #888; }
.ent-desc { font-size: .8rem; color: #666; line-height: 1.45; margin: 4px 0 0; }
.ent-links { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 7px; }
.ent-gmaps { font-size: .8rem; font-weight: 700; color: #2563eb; text-decoration: none; }
.ent-gmaps:hover { text-decoration: underline; }
.ent-score {
  font-size: 1.15rem; font-weight: 800; min-width: 52px; text-align: right;
  padding-top: 2px; flex-shrink: 0; letter-spacing: -.02em;
}
.ent-score span { font-size: .72rem; font-weight: 500; color: #bbb; }
.ent-nota { font-size: .78rem; font-weight: 700; text-decoration: none; }

.ent-pag { display: flex; align-items: center; justify-content: center; gap: 16px; padding: 28px 16px 0; }
.ent-pg { color: var(--primary); text-decoration: none; font-weight: 700; font-size: .9rem; padding: 8px 18px; border: 2px solid var(--primary); border-radius: 10px; }
.ent-pg:hover { background: var(--primary); color: #fff; }
.ent-pg-info { font-size: .85rem; color: #888; }

@media (max-width: 600px) {
  .ent-score { font-size: 1rem; min-width: 42px; }
  .ent-row { gap: 10px; }
}
</style>
<style>
.vista-btns-ent { display: flex; gap: 10px; margin-bottom: 16px; flex-wrap: wrap; }
.vt-e { display: flex; align-items: center; justify-content: center; padding: 14px 20px; border-radius: 14px; font-size: .95rem; font-weight: 700; text-decoration: none; }
.vt-e.on { background: #fff; color: #222; box-shadow: 0 6px 18px rgba(0,0,0,.18); }
.vt-e:not(.on) { background: transparent; color: #fff; border: 2px solid rgba(255,255,255,.75); }
.vt-e:not(.on):hover { background: rgba(255,255,255,.12); }
@media (max-width: 640px) { .vt-e { font-size: .88rem; padding: 13px 15px; width: 100%; } }
</style>
</Base>
