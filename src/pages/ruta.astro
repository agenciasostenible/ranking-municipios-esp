            <div class="rs-line dia-rural">🏡 Opción rural en el pueblo: <strong>{diaPlan.rural}</strong></div>
          )}
        </div>
      )}

      <div class="dia-anunciate">¿Tienes un negocio o servicio? <a href={`/anunciate?muni=${encodeURIComponent(pueblo.nombre)}&codigo=${puebloCode}&prov=${encodeURIComponent(pueblo.provincia)}`}>📢 Date de alta para que valoremos tu solicitud</a></div>
      <div class="ruta-foot">Plan basado en el inventario verificado de Ranking Spain. Sitios para ver, comer, café, copa y dormir, con su valoración, vía Google. Tiempos a pie/en coche estimados.</div>
    </div>
  )}
</div>

{mapData.length > 0 && (
  <Fragment>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="" is:inline></script>
    <script is:inline define:vars={{ mapData, headColor }}>
      (function () {
        if (!window.L || !mapData.length) return;
        var el = document.getElementById('ruta-map');
        if (!el) return;
        // Vista inicial razonable para que el mapa nunca arranque "perdido"
        var map = L.map(el, { scrollWheelZoom: false }).setView([mapData[0].lat, mapData[0].lng], 9);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; OpenStreetMap', maxZoom: 18,
        }).addTo(map);
        var pts = mapData.map(function (p) { return [p.lat, p.lng]; });
        L.polyline(pts, { color: headColor, weight: 3, opacity: 0.85 }).addTo(map);
        mapData.forEach(function (p) {
          var icon = L.divIcon({
            className: 'ruta-marker',
            html: '<span style="background:' + headColor + '">' + p.n + '</span>',
            iconSize: [26, 26], iconAnchor: [13, 13],
          });
          L.marker([p.lat, p.lng], { icon: icon }).addTo(map)
            .bindPopup('<b>' + p.n + '. ' + p.nombre + '</b>');
        });
        // Recalcular tamaño y reencuadrar: evita el render erróneo en móvil
        // (Leaflet se inicia antes de que el contenedor/CSS tengan medidas).
        function fit() {
          map.invalidateSize();
          map.fitBounds(pts, { padding: [30, 30], maxZoom: 12 });
        }
        fit();
        setTimeout(fit, 250);
        setTimeout(fit, 800);
        window.addEventListener('load', fit);
      })();
    </script>
  </Fragment>
)}

<script>
  // Cambiar de sitio (comer / dormir) sin recargar
  function rsFmt(h) {
    var r = Number(h.rating || 0).toLocaleString('es-ES', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    var n = h.reviews ? ' (' + Number(h.reviews).toLocaleString('es-ES') + ')' : '';
    return '★ ' + r + n;
  }
  document.querySelectorAll('.rs-swap').forEach(function (box) {
    var list;
    try { list = JSON.parse(box.getAttribute('data-places') || '[]'); } catch (e) { return; }
    var btn = box.querySelector('.rs-swap-btn');
    if (!btn || list.length < 2) return;
    btn.addEventListener('click', function () {
      var idx = ((parseInt(box.getAttribute('data-idx'), 10) || 0) + 1) % list.length;
      box.setAttribute('data-idx', String(idx));
      var it = list[idx];
      var name = box.querySelector('.rs-pname'); if (name) name.textContent = it.nombre;
      var rat = box.querySelector('.rs-prating'); if (rat) rat.textContent = rsFmt(it);
      var img = box.querySelector('.rs-thumb');
      if (img) {
        if (it.foto_ref) { img.src = '/api/place-photo?w=200&ref=' + encodeURIComponent(it.foto_ref); img.style.display = ''; img.alt = it.nombre; }
        else { img.style.display = 'none'; }
      }
      var attr = box.querySelector('.rs-pattr'); if (attr) attr.innerHTML = it.foto_attr || '';
      var loc = box.querySelector('.rs-loc');
      if (loc) { if (it.locLabel) { loc.textContent = '📍 ' + it.locLabel; loc.style.display = ''; } else { loc.style.display = 'none'; } }
    });
  });
</script>

