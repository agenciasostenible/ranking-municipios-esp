      {/* DORMIR */}
      {(diaPlan.dormirCur || diaPlan.rural) && (
        <div class="dia-block">
          <div class="dia-tag dia-tag-soft">🛏️ Dónde dormir</div>
          {diaPlan.dormirCur && (
            <div class="rs-place rs-swap" data-places={JSON.stringify(diaPlan.dormirList)} data-idx={diaPlan.dormirIdx}>
              <img class="rs-thumb" src={diaPlan.dormirCur.foto_ref ? `/api/place-photo?w=200&ref=${encodeURIComponent(diaPlan.dormirCur.foto_ref)}` : ''} alt={diaPlan.dormirCur.nombre} loading="lazy" width="56" height="56" style={diaPlan.dormirCur.foto_ref ? '' : 'display:none'} />
              <div class="rs-place-txt">
                <div class="rs-line">🛏️ <strong class="rs-pname">{diaPlan.dormirCur.nombre}</strong><span class="rs-star rs-prating">★ {fmtRating(diaPlan.dormirCur)}</span>{diaPlan.dormirList.length > 1 && <button type="button" class="rs-swap-btn">↻ otra opción</button>}</div>
                {diaPlan.dormirCur.locLabel && <div class="rs-loc">📍 {diaPlan.dormirCur.locLabel}</div>}
                <div class="rs-attr rs-pattr" set:html={diaPlan.dormirCur.foto_attr ?? ''}></div>
