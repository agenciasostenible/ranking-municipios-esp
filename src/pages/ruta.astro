      {/* TARDE — más que ver */}
      {diaPlan.tarde.length > 0 && (
        <div class="dia-block">
          <div class="dia-tag" style={`color:${diaPlan.color};background:${diaPlan.color}15`}>☀️ Por la tarde · más que ver</div>
