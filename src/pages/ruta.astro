      {/* SI TE QUEDA TIEMPO — lo que no entra en el día a pie */}
      {diaPlan.lejos && diaPlan.lejos.length > 0 && (
        <div class="dia-block">
          <div class="dia-tag dia-tag-soft">✨ Si te queda tiempo · más que ver</div>
          {diaPlan.lejos.map((v: any) => (
            <div class="rs-place dia-vis">
              <img class="rs-thumb" src={v.foto_ref ? `/api/place-photo?w=200&ref=${encodeURIComponent(v.foto_ref)}` : ''} alt={v.nombre} loading="lazy" width="56" height="56" style={v.foto_ref ? '' : 'display:none'} />
              <div class="rs-place-txt">
                <div class="rs-line">👁️ <strong>{v.nombre}</strong><span class="rs-star">★ {fmtRating(v)}</span></div>
                <div class="rs-loc">{v.far ? `🚗 a ~${fmtDur(v.carMin)} · ${v.carDist} del centro` : `🚶 a ~${fmtDur(v.walkMin)} del centro`}</div>
                <div class="rs-attr" set:html={v.foto_attr ?? ''}></div>
              </div>
            </div>
          ))}
        </div>
      )}

      {/* COPA */}
      {diaPlan.copa && (
        <div class="dia-block">
          <div class="dia-tag dia-tag-soft">🍷 Una copa</div>
          <div class="rs-place">
            <img class="rs-thumb" src={diaPlan.copa.foto_ref ? `/api/place-photo?w=200&ref=${encodeURIComponent(diaPlan.copa.foto_ref)}` : ''} alt={diaPlan.copa.nombre} loading="lazy" width="56" height="56" style={diaPlan.copa.foto_ref ? '' : 'display:none'} />
            <div class="rs-place-txt">
              <div class="rs-line">🍷 Una copa en <strong>{diaPlan.copa.nombre}</strong><span class="rs-star">★ {fmtRating(diaPlan.copa)}</span></div>
              {diaPlan.copa.locLabel && <div class="rs-loc">📍 {diaPlan.copa.locLabel}</div>}
              <div class="rs-attr" set:html={diaPlan.copa.foto_attr ?? ''}></div>
