.dia-rural { color: var(--text); margin-top: 6px; }
.dia-tag-reco { color: #b45309; background: #fff7e6; }
.rs-reco-line { color: #92500a; }
.rs-reco-line a { color: #b45309; font-weight: 700; }
.rs-reco-acts { display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: center; }
.rs-reco-acts a { color: var(--primary); font-weight: 600; text-decoration: none; }
.rs-wa { color: #128c4b !important; }
.rs-reco-badge { display: inline-block; margin-left: 8px; font-size: .64rem; font-weight: 800; text-transform: uppercase; letter-spacing: .4px; color: #b45309; background: #fff7e6; border: 1px solid #f5d28a; border-radius: 10px; padding: 1px 7px; white-space: nowrap; }
.dia-anunciate { background: #fff7e6; padding: 12px 20px; font-size: .82rem; color: #92500a; border-top: 1px solid #f3e2c0; }
.dia-anunciate a { color: #b45309; font-weight: 800; text-decoration: none; }
@media (max-width: 560px) { .rf-field { flex: 1 1 100%; } }
</style>
<script>
  // Marca/desmarca visualmente los chips de categoría al pulsarlos
  document.querySelectorAll('.rf-chip input').forEach((inp) => {
    inp.addEventListener('change', (e) => {
      const el = e.target as HTMLInputElement;
      el.closest('.rf-chip')?.classList.toggle('on', el.checked);
    });
  });

  // Selector de días (radios): mueve el resaltado al pulsar
  document.querySelectorAll('.rf-day input').forEach((inp) => {
    inp.addEventListener('change', () => {
      document.querySelectorAll('.rf-day').forEach((d) => d.classList.remove('on'));
      (inp as HTMLElement).closest('.rf-day')?.classList.add('on');
    });
  });

  // Conmutador de modo: "Por la zona" / "Un día en un pueblo"
  const rutaForm = document.getElementById('ruta-form');
  document.querySelectorAll('.rf-mode').forEach((b) => {
    b.addEventListener('click', () => {
      const m = b.getAttribute('data-mode') || 'zona';
      rutaForm?.setAttribute('data-mode', m);
      document.querySelectorAll('.rf-mode').forEach((x) => x.classList.toggle('on', x === b));
      if (m === 'pueblo') (document.getElementById('rf-pueblo-input') as HTMLInputElement | null)?.focus();
    });
  });

  // Autocompletado de municipio (modo "un día en un pueblo") usando /api/search
  const pInput = document.getElementById('rf-pueblo-input') as HTMLInputElement | null;
  const pAc = document.getElementById('rf-pueblo-ac');
  const catsQS = () => {
    const ks = Array.from(document.querySelectorAll('.rf-chip input:checked'))
      .map((i) => (i as HTMLInputElement).value);
    return ks.length ? '&' + ks.map((k) => 'cat=' + encodeURIComponent(k)).join('&') : '';
  };
  let pTimer: any;
  pInput?.addEventListener('input', () => {
    const q = pInput.value.trim();
    clearTimeout(pTimer);
    if (q.length < 2) { if (pAc) pAc.innerHTML = ''; return; }
    pTimer = setTimeout(async () => {
      try {
        const res = await fetch('/api/search?q=' + encodeURIComponent(q));
        const data = await res.json();
        const muns = ((data as any[]) || []).filter((d) => d.tipo === 'municipio').slice(0, 6);
        if (pAc) pAc.innerHTML = muns.map((m) => {
          const nom = String(m.nombre || '').replace(/[&<>]/g, '');
          const prov = String(m.provincia || '').replace(/[&<>]/g, '');
          return `<a href="/ruta?pueblo=${m.codigo_ine}${catsQS()}" style="display:flex;align-items:center;gap:10px;padding:11px 15px;text-decoration:none;border-bottom:1px solid #f2f2f2;background:#fff;cursor:pointer" onmouseover="this.style.background='#fff1f3'" onmouseout="this.style.background='#fff'"><span style="flex-shrink:0">📍</span><span style="flex:1;min-width:0;font-size:.92rem;font-weight:700;color:#222;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${nom}<span style="font-weight:400;color:#888;font-size:.82rem;margin-left:7px">${prov}</span></span></a>`;
        }).join('');
      } catch (e) { if (pAc) pAc.innerHTML = ''; }
    }, 180);
  });
  document.addEventListener('click', (e) => {
    if (pAc && !pAc.contains(e.target as Node) && e.target !== pInput) pAc.innerHTML = '';
  });
</script>
</Base>
