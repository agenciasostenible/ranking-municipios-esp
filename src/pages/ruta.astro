      {/* CENAR */}
      {diaPlan.cenarCur && (
        <div class="dia-block">
          <div class="dia-tag dia-tag-soft">🌆 Cenar</div>
          <div class="rs-place rs-swap" data-places={JSON.stringify(diaPlan.cenarList)} data-idx={diaPlan.cenarIdx}>
            <img class="rs-thumb" src={diaPlan.cenarCur.foto_ref ? `/api/place-photo?w=200&ref=${encodeURIComponent(diaPlan.cenarCur.foto_ref)}` : ''} alt={diaPlan.cenarCur.nombre} loading="lazy" width="56" height="56" style={diaPlan.cenarCur.foto_ref ? '' : 'display:none'} />
            <div class="rs-place-txt">
              <div class="rs-line">🌆 <strong class="rs-pname">{diaPlan.cenarCur.nombre}</strong><span class="rs-star rs-prating">★ {fmtRating(diaPlan.cenarCur)}</span>{diaPlan.cenarList.length > 1 && <button type="button" class="rs-swap-btn">↻ otra opción</button>}</div>
              {diaPlan.cenarCur.locLabel && <div class="rs-loc">📍 {diaPlan.cenarCur.locLabel}</div>}
              <div class="rs-attr rs-pattr" set:html={diaPlan.cenarCur.foto_attr ?? ''}></div>
            </div>
          </div>
        </div>
