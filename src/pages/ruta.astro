---
import { DB } from '../lib/d1client';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getCatInfo } from '../lib/db';
import { CAT_COLORS } from '../lib/utils';
import { getPlace, getPlaceOptions, modestIndex, PLACES_ENABLED } from '../lib/places';
import { getAnunciosMunicipio, getAnunciosProvincia } from '../lib/anuncios';

// Categorías que tienen recurso real + descripción (las que dan rutas verídicas)
const RUTA_CATS: { key: string; tipo: string; label: string }[] = [
  { key: 'oleoturismo',       tipo: 'oleoturismo', label: 'Oleoturismo' },
  { key: 'monumentos',        tipo: 'monumento',   label: 'Monumentos' },
  { key: 'castillos',         tipo: 'castillo',    label: 'Castillos' },
  { key: 'turismo_religioso', tipo: 'religioso',   label: 'Turismo religioso' },
  { key: 'turismo_activo',    tipo: 'activo',      label: 'Turismo activo' },
  { key: 'turismo_mascotas',  tipo: 'mascotas',    label: 'Turismo con mascotas' },
  { key: 'turismo_lgtbi',     tipo: 'lgtbi',       label: 'Turismo LGTBI' },
  { key: 'TurismoRural',      tipo: 'rural',       label: 'Turismo rural' },
  { key: 'senderismo',        tipo: 'sendero',     label: 'Senderismo' },
  // NOTA: fiestas y festivales se excluyen a propósito del planificador: son
  // eventos con fecha fija (y solo conocemos el mes, a veces ni eso), así que
  // no forman un itinerario coherente de un mismo viaje. Siguen como ranking.
];

// Perfiles de búsqueda en Google según la categoría de la parada, para que el
// "qué visitar / dónde comer" sea coherente (y no te mande a la catedral con perro).
//  - comer.keyword:    sesga el restaurante (red de seguridad: si no hay, cae al mejor).
//  - visitar:          null = ocultar (el "qué hacer" ya ES lo que visitas);
//                      objeto = búsqueda adaptada; ausente = atracción genérica.
type CatProfile = {
  comer?: { keyword?: string };
  dormir?: { keyword?: string };
  visitar?: { keyword?: string; type?: string; excludeTypes?: string[] } | null;
};
const CAT_PROFILE: Record<string, CatProfile> = {
  turismo_mascotas: {
    comer:   { keyword: 'pet friendly' },
    dormir:  { keyword: 'pet friendly' },
    visitar: { keyword: 'pet friendly', excludeTypes: ['church','place_of_worship','museum','art_gallery','hindu_temple','mosque','synagogue'] },
  },
  turismo_lgtbi:    { dormir: { keyword: 'lgtbi friendly' }, visitar: { keyword: 'lgtbi friendly' } },
  oleoturismo:      { visitar: { keyword: 'almazara aceite de oliva' } },
  turismo_activo:   { visitar: { keyword: 'naturaleza aventura' } },
  turismo_religioso:{ visitar: null },
  monumentos:       { visitar: null },
  castillos:        { visitar: null },
};

const url = Astro.url;
// Multi-categoría: acepta varios ?cat=... (y ?cat=a,b). Compatible con uno solo.
let cats = url.searchParams.getAll('cat').flatMap(v => v.split(','));
cats = [...new Set(cats.filter(k => RUTA_CATS.some(c => c.key === k)))];
let prov = url.searchParams.get('prov') ?? '';
const dias = Math.min(3, Math.max(1, parseInt(url.searchParams.get('dias') ?? '2')));

// Ajustes de la ruta (filtros que regeneran)
const pres = url.searchParams.get('pres') ?? '';          // 'eco' = económico
const compacta = url.searchParams.get('compacta') === '1';// paradas más cercanas
// Ritmo del plan de un día: 'relajado' (pocas visitas, caminable) o 'completo'
const ritmo = url.searchParams.get('ritmo') === 'completo' ? 'completo' : 'relajado';
// Enlaces de la barra de ajustes: clonan la URL actual y fijan/quitan un parámetro
function setParam(key: string, val: string | null) {
  const p = new URLSearchParams(url.search);
  if (val === null) p.delete(key); else p.set(key, val);
  return '/ruta?' + p.toString();
}

// Ruta "por la zona": anclada a un municipio, con radio compacto.
const ZONA_RADIO_KM = 55;
const COMPACT_RADIO_KM = 45;
const inicioCode = url.searchParams.get('inicio') ?? '';
let anchor: any = null;
if (inicioCode) {
  anchor = await DB.prepare(
    `SELECT codigo_ine, nombre, provincia, latitud, longitud FROM municipios
      WHERE codigo_ine=? AND latitud IS NOT NULL LIMIT 1`
  ).bind(inicioCode).first();
  if (anchor) {
    prov = anchor.provincia;                       // la zona = su provincia
    if (!cats.length) cats = RUTA_CATS.map(c => c.key); // lo mejor de todo alrededor
  }
}

// ── MODO "UN DÍA EN UN PUEBLO" ────────────────────────────────────────────
// Itinerario de un solo día DENTRO de un municipio (no por la zona): visitas a
// pie encadenadas + café, comer, copa, cenar y dormir, todo en el mismo pueblo.
const puebloCode = url.searchParams.get('pueblo') ?? '';
let pueblo: any = null;
if (puebloCode) {
  pueblo = await DB.prepare(
    `SELECT codigo_ine, nombre, provincia, latitud, longitud FROM municipios
      WHERE codigo_ine=? AND latitud IS NOT NULL LIMIT 1`
  ).bind(puebloCode).first();
  if (pueblo) {
    prov = pueblo.provincia;               // la provincia se deriva del pueblo
    if (!cats.length) {
      // sin experiencia elegida → la mejor puntuada del pueblo (o monumentos)
      const ph = RUTA_CATS.map(() => '?').join(',');
      const best = await DB.prepare(
        `SELECT categoria FROM puntuaciones
          WHERE codigo_ine=? AND categoria IN (${ph}) AND puntuacion>0
          ORDER BY puntuacion DESC LIMIT 1`
      ).bind(puebloCode, ...RUTA_CATS.map(c => c.key)).first();
      cats = [best ? (best as any).categoria : 'monumentos'];
    } else {
      cats = [cats[0]];                    // el día gira en torno a UNA experiencia
    }
  }
}

const selCfgs = RUTA_CATS.filter(c => cats.includes(c.key));
const tipoByCat:  Record<string,string> = Object.fromEntries(selCfgs.map(c => [c.key, c.tipo]));
const labelByCat: Record<string,string> = Object.fromEntries(selCfgs.map(c => [c.key, c.label]));
const infoByCat:  Record<string,any>    = Object.fromEntries(selCfgs.map(c => [c.key, getCatInfo(c.key)]));
const colorByCat: Record<string,string> = Object.fromEntries(selCfgs.map(c => [c.key, CAT_COLORS[c.key] ?? '#FF385C']));
const headColor = selCfgs.length ? colorByCat[selCfgs[0].key] : '#FF385C';

// Lista de provincias para el formulario
const { results: provRows } = await DB.prepare(
  `SELECT DISTINCT provincia FROM municipios WHERE COALESCE(es_duplicado,0)=0 AND provincia IS NOT NULL ORDER BY provincia`
).all();
const provincias = (provRows as any[]).map(r => r.provincia);

function haversine(a: any, b: any) {
  const R = 6371, t = Math.PI / 180;
  const dLat = (b.latitud - a.latitud) * t, dLon = (b.longitud - a.longitud) * t;
  const la1 = a.latitud * t, la2 = b.latitud * t;
  const h = Math.sin(dLat/2)**2 + Math.cos(la1)*Math.cos(la2)*Math.sin(dLon/2)**2;
  return 2 * R * Math.asin(Math.sqrt(h));
}

// "Dentro del pueblo": a menos de NEAR_KM del centro y con calidad → va primero.
const NEAR_KM = 4;
const norm = (s: string) => (s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
const localidad = (dir: string | null) => {
  if (!dir) return '';
  const parts = String(dir).split(',').map(p => p.trim()).filter(Boolean);
  return parts.length ? parts[parts.length - 1] : '';
};
// Decora cada opción con localidad/km/locLabel y reordena: dentro del pueblo y
// con calidad (rating ≥ 4) primero; el resto después, por valoración.
function decoratePlaces(list: any[], stop: any) {
  const q = (h: any) => (h.rating ?? 0) * Math.log10((h.reviews ?? 0) + 1);
  for (const it of list) {
    const km = (it.lat != null && it.lng != null)
      ? Math.round(haversine(stop, { latitud: it.lat, longitud: it.lng })) : null;
    const loc = localidad(it.direccion);
    const enPueblo = (loc && (norm(loc) === norm(stop.nombre) || norm(loc).includes(norm(stop.nombre)) || norm(stop.nombre).includes(norm(loc))))
      || (km != null && km <= NEAR_KM);
    it.km = km; it.enPueblo = enPueblo;
    it.locLabel = enPueblo
      ? (loc || stop.nombre)
      : (loc ? `${loc} · a ${km} km` : (km != null ? `a ${km} km` : ''));
  }
  list.sort((a, b) => {
    const ap = (a.enPueblo && (a.rating ?? 0) >= 4.0) ? 1 : 0;
    const bp = (b.enPueblo && (b.rating ?? 0) >= 4.0) ? 1 : 0;
    if (ap !== bp) return bp - ap;
    return q(b) - q(a);
  });
  return list;
}

let dayPlan: any[][] = [];
let stops: any[] = [];
let zonaAnuncios: any[] = [];   // publicidad a nivel provincia en rutas por zona
let totalKm = 0;
let driveTotalMin = 0;

if (selCfgs.length && prov && !pueblo) {
  // Todas las puntuaciones de las categorías elegidas en la provincia
  const catPh = cats.map(() => '?').join(',');
  const { results } = await DB.prepare(
    `SELECT p.codigo_ine, p.categoria, p.puntuacion, m.nombre, m.latitud, m.longitud
       FROM puntuaciones p JOIN municipios m ON m.codigo_ine=p.codigo_ine
      WHERE p.categoria IN (${catPh}) AND m.provincia=? AND COALESCE(m.es_duplicado,0)=0
        AND m.latitud IS NOT NULL AND m.longitud IS NOT NULL AND p.puntuacion>0`
  ).bind(...cats, prov).all();

  // Por municipio nos quedamos con su mejor categoría elegida (mayor puntuación)
  const byMuni = new Map<string, any>();
  for (const r of results as any[]) {
    const ex = byMuni.get(r.codigo_ine);
    if (!ex || r.puntuacion > ex.puntuacion) {
      byMuni.set(r.codigo_ine, {
        codigo_ine: r.codigo_ine, nombre: r.nombre,
        latitud: r.latitud, longitud: r.longitud,
        puntuacion: r.puntuacion, catKey: r.categoria,
      });
    }
  }
  let pool = [...byMuni.values()].sort((a, b) => b.puntuacion - a.puntuacion);
  // Centro de la ruta: el municipio ancla; o, si se pide compacta, el mejor puntuado.
  let seed: any = anchor;
  if (!seed && compacta && pool.length) seed = pool[0];
  if (seed) pool = pool.filter(p => haversine(seed, p) <= (anchor ? ZONA_RADIO_KM : COMPACT_RADIO_KM));
  const nStops = Math.min(pool.length, dias * 2 + 1); // 3 / 5 / 7
  const top = pool.slice(0, nStops);

  // Recurso (qué hacer) de cada parada según su mejor categoría
  if (top.length) {
    const ids = top.map(s => s.codigo_ine);
    const tipos = [...new Set(top.map(s => tipoByCat[s.catKey]))];
    const { results: entRows } = await DB.prepare(
      `SELECT codigo_ine, tipo, nombre, descripcion FROM entidades
        WHERE codigo_ine IN (${ids.map(() => '?').join(',')})
          AND tipo IN (${tipos.map(() => '?').join(',')})`
    ).bind(...ids, ...tipos).all();
    const recMap = new Map<string, any>();
    for (const e of entRows as any[]) {
      const k = e.codigo_ine + '|' + e.tipo;
      const ex = recMap.get(k);
      if (!ex || (e.descripcion?.length || 0) > (ex.descripcion?.length || 0)) recMap.set(k, e);
    }
    for (const s of top) {
      const e = recMap.get(s.codigo_ine + '|' + tipoByCat[s.catKey]);
      s.recurso = e?.nombre ?? null;
      s.recurso_desc = e?.descripcion ?? null;
      s.catLabel = labelByCat[s.catKey];
    }
  }

  // Ruta por vecino más cercano. Si hay ancla, empezamos por la parada más
  // cercana a ella; si no, por la mejor puntuada.
  if (top.length) {
    let startIdx = 0;
    if (seed) {
      let bd = Infinity;
      for (let i = 0; i < top.length; i++) { const d = haversine(seed, top[i]); if (d < bd) { bd = d; startIdx = i; } }
    }
    const used = new Set<number>(); const order: any[] = [];
    let cur = startIdx; used.add(startIdx); order.push(top[startIdx]);
    while (order.length < top.length) {
      let best = -1, bd = Infinity;
      for (let i = 0; i < top.length; i++) {
        if (used.has(i)) continue;
        const d = haversine(top[cur], top[i]);
        if (d < bd) { bd = d; best = i; }
      }
      used.add(best); order.push(top[best]); cur = best;
    }
    for (let i = 1; i < order.length; i++) totalKm += haversine(order[i-1], order[i]);
    stops = order;

    // Tiempos de conducción reales entre paradas (OSRM, gratis). 1 petición/ruta.
    if (stops.length > 1) {
      try {
        const coords = stops.map((s: any) => `${s.longitud},${s.latitud}`).join(';');
        const r = await fetch(`https://router.project-osrm.org/route/v1/driving/${coords}?overview=false`,
          { signal: AbortSignal.timeout(4000) });
        if (r.ok) {
          const d: any = await r.json();
          const legs = d.routes?.[0]?.legs;
          if (legs && legs.length === stops.length - 1) {
            for (let i = 0; i < legs.length; i++) {
              stops[i].driveNext = { min: Math.round(legs[i].duration / 60), km: Math.round(legs[i].distance / 1000) };
            }
          }
        }
      } catch { /* si OSRM falla, usamos la estimación de abajo */ }
      // Respaldo: estimación por carretera (haversine × 1.3 a ~65 km/h)
      for (let i = 0; i < stops.length - 1; i++) {
        if (!stops[i].driveNext) {
          const km = Math.round(haversine(stops[i], stops[i + 1]) * 1.3);
          stops[i].driveNext = { min: Math.max(1, Math.round((km / 65) * 60)), km, est: true };
        }
      }
      driveTotalMin = stops.reduce((a: number, s: any) => a + (s.driveNext?.min ?? 0), 0);
    }

    // Opciones de DORMIR (turismo rural) y COMER (gastronomía) en la provincia
    const { results: ruralRows } = await DB.prepare(
      `SELECT m.codigo_ine, m.nombre, m.latitud, m.longitud,
         (SELECT descripcion FROM entidades e WHERE e.codigo_ine=m.codigo_ine AND e.tipo='rural' ORDER BY length(COALESCE(descripcion,'')) DESC LIMIT 1) descr
       FROM municipios m WHERE m.provincia=? AND COALESCE(m.es_duplicado,0)=0 AND m.latitud IS NOT NULL
         AND EXISTS(SELECT 1 FROM entidades e WHERE e.codigo_ine=m.codigo_ine AND e.tipo='rural')`
    ).bind(prov).all();
    const { results: gastroRows } = await DB.prepare(
      `SELECT m.codigo_ine, m.nombre, m.latitud, m.longitud,
         (SELECT nombre FROM entidades e WHERE e.codigo_ine=m.codigo_ine AND e.tipo='gastronomia'
           ORDER BY CASE WHEN nombre LIKE '%Michelin%' OR nombre LIKE '%Repsol%' OR nombre LIKE '%Sol %' THEN 0 ELSE 1 END, length(nombre) DESC LIMIT 1) rec
       FROM municipios m WHERE m.provincia=? AND COALESCE(m.es_duplicado,0)=0 AND m.latitud IS NOT NULL
         AND EXISTS(SELECT 1 FROM entidades e WHERE e.codigo_ine=m.codigo_ine AND e.tipo='gastronomia')`
    ).bind(prov).all();
    const ruralOpts = ruralRows as any[]; const gastroOpts = gastroRows as any[];
    // Etiqueta de dormir = tipo de alojamiento real (de la descripción)
    for (const o of ruralOpts) {
      const md = /Alojamientos rurales:\s*(.+?)(?:\.\s*Entorno|\.$|$)/i.exec(o.descr || '');
      let a = (md ? md[1] : (o.descr || '')).trim().replace(/\.$/, '');
      if (a.length > 90) a = a.slice(0, 90).replace(/,?\s*\S*$/, '') + '…';
      o.rec = a || 'Alojamientos rurales';
    }

    function nearestWithData(opts: any[], s: any) {
      let best: any = null, bd = Infinity;
      for (const o of opts) { const d = haversine(s, o); if (d < bd) { bd = d; best = o; } }
      if (!best) return null;
      return { nombre: best.nombre, rec: best.rec, km: Math.round(bd), mismo: best.codigo_ine === s.codigo_ine };
    }
    for (const s of stops) {
      // si la actividad de ESA parada ya es turismo rural / gastronomía, no la repetimos
      s.dormir = (s.catKey === 'TurismoRural') ? null : nearestWithData(ruralOpts, s);
      s.comer  = (s.catKey === 'gastronomia') ? null : nearestWithData(gastroOpts, s);
    }

    // Enriquecimiento con Google Places: mejor sitio para comer y qué visitar
    // en cada parada (rating + nº de reseñas). Solo si hay clave configurada.
    if (PLACES_ENABLED) {
      await Promise.all(stops.map(async (s: any) => {
        const prof = CAT_PROFILE[s.catKey] ?? {};

        // COMER: lista de restaurantes (para poder cambiar de sitio)
        const comerKw = prof.comer?.keyword;
        const comerSpec = { type: 'restaurant', radius: 7000, minReviews: 30, keyword: comerKw, softKeyword: true };
        const comerKind = 'comer' + (comerKw ? '_' + s.catKey : '');
        const comerP = s.catKey === 'gastronomia'
          ? Promise.resolve([] as any[])
          : getPlaceOptions(s.codigo_ine, comerKind, s.latitud, s.longitud, comerSpec, 4);

        // VISITAR: lista de sitios (null = ocultar; ausente = atracción genérica)
        const visCfg = ('visitar' in prof) ? prof.visitar : { type: 'tourist_attraction' };
        let visitarP: Promise<any[]> = Promise.resolve([] as any[]);
        if (visCfg) {
          const visSpec = {
            type: visCfg.type ?? 'tourist_attraction', radius: 12000, minReviews: 15,
            keyword: visCfg.keyword, excludeTypes: visCfg.excludeTypes,
          };
          const visKind = 'visitar' + (visCfg.keyword || visCfg.excludeTypes ? '_' + s.catKey : '');
          visitarP = getPlaceOptions(s.codigo_ine, visKind, s.latitud, s.longitud, visSpec, 4);
        }

        // DORMIR: lista de alojamientos (para poder cambiar de sitio / más barato)
        const dormirKw = prof.dormir?.keyword;
        const dormirSpec = { type: 'lodging', radius: 9000, minReviews: 15, keyword: dormirKw, softKeyword: true };
        const dormirKind = 'dormir' + (dormirKw ? '_' + s.catKey : '');
        const dormirP = s.catKey === 'TurismoRural'
          ? Promise.resolve([] as any[])
          : getPlaceOptions(s.codigo_ine, dormirKind, s.latitud, s.longitud, dormirSpec, 4);

        const [comerList, visitarList, dormirList] = await Promise.all([comerP, visitarP, dormirP]);
        // Localidad/km + "dentro del pueblo con calidad primero"
        decoratePlaces(comerList, s);
        decoratePlaces(visitarList, s);
        decoratePlaces(dormirList, s);
        s.comerList = comerList;
        s.dormirList = dormirList;
        s.visitarList = visitarList;
        // Índice inicial: en presupuesto "económico", la opción más modesta
        s.comerIdx  = pres === 'eco' ? modestIndex(comerList) : 0;
        s.dormirIdx = pres === 'eco' ? modestIndex(dormirList) : 0;
        s.visitarIdx = 0; // el presupuesto no aplica a "qué visitar"
        s.comerCur   = comerList[s.comerIdx] ?? null;
        s.dormirCur  = dormirList[s.dormirIdx] ?? null;
        s.visitarCur = visitarList[0] ?? null;
      }));
    }

    // Recomendados (publicidad) a nivel PROVINCIA: salen en cualquier ruta de la provincia,
    // aunque su municipio no sea una de las paradas.
    zonaAnuncios = await getAnunciosProvincia(prov, 'ruta_zona');

    // Repartir en días (equitativo, secuencial)
    const per = Math.ceil(stops.length / dias);
    for (let d = 0; d < dias; d++) dayPlan.push(stops.slice(d*per, (d+1)*per));
    dayPlan = dayPlan.filter(d => d.length);
  }
}

// ── Construcción del itinerario de un día dentro de un solo municipio ──────
// Tiempos a pie / en coche estimados entre dos puntos (urbano, con rodeo).
function legTimes(a: any, b: any) {
  const km = haversine(a, b);
  return {
    dist: km < 1 ? `${Math.round(km * 1000)} m` : `${(Math.round(km * 10) / 10).toLocaleString('es-ES')} km`,
    walkMin: Math.max(1, Math.round((km / 4.5) * 60 * 1.25)),
    driveMin: Math.max(1, Math.round((km / 28) * 60 * 1.25)),
  };
}

let diaPlan: any = null;
if (pueblo && selCfgs.length) {
  const primaryCat = cats[0];
  const tipo = tipoByCat[primaryCat];
  const center = { latitud: pueblo.latitud, longitud: pueblo.longitud, nombre: pueblo.nombre };

  // Recurso "estrella" verificado de nuestro inventario (lo que hace destacar al pueblo)
  const starRow = await DB.prepare(
    `SELECT nombre, descripcion FROM entidades
      WHERE codigo_ine=? AND tipo=? ORDER BY length(COALESCE(descripcion,'')) DESC LIMIT 1`
  ).bind(puebloCode, tipo).first();

  // Alojamiento rural propio (respaldo local de "dormir")
  const ruralRow = await DB.prepare(
    `SELECT descripcion FROM entidades WHERE codigo_ine=? AND tipo='rural'
      ORDER BY length(COALESCE(descripcion,'')) DESC LIMIT 1`
  ).bind(puebloCode).first();
  let ruralTxt: string | null = null;
  if (ruralRow) {
    const md = /Alojamientos rurales:\s*(.+?)(?:\.\s*Entorno|\.$|$)/i.exec((ruralRow as any).descripcion || '');
    let a = (md ? md[1] : ((ruralRow as any).descripcion || '')).trim().replace(/\.$/, '');
    if (a.length > 90) a = a.slice(0, 90).replace(/,?\s*\S*$/, '') + '…';
    ruralTxt = a || null;
  }

  if (PLACES_ENABLED) {
    const prof = CAT_PROFILE[primaryCat] ?? {};
    // En el día SÍ queremos puntos que visitar aunque la categoría los oculte en la zona
    const visCfg = (prof.visitar && typeof prof.visitar === 'object') ? prof.visitar : { type: 'tourist_attraction' };
    const visSpec = {
      type: visCfg.type ?? 'tourist_attraction', radius: 5000, minReviews: 10,
      keyword: visCfg.keyword, excludeTypes: visCfg.excludeTypes,
    };
    const visKind = 'diavis' + (visCfg.keyword || visCfg.excludeTypes ? '_' + primaryCat : '');
    const comerKw = prof.comer?.keyword;
    const dormirKw = prof.dormir?.keyword;

    const [visRaw, cafeList, comerList, copaList, dormirList] = await Promise.all([
      getPlaceOptions(puebloCode, visKind, pueblo.latitud, pueblo.longitud, visSpec, 10),
      getPlaceOptions(puebloCode, 'cafe', pueblo.latitud, pueblo.longitud, { type: 'cafe', radius: 4000, minReviews: 20 }, 2),
      getPlaceOptions(puebloCode, 'comer' + (comerKw ? '_' + primaryCat : ''), pueblo.latitud, pueblo.longitud, { type: 'restaurant', radius: 7000, minReviews: 30, keyword: comerKw, softKeyword: true }, 4),
      getPlaceOptions(puebloCode, 'copa', pueblo.latitud, pueblo.longitud, { type: 'bar', radius: 4000, minReviews: 20 }, 2),
      getPlaceOptions(puebloCode, 'dormir' + (dormirKw ? '_' + primaryCat : ''), pueblo.latitud, pueblo.longitud, { type: 'lodging', radius: 9000, minReviews: 15, keyword: dormirKw, softKeyword: true }, 4),
    ]);

    decoratePlaces(visRaw, center);
    decoratePlaces(cafeList, center);
    decoratePlaces(comerList, center);
    decoratePlaces(copaList, center);
    decoratePlaces(dormirList, center);

    // Un día caben pocas cosas. Separamos lo CAMINABLE (cerca del centro) de las
    // joyas LEJANAS (que rompen el ritmo a pie → van aparte, "en coche").
    const WALK_FAR_KM = 1.6;                 // > 1,6 km del centro = lejano
    const walkCap = ritmo === 'completo' ? 6 : 4;   // nº de visitas a pie en el día
    const lejosCap = ritmo === 'completo' ? 3 : 2;  // joyas lejanas que sugerimos

    const visGeo = visRaw.filter((v: any) => v.lat != null && v.lng != null);
    for (const v of visGeo) v.distCentro = haversine(center, { latitud: v.lat, longitud: v.lng });
    let cerca = visGeo.filter((v: any) => v.distCentro <= WALK_FAR_KM);
    let lejosPool = visGeo.filter((v: any) => v.distCentro > WALK_FAR_KM);
    // Si el centroide está descolocado y nada cae "cerca", no dejamos el día vacío
    if (!cerca.length && visGeo.length) { cerca = visGeo; lejosPool = []; }

    // Ordenar lo caminable por vecino más cercano empezando por lo más céntrico
    const ordered: any[] = [];
    if (cerca.length) {
      const used = new Set<number>();
      let cur = 0, bd = Infinity;
      for (let i = 0; i < cerca.length; i++) { if (cerca[i].distCentro < bd) { bd = cerca[i].distCentro; cur = i; } }
      used.add(cur); ordered.push(cerca[cur]);
      while (ordered.length < cerca.length) {
        const a = { latitud: ordered[ordered.length - 1].lat, longitud: ordered[ordered.length - 1].lng };
        let best = -1; bd = Infinity;
        for (let i = 0; i < cerca.length; i++) {
          if (used.has(i)) continue;
          const d = haversine(a, { latitud: cerca[i].lat, longitud: cerca[i].lng });
          if (d < bd) { bd = d; best = i; }
        }
        used.add(best); ordered.push(cerca[best]);
      }
    }
    const walkable = ordered.slice(0, walkCap);   // tope realista para un día
    // Tiempo a la siguiente visita (a pie / en coche)
    for (let i = 0; i < walkable.length - 1; i++) {
      const t = legTimes(
        { latitud: walkable[i].lat, longitud: walkable[i].lng },
        { latitud: walkable[i + 1].lat, longitud: walkable[i + 1].lng },
      );
      walkable[i].next = { ...t, to: walkable[i + 1].nombre };
    }

    // "Si te queda tiempo": lo que no entró en el día a pie — joyas lejanas +
    // lo céntrico que se salió del cupo. Así no se pierde nada notable.
    const extraPool = [...ordered.slice(walkCap), ...lejosPool];
    const lejos = extraPool
      .sort((a: any, b: any) => (b.rating ?? 0) * Math.log10((b.reviews ?? 0) + 1) - (a.rating ?? 0) * Math.log10((a.reviews ?? 0) + 1))
      .slice(0, lejosCap)
      .map((v: any) => {
        const t = legTimes(center, { latitud: v.lat, longitud: v.lng });
        return { ...v, far: v.distCentro > WALK_FAR_KM, carDist: t.dist, carMin: t.driveMin, walkMin: t.walkMin };
      });

    // Repartir lo caminable en mañana / tarde
    const half = Math.max(1, Math.ceil(walkable.length / 2));
    const manana = walkable.slice(0, half);
    const tarde = walkable.slice(half);

    const comerIdx = pres === 'eco' ? modestIndex(comerList) : 0;
    const dormirIdx = pres === 'eco' ? modestIndex(dormirList) : 0;
    // Cenar = una opción distinta de la comida (o la modesta en económico)
    const cenarIdx = pres === 'eco' ? modestIndex(comerList) : (comerList.length > 1 ? 1 : 0);

    // Duración aproximada del plan a pie: ~50 min por visita + caminatas + comidas
    const walkLegs = walkable.reduce((a: number, s: any) => a + (s.next?.walkMin ?? 0), 0);
    const planMin = walkable.length * 50 + walkLegs
      + (cafeList[0] ? 30 : 0) + (comerList.length ? 75 : 0)
      + (copaList[0] ? 45 : 0) + (comerList.length ? 75 : 0);

    diaPlan = {
      star: starRow ? { nombre: (starRow as any).nombre, desc: (starRow as any).descripcion } : null,
      manana, tarde, lejos,
      cafe: cafeList[0] ?? null,
      comerList, comerCur: comerList[comerIdx] ?? null, comerIdx,
      copa: copaList[0] ?? null,
      cenarList: comerList, cenarIdx, cenarCur: comerList[cenarIdx] ?? null,
      dormirList, dormirCur: dormirList[dormirIdx] ?? null, dormirIdx,
      rural: ruralTxt, planMin,
      catLabel: labelByCat[primaryCat], catKey: primaryCat,
      icon: infoByCat[primaryCat].icon, color: colorByCat[primaryCat],
    };
  } else {
    // Sin Google: al menos mostramos el recurso estrella y el alojamiento rural
    diaPlan = {
      star: starRow ? { nombre: (starRow as any).nombre, desc: (starRow as any).descripcion } : null,
      manana: [], tarde: [], lejos: [], cafe: null, comerList: [], comerCur: null,
      copa: null, cenarList: [], cenarCur: null, dormirList: [], dormirCur: null,
      rural: ruralTxt, planMin: 0, catLabel: labelByCat[primaryCat], catKey: primaryCat,
      icon: infoByCat[primaryCat].icon, color: colorByCat[primaryCat],
    };
  }
}
const diaVisitas: any[] = diaPlan ? [...diaPlan.manana, ...diaPlan.tarde] : [];
const hasDia = !!(pueblo && diaPlan && (diaVisitas.length || diaPlan.star));
// Establecimientos anunciados y aprobados en este municipio (sello "Recomendado")
const diaAnuncios = pueblo ? await getAnunciosMunicipio(puebloCode, 'ruta_mun') : [];

// Datos para el mapa (paradas en orden de ruta, o visitas del día a pie)
const mapData = hasDia
  ? diaVisitas.map((v: any, i: number) => ({ n: i + 1, nombre: v.nombre, lat: v.lat, lng: v.lng }))
  : stops.map((s: any, i: number) => ({
      n: i + 1, nombre: s.nombre, lat: s.latitud, lng: s.longitud,
    }));

const fmtDur = (min: number) => {
  if (min >= 60) { const h = Math.floor(min / 60), m = min % 60; return m ? `${h} h ${m} min` : `${h} h`; }
  return `${min} min`;
};

const fmtRating = (h: any) => {
  const r = Number(h?.rating ?? 0).toLocaleString('es-ES', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  const n = h?.reviews ? ` (${Number(h.reviews).toLocaleString('es-ES')})` : '';
  return `${r}${n}`;
};

const selLabels = selCfgs.map(c => c.label);
const catTitle = selLabels.length <= 2
  ? selLabels.join(' y ')
  : `${selLabels.slice(0, 2).join(', ')} y ${selLabels.length - 2} más`;
// Encabezado: "por la zona de X" si hay ancla, si no "{cats} por {provincia}"
const routeHeading = anchor ? `Lo mejor por la zona de ${anchor.nombre}` : `${catTitle} por ${prov}`;
const diaHeading = pueblo ? `Un día en ${pueblo.nombre}` : '';
const title = hasDia
  ? `Ruta · ${diaHeading} — Ranking Spain`
  : (selCfgs.length && prov
    ? `Ruta · ${routeHeading} · ${dias} ${dias===1?'día':'días'} — Ranking Spain`
    : 'Planifica tu ruta — Ranking Spain');
---
<Base title={title} description="Genera una ruta de viaje real basada en datos verificados de Ranking Spain." noindex={true}>
<div class="ruta-page">
  <div class="ruta-hero">
    <h1>🗺️ Planifica tu ruta</h1>
    <p>Elige <strong>una o varias experiencias</strong> y una provincia. Te montamos una ruta <strong>real</strong> y en cada parada te decimos <strong>qué visitar</strong>, <strong>dónde comer</strong> y <strong>dónde dormir</strong>, con la valoración de Google en cada sitio.</p>
  </div>

  <form class="ruta-form" method="get" id="ruta-form" data-mode={pueblo ? 'pueblo' : 'zona'}>
    <div class="rf-modes" role="tablist">
      <button type="button" class={`rf-mode${pueblo?'':' on'}`} data-mode="zona">🧭 Por la zona</button>
      <button type="button" class={`rf-mode${pueblo?' on':''}`} data-mode="pueblo">📍 Un día en un pueblo</button>
    </div>

    <div class="rf-field rf-cats">
      <label>¿Qué quieres hacer? <span class="rf-hint rf-hint-zona">(puedes elegir varias)</span><span class="rf-hint rf-hint-pueblo">(opcional: enfoca el día)</span></label>
      <div class="rf-chips">
        {RUTA_CATS.map(c => (
          <label class={`rf-chip${cats.includes(c.key)?' on':''}`}>
            <input type="checkbox" name="cat" value={c.key} checked={cats.includes(c.key)} />
            {c.label}
          </label>
        ))}
      </div>
    </div>

    <!-- MODO POR LA ZONA -->
    <div class="rf-block rf-block-zona">
      <div class="rf-field">
        <label>Provincia</label>
        <select name="prov">
          <option value="">Elige provincia…</option>
          {provincias.map(p => <option value={p} selected={p===prov}>{p}</option>)}
        </select>
      </div>
      <div class="rf-field rf-dias">
        <label>Días</label>
        <div class="rf-dias-btns">
          {[1,2,3].map(d => <label class={`rf-day${d===dias?' on':''}`}><input type="radio" name="dias" value={d} checked={d===dias} />{d}</label>)}
        </div>
      </div>
      <button type="submit" class="rf-go">Generar ruta</button>
    </div>

    <!-- MODO UN DÍA EN UN PUEBLO -->
    <div class="rf-block rf-block-pueblo">
      <div class="rf-field rf-pueblo-field">
        <label>¿Qué pueblo?</label>
        <div class="rf-ac-wrap">
          <input type="text" id="rf-pueblo-input" placeholder="Escribe un municipio…" autocomplete="off" value={pueblo ? pueblo.nombre : ''} />
          <div class="rf-ac" id="rf-pueblo-ac"></div>
        </div>
        <p class="rf-pueblo-hint">Te montamos el <strong>plan del día completo</strong> dentro del pueblo: qué ver a pie, dónde comer, un café, una copa, cenar y dormir.</p>
      </div>
    </div>
  </form>

  {!pueblo && selCfgs.length > 0 && prov && stops.length === 0 && (
    <p class="ruta-empty">{anchor
      ? `No tenemos suficientes sitios cerca de ${anchor.nombre} para montar una ruta por la zona. Prueba el planificador eligiendo provincia y experiencias.`
      : `No tenemos suficientes datos de ${catTitle} en ${prov} para montar una ruta. Prueba otra provincia o experiencia.`}</p>
  )}

  {pueblo && !hasDia && (
    <p class="ruta-empty">No hemos podido montar un plan de un día en {pueblo.nombre} ahora mismo. Prueba con otra experiencia u otro municipio.</p>
  )}

  {selCfgs.length > 0 && prov && stops.length > 0 && (
    <div class="ruta-result">
      <div class="ruta-result-head" style={`background:${headColor}`}>
        <div class="rrh-eyebrow">Ruta a medida · Ranking Spain</div>
        <div class="rrh-title"><Icon name={anchor ? 'map' : infoByCat[selCfgs[0].key].icon} size={22} /> {routeHeading}</div>
        <div class="rrh-meta">{stops.length} paradas · {dias} {dias===1?'día':'días'}{driveTotalMin > 0 ? ` · 🚗 ~${fmtDur(driveTotalMin)} en coche` : ` · ~${Math.round(totalKm)} km`}</div>
      </div>

      <div class="ruta-tweaks">
        <span class="rt-grp">
          <span class="rt-label">💶 Presupuesto</span>
          <a class={`rt-pill${pres!=='eco'?' on':''}`} href={setParam('pres', null)}>Cualquiera</a>
          <a class={`rt-pill${pres==='eco'?' on':''}`} href={setParam('pres', 'eco')}>Económico</a>
        </span>
        <span class="rt-grp">
          <span class="rt-label">🧭 Distancia</span>
          <a class={`rt-pill${!compacta?' on':''}`} href={setParam('compacta', null)}>Cualquiera</a>
          <a class={`rt-pill${compacta?' on':''}`} href={setParam('compacta', '1')} title="Paradas más cercanas entre sí, menos conducción">Corta</a>
        </span>
      </div>

      <div id="ruta-map" class="ruta-map"></div>

      {dayPlan.map((day, di) => (
        <div class="ruta-day">
          <div class="ruta-day-tag" style={`color:${headColor};background:${headColor}15`}>DÍA {di+1}</div>
          {day.map((s: any, idx: number) => (
            <Fragment>
            <div class="ruta-stop">
              <span class="rs-icon" style={`color:${colorByCat[s.catKey]}`}><Icon name={infoByCat[s.catKey].icon} size={18} /></span>
              <div class="rs-body">
                <a href={`/municipio/${s.codigo_ine}?desde=${s.catKey}`} class="rs-name">{s.nombre}</a>
                <span class="rs-score" style={`color:${colorByCat[s.catKey]}`}>{Math.round(s.puntuacion)}/100</span>
                <span class="rs-cat" style={`color:${colorByCat[s.catKey]};background:${colorByCat[s.catKey]}15`}>{s.catLabel}</span>
                {s.recurso && <div class="rs-rec">🎯 Hacer: <strong>{s.recurso}</strong></div>}
                {s.recurso_desc && <div class="rs-desc">{String(s.recurso_desc).slice(0,150)}{String(s.recurso_desc).length>150?'…':''}</div>}
                {s.visitarCur && (
                  <div class="rs-place rs-swap" data-emoji="👁️" data-label="Visitar" data-places={JSON.stringify(s.visitarList)} data-idx={s.visitarIdx}>
                    <img class="rs-thumb" src={s.visitarCur.foto_ref ? `/api/place-photo?w=200&ref=${encodeURIComponent(s.visitarCur.foto_ref)}` : ''} alt={s.visitarCur.nombre} loading="lazy" width="56" height="56" style={s.visitarCur.foto_ref ? '' : 'display:none'} />
                    <div class="rs-place-txt">
                      <div class="rs-line">👁️ Visitar: <strong class="rs-pname">{s.visitarCur.nombre}</strong><span class="rs-star rs-prating">★ {fmtRating(s.visitarCur)}</span>{s.visitarList.length > 1 && <button type="button" class="rs-swap-btn">↻ otra opción</button>}</div>
                      {s.visitarCur.locLabel && <div class="rs-loc">📍 {s.visitarCur.locLabel}</div>}
                      <div class="rs-attr rs-pattr" set:html={s.visitarCur.foto_attr ?? ''}></div>
                    </div>
                  </div>
                )}
                {s.catKey !== 'gastronomia' && (s.comerCur
                  ? <div class="rs-place rs-swap" data-emoji="🍽️" data-label="Comer" data-places={JSON.stringify(s.comerList)} data-idx={s.comerIdx}>
                      <img class="rs-thumb" src={s.comerCur.foto_ref ? `/api/place-photo?w=200&ref=${encodeURIComponent(s.comerCur.foto_ref)}` : ''} alt={s.comerCur.nombre} loading="lazy" width="56" height="56" style={s.comerCur.foto_ref ? '' : 'display:none'} />
                      <div class="rs-place-txt">
                        <div class="rs-line">🍽️ Comer: <strong class="rs-pname">{s.comerCur.nombre}</strong><span class="rs-star rs-prating">★ {fmtRating(s.comerCur)}</span>{s.comerList.length > 1 && <button type="button" class="rs-swap-btn">↻ otra opción</button>}</div>
                        {s.comerCur.locLabel && <div class="rs-loc">📍 {s.comerCur.locLabel}</div>}
                        <div class="rs-attr rs-pattr" set:html={s.comerCur.foto_attr ?? ''}></div>
                      </div>
                    </div>
                  : s.comer
                  ? <div class="rs-line">🍽️ Comer: <strong>{s.comer.rec}</strong>{s.comer.mismo ? '' : ` · ${s.comer.nombre} (a ${s.comer.km} km)`}</div>
                  : <div class="rs-line rs-none">🍽️ Sin restaurante recomendado cerca</div>)}
                {s.catKey !== 'TurismoRural' && (s.dormirCur
                  ? <div class="rs-place rs-swap" data-emoji="🛏️" data-label="Dormir" data-places={JSON.stringify(s.dormirList)} data-idx={s.dormirIdx}>
                      <img class="rs-thumb" src={s.dormirCur.foto_ref ? `/api/place-photo?w=200&ref=${encodeURIComponent(s.dormirCur.foto_ref)}` : ''} alt={s.dormirCur.nombre} loading="lazy" width="56" height="56" style={s.dormirCur.foto_ref ? '' : 'display:none'} />
                      <div class="rs-place-txt">
                        <div class="rs-line">🛏️ Dormir: <strong class="rs-pname">{s.dormirCur.nombre}</strong><span class="rs-star rs-prating">★ {fmtRating(s.dormirCur)}</span>{s.dormirList.length > 1 && <button type="button" class="rs-swap-btn">↻ otra opción</button>}</div>
                        {s.dormirCur.locLabel && <div class="rs-loc">📍 {s.dormirCur.locLabel}</div>}
                        <div class="rs-attr rs-pattr" set:html={s.dormirCur.foto_attr ?? ''}></div>
                      </div>
                    </div>
                  : s.dormir
                  ? <div class="rs-line">🛏️ Dormir: <strong>{s.dormir.rec}</strong>{s.dormir.mismo ? '' : ` · ${s.dormir.nombre} (a ${s.dormir.km} km)`}</div>
                  : <div class="rs-line rs-none">🛏️ Sin alojamiento recomendado cerca</div>)}
              </div>
            </div>
            {idx < day.length - 1 && s.driveNext && (
              <div class="ruta-drive">🚗 {fmtDur(s.driveNext.min)} · {s.driveNext.km} km hasta {day[idx+1].nombre}{s.driveNext.est ? ' (aprox.)' : ''}</div>
            )}
            </Fragment>
          ))}
        </div>
      ))}

      {zonaAnuncios.length > 0 && (
        <div class="ruta-day reco-zona">
          <div class="dia-tag dia-tag-reco">⭐ Recomendados en {prov}</div>
          {zonaAnuncios.map((a: any) => (
            <div class="rs-place dia-vis">
              <img class="rs-thumb" src={a.foto ?? ''} alt={a.nombre} loading="lazy" width="56" height="56" style={a.foto ? '' : 'display:none'} />
              <div class="rs-place-txt">
                <div class="rs-line">⭐ <strong>{a.nombre}</strong><span class="rs-reco-badge">Recomendado</span></div>
                <div class="rs-loc">📍 {a.municipio}{a.direccion ? ` · ${a.direccion}` : ''}{a.codigo_ine ? <> · <a href={`/municipio/${a.codigo_ine}`}>ver pueblo</a></> : ''}</div>
                <div class="rs-loc rs-reco-acts">{a.telefono && <a href={`tel:${a.telefono}`}>📞 Llamar</a>}{a.wa && <a href={a.wa} target="_blank" rel="nofollow noopener" class="rs-wa">💬 WhatsApp</a>}{a.web && <a href={a.web} target="_blank" rel="nofollow noopener">🔗 web</a>}</div>
              </div>
            </div>
          ))}
        </div>
      )}

      <div class="ruta-foot">Ruta basada en el inventario verificado de Ranking Spain. Restaurantes y sitios para visitar, con su valoración, vía Google. Datos reales, sin inventar.</div>
    </div>
  )}

  {hasDia && (
    <div class="ruta-result dia-result">
      <div class="ruta-result-head" style={`background:${diaPlan.color}`}>
        <div class="rrh-eyebrow">Plan de un día · Ranking Spain</div>
        <div class="rrh-title"><Icon name={diaPlan.icon} size={22} /> {diaHeading}</div>
        <div class="rrh-meta">{pueblo.provincia} · {diaPlan.catLabel}{diaVisitas.length ? ` · ${diaVisitas.length} para ver a pie` : ''}{diaPlan.planMin > 0 ? ` · ⏱️ ~${fmtDur(diaPlan.planMin)} de plan` : ''}</div>
      </div>

      <div class="ruta-tweaks">
        <span class="rt-grp">
          <span class="rt-label">🚶 Ritmo</span>
          <a class={`rt-pill${ritmo!=='completo'?' on':''}`} href={setParam('ritmo', null)} title="Pocas visitas, todo a pie y céntrico">Relajado</a>
          <a class={`rt-pill${ritmo==='completo'?' on':''}`} href={setParam('ritmo', 'completo')} title="Más visitas (mejor con coche)">Completo</a>
        </span>
        <span class="rt-grp">
          <span class="rt-label">💶 Presupuesto</span>
          <a class={`rt-pill${pres!=='eco'?' on':''}`} href={setParam('pres', null)}>Cualquiera</a>
          <a class={`rt-pill${pres==='eco'?' on':''}`} href={setParam('pres', 'eco')}>Económico</a>
        </span>
      </div>

      {diaVisitas.length > 0 && <div id="ruta-map" class="ruta-map"></div>}

      {diaPlan.star && (
        <div class="dia-star" style={`border-color:${diaPlan.color}`}>
          <div class="dia-star-tag" style={`color:${diaPlan.color}`}><Icon name={diaPlan.icon} size={15} /> Lo que hace destacar a {pueblo.nombre}</div>
          <div class="dia-star-name">{diaPlan.star.nombre}</div>
          {diaPlan.star.desc && <div class="rs-desc">{String(diaPlan.star.desc).slice(0,200)}{String(diaPlan.star.desc).length>200?'…':''}</div>}
        </div>
      )}

      {/* RECOMENDADOS — establecimientos anunciados y aprobados en el pueblo */}
      {diaAnuncios.length > 0 && (
        <div class="dia-block">
          <div class="dia-tag dia-tag-reco">⭐ Recomendados en {pueblo.nombre}</div>
          {diaAnuncios.map((a: any) => (
            <div class="rs-place dia-vis">
              <img class="rs-thumb" src={a.foto ?? ''} alt={a.nombre} loading="lazy" width="56" height="56" style={a.foto ? '' : 'display:none'} />
              <div class="rs-place-txt">
                <div class="rs-line">⭐ <strong>{a.nombre}</strong><span class="rs-reco-badge">Recomendado</span></div>
                {a.descripcion && <div class="rs-desc">{String(a.descripcion).slice(0,140)}{String(a.descripcion).length>140?'…':''}</div>}
                <div class="rs-loc rs-reco-acts">{a.direccion ? <span>📍 {a.direccion}</span> : ''}{a.telefono && <a href={`tel:${a.telefono}`}>📞 Llamar</a>}{a.wa && <a href={a.wa} target="_blank" rel="nofollow noopener" class="rs-wa">💬 WhatsApp</a>}{a.web && <a href={a.web} target="_blank" rel="nofollow noopener">🔗 web</a>}</div>
              </div>
            </div>
          ))}
        </div>
      )}

