              </div>
              {i < diaPlan.tarde.length - 1 && v.next && (
                <div class="dia-leg">🚶 {fmtDur(v.next.walkMin)} · 🚗 {fmtDur(v.next.driveMin)} · {v.next.dist} hasta {v.next.to}</div>
