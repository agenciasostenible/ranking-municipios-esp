---
import Base from '../../layouts/Base.astro';
import { DB } from '../../lib/d1client';
import { TIPO_LABEL } from '../../lib/entidades';

const { codigo } = Astro.params;
const muni = await DB.prepare(`SELECT codigo_ine, nombre, provincia FROM municipios WHERE codigo_ine = ?`).bind(codigo).first() as any;
if (!muni) return Astro.redirect('/');

const { results: ents } = await DB.prepare(
  `SELECT id, nombre, tipo, descripcion FROM entidades WHERE codigo_ine = ? ORDER BY tipo, nombre`
).bind(codigo).all();
const sitios = (ents as any[]);
---
<Base title={`Revisar ficha de ${muni.nombre} — Ranking Spain`} noindex={true}>
<div class="rv-page">
  <div class="rv-head">
    <span class="rv-kick">Revisión de ficha · Ayuntamiento</span>
    <h1>{muni.nombre}</h1>
    <p class="rv-sub">Estos son los {sitios.length} sitios que mostramos de <strong>{muni.nombre}</strong> ({muni.provincia}). Marca los que <strong>no existen o están mal</strong> y añade lo que quieras. Lo revisamos a mano — no se borra nada automáticamente.</p>
  </div>

  <div class="rv-list">
    {sitios.map(s => (
      <label class="rv-item" data-id={s.id} data-nombre={s.nombre}>
        <input type="checkbox" class="rv-chk" />
        <div class="rv-info">
          <div class="rv-nombre">{s.nombre}</div>
          <div class="rv-tipo">{TIPO_LABEL[s.tipo] ?? s.tipo}</div>
        </div>
        <select class="rv-motivo" disabled>
          <option value="no_existe">No existe</option>
          <option value="otro_municipio">Es de otro pueblo</option>
          <option value="nombre_mal">Nombre incorrecto</option>
          <option value="falta_info">Desactualizado</option>
        </select>
      </label>
    ))}
  </div>

  <div class="rv-foot">
    <label class="rv-lbl">¿Algo más que debamos saber, o un sitio que falte? (opcional)</label>
    <textarea id="rv-com" rows="3" placeholder="Cuéntanos…"></textarea>
    <label class="rv-lbl">Email de contacto (opcional)</label>
    <input id="rv-email" type="email" placeholder="ayuntamiento@ejemplo.es" />
    <input id="rv-hp" type="text" style="display:none" tabindex="-1" autocomplete="off" />
    <button id="rv-send" class="rv-send">Enviar revisión</button>
    <div id="rv-ok" class="rv-okmsg" hidden>✅ ¡Gracias! Hemos recibido tu revisión y la aplicaremos pronto.</div>
  </div>
</div>

<script is:inline define:vars={{ rvCodigo: codigo, rvMuni: muni.nombre }}>
  (function () {
    document.querySelectorAll('.rv-item').forEach(function (it) {
      var chk = it.querySelector('.rv-chk'), sel = it.querySelector('.rv-motivo');
      chk.addEventListener('change', function () { sel.disabled = !chk.checked; it.classList.toggle('on', chk.checked); });
    });
    document.getElementById('rv-send').addEventListener('click', function () {
      if (document.getElementById('rv-hp').value) return;
      var items = [];
      document.querySelectorAll('.rv-item').forEach(function (it) {
        if (it.querySelector('.rv-chk').checked) items.push({
          entidad_id: it.dataset.id, entidad_nombre: it.dataset.nombre,
          motivo: it.querySelector('.rv-motivo').value,
        });
      });
      var com = document.getElementById('rv-com').value.trim();
      if (!items.length && !com) { alert('Marca al menos un sitio o escribe un comentario.'); return; }
      var btn = document.getElementById('rv-send'); btn.disabled = true; btn.textContent = 'Enviando…';
      fetch('/api/reportar', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ codigo_ine: rvCodigo, municipio: rvMuni, origen: 'ayuntamiento', comentario: com, email: document.getElementById('rv-email').value.trim(), items: items }),
      }).then(function (r) { return r.json(); }).then(function (j) {
        if (j.ok) { document.getElementById('rv-ok').hidden = false; btn.style.display = 'none'; window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' }); }
        else { alert('No se pudo enviar.'); btn.disabled = false; btn.textContent = 'Enviar revisión'; }
      }).catch(function () { alert('Error de conexión.'); btn.disabled = false; btn.textContent = 'Enviar revisión'; });
    });
  })();
</script>

<style>
.rv-page { max-width: 680px; margin: 0 auto; padding: 24px 16px 60px; }
.rv-kick { font-size: .75rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: #FF385C; }
.rv-head h1 { font-size: 1.8rem; font-weight: 700; margin: 6px 0 8px; color: #222; }
.rv-sub { color: #666; font-size: .95rem; line-height: 1.5; }
.rv-list { display: flex; flex-direction: column; gap: 8px; margin: 22px 0; }
.rv-item { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border: 1.5px solid #eee; border-radius: 12px; cursor: pointer; background: #fff; }
.rv-item.on { border-color: #FF385C; background: #fff1f3; }
.rv-chk { width: 20px; height: 20px; flex-shrink: 0; accent-color: #FF385C; }
.rv-info { flex: 1; min-width: 0; }
.rv-nombre { font-weight: 700; color: #222; font-size: .95rem; }
.rv-tipo { font-size: .78rem; color: #999; }
.rv-motivo { flex-shrink: 0; padding: 7px 10px; border: 1.5px solid #ddd; border-radius: 9px; font-size: .82rem; }
.rv-motivo:disabled { opacity: .4; }
.rv-foot { border-top: 1px solid #eee; padding-top: 20px; }
.rv-lbl { display: block; font-size: .82rem; font-weight: 700; color: #444; margin: 12px 0 6px; }
.rv-foot textarea, .rv-foot input { width: 100%; box-sizing: border-box; padding: 11px 13px; border: 1.5px solid #ddd; border-radius: 11px; font-size: .92rem; font-family: inherit; }
.rv-send { margin-top: 18px; width: 100%; background: #FF385C; color: #fff; border: none; border-radius: 12px; padding: 14px; font-weight: 700; font-size: 1rem; cursor: pointer; }
.rv-okmsg { margin-top: 16px; text-align: center; color: #16a34a; font-weight: 700; }
</style>
</Base>
